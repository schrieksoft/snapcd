<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SnapCd.Utils</RootNamespace>

        <!-- NuGet Package Metadata. SnapCd.Server.Core's package declares a dependency on this id,
             so it must be published for a package-based restore to resolve. -->
        <PackageId>SnapCd.Utils</PackageId>
        <Authors>Schrieksoft</Authors>
        <Company>Schrieksoft</Company>
        <Description>Shared configuration and settings utilities for SnapCD</Description>
        <PackageProjectUrl>https://github.com/schrieksoft/snapcd-lib</PackageProjectUrl>
        <RepositoryUrl>https://github.com/schrieksoft/snapcd-lib</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageTags>snapcd</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SnapCd.Contracts\SnapCd.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The externalsettings.json provider, shared by the Server, the Runner and the Agent. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
        <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.22" />
    </ItemGroup>

    <ItemGroup>
        <!-- Carve-out schema fragments for settings that don't fit the POCO-driven path:
             .NET-standard sections (Logging) and bare top-level scalars (ConnectionString,
             AllowHttp). Loaded by StandardSchemaFragments via Assembly.GetManifestResourceStream. -->
        <EmbeddedResource Include="Settings/Carveouts/*.json" />
    </ItemGroup>

</Project>
