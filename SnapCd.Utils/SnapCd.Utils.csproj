<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SnapCd.Utils</RootNamespace>
        <!-- Internal shared library, consumed by the applications, codegen tools and tests; not a NuGet artifact. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SnapCd.Contracts\SnapCd.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The externalsettings.json provider, shared by the Server, the Runner and the Agent. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Azure.Identity" Version="1.16.0" />
        <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.0" />
        <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.4.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- Carve-out schema fragments for settings that don't fit the POCO-driven path:
             .NET-standard sections (Logging) and bare top-level scalars (ConnectionString,
             AllowHttp). Loaded by StandardSchemaFragments via Assembly.GetManifestResourceStream. -->
        <EmbeddedResource Include="Settings/Carveouts/*.json" />
    </ItemGroup>

</Project>
