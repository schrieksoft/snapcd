{
  "profiles": {
    "SnapCd.Runner": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "https://localhost:20003",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "SnapCd.Runner (federated)": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "https://localhost:20004",
