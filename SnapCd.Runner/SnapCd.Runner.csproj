<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Required by SnapCd.Settings.Generator.Runner: the codegen reads <summary> XML doc
             off settings POCO properties to project into JSON Schema description keywords.
             CS1591 ("missing XML doc comment for publicly visible type or member") is opted out
             since the settings types are the only members we care about documenting. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <SnapCdInspectSource>$(MSBuildThisFileDirectory)../tools/snapcd-inspect</SnapCdInspectSource>
        <SnapCdInspectBinary>$(MSBuildThisFileDirectory)EmbeddedTools/snapcd-inspect</SnapCdInspectBinary>
    </PropertyGroup>

    <ItemGroup>
        <SnapCdInspectInput Include="$(SnapCdInspectSource)/*.go;$(SnapCdInspectSource)/go.mod;$(SnapCdInspectSource)/go.sum"
                            Exclude="$(SnapCdInspectSource)/*_test.go" />
    </ItemGroup>

    <!-- Rebuilds the embedded tool whenever its Go source is newer than the binary; skipped when Go is not installed. -->
    <Target Name="DetectGo" BeforeTargets="BeforeBuild">
        <Exec Command="go version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
            <Output TaskParameter="ExitCode" PropertyName="GoVersionExitCode" />
        </Exec>
    </Target>

    <Target Name="BuildSnapCdInspect" AfterTargets="DetectGo" Condition="'$(GoVersionExitCode)' == '0'"
            Inputs="@(SnapCdInspectInput)" Outputs="$(SnapCdInspectBinary)">
        <Exec Command="go build -C &quot;$(SnapCdInspectSource)&quot; -buildvcs=false -o &quot;$(SnapCdInspectBinary)&quot; ."
              EnvironmentVariables="CGO_ENABLED=0;GOOS=linux;GOARCH=amd64" />
    </Target>

    <!-- Added after the build step so a binary created by it on a clean checkout is embedded in the same build. -->
    <Target Name="EmbedSnapCdInspect" AfterTargets="BuildSnapCdInspect" BeforeTargets="PrepareResources">
        <ItemGroup>
            <EmbeddedResource Include="$(SnapCdInspectBinary)"
                              Condition="Exists('$(SnapCdInspectBinary)')"
                              LogicalName="SnapCd.Runner.EmbeddedTools.snapcd-inspect" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.33.1" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
        <ProjectReference Include="..\SnapCd.Contracts\SnapCd.Contracts.csproj" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
        <PackageReference Include="OpenIddict.AspNetCore" Version="7.0.0" />
        <PackageReference Include="OpenIddict.Abstractions" Version="7.0.0" />
        <PackageReference Include="OpenIddict.Quartz" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Azure.Identity" Version="1.16.0" />
        <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.0" />
        <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.4.5" />
        <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1" />
    </ItemGroup>

    <!-- Version Configuration -->
    <!-- Version / AssemblyVersion / FileVersion / InformationalVersion are intentionally
         unset so they are supplied at publish time (CI passes /p:Version=$SEMVER) and fall
         back to git-describe in Debug via Directory.Build.targets at the repo root. -->
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

</Project>
