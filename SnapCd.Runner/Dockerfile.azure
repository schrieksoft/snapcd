FROM ghcr.io/schrieksoft/base-image-snapcd-runner:1.2.2-azure

WORKDIR /app
EXPOSE 8080

# tools/ is most of the image and changes far less often than the application, so it gets
# its own layer. The two source directories are disjoint: the app one has tools/ removed.
COPY out/snapcd-runner-tools/ ./tools/
COPY out/snapcd-runner-app/ ./

# Application files stay root-owned so the unprivileged process cannot rewrite its own
# assemblies. runnerdata is the only path it writes, and deployments mount over it.
USER root
RUN chown root:root /app && install -d -o $APP_UID -g $APP_UID /app/runnerdata
USER $APP_UID

ENTRYPOINT ["dotnet", "SnapCd.Runner.dll"]
