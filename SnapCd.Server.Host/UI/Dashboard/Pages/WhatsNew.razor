@page "/WhatsNew"
@layout OrganizationMainLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.Extensions.Options
@using SnapCd.Contracts
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Telemetry
@using SnapCd.Server.Core.UI.Dashboard.Layout
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Host.CapAlerts
@using SnapCd.Server.Host.Installations
@using SnapCd.Server.Host.Telemetry
@implements IDisposable
@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@inject InstallationService Installation
@inject IVersionService VersionService
@inject IOptions<TelemetrySettings> TelemetrySettings
@inject GitHubReleasesClient Releases
@inject ProtectedLocalStorage LocalStorage
@inject CapAlertService CapAlerts
@inject ModuleCountChangedNotificationService CapAlertNotifications
@inject IOrganizationContext OrganizationContext
@inject SnapCd.Server.Core.Services.Admin.SystemRoleService SystemRoleService
@inject OrganizationMembershipCacheService MembershipCache
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<SnapCd.Server.Core.Entities.Definition.User> UserManager

<PageTitle>What's New</PageTitle>
<link rel="stylesheet" href="/_content/SnapCd.Server.Core/snapcd-content.css"/>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else
{
    @if (!TelemetrySettings.Value.Enabled)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">Telemetry is disabled on this server, so it receives no alerts or notices.</MudText>
    }

    @if (_alerts.Count > 0 || ShowCapAlert)
    {
        <MudText Typo="Typo.h4" Class="wn-section">Alerts</MudText>
        @if (ShowCapAlert)
        {
            <div class="wn-notice wn-alert">
                <div class="wn-notice-head">
                    <MudText Typo="Typo.subtitle1" Class="wn-notice-title">@_capAlert!.Title</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="DismissCapAlertAsync">Dismiss</MudButton>
                </div>
                <div class="blog-content">
                    @((MarkupString)WhatsNewMarkdown.ToHtml(_capAlert.Markdown))
                </div>
            </div>
        }
        @foreach (var e in _alerts)
        {
            @RenderEntry(e, true)
        }
    }

    @if (_notices.Count > 0)
    {
        <MudText Typo="Typo.h4" Class="@(_alerts.Count > 0 || ShowCapAlert ? "wn-section wn-section-gap" : "wn-section")">Notices</MudText>
        @foreach (var e in _notices)
        {
            @RenderEntry(e, false)
        }
    }

    <MudText Typo="Typo.h4" Class="@(_alerts.Count + _notices.Count > 0 || ShowCapAlert ? "wn-section wn-section-gap" : "wn-section")">Releases</MudText>
    @if (_releases.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
            @(_releasesUnavailable ? "GitHub could not be reached, so newer releases cannot be listed." : $"You are on {VersionService.ShortVersion}, the latest release.")
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">The following additional changes have been released:</MudText>
        <div class="wn-releases mb-6">
            @foreach (var r in _releases)
            {
                <div class="wn-release">
                    <a class="wn-mono wn-release-version" href="@r.Url" target="_blank" rel="noopener">@r.Tag</a>
                    <span class="wn-release-bump">
                        @if (r.Bump == "minor")
                        {
                            <MudTooltip Text="A minor release: new features, compatible with what you have.">
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Text="minor"/>
                            </MudTooltip>
                        }
                        else if (r.Bump == "major")
                        {
                            <MudTooltip Text="A major release: read the notes before upgrading, something may have changed incompatibly.">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Text="major"/>
                            </MudTooltip>
                        }
                    </span>
                    <span class="wn-release-heading">@r.Heading</span>
                </div>
            }
        </div>
    }
}

<style>
    .wn-section {
        font-weight: 600;
        letter-spacing: -0.015em;
        margin-bottom: 16px;
    }

    .wn-section-gap {
        margin-top: 48px;
    }

    .wn-mono {
        font-family: 'Geist Mono', ui-monospace, monospace;
    }

    .wn-releases {
        max-width: 1100px;
    }

    .wn-release {
        display: grid;
        grid-template-columns: 96px 72px 1fr;
        align-items: center;
        column-gap: 16px;
        padding: 6px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        font-size: 14px;
    }

    .wn-release-bump {
        display: flex;
        align-items: center;
        min-height: 24px;
    }

    .wn-release:last-child {
        border-bottom: none;
    }

    .wn-release-version {
        color: var(--snap-accent);
        text-decoration: none;
    }

    .wn-release-heading {
        min-width: 0;
    }

    .wn-release-version:hover {
        text-decoration: underline;
    }

    .wn-notice {
        max-width: 1100px;
        padding: 12px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .wn-notice:last-child {
        border-bottom: none;
    }

    .wn-notice-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .wn-notice-title {
        font-weight: 600;
    }

    .wn-alert {
        border-left: 3px solid var(--snap-error);
        padding-left: 12px;
    }

    .wn-notice .blog-content {
        padding: 0;
        overflow: visible;
    }
</style>

@code {
    private bool _loading = true;
    private bool _releasesUnavailable;
    private IReadOnlyList<ReleaseSummary> _releases = [];
    private List<WhatsNewEntryDto> _entries = [];
    private List<WhatsNewEntryDto> _alerts = [];
    private List<WhatsNewEntryDto> _notices = [];
    private CapAlert? _capAlert;
    private int? _capAlertDismissedAtCount;
    private Guid _subscription;

    // Dismissed for this browser at a count; it comes back once a module is added past it.
    private bool _canActOnLicence;

    // The module-limit alert is for the people who can buy a licence; everyone else gets news only.
    private bool ShowCapAlert => _canActOnLicence && _capAlert is not null && (_capAlertDismissedAtCount is null || _capAlert.Count > _capAlertDismissedAtCount);

    private RenderFragment RenderEntry(WhatsNewEntryDto e, bool alert) => __builder =>
    {
        <div class="wn-notice @(alert ? "wn-alert" : "")">
            <div class="wn-notice-head">
                <MudText Typo="Typo.subtitle1" Class="wn-notice-title">@e.Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@e.PublishedUtc.ToString("yyyy-MM-dd")</MudText>
            </div>
            <div class="blog-content">
                @((MarkupString)WhatsNewMarkdown.ToHtml(e.Markdown))
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        var row = await Installation.GetAsync();
        _entries = TelemetrySnapshotProvider.ReadStored(row.WhatsNewJson).OrderByDescending(e => e.PublishedUtc).ToList();
        _alerts = _entries.Where(e => e.Kind == nameof(WhatsNewKind.Alert)).ToList();
        _notices = _entries.Where(e => e.Kind == nameof(WhatsNewKind.Notice)).ToList();
        _releases = await Releases.NewerThanRunningAsync();
        _releasesUnavailable = !Releases.LastFetchSucceeded;
        _canActOnLicence = await CanActOnLicenceAsync();
        _capAlert = _canActOnLicence ? await CapAlerts.EvaluateAsync(OrganizationContext.CurrentOrganizationId ?? Guid.Empty) : null;
        _subscription = CapAlertNotifications.Subscribe(OnModuleCountChanged);
        _loading = false;
    }

    private async Task OnModuleCountChanged()
    {
        if (!_canActOnLicence) return;
        _capAlert = await CapAlerts.EvaluateAsync(OrganizationContext.CurrentOrganizationId ?? Guid.Empty);
        await InvokeAsync(StateHasChanged);
    }

    private string CapAlertKey => $"snapcd.capalert.{OrganizationContext.CurrentOrganizationId}.{_capAlert?.Kind}";

    private async Task DismissCapAlertAsync()
    {
        if (_capAlert is null) return;
        _capAlertDismissedAtCount = _capAlert.Count;
        try
        {
            await LocalStorage.SetAsync(CapAlertKey, _capAlert.Count);
        }
        catch
        {
            // Storage unavailable: dismissed for this circuit only.
        }
    }

    private async Task<bool> CanActOnLicenceAsync()
    {
        if (await SystemRoleService.CurrentUserIsSystemAdministratorAsync()) return true;
        var orgId = OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
        if (orgId == Guid.Empty) return false;
        var user = await UserManager.GetUserAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        return user is not null && await MembershipCache.HasAnyOrganizationRoleAsync(user.Id, orgId, [OrganizationRole.Owner, OrganizationRole.SubscriptionManager]);
    }

    public void Dispose() => CapAlertNotifications.Unsubscribe(_subscription);

    // Opening the page is what clears the badge, for this browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var newest = _entries.FirstOrDefault(e => !WhatsNewKinds.IsCap(e.Kind));
            if (newest is not null) await LocalStorage.SetAsync(WhatsNewKeys.LastSeenEntryId, newest.Id);
            if (_capAlert is not null)
            {
                var dismissed = await LocalStorage.GetAsync<int>(CapAlertKey);
                if (dismissed.Success)
                {
                    _capAlertDismissedAtCount = dismissed.Value;
                    StateHasChanged();
                }
            }
        }
        catch
        {
            // Storage unavailable: the badge simply stays and the alert shows.
        }
    }
}
