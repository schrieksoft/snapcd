@page "/WhatsNew"
@layout OrganizationMainLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.Extensions.Options
@using SnapCd.Contracts
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Telemetry
@using SnapCd.Server.Core.UI.Dashboard.Layout
@using SnapCd.Server.Host.Installations
@using SnapCd.Server.Host.Telemetry
@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission(OrganizationRole.Owner, OrganizationRole.SubscriptionManager)]
@inject InstallationService Installation
@inject IVersionService VersionService
@inject IOptions<TelemetrySettings> TelemetrySettings
@inject ProtectedLocalStorage LocalStorage

<PageTitle>What's New</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4" Class="page-header-title">What's New</MudText>
</div>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else
{
    @if (_delta is not null)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.body2">
                You are running <span class="wn-mono">@VersionService.ShortVersion</span>. A @_delta release, <span class="wn-mono">@_latest</span>, is available.
            </MudText>
        </MudPaper>
    }

    @if (!TelemetrySettings.Value.Enabled)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Telemetry is disabled on this server, so it receives no version information and no entries here.
        </MudText>
    }
    else if (_entries.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing yet. Entries arrive with the daily beacon.</MudText>
    }

    @foreach (var e in _entries)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4 wn-entry">
            <div class="wn-entry-head">
                <MudText Typo="Typo.h6" Class="wn-entry-title">@e.Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@e.PublishedUtc.ToString("yyyy-MM-dd")</MudText>
            </div>
            <div class="wn-body">
                @((MarkupString)WhatsNewMarkdown.ToHtml(e.Markdown))
            </div>
        </MudPaper>
    }
}

<style>
    .page-header {
        margin-bottom: 16px;
    }

    .page-header-title {
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .wn-mono {
        font-family: 'Geist Mono', ui-monospace, monospace;
    }

    .wn-entry {
        max-width: 760px;
    }

    .wn-entry-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .wn-entry-title {
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .wn-body {
        font-size: 14px;
        line-height: 1.5;
        margin-top: 8px;
    }

    .wn-body h1, .wn-body h2, .wn-body h3 {
        font-weight: 600;
        letter-spacing: -0.015em;
        margin: 16px 0 8px;
    }

    .wn-body code {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 13px;
    }

    .wn-body pre {
        overflow-x: auto;
        padding: 8px 12px;
        background: var(--mud-palette-background-gray);
    }
</style>

@code {
    private bool _loading = true;
    private List<WhatsNewEntryDto> _entries = [];
    private string? _latest;
    private string? _delta;

    protected override async Task OnInitializedAsync()
    {
        var row = await Installation.GetAsync();
        _entries = TelemetrySnapshotProvider.ReadStored(row.WhatsNewJson).OrderByDescending(e => e.PublishedUtc).ToList();
        _latest = row.LatestKnownVersion;
        _delta = VersionDelta.Describe(VersionService.ShortVersion, _latest);
        _loading = false;
    }

    // Opening the page is what clears the badge, for this browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _entries.Count == 0) return;
        try
        {
            await LocalStorage.SetAsync(WhatsNewKeys.LastSeenEntryId, _entries[0].Id);
        }
        catch
        {
            // Storage unavailable: the badge simply stays.
        }
    }
}
