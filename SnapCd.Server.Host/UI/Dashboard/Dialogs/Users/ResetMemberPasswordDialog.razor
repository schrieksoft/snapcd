@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Factories
@using SnapCd.Server.Core.Services.Admin
@using SnapCd.Server.Core.Services.Email

@inject IMemberAdminService MemberAdminService
@inject ISnapCdEmailSender EmailSender
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IdentityUserAccessorFactory UserAccessorFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudDialog>
    <DialogContent>
        @if (_resultLink is null)
        {
            @* Confirm phase *@
            <MudText>
                @if (_isDeliveryActive == false)
                {
                    <text>Reset password for <strong>@TargetUser.Email</strong>? You will receive the reset link to relay to the user manually.</text>
                }
                else
                {
                    <text>Reset password for <strong>@TargetUser.Email</strong>? The user will receive a reset link by email.</text>
                }
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                This may also affect the user's access to any other organizations they are a member of.
            </MudText>
        }
        else if (_emailSent)
        {
            @* Result phase: real-email mode *@
            <MudAlert Severity="Severity.Success">
                Password reset link sent to @TargetUser.Email.
            </MudAlert>
        }
        else
        {
            @* Result phase: NoOp mode *@
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Email delivery is not configured. Send this reset link to the user manually
                (Slack, SMS, in person, etc.). The link is single-use and expires per the
                configured token lifetime.
            </MudAlert>
            <MudTextField @bind-Value="_resultLink" ReadOnly="true" Variant="Variant.Outlined" />
            <MudButton OnClick="CopyLink" Variant="Variant.Filled" Style="background-color: #000; color: #fff;"
                       StartIcon="@Icons.Material.Filled.ContentCopy" Class="mt-2">
                Copy link
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        @if (_resultLink is null)
        {
            <MudButton OnClick="Cancel" Variant="Variant.Filled" Style="background-color: #000; color: #fff;">Cancel</MudButton>
            <MudButton OnClick="Confirm" Variant="Variant.Filled" Style="background-color: #000; color: #fff;" Disabled="@_isSubmitting">
                @(_isSubmitting ? "Resetting…" : "Reset")
            </MudButton>
        }
        else
        {
            <MudButton OnClick="Close" Variant="Variant.Filled" Style="background-color: #000; color: #fff;">Done</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public required User TargetUser { get; set; }
    [Parameter, EditorRequired] public required Guid OrganizationId { get; set; }

    private bool? _isDeliveryActive;
    private string? _resultLink;
    private bool _emailSent;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        _isDeliveryActive = await EmailSender.IsDeliveryActiveAsync();
    }

    private async Task Confirm()
    {
        _isSubmitting = true;
        try
        {
            using var accessor = UserAccessorFactory.Create();
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actingUser = await accessor.UserAccessor.GetRequiredUserAsync(authState);

            var (sent, link) = await MemberAdminService.ResetMemberPasswordAsync(
                OrganizationId, TargetUser.Id, actingUser.Id);
            _emailSent = sent;
            _resultLink = link;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to reset password: {ex.Message}", Severity.Error);
            MudDialog.Cancel();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CopyLink()
    {
        if (_resultLink is null) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _resultLink);
        Snackbar.Add("Link copied to clipboard", Severity.Success);
    }

    private void Cancel() => MudDialog.Cancel();
    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
