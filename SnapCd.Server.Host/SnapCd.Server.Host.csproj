<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-SnapCd.Server.Host-5c74f737-e151-43e7-abde-a1a9e6fa1885</UserSecretsId>
        <RootNamespace>SnapCd.Server.Host</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SnapCd.Server.Core\SnapCd.Server.Core.csproj" />
    </ItemGroup>

    <!-- Version Configuration -->
    <!-- Version / AssemblyVersion / FileVersion / InformationalVersion are intentionally
         unset so they are supplied at publish time (CI passes /p:Version=$SEMVER) and fall
         back to git-describe in Debug via Directory.Build.targets at the repo root. -->
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

</Project>
