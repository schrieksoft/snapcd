@using SnapCd.Server.Core.Services.Dashboard
@using SnapCd.Server.Core.UI.Dashboard.Components.Account
@inject NavigationManager NavigationManager

<!DOCTYPE html>
<html lang="en" class="@((HttpContext.Request.Cookies["theme"] ?? "light") == "dark" ? "mud-dark" : "")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link href="_content/SnapCd.Server.Core/snapcd-theme.css" rel="stylesheet"/>
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet"/>
    <link rel="icon" type="image/svg+xml" href="_content/SnapCd.Server.Core/favicon.svg"/>
    <link href="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.css" rel="stylesheet"/>
    <HeadOutlet @rendermode="RenderModeForPage"/>

    <script>
        // Immediate cookie-based theme setup
        (function () {
            const theme = document.cookie.replace(/(?:(?:^|.*;\s*)theme\s*=\s*([^;]*).*$)|^.*$/, '$1') || 'light';
            document.documentElement.classList.toggle('mud-dark', theme === 'dark');

            window.setThemeCookie = (theme) => {
                document.cookie = `theme=${theme}; path=/; max-age=${31536000}`;
                document.documentElement.classList.toggle('mud-dark', theme === 'dark');
            };
        })();
    </script>
</head>

<body>

<Routes @rendermode="RenderModeForPage"/>
<script src="_content/BlazorMonaco/jsInterop.js"></script>
<script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
<script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
<script src="_framework/blazor.web.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script src="_content/Extensions.MudBlazor.StaticInput/NavigationObserver.js"></script>
<script>
    // Clipboard functionality
    window.copyToClipboard = (text) => {
        if (navigator.clipboard && window.isSecureContext) {
            // Preferred method (only works on HTTPS)
            navigator.clipboard.writeText(text).then(
                () => console.log("Copied to clipboard"),
                (err) => console.error("Could not copy text: ", err)
            );
        } else {
            // Fallback method for HTTP
            let textArea = document.createElement("textarea");
            textArea.value = text;
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand("copy");
                console.log("Copied to clipboard (fallback)");
            } catch (err) {
                console.error("Could not copy text (fallback):", err);
            }
            document.body.removeChild(textArea);
        }
    };

    window.ChangeUrl = function (url) {
        history.pushState(null, '', url);
    }


</script>
<TurnstileScripts/>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage => RenderModeHelper.GetRenderMode(HttpContext, NavigationManager);

}
