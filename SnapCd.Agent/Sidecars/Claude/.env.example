SNAPCD_BASE_URL=https://localhost:20002

# Claude auth — the bundled Claude Code CLI uses one of these (in this precedence):
#   ANTHROPIC_API_KEY        Console API key, per-token billing
#   CLAUDE_CODE_OAUTH_TOKEN  Pro/Max subscription token (`claude setup-token`)
#   (neither)                falls back to an ambient `~/.claude` login
# In a container you must set one of them; an ambient login only exists on a host.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=sk-ant-...

EXTERNAL_MCP_CONFIG={}

CLAUDE_MODEL=claude-opus-4-7
# CLAUDE_MAX_TURNS=24
# CLAUDE_PERMISSION_MODE=bypassPermissions

# HOST=0.0.0.0
# PORT=7001
