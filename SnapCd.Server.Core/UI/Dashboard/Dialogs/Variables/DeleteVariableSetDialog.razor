@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured.Variables
<MudDialog>
    <TitleContent>
        <MudText>Delete Variable Set</MudText>
    </TitleContent>
    <DialogContent>
        @{
            var dateTime = DateTimeOffset.FromUnixTimeMilliseconds(VariableSet.Timestamp).DateTime;
        }
        <MudText Typo="Typo.body1" Class="mb-2">
            <strong>Variable Set @dateTime.ToString("yyyy-MM-dd HH:mm:ss")</strong>
        </MudText>
        <MudAlert Severity="Severity.Warning" Class="mb-2">
            Are you sure you want to delete this variable set? This can have unintended consequences for how Snap CD resolves output-based triggers! This action cannot be undone.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="Delete" Disabled="_isDeleting">
            @if (_isDeleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Delete
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private VariableSetSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required VariableSet VariableSet { get; set; }

    private bool _isDeleting;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        try
        {
            _isDeleting = true;
            StateHasChanged();

            using var repo = RepoFactory.Create();
            await repo.Delete(VariableSet.Id, OrganizationId);

            Snackbar.Add("Variable set deleted successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(VariableSet.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting variable set: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
            StateHasChanged();
        }
    }
}
