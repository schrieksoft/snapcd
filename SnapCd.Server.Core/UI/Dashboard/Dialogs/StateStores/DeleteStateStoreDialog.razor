@using SnapCd.Server.Core.Repositories.Organizations.Secured
<MudDialog>
    <TitleContent>
        <MudText>Delete State Store</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to delete state store "@StateStore.Name" (ID "@StateStore.Id")?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete" Size="Size.Small">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private StateStoreSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public required Entities.Definition.StateStore StateStore { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(StateStore.Id, OrganizationId);
        MudDialog.Close(DialogResult.Ok(StateStore.Id));
    }
}
