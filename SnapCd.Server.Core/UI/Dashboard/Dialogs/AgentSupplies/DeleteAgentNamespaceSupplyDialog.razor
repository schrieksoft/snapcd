@using SnapCd.Server.Core.Repositories.Organizations.Secured.AgentSupplies
<MudDialog>
    <TitleContent>
        <MudText>Delete Agent Namespace Supply</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to remove the supply of Agent "@AgentName" to Namespace "@NamespaceName"?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete" Size="Size.Small">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Inject] private AgentNamespaceSupplySecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }


    [Parameter] public required Guid AgentNamespaceSupplyId { get; set; }
    [Parameter] public required string AgentName { get; set; }
    [Parameter] public required string NamespaceName { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(AgentNamespaceSupplyId, OrganizationId);

        MudDialog.Close(DialogResult.Ok(AgentNamespaceSupplyId));
    }

}
