@using SnapCd.Server.Core.Entities.Definition.RoleAssignments.Org
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RoleAssignments
<MudDialog>
    <TitleContent>
        <MudText>Delete Group Organization Role Assignment</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete the role assignment "@Assignment.RoleName" for group
            "@GetGroupDisplayName()"?
        </MudText>
        @if (!_canDelete)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                You do not have permission to delete this.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="@DeleteDisabledReason" Disabled="@(DeleteDisabledReason is null)">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="Delete" Disabled="@(!_canDelete)">Delete</MudButton>
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private GroupOrganizationRoleAssignmentSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required GroupOrganizationRoleAssignment Assignment { get; set; }

    private bool _canDelete;

    private string? DeleteDisabledReason => _canDelete ? null : "You do not have permission to delete this.";

    protected override void OnInitialized()
    {
        using var repo = RepoFactory.Create();
        _canDelete = repo.CanDelete(Assignment.Id, OrganizationId);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(Assignment.Id, OrganizationId);

        MudDialog.Close(DialogResult.Ok(Assignment.Id));
    }

    private string GetGroupDisplayName()
    {
        return Assignment.Group?.Name ?? $"Group {Assignment.GroupId}";
    }

}