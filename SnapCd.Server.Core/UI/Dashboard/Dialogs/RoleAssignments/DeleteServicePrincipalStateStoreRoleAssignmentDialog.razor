@using SnapCd.Server.Core.Entities.Definition.RoleAssignments.Org
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RoleAssignments
<MudDialog>
    <TitleContent>
        <MudText>Delete Service Principal State Store Role Assignment</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete the role assignment "@Assignment.RoleName" for service principal
            "@(Assignment.ServicePrincipal?.ClientId ?? Assignment.ServicePrincipalId.ToString())"?
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="Delete">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ServicePrincipalStateStoreRoleAssignmentSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required ServicePrincipalStateStoreRoleAssignment Assignment { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(Assignment.Id, OrganizationId);

        MudDialog.Close(DialogResult.Ok(Assignment.Id));
    }
}
