@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@inject AgentSecuredRepositoryFactory RepoFactory
@inject ILogger<DeactivateAgentDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText>Deactivate Agent</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to deactivate Agent "@Agent.Name" (ID "@Agent.Id")?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Deactivate" Size="Size.Small">Deactivate</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public required Agent Agent { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    private void Cancel() => MudDialog.Cancel();

    private async Task Deactivate()
    {
        try
        {
            using var repo = RepoFactory.Create();
            Agent.IsDisabled = true;
            await repo.Update(Agent);
            MudDialog.Close(DialogResult.Ok(Agent.Id));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deactivate Agent {AgentId}", Agent.Id);
            MudDialog.Cancel();
        }
    }
}
