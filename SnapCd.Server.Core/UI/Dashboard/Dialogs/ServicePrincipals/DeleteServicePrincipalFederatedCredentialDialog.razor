@using SnapCd.Contracts.Dto.ServicePrincipalFederatedCredentials
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Secured.Crud

<MudDialog>
    <TitleContent>
        <MudText>Delete Federated Credential</MudText>
    </TitleContent>
    <DialogContent>
        @if (_refusal is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">@_refusal</MudAlert>
        }
        Are you sure you want to delete federated credential "@Credential.Name"? Any workload
        authenticating through it will stop being able to obtain a token.
    </DialogContent>
    <DialogActions>
        @if (_refusal is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete" Size="Size.Small">Delete</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public required ServicePrincipalFederatedCredentialReadDto Credential { get; set; }

    [Inject] private ServicePrincipalFederatedCredentialService Service { get; set; } = null!;
    [Inject] private ServicePrincipalFederatedCredentialSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private string? _refusal;

    protected override void OnInitialized()
    {
        using var repo = RepoFactory.Create();
        if (!repo.CanDelete(Credential.Id, OrganizationId))
            _refusal = "You do not have permission to delete this federated credential.";
    }

    private async Task Delete()
    {
        try
        {
            await Service.Delete(Credential.Id, OrganizationId);
            MudDialog.Close(DialogResult.Ok(Credential.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting federated credential: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
