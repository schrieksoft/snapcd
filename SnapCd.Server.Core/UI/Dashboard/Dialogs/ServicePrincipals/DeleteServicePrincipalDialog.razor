@using SnapCd.Contracts.Dto.ServicePrincipals
@using SnapCd.Server.Core.Services.Secured.Crud
@using SnapCd.Server.Core.Repositories.Organizations.Secured
<MudDialog>
    <TitleContent>
        <MudText>Delete Service Principal</MudText>
    </TitleContent>
    <DialogContent>
        @if (_refusal is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">@_refusal</MudAlert>
        }
        Are you sure you want to delete service principal "@ServicePrincipal.ClientId" (ID "@ServicePrincipal.Id")?
    </DialogContent>
    <DialogActions>
        @if (_refusal is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete" Size="Size.Small">Delete</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Inject] private ServicePrincipalServiceFactory ServiceFactory { get; set; } = null!;
    [Inject] private RunnerSecuredRepositoryFactory RunnerRepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required ServicePrincipalReadDto ServicePrincipal { get; set; }

    private string? _refusal;

    protected override async Task OnInitializedAsync()
    {
        using var permissionRepo = ServiceFactory.Create();
        if (!permissionRepo.CanDelete(ServicePrincipal.Id, OrganizationId))
        {
            _refusal = "You do not have permission to delete this service principal.";
            return;
        }

        using var runnerRepo = RunnerRepoFactory.Create();
        var runners = await runnerRepo.ListMetadata(OrganizationId,
            q => q.Where(x => x.ServicePrincipalId == ServicePrincipal.Id),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 5);

        if (runners.Count > 0)
            _refusal = $"This service principal is used by the runner(s) {string.Join(", ", runners.Select(r => $"\"{r.Name}\""))}. Delete or reassign them first.";
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        var service = ServiceFactory.Create();
        await service.Delete(ServicePrincipal.Id, OrganizationId);

        MudDialog.Close(DialogResult.Ok(ServicePrincipal.Id));
    }

}