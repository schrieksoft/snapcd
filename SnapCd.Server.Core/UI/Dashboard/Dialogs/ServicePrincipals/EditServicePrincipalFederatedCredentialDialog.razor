@using SnapCd.Contracts.Dto.ServicePrincipalFederatedCredentials
@using SnapCd.Server.Core.Services.Secured.Crud

<MudDialog>
    <TitleContent>
        <MudText>Edit Federated Credential</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField Label="Name" @bind-Value="_name" Required="true"/>

                <MudTextField Label="Issuer" @bind-Value="_issuer" Required="true"
                              HelperText="The cluster's or provider's OIDC issuer URL. Must be https and reachable from the Server."/>

                <MudTextField Label="Subject" @bind-Value="_subject" Required="true"
                              HelperText="The `sub` the presented token carries."/>

                <MudTextField Label="Audience" @bind-Value="_audience" Required="true"
                              HelperText="The `aud` the presented token carries."/>

                <MudSwitch T="bool" @bind-Value="_isDisabled" Label="Disabled" Color="Color.Secondary"/>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Save" Size="Size.Small">Save</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public required ServicePrincipalFederatedCredentialReadDto Credential { get; set; }

    [Inject] private ServicePrincipalFederatedCredentialService Service { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private MudForm? _form;
    private string _name = string.Empty;
    private string _issuer = string.Empty;
    private string _subject = string.Empty;
    private string _audience = string.Empty;
    private bool _isDisabled;

    protected override void OnParametersSet()
    {
        _name = Credential.Name;
        _issuer = Credential.Issuer;
        _subject = Credential.Subject;
        _audience = Credential.Audience;
        _isDisabled = Credential.IsDisabled;
    }

    private async Task Save()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        try
        {
            var dto = new ServicePrincipalFederatedCredentialUpdateDto
            {
                Id = Credential.Id,
                ServicePrincipalId = Credential.ServicePrincipalId,
                Name = _name,
                Issuer = _issuer,
                Subject = _subject,
                Audience = _audience,
                IsDisabled = _isDisabled
            };

            await Service.Update(dto, Credential.Id, OrganizationId);
            MudDialog.Close(DialogResult.Ok(Credential.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating federated credential: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
