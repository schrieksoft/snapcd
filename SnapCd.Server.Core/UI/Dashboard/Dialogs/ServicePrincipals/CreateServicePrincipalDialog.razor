@inject IJSRuntime JsRuntime
@using SnapCd.Contracts.Dto
@using SnapCd.Contracts.Dto.ServicePrincipals
@using SnapCd.Server.Core.Misc.Utils
@using SnapCd.Server.Core.Services.Crud

<MudDialog>
    <TitleContent>
        <MudText>Create a new ServicePrincipal</MudText>
    </TitleContent>
    <DialogActions>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField Label="Client Id" @bind-Value="ClientId" Required="true"
                              HelperText="Set a unique Client Id for the Service Principal."/>
                <MudGrid>
                    <MudItem xs="9">
                        <MudTextField Label="Client Secret" @bind-Value="ClientSecret"
                                      HelperText="Set a Client Secret for the Service Principal"
                                      InputType="InputType.Password"/>
                    </MudItem>
                    <MudItem xs="3">
                        <MudTooltip Text="Generate a new random secret">
                            <MudIconButton Icon="@SnapCdIcons.Refresh" Color="Color.Secondary"
                                           Size="Size.Small" OnClick="GenerateClientSecret"
                                           Class="d-flex align-center justify-center mud-width-full py-8"/>
                        </MudTooltip>
                        <MudTooltip Text="Copy the secret">
                            <MudIconButton Icon="@SnapCdIcons.ContentCopy" Color="Color.Secondary"
                                           Size="Size.Small" OnClick="CopyClientSecret"
                                           Class="d-flex align-center justify-center mud-width-full py-8"/>
                        </MudTooltip>
                    </MudItem>
                </MudGrid>
                <MudSpacer/>

                <MudItem md="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Create">Save</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
                </MudItem>


            </MudStack>
        </MudForm>

    </DialogActions>
</MudDialog>




@code {


    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }


    [Inject] private ServicePrincipalService ServicePrincipalService { get; set; } = null!;

    private MudForm? _form;
    private string ClientId { get; set; } = string.Empty;
    private string ClientSecret { get; set; } = string.Empty;

    private async Task CopyClientSecret()
    {
        if (!string.IsNullOrEmpty(ClientSecret))
        {
            await JsRuntime.InvokeVoidAsync("copyToClipboard", ClientSecret);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Create()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid)
            {
                // Handle validation feedback if needed
                return;
            }
        }
        else throw new Exception("Form is null");

        var servicePrincipal = new ServicePrincipalReadDto
        {
            ClientId = ClientId,
            ClientSecret = ClientSecret
        };

        await ServicePrincipalService.Create(servicePrincipal, OrganizationId);


        MudDialog.Close(DialogResult.Ok(servicePrincipal.Id));
    }

    private void GenerateClientSecret()
    {
        ClientSecret = CredentialHelper.GenerateRandomPassword(32);
    }

}
