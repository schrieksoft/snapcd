@using SnapCd.Contracts.Dto.ServicePrincipalFederatedCredentials
@using SnapCd.Server.Core.Services.Secured.Crud

<MudDialog>
    <TitleContent>
        <MudText>Add Federated Credential</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField Label="Name" @bind-Value="_name" Required="true"
                              HelperText="Identifies this credential. Unique within the Service Principal."/>

                <MudTextField Label="Issuer" @bind-Value="_issuer" Required="true"
                              HelperText="The cluster's or provider's OIDC issuer URL. Must be https and reachable from the Server."/>

                <MudSwitch T="bool" @bind-Value="_kubernetesSubject" Label="Build a Kubernetes subject"
                           Color="Color.Secondary"/>

                @if (_kubernetesSubject)
                {
                    <MudGrid>
                        <MudItem xs="6">
                            <MudTextField Label="Namespace" @bind-Value="_kubernetesNamespace" Required="true"/>
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField Label="Service Account" @bind-Value="_kubernetesServiceAccount" Required="true"/>
                        </MudItem>
                    </MudGrid>
                    <MudTextField Label="Subject" Value="@Subject" Disabled="true"/>
                }
                else
                {
                    <MudTextField Label="Subject" @bind-Value="_subject" Required="true"
                                  HelperText="The `sub` the presented token carries."/>
                }

                <MudTextField Label="Audience" @bind-Value="_audience" Required="true"
                              HelperText="The `aud` the presented token carries."/>

                <MudSwitch T="bool" @bind-Value="_isDisabled" Label="Disabled" Color="Color.Secondary"/>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Create" Size="Size.Small">Save</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public Guid ServicePrincipalId { get; set; }

    [Inject] private ServicePrincipalFederatedCredentialService Service { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private MudForm? _form;
    private string _name = string.Empty;
    private string _issuer = string.Empty;
    private string _subject = string.Empty;
    private string _audience = "snapcd";
    private bool _isDisabled;

    private bool _kubernetesSubject = true;
    private string _kubernetesNamespace = string.Empty;
    private string _kubernetesServiceAccount = string.Empty;

    private string Subject => _kubernetesSubject
        ? $"system:serviceaccount:{_kubernetesNamespace}:{_kubernetesServiceAccount}"
        : _subject;

    private async Task Create()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        try
        {
            var dto = new ServicePrincipalFederatedCredentialCreateDto
            {
                ServicePrincipalId = ServicePrincipalId,
                Name = _name,
                Issuer = _issuer,
                Subject = Subject,
                Audience = _audience,
                IsDisabled = _isDisabled
            };

            var result = await Service.Create(dto, OrganizationId);
            MudDialog.Close(DialogResult.Ok(result.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating federated credential: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
