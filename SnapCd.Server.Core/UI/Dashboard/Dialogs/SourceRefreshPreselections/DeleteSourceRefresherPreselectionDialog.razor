@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
<MudDialog>
    <TitleContent>
        <MudText>Delete Source Refresher Preselection</MudText>
    </TitleContent>
    <DialogContent>
        @if (_refusal is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">@_refusal</MudAlert>
        }
        Are you sure you want to delete SourceRefresherPreselection for SourceUrl
        "@SourceRefresherPreselection.SourceUrl" (ID "@SourceRefresherPreselection.Id")?
    </DialogContent>
    <DialogActions>
        @if (_refusal is null)
        {
            <MudButton Variant="Variant.Filled " Color="Color.Secondary" OnClick="Delete" Size="Size.Small">Delete</MudButton>
        }
        <MudButton Variant="Variant.Filled " Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Inject] private SourceRefresherPreselectionSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }


    [Parameter] public required SourceRefresherPreselection SourceRefresherPreselection { get; set; }

    private string? _refusal;

    protected override void OnInitialized()
    {
        using var permissionRepo = RepoFactory.Create();
        _refusal = permissionRepo.CanDelete(SourceRefresherPreselection.Id, OrganizationId)
            ? null
            : "You do not have permission to delete this source refresher.";
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(SourceRefresherPreselection.Id, OrganizationId);

        MudDialog.Close(DialogResult.Ok(SourceRefresherPreselection.Id));
    }

}