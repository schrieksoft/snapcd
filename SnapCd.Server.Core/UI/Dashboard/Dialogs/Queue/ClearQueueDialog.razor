@using SnapCd.Server.Core.Services.Crud.Jobs
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@inject SecuredJobServiceFactory SecuredJobServiceFactory
@inject ModuleJobSecuredRepositoryFactory JobSecuredRepoFactory

<MudDialog>
    <TitleContent>
        <MudText>Clear Queued</MudText>
    </TitleContent>
    <DialogContent>
        @if (_refusal is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">@_refusal</MudAlert>
        }
        Are your sure you want clear the existing queued Job?
    </DialogContent>
    <DialogActions>
        @if (_refusal is null)
        {
            <MudButton Variant="Variant.Filled " Color="Color.Secondary" OnClick="Clear" Size="Size.Small">Clear</MudButton>
        }
        <MudButton Variant="Variant.Filled " Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required Guid ModuleId { get; set; }

    private string? _refusal;

    protected override void OnInitialized()
    {
        using var repo = JobSecuredRepoFactory.Create();
        _refusal = repo.CanRunJob(ModuleId, OrganizationId)
            ? null
            : "You do not have permission to clear the queue for this module.";
    }
    [Parameter] public required Guid NamespaceId { get; set; }

    [Parameter] public required IPrincipalProvider PrincipalProvider { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Clear()
    {
        using var jobService = SecuredJobServiceFactory.Create(PrincipalProvider);
        await jobService.ClearQueue(ModuleId, NamespaceId, OrganizationId);

        MudDialog.Close(DialogResult.Ok(ModuleId));
    }

}