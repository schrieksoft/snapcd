@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Destroy All Modules in Namespace</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="text-center">
                <MudText Typo="Typo.h6" Class="mb-4">Loading dependency graph...</MudText>
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else if (_dependencyGraph != null)
        {
            <MudText Typo="Typo.body1" Class="mb-2">
                Are you sure you want to destroy these modules?
            </MudText>

            var modulesInNamespace = _dependencyGraph.NodeStates
                .Where(n => n.NamespaceId == NamespaceId)
                .Select(n => n.DisplayName)
                .ToList();

            // External modules that depend on namespace modules (must be destroyed first)
            var externalDependentModules = _dependencyGraph.NodeStates
                .Where(n => n.NamespaceId != NamespaceId &&
                            n.OutgoingEdges.Any(e =>
                                _dependencyGraph.NodeStates.Any(ns => ns.ModuleId == e.ModuleId && ns.NamespaceId == NamespaceId)))
                .ToList();

            // External modules that namespace modules depend on (should remain)
            var externalReferencedModules = _dependencyGraph.NodeStates
                .Where(n => n.NamespaceId != NamespaceId &&
                            n.IncomingEdges.Any(e =>
                                _dependencyGraph.NodeStates.Any(ns => ns.ModuleId == e.ModuleId && ns.NamespaceId == NamespaceId)))
                .ToList();

            @if (modulesInNamespace.Any())
            {
                <div class="d-flex flex-column gap-1 mb-3">
                    @foreach (var moduleNode in _dependencyGraph.NodeStates.Where(n => n.NamespaceId == NamespaceId))
                    {
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Style="background-color: black; color: white;" Variant="Variant.Filled"
                                     Size="Size.Medium">@moduleNode.DisplayName</MudChip>
                            @if (_modulePermissions.TryGetValue(moduleNode.ModuleId, out var hasPermission) && !hasPermission)
                            {
                                <MudTooltip Text="You do not have permission to destroy this module">
                                    <MudIcon Icon="Icons.Material.Filled.Warning" Color="Color.Warning"
                                             Size="Size.Small"/>
                                </MudTooltip>
                            }
                        </div>
                    }
                </div>
            }

            @if (externalDependentModules.Any())
            {
                <MudText Typo="Typo.body1" Class="mb-2">Modules outside this namespace that depend on ones within it
                    (must be destroyed first):
                </MudText>

                <MudCheckBox T="bool"
                             Value="@_destroyExternalModules"
                             Label="Also destroy these dependent modules"
                             Color="Color.Info"
                             Class="mb-3"
                             Disabled="@_isDestroying"
                             ValueChanged="@OnDestroyExternalModulesChanged"
                />
                <div class="d-flex flex-column gap-1 mb-3">
                    @foreach (var moduleNode in externalDependentModules)
                    {
                        <div class="d-flex align-center gap-2">
                            <MudChip T="string" Style="background-color: black; color: white;" Variant="Variant.Filled"
                                     Size="Size.Medium">@moduleNode.DisplayName</MudChip>
                            @if (_modulePermissions.TryGetValue(moduleNode.ModuleId, out var hasPermission) && !hasPermission)
                            {
                                <MudTooltip Text="You do not have permission to destroy this module">
                                    <MudIcon Icon="Icons.Material.Filled.Warning" Color="Color.Warning"
                                             Size="Size.Small"/>
                                </MudTooltip>
                            }
                        </div>
                    }
                </div>

                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    <strong>Note:</strong> @externalDependentModules.Count module(s) outside this namespace depend on
                    ones within it and must be destroyed first.
                </MudAlert>
            }
            else
            {
                <MudPaper Elevation="1" Class="pa-3 mb-3">
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <MudText Typo="Typo.body2" Color="Color.Success">No modules outside this namespace depend on
                                ones within it
                            </MudText>
                        </MudListItem>
                    </MudList>
                </MudPaper>
            }


            <MudText Typo="Typo.h6" Class="mb-3">Destruction Plan</MudText>
            var filteredGraph = GetFilteredGraph();
            var uninvolvedModuleIds = GetUninvolvedModuleIds();
            var uninvolvedNamespaceIds = GetUninvolvedNamespaceIds();

            <MudText Typo="Typo.body2" Class="mb-4">
                The following @(filteredGraph.NodeStates.Count - uninvolvedModuleIds.Count) module(s) will be destroyed:
            </MudText>

            <div style="max-height: 400px; overflow-y: auto;">
                <NamespaceDependencyGraphExecutionFlow DependencyGraphWithStates="filteredGraph"
                                                       UninvolvedModuleIds="uninvolvedModuleIds"
                                                       PrimaryNamespaceId="NamespaceId"
                                                       UninvolvedNamespaceIds="uninvolvedNamespaceIds"/>
            </div>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error">
                Error loading dependency graph: @_error
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_dependencyGraph != null)
        {
            var filteredGraph = GetFilteredGraph();
            var uninvolvedCount = GetUninvolvedModuleIds().Count;
            var involvedCount = filteredGraph.NodeStates.Count - uninvolvedCount;
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="ExecuteNamespaceDestruction"
                       Disabled="@_isDestroying">
                @if (_isDestroying)
                {
                    @:Destroying Infrastructure...
                }
                else
                {
                    @:Destroy All (@involvedCount modules)
                }
            </MudButton>
        }

        <MudButton Variant="Variant.Filled"
                   Style="background-color: black; color: white;"
                   OnClick="Cancel"
                   Disabled="@_isDestroying">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private DestroyModuleGraphServiceFactory DestroyServiceFactory { get; set; } = null!;
    [Inject] private IPublishEndpoint Publisher { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required Guid NamespaceId { get; set; }
    [Parameter] public required string NamespaceName { get; set; }

    // private PersistingComponentStateSubscription _persistenceSubscription;

    private bool _isLoading = true;
    private string? _error = null;
    private NamespaceDependencyGraphDto? _dependencyGraph = null;
    private bool _destroyExternalModules = false;
    private bool _isDestroying;
    private DestroyModuleGraphService? _destroyService;
    private Dictionary<Guid, bool> _modulePermissions = new();

    protected override async Task OnInitializedAsync()
    {
        var cacheKey = $"destroyNamespaceDialog_{NamespaceId}";

        _destroyService = DestroyServiceFactory.Create();

        await LoadDependencyGraph();

        // Pre-rendering persistence - commented out since pre-rendering is disabled
