        //         Error = _error,
        //         DestroyExternalModules = _destroyExternalModules,
        //         IsDestroying = _isDestroying,
        //         ModulePermissions = _modulePermissions
        //     });
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<CachedDialogData>(cacheKey, out var cachedData))
        // {
        //     _dependencyGraph = cachedData.DependencyGraph;
        //     _isLoading = false;
        //     _error = cachedData.Error;
        //     _destroyExternalModules = cachedData.DestroyExternalModules;
        //     _isDestroying = cachedData.IsDestroying;
        //     _modulePermissions = cachedData.ModulePermissions ?? new Dictionary<Guid, bool>();
        // }
    }

    private async Task LoadDependencyGraph()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _dependencyGraph = await _destroyService!.BuildNamespaceDestroyGraphAsync(NamespaceId, NamespaceName);

            // Check permissions for all modules in the graph
            await LoadModulePermissions();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private NamespaceDependencyGraphDto GetFilteredGraph()
    {
        if (_dependencyGraph == null)
        {
            return null!;
        }

        // Always include all modules in the graph for display
        return _dependencyGraph;
    }

    private HashSet<Guid> GetUninvolvedModuleIds()
    {
        var uninvolvedIds = new HashSet<Guid>();

        if (_dependencyGraph == null)
        {
            return uninvolvedIds;
        }

        // For Destroy operation:
        // - External modules that depend on namespace modules (defined outside, reference inside) must be destroyed first
        //   They are INVOLVED if checkbox is checked, UNINVOLVED if unchecked
        // - External modules that namespace modules depend on (referenced by namespace modules) should NOT be destroyed
        //   They are ALWAYS UNINVOLVED regardless of checkbox state

        // Find all external modules (not in this namespace)
        var externalModules = _dependencyGraph.NodeStates
            .Where(n => n.NamespaceId != NamespaceId)
            .ToList();

        foreach (var externalModule in externalModules)
        {
            // Check if any namespace module depends on this external module (this module is in their outgoing edges)
            var namespaceModulesDependOnThis = _dependencyGraph.NodeStates
                .Any(ns => ns.NamespaceId == NamespaceId &&
                           ns.OutgoingEdges.Any(e => e.ModuleId == externalModule.ModuleId));

            // Check if this external module depends on any namespace module (has namespace modules in its outgoing edges)  
            var thisDependsOnNamespaceModules = externalModule.OutgoingEdges
                .Any(e => _dependencyGraph.NodeStates.Any(ns =>
                    ns.ModuleId == e.ModuleId && ns.NamespaceId == NamespaceId));

            if (namespaceModulesDependOnThis)
            {
                // Namespace modules depend on this external module - it's a prerequisite, NEVER destroy it
                uninvolvedIds.Add(externalModule.ModuleId);
            }
            else if (thisDependsOnNamespaceModules && !_destroyExternalModules)
            {
                // This external module depends on namespace modules (downstream dependent)
                // It should be destroyed first, but only if checkbox is checked
                // Mark as uninvolved if we're NOT destroying external modules
                uninvolvedIds.Add(externalModule.ModuleId);
            }
            else if (!namespaceModulesDependOnThis && !thisDependsOnNamespaceModules)
            {
                // This external module has no relationship with namespace modules
                // It should be uninvolved
                uninvolvedIds.Add(externalModule.ModuleId);
            }
        }

        return uninvolvedIds;
    }

    private HashSet<Guid> GetUninvolvedNamespaceIds()
    {
        var uninvolvedIds = new HashSet<Guid>();

        if (_dependencyGraph == null || _destroyExternalModules)
        {
            return uninvolvedIds;
        }

        // Get namespaces that contain uninvolved modules
        var uninvolvedModuleIds = GetUninvolvedModuleIds();
        var uninvolvedNamespaces = _dependencyGraph.NodeStates
            .Where(n => uninvolvedModuleIds.Contains(n.ModuleId))
            .Select(n => n.NamespaceId)
            .Distinct();

        foreach (var namespaceId in uninvolvedNamespaces)
        {
            uninvolvedIds.Add(namespaceId);
        }

        return uninvolvedIds;
    }

    private async Task LoadModulePermissions()
    {
        if (_dependencyGraph == null) return;

        var modulesToCheck = _dependencyGraph.NodeStates
            .Select(n => new ModuleNamespaceIdTuple
            {
                ModuleId = n.ModuleId,
                NamespaceId = n.NamespaceId
            })
            .ToList();

        if (!modulesToCheck.Any()) return;

        using var jobSecuredRepository = ModuleJobSecuredRepositoryFactory.Create();
        var permissions = await jobSecuredRepository.ListHasRunJobPermission(modulesToCheck, OrganizationId);

        _modulePermissions = permissions.ToDictionary(p => p.ModuleId, p => p.HasPermission);
    }

    private void OnDestroyExternalModulesChanged(bool isChecked)
    {
        _destroyExternalModules = isChecked;
        StateHasChanged();
    }

    private void Cancel()
    {
        if (!_isDestroying)
        {
            MudDialog.Cancel();
        }
    }

    private async Task ExecuteNamespaceDestruction()
    {
        var filteredGraph = GetFilteredGraph();
        if (filteredGraph == null)
        {
            Snackbar.Add("Destroy graph not loaded", Severity.Error);
            return;
        }

        // Categorize modules for the confirmation dialog - only modules that aren't already destroyed or being destroyed
        var uninvolvedModuleIds = GetUninvolvedModuleIds();
        var modulesToDestroy = filteredGraph.NodeStates
            .Where(n => !uninvolvedModuleIds.Contains(n.ModuleId) &&
                        n.LatestActualState != ActualStateHeadline.Destroyed &&
                        n.DesiredState != DesiredStateHeadline.Destroyed)
            .ToList();

        if (!modulesToDestroy.Any())
        {
            Snackbar.Add("All modules are already destroyed", Severity.Info);
            MudDialog.Close(DialogResult.Ok(new List<Guid>()));
            return;
        }

        // Find dependent modules (modules outside the filtered graph that depend on modules being destroyed)
        var allModulesInGraph = _dependencyGraph?.NodeStates ?? new List<DependencyGraphNodeStateDto>();
        var moduleIdsToDestroy = modulesToDestroy.Select(m => m.ModuleId).ToHashSet();

        var dependentModules = allModulesInGraph
            .Where(m => !moduleIdsToDestroy.Contains(m.ModuleId) &&
                        m.IncomingEdges.Any(e => moduleIdsToDestroy.Contains(e.ModuleId)))
            .ToList();

        // Find remaining modules in the namespace that won't be destroyed
        var remainingModules = allModulesInGraph
            .Where(m => m.NamespaceId == NamespaceId &&
                        !moduleIdsToDestroy.Contains(m.ModuleId) &&
                        m.LatestActualState != ActualStateHeadline.Destroyed &&
                        m.DesiredState != DesiredStateHeadline.Destroyed)
            .ToList();

        // Find already destroyed modules in the namespace
        var alreadyDestroyedModules = allModulesInGraph
            .Where(m => m.NamespaceId == NamespaceId &&
                        (m.LatestActualState == ActualStateHeadline.Destroyed ||
                         m.DesiredState == DesiredStateHeadline.Destroyed) &&
                        !moduleIdsToDestroy.Contains(m.ModuleId))
            .ToList();

        // Open confirmation dialog
        var parameters = new DialogParameters
        {
            { nameof(DestroyNamespaceConfirmationDialog.NamespaceId), NamespaceId },
            { nameof(DestroyNamespaceConfirmationDialog.NamespaceName), NamespaceName },
            { nameof(DestroyNamespaceConfirmationDialog.ModulesToDestroy), modulesToDestroy },
            { nameof(DestroyNamespaceConfirmationDialog.DependentModules), dependentModules },
            { nameof(DestroyNamespaceConfirmationDialog.RemainingModules), remainingModules },
            { nameof(DestroyNamespaceConfirmationDialog.AlreadyDestroyedModules), alreadyDestroyedModules },
            { nameof(DestroyNamespaceConfirmationDialog.ModulePermissions), _modulePermissions }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var confirmationDialog = await DialogService.ShowAsync<DestroyNamespaceConfirmationDialog>(
            "Confirm Destruction", parameters, options);

        var result = await confirmationDialog.Result;

        if (!result.Canceled && result.Data is List<Guid> destroyedModuleIds)
        {
            // Close the original dialog with the result
            MudDialog.Close(DialogResult.Ok(destroyedModuleIds));
        }
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
        _destroyService?.Dispose();
    }

    private class CachedDialogData
    {
        public NamespaceDependencyGraphDto? DependencyGraph { get; set; }
        public bool IsLoading { get; set; }
        public string? Error { get; set; }
        public bool DestroyExternalModules { get; set; }
        public bool IsDestroying { get; set; }
        public Dictionary<Guid, bool>? ModulePermissions { get; set; }
    }

}