        //         Error = _error,
        //         ApplyExternalModules = _applyExternalModules,
        //         IsApplying = _isApplying,
        //         ModulePermissions = _modulePermissions
        //     });
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<CachedDialogData>(cacheKey, out var cachedData))
        // {
        //     _dependencyGraph = cachedData.DependencyGraph;
        //     _isLoading = false;
        //     _error = cachedData.Error;
        //     _applyExternalModules = cachedData.ApplyExternalModules;
        //     _isApplying = cachedData.IsApplying;
        //     _modulePermissions = cachedData.ModulePermissions ?? new Dictionary<Guid, bool>();
        // }
    }

    private async Task LoadDependencyGraph()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _dependencyGraph = await _applyService!.BuildNamespaceApplyGraphAsync(NamespaceId, NamespaceName);

            // Check permissions for all modules in the graph
            await LoadModulePermissions();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private NamespaceDependencyGraphDto GetFilteredGraph()
    {
        if (_dependencyGraph == null)
        {
            return null!;
        }

        // Always include all modules in the graph for display
        return _dependencyGraph;
    }

    private HashSet<Guid> GetUninvolvedModuleIds()
    {
        var uninvolvedIds = new HashSet<Guid>();

        if (_dependencyGraph == null)
        {
            return uninvolvedIds;
        }

        // Find all external modules (not in this namespace)
        var externalModules = _dependencyGraph.NodeStates
            .Where(n => n.NamespaceId != NamespaceId)
            .ToList();

        foreach (var externalModule in externalModules)
        {
            // Check if this external module has namespace modules in its outgoing edges (external → namespace)
            // This means namespace modules depend on this external module (it's a prerequisite)
            var namespaceModulesDependOnThis = externalModule.OutgoingEdges
                .Any(e => _dependencyGraph.NodeStates.Any(ns =>
                    ns.ModuleId == e.ModuleId && ns.NamespaceId == NamespaceId));

            // Check if any namespace module has this external module in its outgoing edges (namespace → external)
            // This means this external module depends on namespace modules
            var thisDependsOnNamespaceModules = _dependencyGraph.NodeStates
                .Any(ns => ns.NamespaceId == NamespaceId &&
                           ns.OutgoingEdges.Any(e => e.ModuleId == externalModule.ModuleId));

            if (namespaceModulesDependOnThis)
            {
                // Namespace modules depend on this external module - it's a prerequisite
                // Mark as uninvolved if we're NOT applying external modules
                if (!_applyExternalModules)
                {
                    uninvolvedIds.Add(externalModule.ModuleId);
                }
                // If _applyExternalModules is true, this module should be involved (not added to uninvolvedIds)
            }
            else if (thisDependsOnNamespaceModules && !namespaceModulesDependOnThis)
            {
                // This external module depends on namespace modules but is not depended on by any
                // These should be uninvolved (would be applied later, not as prerequisites)
                uninvolvedIds.Add(externalModule.ModuleId);
            }
            else if (!namespaceModulesDependOnThis && !thisDependsOnNamespaceModules)
            {
                // This external module has no relationship with namespace modules - always uninvolved
                uninvolvedIds.Add(externalModule.ModuleId);
            }
        }

        return uninvolvedIds;
    }

    private HashSet<Guid> GetUninvolvedNamespaceIds()
    {
        var uninvolvedIds = new HashSet<Guid>();

        if (_dependencyGraph == null)
        {
            return uninvolvedIds;
        }

        // Get namespaces that contain uninvolved modules
        var uninvolvedModuleIds = GetUninvolvedModuleIds();
        var uninvolvedNamespaces = _dependencyGraph.NodeStates
            .Where(n => uninvolvedModuleIds.Contains(n.ModuleId))
            .Select(n => n.NamespaceId)
            .Distinct();

        foreach (var namespaceId in uninvolvedNamespaces)
        {
            uninvolvedIds.Add(namespaceId);
        }

        return uninvolvedIds;
    }

    private async Task LoadModulePermissions()
    {
        if (_dependencyGraph == null) return;

        var modulesToCheck = _dependencyGraph.NodeStates
            .Select(n => new ModuleNamespaceIdTuple
            {
                ModuleId = n.ModuleId,
                NamespaceId = n.NamespaceId
            })
            .ToList();

        if (!modulesToCheck.Any()) return;

        using var jobSecuredRepository = ModuleJobSecuredRepositoryFactory.Create();
        var permissions = await jobSecuredRepository.ListHasRunJobPermission(modulesToCheck, OrganizationId);

        _modulePermissions = permissions.ToDictionary(p => p.ModuleId, p => p.HasPermission);
    }

    private void OnApplyExternalModulesChanged(bool isChecked)
    {
        _applyExternalModules = isChecked;
        StateHasChanged();
    }

    private void Cancel()
    {
        if (!_isApplying)
        {
            MudDialog.Cancel();
        }
    }

    private async Task ExecuteNamespaceApplication()
    {
        var filteredGraph = GetFilteredGraph();
        if (filteredGraph == null)
        {
            Snackbar.Add("Apply graph not loaded", Severity.Error);
            return;
        }

        // Categorize modules for the confirmation dialog
        var uninvolvedModuleIds = GetUninvolvedModuleIds();

        // Only include modules that need to be applied (not already applied and not currently being applied)
        var modulesToApply = filteredGraph.NodeStates
            .Where(n => !uninvolvedModuleIds.Contains(n.ModuleId) &&
                        n.LatestActualState != ActualStateHeadline.Applied &&
                        (n.DesiredState == null || n.DesiredState != DesiredStateHeadline.Applied))
            .ToList();

        // Find modules that are already applied
        var alreadyAppliedModules = filteredGraph.NodeStates
            .Where(n => !uninvolvedModuleIds.Contains(n.ModuleId) &&
                        n.LatestActualState == ActualStateHeadline.Applied)
            .ToList();

        if (!modulesToApply.Any())
        {
            Snackbar.Add("All modules are already applied", Severity.Info);
            MudDialog.Close(DialogResult.Ok(new List<Guid>()));
            return;
        }

        // We don't need prerequisite modules or remaining modules for a simplified dialog
        // Just pass empty lists to maintain compatibility with the confirmation dialog
        var prerequisiteModules = new List<DependencyGraphNodeStateDto>();
        var remainingModules = new List<DependencyGraphNodeStateDto>();

        // Open confirmation dialog
        var parameters = new DialogParameters
        {
            { nameof(ApplyNamespaceConfirmationDialog.NamespaceId), NamespaceId },
            { nameof(ApplyNamespaceConfirmationDialog.NamespaceName), NamespaceName },
            { nameof(ApplyNamespaceConfirmationDialog.ModulesToApply), modulesToApply },
            { nameof(ApplyNamespaceConfirmationDialog.PrerequisiteModules), prerequisiteModules },
            { nameof(ApplyNamespaceConfirmationDialog.RemainingModules), remainingModules },
            { nameof(ApplyNamespaceConfirmationDialog.AlreadyAppliedModules), alreadyAppliedModules },
            { nameof(ApplyNamespaceConfirmationDialog.ModulePermissions), _modulePermissions }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var confirmationDialog = await DialogService.ShowAsync<ApplyNamespaceConfirmationDialog>(
            "Confirm Application", parameters, options);

        var result = await confirmationDialog.Result;

        if (result is { Canceled: false, Data: List<Guid> appliedModuleIds })
        {
            // Close the original dialog with the result
            MudDialog.Close(DialogResult.Ok(appliedModuleIds));
        }
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
        _applyService?.Dispose();
    }

    private class CachedDialogData
    {
        public NamespaceDependencyGraphDto? DependencyGraph { get; set; }
        public bool IsLoading { get; set; }
        public string? Error { get; set; }
        public bool ApplyExternalModules { get; set; }
        public bool IsApplying { get; set; }
        public Dictionary<Guid, bool>? ModulePermissions { get; set; }
    }

}