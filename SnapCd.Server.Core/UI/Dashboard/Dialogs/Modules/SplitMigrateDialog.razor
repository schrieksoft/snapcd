@using MudBlazor
@using SnapCd.Server.Core.UI.Dashboard.Theme

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>Split monolith</MudText>
            <MudTooltip Text="Splits this module's monolith into the module directories its refactor map describes, and migrates the state. The plan is proved first and pushed only after approval.">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="1">
            <MudCheckBox @bind-Value="_proveOnly"
                         Label="Dry-run only (Prove)"
                         Color="Color.Secondary"/>

            <MudCheckBox @bind-Value="_rederiveBackend"
                         Label="Re-derive backends"
                         Color="Color.Secondary"/>

            @if (!_proveOnly)
            {
                <MudCheckBox @bind-Value="_force"
                             Label="Overwrite existing states"
                             Color="Color.Secondary"/>
            }

            @* A proof has no configured revision to fall back on, so its ref is required; a split
               runs the module's own revision unless one is given. *@
            <MudTextField @bind-Value="_sourceRevision"
                          Label="@(_proveOnly ? "Ref" : "Ref (optional)")"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          FullWidth="true"
                          Class="mt-2"/>

            <MudDivider Class="my-2"/>

            <MudCheckBox @bind-Value="_overrideRoot"
                         Label="Set monolith directory"
                         Color="Color.Secondary"/>

            @if (_overrideRoot)
            {
                <MudTextField @bind-Value="_rootDirectory"
                              Label="Monolith root"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              FullWidth="true"
                              Class="mb-2"/>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   Disabled="@(_proveOnly && string.IsNullOrWhiteSpace(_sourceRevision))"
                   OnClick="Confirm">
            Start
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string? _rootDirectory;
    private string? _sourceRevision;
    private bool _proveOnly;
    private bool _force;
    private bool _rederiveBackend;
    private bool _overrideRoot;

    private void Confirm() =>
        MudDialog.Close(DialogResult.Ok(new SplitMigrateOptions(
            _overrideRoot ? _rootDirectory?.Trim() : null,
            _force, _rederiveBackend, _proveOnly, _sourceRevision?.Trim())));

    private void Cancel() => MudDialog.Cancel();

    /// <summary>What to run: a proof against a ref, or the split itself.</summary>
    public record SplitMigrateOptions(
        string? RootDirectory, bool Force, bool RederiveBackend, bool ProveOnly, string? SourceRevision);
}
