@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            While paused, no triggered or dependency-driven work is dispatched to this module.
            Requests raised meanwhile are queued, not lost, and apply and destroy are unavailable
            until it is resumed.
        </MudText>

        <MudTextField @bind-Value="_reason"
                      Label="Reason (optional)"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Class="mb-3"/>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Confirm">
            Pause
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string? _reason;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_reason));

    private void Cancel() => MudDialog.Cancel();
}
