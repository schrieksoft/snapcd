@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
<MudDialog>
    <TitleContent>
        <MudText>Delete Stack</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to delete stack "@Stack.Name" (ID "@Stack.Id")?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Inject] private StackSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }


    [Parameter] public required Stack Stack { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(Stack.Id, OrganizationId);

        MudDialog.Close(DialogResult.Ok(Stack.Id));
    }

}