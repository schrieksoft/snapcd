@using SnapCd.Contracts.Dto.StateFiles
@using SnapCd.Server.Core.Services.Crud
<MudDialog>
    <TitleContent>
        <MudText>Rename State File</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Required="true" RequiredError="Name is required"/>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(_name)" Size="Size.Small">Save</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private StateFileService Service { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public required StateFileReadDto StateFile { get; set; }

    private string _name = string.Empty;

    protected override void OnParametersSet()
    {
        _name = StateFile.Name;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        var updateDto = new StateFileUpdateDto
        {
            Name = _name,
            StateStoreId = StateFile.StateStoreId
        };
        await Service.Update(updateDto, StateFile.Id, OrganizationId);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
