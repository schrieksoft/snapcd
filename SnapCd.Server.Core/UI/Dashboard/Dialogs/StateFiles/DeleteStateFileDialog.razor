@using SnapCd.Contracts.Dto.StateFiles
@using SnapCd.Server.Core.Services.Crud
<MudDialog>
    <TitleContent>
        <MudText>Delete State File</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to delete state file "@StateFile.Name"?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private StateFileService Service { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }
    [Parameter] public required StateFileReadDto StateFile { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        await Service.Delete(StateFile.Id, OrganizationId);
        MudDialog.Close(DialogResult.Ok(StateFile.Id));
    }
}
