@using MudBlazor
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Events.Steps.StateMigrations
@using SnapCd.Server.Core.UI.Dashboard.Theme

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>Edit state</MudText>
            <MudTooltip Text="Each address is run on its own, so a batch that manages some and not others says which. The state is checked afterwards, and that check is what counts as done.">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudSelect T="StateEditOperation" @bind-Value="_operation"
                   Label="What to do"
                   Variant="Variant.Outlined"
                   Class="mb-2">
            <MudSelectItem T="StateEditOperation" Value="StateEditOperation.Move">Move addresses</MudSelectItem>
            <MudSelectItem T="StateEditOperation" Value="StateEditOperation.Import">Import existing resources</MudSelectItem>
            <MudSelectItem T="StateEditOperation" Value="StateEditOperation.Remove">Remove from state</MudSelectItem>
        </MudSelect>

        <MudTooltip Text="@LinesHelp">
            <MudTextField @bind-Value="_lines"
                          Label="Addresses, one per line"
                          Variant="Variant.Outlined"
                          Lines="6"
                          Placeholder="@Placeholder"/>
        </MudTooltip>

        @if (_error != null)
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">@_error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   Disabled="@(string.IsNullOrWhiteSpace(_lines))"
                   OnClick="Confirm">@Verb</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private StateEditOperation _operation = StateEditOperation.Move;
    private string? _lines;
    private string? _error;

    private bool NeedsTarget => _operation != StateEditOperation.Remove;

    private string Verb => _operation switch
    {
        StateEditOperation.Move => "Move",
        StateEditOperation.Import => "Import",
        _ => "Remove"
    };

    private string LinesHelp => _operation switch
    {
        StateEditOperation.Move => "One move per line: the address as it is now, then where it should go.",
        StateEditOperation.Import => "One import per line: the address to create, then the resource's own id.",
        _ => "One address per line. The infrastructure is left alone; only the state entry goes."
    };

    private string Placeholder => _operation switch
    {
        StateEditOperation.Move => "random_pet.old random_pet.new",
        StateEditOperation.Import => "aws_s3_bucket.main my-bucket-name",
        _ => "random_pet.gone"
    };

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        var instructions = new List<AddressInstruction>();

        foreach (var line in (_lines ?? string.Empty)
                     .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (NeedsTarget && parts.Length != 2)
            {
                _error = $"'{line}' needs two values separated by a space.";
                return;
            }

            if (!NeedsTarget && parts.Length != 1)
            {
                _error = $"'{line}' should be one address on its own.";
                return;
            }

            instructions.Add(new AddressInstruction
            {
                Address = parts[0],
                Target = NeedsTarget ? parts[1] : null
            });
        }

        if (instructions.Count == 0)
        {
            _error = "Name at least one address.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new Choice(_operation, instructions)));
    }

    /// <summary>What to run, and over which addresses.</summary>
    public record Choice(StateEditOperation Operation, List<AddressInstruction> Instructions);
}
