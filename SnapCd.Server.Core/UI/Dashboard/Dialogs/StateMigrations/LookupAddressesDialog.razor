@using MudBlazor
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using YamlDotNet.Serialization
@using YamlDotNet.Serialization.NamingConventions

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>Lookup addresses</MudText>
            <MudTooltip Text="Asks which of these addresses are in this module's state. Nothing is written, and the rest of the state is neither listed nor reported.">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
            <MudSpacer/>
            @* Labelled, not icon-only: the YAML mode went unnoticed behind a bare glyph. *@
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@(_asCode ? SnapCdIcons.Columns : SnapCdIcons.Code)"
                       OnClick="ToggleMode">
                @(_asCode ? "Form" : "YAML")
            </MudButton>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_asCode)
        {
            <MudText Typo="Typo.body2" Class="mb-2">A list of addresses.</MudText>

            <MudTextField @bind-Value="_yaml"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Lines="14"
                          Class="snapcd-mono"
                          Placeholder="@YamlPlaceholder"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">Only these addresses are reported on.</MudText>

            @foreach (var row in _rows)
            {
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudTextField @bind-Value="row.Address"
                                  Immediate="true"
                                  Label="Address"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="snapcd-mono"
                                  Placeholder="aws_subnet.legacy"/>

                    <MudIconButton Icon="@SnapCdIcons.Delete"
                                   Size="Size.Small"
                                   Disabled="@(_rows.Count == 1)"
                                   OnClick="@(() => Remove(row))"/>
                </MudStack>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@SnapCdIcons.Add"
                       OnClick="AddRow"
                       Class="mt-2">add another</MudButton>
        }

        @if (_error != null)
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-3">@_error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   Disabled="@(!HasSomething)"
                   OnClick="Confirm">Look up</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly List<Row> _rows = [new Row()];
    private bool _asCode;
    private string? _yaml;
    private string? _error;

    private bool HasSomething => _asCode
        ? !string.IsNullOrWhiteSpace(_yaml)
        : _rows.Any(r => !string.IsNullOrWhiteSpace(r.Address));

    private const string YamlPlaceholder = "- aws_subnet.legacy\n- aws_route_table.legacy";

    private void AddRow()
    {
        _error = null;
        _rows.Add(new Row());
    }

    private void Remove(Row row)
    {
        if (_rows.Count == 1) return;

        _error = null;
        _rows.Remove(row);
    }

    /// <summary>
    /// Carries what has been entered across, so switching to look at the YAML and back does not
    /// cost the work. A form that cannot represent what the YAML says is left for the YAML.
    /// </summary>
    private void ToggleMode()
    {
        _error = null;

        if (!_asCode)
        {
            _yaml = ToYaml(Filled());
            _asCode = true;
            return;
        }

        if (TryParseYaml(out var parsed, out var problem))
        {
            _rows.Clear();
            foreach (var address in parsed)
                _rows.Add(new Row { Address = address });

            if (_rows.Count == 0) _rows.Add(new Row());

            _asCode = false;
            return;
        }

        _error = problem;
    }

    private List<string> Filled() =>
        _rows
            .Where(r => !string.IsNullOrWhiteSpace(r.Address))
            .Select(r => r.Address!.Trim())
            .Distinct()
            .ToList();

    private static string ToYaml(List<string> addresses)
    {
        if (addresses.Count == 0) return string.Empty;

        var serializer = new SerializerBuilder()
            .WithNamingConvention(CamelCaseNamingConvention.Instance)
            .Build();

        return serializer.Serialize(addresses);
    }

    private bool TryParseYaml(out List<string> addresses, out string? problem)
    {
        addresses = [];
        problem = null;

        if (string.IsNullOrWhiteSpace(_yaml)) return true;

        var deserializer = new DeserializerBuilder()
            .WithNamingConvention(CamelCaseNamingConvention.Instance)
            .IgnoreUnmatchedProperties()
            .Build();

        try
        {
            addresses = (deserializer.Deserialize<List<string>>(_yaml) ?? [])
                .Where(a => !string.IsNullOrWhiteSpace(a))
                .Select(a => a.Trim())
                .Distinct()
                .ToList();
        }
        catch (YamlDotNet.Core.YamlException)
        {
            problem = "A list of addresses.";
            return false;
        }

        return true;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        if (_asCode)
        {
            if (!TryParseYaml(out var parsed, out var problem))
            {
                _error = problem;
                return;
            }

            MudDialog.Close(DialogResult.Ok(parsed));
            return;
        }

        MudDialog.Close(DialogResult.Ok(Filled()));
    }

    private class Row
    {
        public string? Address { get; set; }
    }
}
