@using SnapCd.Server.Core.Events.Steps.StateMigrations
@using YamlDotNet.Serialization
@using YamlDotNet.Serialization.NamingConventions

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>@Verb</MudText>
            <MudSpacer/>
            @* Labelled, not icon-only: the YAML mode went unnoticed behind a bare glyph. *@
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@(_asCode ? SnapCdIcons.Columns : SnapCdIcons.Code)"
                       OnClick="ToggleMode">
                @(_asCode ? "Form" : "YAML")
            </MudButton>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (RefusalReason is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">@RefusalReason</MudAlert>
        }
        @if (_asCode)
        {
            <MudText Typo="Typo.body2" Class="mb-2">@YamlShape</MudText>

            <MudTextField @bind-Value="_yaml"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Lines="14"
                          Class="snapcd-mono"
                          Placeholder="@YamlPlaceholder"/>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">@Explanation</MudText>

            @foreach (var row in _rows)
            {
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudTextField @bind-Value="row.Address"
                                  Immediate="true"
                                  Label="@AddressLabel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="snapcd-mono"
                                  Placeholder="@AddressPlaceholder"/>

                    @if (NeedsTarget)
                    {
                        <MudIcon Icon="@SnapCdIcons.ArrowForward" Size="Size.Small" Color="Color.Default"/>

                        <MudTextField @bind-Value="row.Target"
                                      Immediate="true"
                                      Label="@TargetLabel"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="snapcd-mono"
                                      Placeholder="@TargetPlaceholder"/>
                    }

                    <MudIconButton Icon="@SnapCdIcons.Delete"
                                   Size="Size.Small"
                                   Disabled="@(_rows.Count == 1)"
                                   OnClick="@(() => RemoveRow(row))"/>
                </MudStack>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@SnapCdIcons.Add"
                       OnClick="AddRow"
                       Class="mt-2">add another</MudButton>
        }

        @if (_error != null)
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-3">@_error</MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (RefusalReason is null)
        {
            <MudTooltip Text="@SubmitDisabledReason" Disabled="@(SubmitDisabledReason is null)">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           Disabled="@(!HasSomething)"
                           OnClick="Confirm">@Verb</MudButton>
            </MudTooltip>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The edit this dialog collects addresses for, as the button and title name it.</summary>
    [Parameter] public required string Verb { get; set; }

    /// <summary>
    /// Whether each address needs a second value beside it. Import pairs an address with the id of
    /// the resource that already exists; move pairs it with where it should end up; remove takes
    /// addresses alone.
    /// </summary>
    [Parameter] public bool NeedsTarget { get; set; }

    [Parameter] public required string Explanation { get; set; }
    [Parameter] public required string AddressLabel { get; set; }
    [Parameter] public required string AddressPlaceholder { get; set; }
    [Parameter] public string? TargetLabel { get; set; }
    [Parameter] public string? TargetPlaceholder { get; set; }
    [Parameter] public required string YamlPlaceholder { get; set; }

    /// <summary>Names what a target is in this edit's terms, for the error when one is missing.</summary>
    [Parameter] public string? TargetNoun { get; set; }

    /// <summary>Set to explain why the job will be refused. The confirm button is then not offered.</summary>
    [Parameter] public string? RefusalReason { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly List<Row> _rows = [new Row()];
    private bool _asCode;
    private string? _yaml;
    private string? _error;

    private string YamlShape => NeedsTarget ? "A list of address and target pairs." : "A list of addresses.";

    private string? SubmitDisabledReason =>
        HasSomething ? null : $"Enter at least one address to {Verb.ToLowerInvariant()}.";

    private bool HasSomething => _asCode
        ? !string.IsNullOrWhiteSpace(_yaml)
        : _rows.Any(r => !string.IsNullOrWhiteSpace(r.Address));

    private void AddRow()
    {
        _error = null;
        _rows.Add(new Row());
    }

    private void RemoveRow(Row row)
    {
        if (_rows.Count == 1) return;

        _error = null;
        _rows.Remove(row);
    }

    /// <summary>
    /// Carries what has been entered across, so switching to look at the YAML and back does not
    /// cost the work. A form that cannot represent what the YAML says is left for the YAML.
    /// </summary>
    private void ToggleMode()
    {
        _error = null;

        if (!_asCode)
        {
            _yaml = ToYaml(Filled());
            _asCode = true;
            return;
        }

        if (TryParseYaml(out var parsed, out var problem))
        {
            _rows.Clear();
            foreach (var instruction in parsed)
                _rows.Add(new Row { Address = instruction.Address, Target = instruction.Target });

            if (_rows.Count == 0) _rows.Add(new Row());

            _asCode = false;
            return;
        }

        _error = problem;
    }

    private List<AddressInstruction> Filled() =>
        _rows
            .Where(r => !string.IsNullOrWhiteSpace(r.Address))
            .Select(r => new AddressInstruction
            {
                Address = r.Address!.Trim(),
                Target = NeedsTarget ? r.Target?.Trim() : null
            })
            .ToList();

    private string ToYaml(List<AddressInstruction> instructions)
    {
        if (instructions.Count == 0) return string.Empty;

        var serializer = new SerializerBuilder()
            .WithNamingConvention(CamelCaseNamingConvention.Instance)
            .Build();

        return NeedsTarget
            ? serializer.Serialize(instructions)
            : serializer.Serialize(instructions.Select(i => i.Address).ToList());
    }

    private bool TryParseYaml(out List<AddressInstruction> instructions, out string? problem)
    {
        instructions = [];
        problem = null;

        if (string.IsNullOrWhiteSpace(_yaml)) return true;

        var deserializer = new DeserializerBuilder()
            .WithNamingConvention(CamelCaseNamingConvention.Instance)
            .IgnoreUnmatchedProperties()
            .Build();

        try
        {
            instructions = NeedsTarget
                ? deserializer.Deserialize<List<AddressInstruction>>(_yaml) ?? []
                : (deserializer.Deserialize<List<string>>(_yaml) ?? [])
                    .Select(a => new AddressInstruction { Address = a })
                    .ToList();
        }
        catch (YamlDotNet.Core.YamlException)
        {
            problem = YamlShape;
            return false;
        }

        return true;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        List<AddressInstruction> instructions;

        if (_asCode)
        {
            if (!TryParseYaml(out instructions, out var problem))
            {
                _error = problem;
                return;
            }
        }
        else
        {
            instructions = Filled();
        }

        instructions = instructions
            .Where(i => !string.IsNullOrWhiteSpace(i.Address))
            .ToList();

        if (instructions.Count == 0)
        {
            _error = "Name at least one address.";
            return;
        }

        var missing = instructions.FirstOrDefault(i => NeedsTarget && string.IsNullOrWhiteSpace(i.Target));
        if (missing is not null)
        {
            _error = $"'{missing.Address}' needs a {TargetNoun}.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new TerraformStateMigrationDialogBase.Choice(instructions)));
    }

    private class Row
    {
        public string? Address { get; set; }
        public string? Target { get; set; }
    }
}
