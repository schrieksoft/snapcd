<MudDialog>
    <TitleContent>
        <MudText>@Verb @Noun</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">Are you sure you want to @Verb.ToLowerInvariant() this @Noun.ToLowerInvariant()?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Confirm" Size="Size.Small">@Verb</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required string Verb { get; set; }
    [Parameter] public required string Noun { get; set; }
    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
