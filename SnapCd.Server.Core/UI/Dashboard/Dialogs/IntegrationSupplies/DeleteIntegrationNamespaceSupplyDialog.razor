@using SnapCd.Server.Core.Repositories.Organizations.Secured.IntegrationSupplies
<MudDialog>
    <TitleContent>
        <MudText>Delete Integration Namespace Supply</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to remove the supply of Integration "@IntegrationName" to Namespace "@NamespaceName"?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Style="background-color: #000; color: #fff;" OnClick="Delete">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Style="background-color: #000; color: #fff;" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Inject] private IntegrationNamespaceSupplySecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }

    [Parameter] public required Guid IntegrationNamespaceSupplyId { get; set; }
    [Parameter] public required string IntegrationName { get; set; }
    [Parameter] public required string NamespaceName { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(IntegrationNamespaceSupplyId, OrganizationId);

        MudDialog.Close(DialogResult.Ok(IntegrationNamespaceSupplyId));
    }

}
