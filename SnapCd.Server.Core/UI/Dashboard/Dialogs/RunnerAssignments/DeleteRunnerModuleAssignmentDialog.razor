@using SnapCd.Server.Core.Repositories.Organizations.Secured.RunnerAssignments
<MudDialog>
    <TitleContent>
        <MudText>Delete Runner Module Assignment</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to remove the assignment of Runner "@RunnerName" to Module "@ModuleName" on?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Delete">Delete</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Inject] private RunnerModuleAssignmentSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }


    [Parameter] public required Guid RunnerModuleAssignmentId { get; set; }
    [Parameter] public required string RunnerName { get; set; }
    [Parameter] public required string ModuleName { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Delete()
    {
        using var repo = RepoFactory.Create();
        await repo.Delete(RunnerModuleAssignmentId, OrganizationId);

        MudDialog.Close(DialogResult.Ok(RunnerModuleAssignmentId));
    }

}