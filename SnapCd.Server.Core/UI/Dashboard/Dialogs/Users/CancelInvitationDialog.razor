@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Factories
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText>Are you sure you want to cancel the invitation for "@OrganizationUser.User?.Email"?</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            The invitation will be invalidated and the user will not be able to join this organization using the existing invitation link.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small">Cancel</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small">Cancel Invitation</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required OrganizationUser OrganizationUser { get; set; }
    [Parameter] public required Guid OrganizationId { get; set; }

    [Inject] private MemberServiceFactory MemberServiceFactory { get; set; } = null!;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        try
        {
            using var memberService = MemberServiceFactory.Create();
            await memberService.Service.CancelInvitationAsync(OrganizationUser.Id, OrganizationId);
            MudDialog.Close(DialogResult.Ok(OrganizationUser.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to cancel invitation: {ex.Message}", Severity.Error);
        }
    }
}
