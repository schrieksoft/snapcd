@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Enums

<MudDialog>
    <TitleContent>
        <MudText>Start a transfer</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            What moves is decided in the code, by the transfer map the code move writes.
        </MudText>

        <MudAutocomplete T="Module?"
                         @bind-Value="_counterparty"
                         Label="Counterparty module"
                         SearchFunc="@Search"
                         ToStringFunc="@(m => m?.Name ?? string.Empty)"
                         ResetValueOnEmptyText="true"
                         CoerceText="true"
                         Required="true"
                         Variant="Variant.Text"
                         Class="mb-2">
            <ItemTemplate Context="module">
                <MudText>@module?.Name</MudText>
                <MudText Color="Color.Secondary" Typo="Typo.caption">@module?.SourceSubdirectory</MudText>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>No other module in this namespace.</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   Disabled="@(_counterparty == null)"
                   OnClick="Confirm">Start</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required IReadOnlyList<Module> Candidates { get; set; }

    private Module? _counterparty;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new Choice(_counterparty!.Id)));

    /// <summary>
    /// Filters the candidates already loaded, by name or by the root they own - the root is what
    /// the map names, so it is the more useful of the two when picking.
    /// </summary>
    private Task<IEnumerable<Module?>> Search(string searchText, CancellationToken cancellationToken) =>
        Task.FromResult(Candidates
            .Where(m => string.IsNullOrWhiteSpace(searchText)
                        || m.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || m.SourceSubdirectory.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Cast<Module?>());

    /// <summary>The module on the other side of the move.</summary>
    public record Choice(Guid CounterpartyModuleId);
}
