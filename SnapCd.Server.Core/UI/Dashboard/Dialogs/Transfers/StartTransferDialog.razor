@using MudBlazor
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using SnapCd.Server.Core.Enums

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>Transfer resources</MudText>
            <MudTooltip Text="What moves is decided in the code, by the transfer map the code move writes. Each module moves its own state as its own job, so pause both and start one on each.">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudAutocomplete T="Module?"
                         @bind-Value="_counterparty"
                         Label="Counterparty module"
                         SearchFunc="@Search"
                         ToStringFunc="@(m => m?.Name ?? string.Empty)"
                         ResetValueOnEmptyText="true"
                         CoerceText="true"
                         Required="true"
                         Variant="Variant.Text"
                         Class="mb-2">
            <ItemTemplate Context="module">
                <MudText>@module?.Name</MudText>
                <MudText Color="Color.Secondary" Typo="Typo.caption">@module?.SourceSubdirectory</MudText>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText>No other module in this namespace.</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>

        <MudTooltip Text="Starts this module now rather than waiting for the other to agree. Usually left off, so both move once the agreement is in place.">
            <MudCheckBox @bind-Value="_startImmediately"
                         Label="Start this module without waiting"
                         Color="Color.Secondary"
                         Class="mb-2"/>
        </MudTooltip>

        <MudTooltip Text="The branch or tag carrying this module's half of the code move. The other module names its own when it agrees.">
            <MudTextField @bind-Value="_moduleRef"
                          Label="This module's ref"
                          Variant="Variant.Outlined"/>
        </MudTooltip>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   Disabled="@(_counterparty == null)"
                   OnClick="Confirm">Start</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required IReadOnlyList<Module> Candidates { get; set; }
    [Parameter] public string? ModuleRef { get; set; }

    private Module? _counterparty;
    private string? _moduleRef;
    private bool _startImmediately;

    protected override void OnInitialized() => _moduleRef = ModuleRef;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new Choice(_counterparty!.Id, _moduleRef, _startImmediately)));

    /// <summary>
    /// Filters the candidates already loaded, by name or by the root they own - the root is what
    /// the map names, so it is the more useful of the two when picking.
    /// </summary>
    private Task<IEnumerable<Module?>> Search(string searchText, CancellationToken cancellationToken) =>
        Task.FromResult(Candidates
            .Where(m => string.IsNullOrWhiteSpace(searchText)
                        || m.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || m.SourceSubdirectory.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Cast<Module?>());

    /// <summary>The module on the other side, the ref this one runs against, and whether to wait.</summary>
    public record Choice(Guid CounterpartyModuleId, string? ModuleRef, bool StartImmediately);
}
