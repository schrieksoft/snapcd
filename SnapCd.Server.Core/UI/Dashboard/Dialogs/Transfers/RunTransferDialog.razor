@using MudBlazor
@using SnapCd.Contracts.Enums
@using SnapCd.Server.Core.UI.Dashboard.Theme

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>Move state</MudText>
            <MudTooltip Text="Each module plans, proves the move changes nothing and - once approved - writes its own state. They run at once.">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudSelect T="TransferScope" @bind-Value="_scope"
                   Label="What to transfer"
                   Variant="Variant.Outlined"
                   Class="mb-2">
            <MudSelectItem T="TransferScope" Value="TransferScope.Both">Both modules</MudSelectItem>
            <MudSelectItem T="TransferScope" Value="TransferScope.ModuleOnly">This module only</MudSelectItem>
            <MudSelectItem T="TransferScope" Value="TransferScope.CounterpartyOnly">@CounterpartyName only</MudSelectItem>
        </MudSelect>

        <MudTooltip Text="The branch or tag carrying the code move. Each module runs against its own.">
            <MudTextField @bind-Value="_moduleRef"
                          Label="This module's ref"
                          Variant="Variant.Outlined"
                          Class="mb-2"/>
        </MudTooltip>

        <MudTextField @bind-Value="_counterpartyRef"
                      Label="@($"{CounterpartyName}'s ref")"
                      Variant="Variant.Outlined"/>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Confirm">Move state</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required string CounterpartyName { get; set; }
    [Parameter] public string? ModuleRef { get; set; }
    [Parameter] public string? CounterpartyRef { get; set; }

    private TransferScope _scope = TransferScope.Both;
    private string? _moduleRef;
    private string? _counterpartyRef;

    protected override void OnInitialized()
    {
        _moduleRef = ModuleRef;
        _counterpartyRef = CounterpartyRef;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() =>
        MudDialog.Close(DialogResult.Ok(new Choice(_scope, _moduleRef, _counterpartyRef)));

    /// <summary>Which modules this attempt covers, and the ref each runs against.</summary>
    public record Choice(TransferScope Scope, string? ModuleRef, string? CounterpartyRef);
}
