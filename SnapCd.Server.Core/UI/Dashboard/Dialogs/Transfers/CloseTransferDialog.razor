@using MudBlazor
@using SnapCd.Server.Core.UI.Dashboard.Theme

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>Close transfer</MudText>
            <MudTooltip Text="A closed transfer is no longer watched, so a resource deleted later is not mistaken for one that never arrived.">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (OpenObjects > 0)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @OpenObjects @(OpenObjects == 1 ? "resource is" : "resources are") still unaccounted for. Say why.
            </MudText>
        }

        <MudTextField @bind-Value="_reason"
                      Label="@(OpenObjects > 0 ? "Reason" : "Reason (optional)")"
                      Variant="Variant.Outlined"
                      Lines="2"/>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   Disabled="@(OpenObjects > 0 && string.IsNullOrWhiteSpace(_reason))"
                   OnClick="Confirm">Close</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int OpenObjects { get; set; }

    private string? _reason;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_reason ?? string.Empty));
}
