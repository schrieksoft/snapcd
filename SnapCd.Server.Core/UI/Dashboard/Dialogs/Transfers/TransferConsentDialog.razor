@using MudBlazor
@using SnapCd.Server.Core.UI.Dashboard.Theme

<MudDialog>
    <TitleContent>
        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
            <MudText>@(Granted ? "Agree to the transfer" : "Refuse")</MudText>
            <MudTooltip Text="@(Granted
                                  ? "Agreeing starts both modules' jobs against the refs each named. This module must already be paused."
                                  : "Refusing ends the transfer and releases both modules. The other module can start another.")">
                <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
            </MudTooltip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (Granted)
        {
            <MudTooltip Text="The branch or tag carrying this module's half of the code move.">
                <MudTextField @bind-Value="_moduleRef"
                              Label="This module's ref"
                              Variant="Variant.Outlined"
                              Class="mb-2"/>
            </MudTooltip>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Confirm">@(Granted ? "Agree" : "Refuse")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool Granted { get; set; }
    [Parameter] public string? ModuleRef { get; set; }

    private string? _moduleRef;

    protected override void OnInitialized() => _moduleRef = ModuleRef;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(new Decision(_moduleRef)));

    /// <summary>What this Module answered, and the ref it runs against.</summary>
    public record Decision(string? ModuleRef);
}
