@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@inject RunnerSecuredRepositoryFactory RepoFactory
@inject ILogger<DeactivateRunnerDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText>Deactivate Runner</MudText>
    </TitleContent>
    <DialogContent>
        Are you sure you want to deactivate Runner "@Runner.Name" (ID "@Runner.Id")?
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Deactivate">Deactivate</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [Parameter] public required Runner Runner { get; set; }


    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrganizationId { get; set; }


    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Deactivate()
    {
        try
        {
            using var repo = RepoFactory.Create();
            Runner.IsDisabled = true;

            await repo.Update(Runner);
            MudDialog.Close(DialogResult.Ok(Runner.Id));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deactivate Runner {RunnerId}", Runner.Id);
            MudDialog.Cancel();
        }
    }

}