@using SnapCd.Server.Core.UI.Dashboard.Components.Namespace.Secrets
@using Microsoft.AspNetCore.Components
@using SnapCd.Server.Core.Entities.Definition.Secrets.Scoped
@using SnapCd.Server.Core.Repositories.Organizations.Secured.Secrets.Scoped
@using SnapCd.Server.Core.Services.PrincipalProvider

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudTabs Outlined="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="Namespace" Style="text-transform: none">
        @if (!_showCreateSecret)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       Class="mb-3"
                       OnClick="() => _showCreateSecret = true">
                Add Secret
            </MudButton>
        }

        @if (_showCreateSecret)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <CreateNamespaceSecret
                    NamespaceId="@NamespaceId"
                    PrincipalProvider="@PrincipalProvider"
                    OnSaved="async () => { _showCreateSecret = false; await ReloadSecrets(); }"
                    OnCancel="() => _showCreateSecret = false"/>
            </MudPaper>
        }

        @if (_secrets.Count == 0)
        {
            <MudText Typo="Typo.body2">No secrets configured directly on this Namespace.</MudText>
        }
        else
        {
            @* Own container: without this the panels are adopted by the outer
               accordion in ConfigureNamespace (MultiExpansion="false"), so expanding
               a secret collapses the "Manage Secrets" section around it. *@
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                @foreach (var secret in _secrets)
                {
                    <MudExpansionPanel @key="secret.Id">
                        <TitleContent>
                            <MudText>@secret.Name</MudText>
                        </TitleContent>
                        <ChildContent>
                            <EditNamespaceSecret
                                Secret="@secret"
                                PrincipalProvider="@PrincipalProvider"
                                OnSaved="async () => await ReloadSecrets()"
                                OnCancel="EventCallback.Empty"/>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudTabPanel>

    @if (_stackSecrets.Count > 0)
    {
        <MudTabPanel Text="Inherited from Stack" Style="text-transform: none">
            <div style="opacity: 0.6;">
                <MudText Typo="Typo.caption" Class="mb-2">
                    Manage these from <MudLink Typo="Typo.caption" Style="font-weight: bold; color: var(--snap-accent, #E85D1A); text-decoration: underline;" Href="@($"/Stack/{StackName}?action=configure&section=secrets")">here</MudLink>.
                </MudText>
                <MudDivider Class="mb-3"/>
                <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                    <tbody>
                    @foreach (var secret in _stackSecrets)
                    {
                        <tr>
                            <td>@secret.Name</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            </div>
        </MudTabPanel>
    }
</MudTabs>

@code {
    [Parameter] public required Guid NamespaceId { get; set; }
    [Parameter] public required Guid StackId { get; set; }
    [Parameter] public required string StackName { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private NamespaceSecretSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private StackSecretSecuredRepositoryFactory StackRepoFactory { get; set; } = null!;

    private List<NamespaceSecret> _secrets = new();
    private List<StackSecret> _stackSecrets = new();

    private bool _showCreateSecret;

    protected override async Task OnInitializedAsync()
    {
        await ReloadSecrets();
    }

    private async Task ReloadSecrets()
    {
        using (var repo = RepoFactory.Create(PrincipalProvider))
            _secrets = await repo.ListByParentId(NamespaceId, OrganizationId);

        using (var repo = StackRepoFactory.Create(PrincipalProvider))
            _stackSecrets = await repo.ListByParentId(StackId, OrganizationId);
    }
}
