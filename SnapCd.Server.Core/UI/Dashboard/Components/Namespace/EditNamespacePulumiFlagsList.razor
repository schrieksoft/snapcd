@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.PrincipalProvider
@if (_items == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}

else
{
    <MudExpansionPanels>

        @foreach (var item in _items)
        {
            <MudExpansionPanel Text="@($"{item.Task} - {item.Flag}")">
                <EditNamespacePulumiFlag Context="@item"
                                         PrincipalProvider="@PrincipalProvider"
                                         OnDelete="() => ResetAll()"
                                         OnUpdate="() => ResetAll()"
                                         OnCreate="() => ResetAll()"
                                         OnCancel="() => ResetAll()"
                                         IsCreateMode="false"/>
            </MudExpansionPanel>
        }

        @if (_isCreating)
        {
            <MudExpansionPanel IsExpanded="_newItemExpanded" IsExpandedChanged="OnNewItemExpandedChanged">
                <EditNamespacePulumiFlag Context="_newItem"
                                         PrincipalProvider="@PrincipalProvider"
                                         OnDelete="() => ResetAll()"
                                         OnUpdate="() => ResetAll()"
                                         OnCreate="() => ResetAll()"
                                         OnCancel="() => ResetAll()"
                                         IsCreateMode="true"/>
            </MudExpansionPanel>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   OnClick="StartCreate"
                   Class="mt-2">
            Add New
        </MudButton>

    </MudExpansionPanels>
}

@code {
    [Parameter] public string Title { get; set; } = null!;
    [Parameter] public Guid NamespaceId { get; set; }
    [Parameter] public EventCallback OnTabClick { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private NamespacePulumiFlagSecuredRepositoryFactory NamespacePulumiFlagSecuredRepositoryFactory { get; set; } = null!;

    private bool _isCreating;
    private bool _newItemExpanded;
    private NamespacePulumiFlag? _newItem;
    private List<NamespacePulumiFlag>? _items;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _newItem = new NamespacePulumiFlag { Id = Guid.NewGuid(), NamespaceId = NamespaceId, OrganizationId = OrganizationId };
        _isCreating = true;
        _newItemExpanded = true;
        StateHasChanged();
    }

    private void OnNewItemExpandedChanged(bool expanded)
    {
        _newItemExpanded = expanded;
        if (!expanded && _isCreating)
        {
            // Cancel creation when panel is collapsed
            ResetAll();
        }
    }

    private async void ResetAll()
    {
        _isCreating = false;
        _newItemExpanded = false;
        _newItem = null;
        await ReloadItems();
        StateHasChanged();
    }

    private async Task ReloadItems()
    {
        using var repo = NamespacePulumiFlagSecuredRepositoryFactory.Create(PrincipalProvider);
        _items = await repo.ListByParentId(NamespaceId, OrganizationId);
    }

    public async Task InitializeItems()
    {
        if (_items == null)
        {
            await ReloadItems();
            StateHasChanged();
        }
    }

}
