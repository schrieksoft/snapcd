@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Helpers
@inherits ComponentBase

<MudGrid>
    <MudItem xs="12" md="8" Class="d-flex flex-column gap-4">
        <MudItem xs="12" Class="mb-4">
            <MudSelect T="HookTask" Label="Task" @bind-Value="Context.Task" Variant="Variant.Outlined" Immediate="true">
                @foreach (var val in Enum.GetValues<HookTask>())
                {
                    <MudSelectItem Value="@val">@val.ToString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" Class="mb-4">
            <MudSelect T="HookPhase" Label="Phase" @bind-Value="Context.Phase" Variant="Variant.Outlined" Immediate="true">
                @foreach (var val in Enum.GetValues<HookPhase>())
                {
                    <MudSelectItem Value="@val">@val.ToString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" Class="mb-4">
            <MudTextField Label="Script"
                          @bind-Value="Context.Script"
                          Immediate="true"
                          Lines="6"
                          FullWidth="true"/>
        </MudItem>

        <MudStack Row="true" Spacing="4" Class="mt-4">

            @if (IsCreateMode)
            {
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="CreateItem">
                    Create
                </MudButton>

                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            }
            else
            {
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           Disabled="@(!HasChanges)"
                           OnClick="UpdateItem">
                    Save
                </MudButton>

                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteItem">
                    Delete
                </MudButton>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public bool IsCreateMode { get; set; } = true;
    [Parameter] public NamespaceHook Context { get; set; } = default!;
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private NamespaceHookSecuredRepositoryFactory NamespaceHookSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private NamespaceHook _original = new();

    protected override void OnInitialized()
    {
        SetOriginal();
    }

    private bool HasChanges =>
        Context.Task != _original.Task ||
        Context.Phase != _original.Phase ||
        Context.Script != _original.Script;

    private void SetOriginal()
    {
        _original = new NamespaceHook
        {
            Task = Context.Task,
            Phase = Context.Phase,
            Script = Context.Script
        };
    }

    private async Task DeleteItem()
    {
        try
        {
            using var repo = NamespaceHookSecuredRepositoryFactory.Create(PrincipalProvider);
            await repo.Delete(Context.Id, OrganizationId);

            await OnDelete.InvokeAsync();
            Snackbar.Add("Hook deleted successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "deleting hook");
        }
    }

    private async Task CreateItem()
    {
        try
        {
            using var repo = NamespaceHookSecuredRepositoryFactory.Create(PrincipalProvider);
            await repo.Create(Context);
            await OnCreate.InvokeAsync();
            Snackbar.Add("Hook created successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "creating hook");
        }
    }

    private async Task UpdateItem()
    {
        try
        {
            using var repo = NamespaceHookSecuredRepositoryFactory.Create(PrincipalProvider);
            await repo.Update(Context);
            SetOriginal();
            await OnUpdate.InvokeAsync();
            Snackbar.Add("Hook updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "updating hook");
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

}
