@using SnapCd.Server.Core.Licensing.Models
@using SnapCd.Server.Core.Licensing.Services
@inject LicenseService LicenseService

@if (_showAlert)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        @Message
    </MudAlert>
}

@code {
    [Parameter] public required string Message { get; set; }
    [Parameter] public required Feature Feature { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    private bool _showAlert;

    protected override async Task OnInitializedAsync()
    {
        var licenseInfo = await LicenseService.GetLicenseInfoAsync(OrganizationId);
        _showAlert = !licenseInfo.Includes(Feature);
    }
}
