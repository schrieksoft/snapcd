@using SnapCd.Server.Core.Licensing.Models
@using SnapCd.Server.Core.Licensing.Services
@inject LicenseService LicenseService

@if (_disabled)
{
    <MudItem md="12">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            Approval workflows are not included in your current tier. These settings will have no effect.
        </MudAlert>
    </MudItem>
}

<MudItem md="12">
    <MudTextField T="int?" Label="Approval Threshold (Apply)"
                  Value="@ApplyApprovalThreshold"
                  ValueChanged="@ApplyApprovalThresholdChanged"
                  Variant="Variant.Outlined"
                  Disabled="@_disabled"/>
</MudItem>

<MudItem md="12">
    <MudTextField T="int?" Label="Approval Threshold (Destroy)"
                  Value="@DestroyApprovalThreshold"
                  ValueChanged="@DestroyApprovalThresholdChanged"
                  Variant="Variant.Outlined"
                  Disabled="@_disabled"/>
</MudItem>

<MudItem md="12">
    <MudTextField T="int?" Label="Approval Timeout Minutes"
                  Value="@ApprovalTimeoutMinutes"
                  ValueChanged="@ApprovalTimeoutMinutesChanged"
                  Variant="Variant.Outlined"
                  Disabled="@_disabled"/>
</MudItem>

@code {
    [Parameter] public int? ApplyApprovalThreshold { get; set; }
    [Parameter] public EventCallback<int?> ApplyApprovalThresholdChanged { get; set; }

    [Parameter] public int? DestroyApprovalThreshold { get; set; }
    [Parameter] public EventCallback<int?> DestroyApprovalThresholdChanged { get; set; }

    [Parameter] public int? ApprovalTimeoutMinutes { get; set; }
    [Parameter] public EventCallback<int?> ApprovalTimeoutMinutesChanged { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    private bool _disabled;

    protected override async Task OnInitializedAsync()
    {
        var licenseInfo = await LicenseService.GetLicenseInfoAsync(OrganizationId);
        _disabled = !licenseInfo.Includes(Feature.ApprovalWorkflows);
    }
}
