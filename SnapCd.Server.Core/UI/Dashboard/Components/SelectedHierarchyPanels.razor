@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Interfaces
@using SnapCd.Server.Core.Misc.Exceptions
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Interfaces.PrincipalProvider
@using SnapCd.Server.Core.Services.Nonsecured.PrincipalProvider
@using SnapCd.Server.Core.Services.Utils.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Components.Module
@using SnapCd.Server.Core.UI.Dashboard.Components.Namespace
@using SnapCd.Server.Core.UI.Dashboard.Components.Stack
@using SnapCd.Server.Core.Views.Metadata

@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject StackSecuredRepositoryFactory StackRepoFactory
@inject NamespaceSecuredRepositoryFactory NamespaceRepoFactory

@* What the tree has selected, as its dependencies or its settings. Keyed on the selection by the
   caller, so changing selection rebuilds this rather than reusing a panel holding the last one. *@
@if (Creation != null)
{
    @if (Creation.Scope == SearchScope.Stack)
    {
        <CreateStack OnCreated="OnCreated" OnCancel="OnCreateCancelled"/>
    }
    else if (Creation.Scope == SearchScope.Namespace)
    {
        <CreateNamespace StackId="Creation.ParentId"
                         PrincipalProvider="_principalProvider"
                         OnCreated="OnCreated"
                         OnCancel="OnCreateCancelled"/>
    }
    else
    {
        <CreateModule NamespaceId="Creation.ParentId"
                      PrincipalProvider="_principalProvider"
                      OnCreated="OnCreated"
                      OnCancel="OnCreateCancelled"/>
    }
}
else if (Selection == null)
{
    @* Nothing selected shows nothing. *@
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning">That @Noun no longer exists.</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true"/>
}
else if (Selection.Scope == SearchScope.Module)
{
    <ModulePanel StackName="@Selection.StackName"
                 NamespaceName="@(Selection.NamespaceName!)"
                 ModuleName="@(Selection.ModuleName!)"/>
}
else
{
    <div class="page-header">
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h4" Class="page-header-title">
                @(Selection.Scope == SearchScope.Namespace ? "Namespace" : "Stack"):
                @(Selection.NamespaceName ?? Selection.StackName)
            </MudText>
            @if (_namespace != null)
            {
                <FavoriteToggle TargetType="FavoriteTargetType.Namespace" TargetId="_namespace.Id"/>
            }
            else if (_stack != null)
            {
                <FavoriteToggle TargetType="FavoriteTargetType.Stack" TargetId="_stack.Id"/>
            }
        </div>
        @if (Selection.Scope == SearchScope.Namespace)
        {
            <MudText Typo="Typo.body2" Class="hierarchy-parents">
                Stack: <MudLink Href="@HierarchyRoute.ForStack(Selection.StackName)">@Selection.StackName</MudLink>
            </MudText>
        }
    </div>

    <TabBar Tabs="_tabs" ActiveKey="@_showing.ToString()" OnTabChanged="HandleTabChanged"/>

    @if (_showing == PanelType.Dependencies)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            @if (_stack != null)
            {
                <StackDependencyGraph StackId="_stack.Id" StackName="@_stack.Name"/>
            }
            else if (_namespace != null)
            {
                <NamespaceDependencyGraph NamespaceId="_namespace.Id" NamespaceName="@_namespace.Name"/>
            }
        </MudPaper>
    }
    else if (_showing == PanelType.Configure)
    {
        @if (_stack != null)
        {
            <ConfigureStack Stack="_stack"
                            PrincipalProvider="_principalProvider"
                            OnStackDeleted="OnChanged"
                            OnStackSaved="OnChanged"/>
        }
        else if (_namespace != null)
        {
            <ConfigureNamespace Namespace="_namespace"
                                StackName="@Selection.StackName"
                                PrincipalProvider="_principalProvider"
                                OnNamespaceDeleted="OnChanged"
                                OnNamespaceSaved="OnChanged"/>
        }
    }
}

@code {
    /// <summary>What the tree has selected, or null while nothing is.</summary>
    [Parameter] public HierarchySelection? Selection { get; set; }

    /// <summary>Raised when the panel changes the selected thing, so the tree can reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>A level the tree asked to create at, which takes the column while it is set.</summary>
    [Parameter] public HierarchyCreation? Creation { get; set; }

    /// <summary>Raised once something is created, so the tree reloads and the form closes.</summary>
    [Parameter] public EventCallback OnCreated { get; set; }

    [Parameter] public EventCallback OnCreateCancelled { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    private enum PanelType
    {
        Dependencies,
        Configure
    }

    private PanelType _showing = PanelType.Dependencies;
    private StackMetadata? _stack;
    private NamespaceMetadata? _namespace;
    private IPrincipalProvider _principalProvider = null!;
    private bool _canReadForConfiguration;
    private bool _loading = true;
    private bool _notFound;

    private string Noun => Selection?.Scope == SearchScope.Namespace ? "namespace" : "stack";


    // Configuration asks for read on the thing itself, which is more than reaching this page needs.
    private List<TabBar.TabBarItem> _tabs =>
    [
        new() { Key = nameof(PanelType.Dependencies), Label = "Dependencies" },
        .. _canReadForConfiguration
            ? new[] { new TabBar.TabBarItem { Key = nameof(PanelType.Configure), Label = "Configuration" } }
            : []
    ];

    private HierarchySelection? _loadedFor;

    protected override void OnInitialized()
    {
        var principalId = HttpContextPrincipalProvider.GetSubject(OrganizationId);
        var discriminator = HttpContextPrincipalProvider.GetPrincipalDiscriminator();
        _principalProvider = new LiteralPrincipalProvider(principalId, discriminator, [OrganizationId]);
    }

    protected override async Task OnParametersSetAsync()
    {
        // A creation takes the column without needing the selected node loaded.
        if (Creation != null)
        {
            _loading = false;
            return;
        }

        // Blazor calls this after every event the panels raise, a tab click included. Reloading
        // then would refetch on each click and reset the permission the tab list is built from.
        if (Selection == _loadedFor) return;

        _loadedFor = Selection;
        _stack = null;
        _namespace = null;
        _notFound = false;
        _canReadForConfiguration = false;

        if (Selection == null)
        {
            _loading = false;
            return;
        }

        _loading = true;

        if (Selection.Scope == SearchScope.Module)
        {
            _loading = false;
            return;
        }

        try
        {
            if (Selection.Scope == SearchScope.Namespace)
            {
                using var repo = NamespaceRepoFactory.Create();
                _namespace = await repo.GetMetadata(Selection.StackName, Selection.NamespaceName!, OrganizationId);
                _canReadForConfiguration = repo.CanRead(_namespace.Id, OrganizationId);
            }
            else
            {
                using var repo = StackRepoFactory.Create();
                _stack = await repo.GetMetadataByName(Selection.StackName, OrganizationId);
                _canReadForConfiguration = repo.CanRead(_stack.Id, OrganizationId);
            }
        }
        catch (EntityNotFoundException)
        {
            _notFound = true;
        }
        finally
        {
            _loading = false;
        }

        // A tab the principal cannot see must not stay open across a change of selection.
        if (_showing == PanelType.Configure && !_canReadForConfiguration)
            _showing = PanelType.Dependencies;
    }

    private void HandleTabChanged(string key)
    {
        if (Enum.TryParse<PanelType>(key, out var parsed)) _showing = parsed;
    }
}
