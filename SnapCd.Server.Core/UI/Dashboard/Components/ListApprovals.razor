@implements IDisposable
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Approvals
@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Sagas
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.PrincipalProvider
@using Color = MudBlazor.Color
@using AgentEntity = SnapCd.Server.Core.Entities.Definition.Agent

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SnapCd.Server.Core.Services.Notification.LogReceivedNotificationService LogReceivedNotificationService

@inject HttpContextPrincipalProvider HttpContextPrincipalProvider



@if (_approvals == null)
{
    <p><em>Loading approvals...</em></p>
}
else
{
    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudText Typo="Typo.overline" Class="mud-text-secondary">Approval</MudText>
        <MudText Typo="Typo.h6">@GetApprovalCountText()</MudText>
        @if (_approvals.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">No decisions yet.</MudText>
        }
        else
        {
            <MudDivider Class="my-3"/>
            <MudExpansionPanels Elevation="0">
                @foreach (var approval in _approvals)
                {
                    {
                        var iconColor = approval.ModuleJobApproval.Declined ? Color.Error : Color.Success;
                        var iconType = approval.ModuleJobApproval.Declined ? SnapCdIcons.Error : SnapCdIcons.CheckCircle;
                        var iconTooltip = approval.ModuleJobApproval.Declined ? "Declined" : "Approved";
                        var isUsersApproval = _principalId == approval.ModuleJobApproval.PrincipalId;
                        var hasReason = !string.IsNullOrEmpty(approval.ModuleJobApproval.Reason);

                        var elapsedTime = DateTime.UtcNow - approval.ModuleJobApproval.DecisionDateTime;
                        var elapsedDisplay = elapsedTime.TotalMinutes < 60 ? $"{(int)elapsedTime.TotalMinutes} minutes ago"
                            : elapsedTime.TotalHours < 24 ? $"{(int)elapsedTime.TotalHours} hours ago"
                            : elapsedTime.TotalHours >= 24 && elapsedTime.TotalHours < 48 ? "yesterday"
                            : $"{(int)elapsedTime.TotalDays} days ago";

                        <MudExpansionPanel Class="custom-panel" @key="approval.ModuleJobApproval.Id" Disabled="@(!hasReason)"
                                           HideIcon="@(!hasReason)">
                            <TitleContent>
                                <MudGrid>
                                    <MudItem md="3">
                                        <MudGrid>
                                            <MudItem md="2">
                                                <MudTooltip Text="@iconTooltip">
                                                    <MudIcon Icon="@iconType" Color="@iconColor"></MudIcon>
                                                </MudTooltip>
                                            </MudItem>
                                            <MudItem md="10">
                                                <MudText Typo="Typo.body2">@iconTooltip</MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem md="3">
                                        <MudText Typo="Typo.body2">@approval.PrincipalName</MudText>
                                    </MudItem>
                                    <MudItem md="3">
                                        <MudText Typo="Typo.body2">@elapsedDisplay</MudText>
                                    </MudItem>
                                    <MudItem md="3">
                                        @if (isUsersApproval && _isWaitingForApproval)
                                        {
                                            <MudTooltip Text="Remove My Approval">
                                                <MudIconButton Icon="@SnapCdIcons.Delete"
                                                               Color="Color.Primary" Size="Size.Small"
                                                               OnClick="() => RemoveApproval(approval.ModuleJobApproval.Id)"/>
                                            </MudTooltip>
                                        }
                                    </MudItem>
                                </MudGrid>
                            </TitleContent>
                            <ChildContent>
                                @if (!string.IsNullOrEmpty(approval.ModuleJobApproval.Reason))
                                {
                                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">
                                        <strong>Reason:</strong> @approval.ModuleJobApproval.Reason
                                    </MudText>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                }
            </MudExpansionPanels>
        }
        @if (_isWaitingForApproval)
        {
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Approve" Size="Size.Small">Approve</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Decline" Size="Size.Small">Decline</MudButton>
            </MudStack>
        }
    </MudPaper>

    @if (_moduleJob != null)
    {
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Stretch" Wrap="Wrap.Wrap" Class="mb-4">
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Plan</MudText>
                @if (_moduleJob.PlanTotalChangedCount != null)
                {
                    <MudStack Row="true" Spacing="8" Class="mt-2">
                        @PlanStat("create", _moduleJob.PlanCreateCount ?? 0, Color.Success)
                        @PlanStat("modify", _moduleJob.PlanModifyCount ?? 0, Color.Warning)
                        @PlanStat("destroy", _moduleJob.PlanDestroyCount ?? 0, Color.Error)
                        @PlanStat("recreate", _moduleJob.PlanRecreateCount ?? 0, Color.Error)
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">No plan summary recorded.</MudText>
                }
            </MudPaper>
            @if (_moduleJob.PolicyOutcome != null)
            {
                var (policyIcon, policyColor, policyText) = _moduleJob.PolicyOutcome switch
                {
                    PolicyOutcome.SoftWarned => (SnapCdIcons.Warning, Color.Warning, "Warnings"),
                    PolicyOutcome.HardDenied => (SnapCdIcons.Error, Color.Error, "Denied"),
                    _ => (SnapCdIcons.CheckCircle, Color.Success, "Passed")
                };

                <MudPaper Elevation="0" Class="pa-4">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Policy</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudIcon Icon="@policyIcon" Color="@policyColor"/>
                        <MudText Typo="Typo.h6" Color="@policyColor">@policyText</MudText>
                        @if (_moduleJob.PolicyOutcome != PolicyOutcome.Passed)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">(see detail below)</MudText>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>

        <MudPaper Elevation="0" Class="pa-4">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Logs</MudText>
            <ListLogs ModuleJobId="@ModuleJobId" TaskFilter="@(new[] { PlanTaskName, "PolicyValidate" })" @ref="_inlineLogsRef"/>
        </MudPaper>
    }
}





@code {
    [Parameter] public required Guid ModuleJobId { get; set; }
    [Parameter] public required Guid ModuleId { get; set; }
    [Parameter] public required string JobSagaType { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }
    [Inject] private ModuleSecuredRepositoryFactory ModuleRepoFactory { get; set; } = null!;
    [Inject] private ModuleJobSecuredRepositoryFactory ModuleJobRepoFactory { get; set; } = null!;
    [Inject] private ModuleJobApprovalSecuredRepositoryFactory ModuleJobApprovalRepoFactory { get; set; } = null!;
    [Inject] private OrganizationUserSecuredRepositoryFactory OrganizationUserSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ServicePrincipalSecuredRepositoryFactory ServicePrincipalRepoFactory { get; set; } = null!;
    [Inject] private AgentSecuredRepositoryFactory AgentRepoFactory { get; set; } = null!;

    private List<Approval>? _approvals;
    private ModuleJob? _moduleJob;
    private ListLogs? _inlineLogsRef;
    private bool _isPulumi;
    private int _approvalCount;
    private int? _approvalThreshold;
    private bool _isWaitingForApproval;
    private Guid _principalId;
    private PrincipalDiscriminator _principalDiscriminator;

    protected override async Task OnInitializedAsync()
    {
        // TODO set up caching

        _principalId = HttpContextPrincipalProvider.GetSubject(OrganizationId);
        _principalDiscriminator = HttpContextPrincipalProvider.GetPrincipalDiscriminator();

        await ReloadApprovalThreshold();
        await ReloadModuleJobStatus();
        await ReloadApprovals();

        LogReceivedNotificationService.Subscribe(ModuleId, HandleLogReceived);
    }

    private async Task HandleLogReceived(Guid jobId, Guid moduleId)
    {
        if (jobId != ModuleJobId) return;
        if (_inlineLogsRef == null) return;

        await _inlineLogsRef.RefreshLogs(true);
    }


    public void Dispose()
    {
        LogReceivedNotificationService.Unsubscribe(ModuleId, HandleLogReceived);
    }


    public async Task RefreshAll(bool invokeAsync = false)
    {
        await ReloadApprovalThreshold();
        await ReloadModuleJobStatus();
        await ReloadApprovals();

        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }

    public async Task RefreshModuleJobStatus(bool invokeAsync = false)
    {
        await ReloadModuleJobStatus();

        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }

    public async Task RefreshApprovalThreshold(bool invokeAsync = false)
    {
        await ReloadApprovalThreshold();

        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }


    private string PlanTaskName => JobSagaType == nameof(DestroyJobSaga) ? "PlanDestroy" : "Plan";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_inlineLogsRef != null)
            await _inlineLogsRef.InitializeLogs();
    }

    private string GetApprovalCountText()
    {
        return _approvalThreshold is { } t
            ? $"{_approvalCount} of {t} approvals"
            : $"{_approvalCount} approvals (threshold unknown)";
    }

    private RenderFragment PlanStat(string label, int count, Color colorWhenNonZero) =>
        @<MudStack Spacing="0" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" Color="@(count > 0 ? colorWhenNonZero : Color.Default)" Class="@(count == 0 ? "mud-text-secondary" : null)">@count</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
        </MudStack>;


    private async Task RemoveApproval(Guid moduleJobApprovalId)
    {
        var parameters = new DialogParameters<DeleteApprovalDialog>
        {
            { x => x.ModuleJobApprovalId, moduleJobApprovalId },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteApprovalDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var deletedModuleJobId);
            using var repo = ModuleJobApprovalRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
            await repo.Delete(moduleJobApprovalId, OrganizationId);
            Snackbar.Add($"Successfully deleted  \"{deletedModuleJobId}\"");
        }
    }

    private async Task Approve()
    {
        var parameters = new DialogParameters<ApprovePlanDialog>
        {
            { x => x.ModuleJobId, ModuleJobId },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ApprovePlanDialog>("Approve", parameters, options);
        var result = await dialog.Result;


        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var approvedModuleJobId);
            using var repo = ModuleJobApprovalRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
            await repo.Create(CreateApprovalEntity(false));
            Snackbar.Add($"Successfully approved  \"{approvedModuleJobId}\"");
        }
    }


    private async Task Decline()
    {
        var parameters = new DialogParameters<DeclinePlanDialog>
        {
            { x => x.ModuleJobId, ModuleJobId },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeclinePlanDialog>("Decline", parameters, options);
        var result = await dialog.Result;


        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var declinedModuleJobId);
            using var repo = ModuleJobApprovalRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
            await repo.Create(CreateApprovalEntity(true));
            Snackbar.Add($"Successfully declined  \"{declinedModuleJobId}\"");
        }
    }


    private ModuleJobApproval CreateApprovalEntity(bool declined)
    {
        return new ModuleJobApproval
        {
            Id = Guid.NewGuid(),
            ModuleJobId = ModuleJobId,
            OrganizationId = OrganizationId,
            DecisionDateTime = DateTime.UtcNow,
            Declined = declined,
            PrincipalId = _principalId,
            PrincipalDiscriminator = _principalDiscriminator
        };
    }


    private async Task ReloadModuleJobStatus()
    {
        using var repo = ModuleJobRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));

        _moduleJob = await repo.Get(ModuleJobId, OrganizationId);
        _isWaitingForApproval = _moduleJob.WaitingForApproval.GetValueOrDefault();

        // // TODO this is not working for some reason!
        // var foo = await repo.Get<bool?>(ModuleJobId, x => x.Select(y => y.WaitingForApproval));
        //
    }


    private async Task ReloadApprovalThreshold()
    {
        using var repo = ModuleRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));

        // Get both module and namespace approval thresholds
        var module = await repo.Get<SnapCd.Server.Core.Entities.Definition.Module>(ModuleId, OrganizationId, x => x
            .Include(m => m.Namespace)
            .Select(y => new SnapCd.Server.Core.Entities.Definition.Module
            {
                Id = ModuleId,
                ApplyApprovalThreshold = y.ApplyApprovalThreshold,
                DestroyApprovalThreshold = y.DestroyApprovalThreshold,
                Engine = y.Engine,
                Namespace = new SnapCd.Server.Core.Entities.Definition.Namespace
                {
                    Id = y.Namespace.Id,
                    DefaultApplyApprovalThreshold = y.Namespace.DefaultApplyApprovalThreshold,
                    DefaultDestroyApprovalThreshold = y.Namespace.DefaultDestroyApprovalThreshold,
                    DefaultEngine = y.Namespace.DefaultEngine
                }
            }));

        _isPulumi = (module.Engine ?? module.Namespace.DefaultEngine ?? StateManagementEngine.OpenTofu) == StateManagementEngine.Pulumi;

        if (JobSagaType == nameof(ApplyJobSaga))
        {
            // Use module-level threshold if set, otherwise fall back to namespace default, then 0
            _approvalThreshold = module.ApplyApprovalThreshold ?? module.Namespace.DefaultApplyApprovalThreshold ?? 0;
        }
        else if (JobSagaType == nameof(DestroyJobSaga))
        {
            // Use module-level threshold if set, otherwise fall back to namespace default, then 0
            _approvalThreshold = module.DestroyApprovalThreshold ?? module.Namespace.DefaultDestroyApprovalThreshold ?? 0;
        }
        else
        {
            _approvalThreshold = null;
        }
    }

    public async Task ReloadApprovals()
    {
        using var repo = ModuleJobApprovalRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
        var moduleJobApprovals = await repo.ListByJob(ModuleJobId, OrganizationId);

        var servicePrincipalIds = moduleJobApprovals
            .Where(x => x.PrincipalDiscriminator == PrincipalDiscriminator.ServicePrincipal)
            .Select(x => x.PrincipalId)
            .ToList();

        var userIds = moduleJobApprovals
            .Where(x => x.PrincipalDiscriminator == PrincipalDiscriminator.User)
            .Select(x => x.PrincipalId)
            .ToList();

        using var servicePrincipalRepo = ServicePrincipalRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
        var servicePrincipals = await servicePrincipalRepo
            .List(OrganizationId,
                x => x.Where(y => servicePrincipalIds.Contains(y.Id))
            );

        using var userRepo = OrganizationUserSecuredRepositoryFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
        var users = await userRepo
            .List(
                OrganizationId,
                x => x
                    .Where(y => userIds.Contains(y.UserId))
                    .Include(x => x.User)
            );

        var agentIds = moduleJobApprovals
            .Where(x => x.AgentId.HasValue)
            .Select(x => x.AgentId!.Value)
            .Distinct()
            .ToList();

        using var agentRepo = AgentRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
        var agents = agentIds.Count == 0
            ? new List<AgentEntity>()
            : await agentRepo.List(OrganizationId, x => x.Where(y => agentIds.Contains(y.Id)));

        var approvals = new List<Approval>();

        foreach (var moduleJobApproval in moduleJobApprovals)
        {
            string principalName;

            if (moduleJobApproval.AgentId is { } agentId)
            {
                var agentName = agents.FirstOrDefault(a => a.Id == agentId)?.Name ?? agentId.ToString();
                var spName = servicePrincipals
                    .Where(x => x.Id == moduleJobApproval.PrincipalId)
                    .Select(x => x.ClientId)
                    .SingleOrDefault() ?? moduleJobApproval.PrincipalId.ToString();
                principalName = $"Agent \"{agentName}\" operating as ServicePrincipal \"{spName}\"";
            }
            else
            {
                switch (moduleJobApproval.PrincipalDiscriminator)
                {
                    case PrincipalDiscriminator.ServicePrincipal:
                    {
                        principalName = servicePrincipals
                            .Where(x => x.Id == moduleJobApproval.PrincipalId)
                            .Select(x => x.ClientId)
                            .SingleOrDefault() ?? string.Empty;
                        break;
                    }
                    case PrincipalDiscriminator.User:
                    {
                        principalName = users
                            .Where(x => x.UserId == moduleJobApproval.PrincipalId)
                            .Select(x => x.User.UserName)
                            .SingleOrDefault() ?? string.Empty;
                        break;
                    }
                    default:
                        throw new NotImplementedException($"Not implemented for PrincipalDiscriminator {nameof(moduleJobApproval.PrincipalDiscriminator)}");
                }
            }

            var approval = new Approval
            {
                ModuleJobApproval = moduleJobApproval,
                PrincipalName = principalName
            };

            approvals.Add(approval);
        }

        _approvals = approvals;
        _approvalCount = approvals.Count(x => !x.ModuleJobApproval.Declined);
    }

    private class Approval
    {
        public ModuleJobApproval ModuleJobApproval { get; set; } = null!;

        public string PrincipalName { get; set; } = null!;
    }


}