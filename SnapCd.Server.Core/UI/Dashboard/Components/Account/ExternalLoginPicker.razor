@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using SnapCd.Server.Core.Entities.Definition

@inject SignInManager<User> SignInManager

@if (_externalLogins.Length == 0)
{
    <MudText Align="Align.Center" Typo="Typo.body2" Color="Color.Secondary">
        No external login providers configured
    </MudText>
}
else
{
    <form class="external-login-form" action="Account/PerformExternalLogin" method="post">
        <AntiforgeryToken/>
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl"/>
        @if (!string.IsNullOrEmpty(Token))
        {
            <input type="hidden" name="Token" value="@Token"/>
        }
        @if (IsRegistrationContext)
        {
            <input type="hidden" name="isRegistration" value="true"/>
        }
        <div class="external-login-container">
            <div class="divider-line"></div>
            <div class="external-login-buttons">
                @foreach (var provider in _externalLogins)
                {
                    var (iconHtml, color, textColor) = GetProviderStyleHtml(provider.Name);
                    <button type="submit"
                            name="provider"
                            value="@provider.Name"
                            class="external-login-btn @($"provider-{provider.Name.ToLower()}")"
                            style="background-color: @color;"
                            title="@provider.DisplayName"
                            aria-label="@($"Sign in with {provider.DisplayName}")">
                        <MudTooltip Text="@provider.DisplayName" Placement="Placement.Top" Arrow="true">
                            <span class="provider-icon">@((MarkupString)iconHtml)</span>
                        </MudTooltip>
                    </button>
                }
            </div>
            <div class="divider-line"></div>
        </div>
    </form>
}

<style>
    .external-login-form {
        width: 100%;
    }

    .external-login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        width: 100%;
        margin: 1rem 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: var(--mud-palette-lines-default);
    }

    .external-login-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .external-login-btn {
        width: 48px;
        height: 48px;
        padding: 0;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .external-login-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .external-login-btn:active {
        transform: scale(0.95);
    }

    .mud-dark .external-login-btn:hover {
        box-shadow: 0 4px 16px rgba(255, 255, 255, 0.2);
    }

    .provider-icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

    .provider-icon svg {
        width: 100%;
        height: 100%;
    }

    /* Provider-specific styles */
    .provider-microsoft {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-microsoft:hover {
        background: #f5f5f5 !important;
    }

    .provider-google {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-google:hover {
        background: #f5f5f5 !important;
    }

    .provider-okta {
        background: #ffffff !important;
        border: 1px solid #e0e0e0;
    }

    .provider-okta:hover {
        background: #f5f5f5 !important;
    }

    .provider-okta .provider-icon svg {
        fill: white;
    }

    .provider-github {
        background: #24292e !important;
    }

    .provider-github:hover {
        background: #1a1e22 !important;
    }

    .provider-github .provider-icon svg {
        fill: white;
    }

    .provider-auth0 {
        background: #2d2d2d !important;
    }

    .provider-auth0:hover {
        background: #1a1a1a !important;
    }

    .provider-auth0 .provider-icon svg {
        fill: white;
    }

    /* Dark mode adjustments */
    .mud-dark .provider-microsoft,
    .mud-dark .provider-google {
        background: white !important;
    }

    .mud-dark .provider-microsoft:hover,
    .mud-dark .provider-google:hover {
        background: #f5f5f5 !important;
    }

    /* Responsive design */
    @@media (max-width: 400px) {
        .external-login-btn {
            width: 40px;
            height: 40px;
        }

        .provider-icon {
            width: 20px;
            height: 20px;
        }

        .external-login-buttons {
            gap: 0.75rem;
        }
    }
</style>

@code {
    private AuthenticationScheme[] _externalLogins = [];

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [Parameter] public string? Token { get; set; }

    [Parameter] public bool IsRegistrationContext { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        _externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }

    private (string iconHtml, string color, string textColor) GetProviderStyleHtml(string providerName)
    {
        return providerName.ToLower() switch
        {
            "microsoft" => (GetMicrosoftSvgIcon(), "#ffffff", "#000000"),
            "google" => (GetGoogleSvgIcon(), "#ffffff", "#000000"),
            "okta" => (GetOktaSvgIcon(), "#ffffff", "#000000"),
            "github" => (GetGitHubSvgIcon(), "#24292e", "#ffffff"),
            "auth0" => (GetAuth0SvgIcon(), "#2d2d2d", "#ffffff"),
            "facebook" => (GetFacebookSvgIcon(), "#1877f2", "#ffffff"),
            "twitter" => (GetTwitterSvgIcon(), "#1da1f2", "#ffffff"),
            _ => (GetDefaultSvgIcon(), "#666666", "#ffffff")
        };
    }

    private string GetMicrosoftSvgIcon()
    {
        return @"<svg viewBox=""0 0 21 21"" xmlns=""http://www.w3.org/2000/svg"">
            <rect x=""1"" y=""1"" width=""9"" height=""9"" fill=""#f25022""/>
            <rect x=""1"" y=""11"" width=""9"" height=""9"" fill=""#00a4ef""/>
            <rect x=""11"" y=""1"" width=""9"" height=""9"" fill=""#7fba00""/>
            <rect x=""11"" y=""11"" width=""9"" height=""9"" fill=""#ffb900""/>
        </svg>";
    }

