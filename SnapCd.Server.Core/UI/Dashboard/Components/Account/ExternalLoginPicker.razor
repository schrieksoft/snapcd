    private string GetDefaultSvgIcon()
    {
        return @"<svg viewBox=""0 0 24 24"" xmlns=""http://www.w3.org/2000/svg"">
            <path d=""M18,8H16V6A6,6 0 0,0 10,0H9A6,6 0 0,0 3,6V8H1A1,1 0 0,0 0,9V23A1,1 0 0,0 1,24H23A1,1 0 0,0 24,23V9A1,1 0 0,0 23,8M5,6A4,4 0 0,1 9,2H10A4,4 0 0,1 14,6V8H5V6Z"" fill=""white""/>
        </svg>";
    }

}