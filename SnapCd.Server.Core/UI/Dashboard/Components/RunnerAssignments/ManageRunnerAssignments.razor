@* @page "/RoleAssignments" *@

@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Entities.Definition.RunnerAssignments
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RunnerAssignments
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.RunnerAssignments

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Stack Assignments" Style="text-transform: none">
        @if (!_showCreateStackAssignment)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateStackAssignment">
                Create New
            </MudButton>
        }
        @if (_showCreateStackAssignment)
        {
            <CreateRunnerStackAssignment
                RunnerId="@RunnerId"
                OnSaved="async () => { 
                    _showCreateStackAssignment = false;
                    await ReloadAssignments();
                }"
                OnCancel="() => _showCreateStackAssignment = false"/>
        }
        <MudExpansionPanels>
            @foreach (var assignment in _runnerStackAssignments)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@assignment.Stack.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete role assignment">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteStackAssignment(assignment)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Namespace Assignments" Style="text-transform: none">
        @if (!_showCreateNamespaceAssignment)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateNamespaceAssignment">
                Create New
            </MudButton>
        }
        @if (_showCreateNamespaceAssignment)
        {
            <CreateRunnerNamespaceAssignment
                RunnerId="@RunnerId"
                OnSaved="async () => { 
                    _showCreateNamespaceAssignment = false;
                    await ReloadAssignments();
                }"
                OnCancel="() => _showCreateNamespaceAssignment = false"/>
        }

        <MudExpansionPanels>
            @foreach (var assignment in _runnerNamespaceAssignments)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@assignment.Namespace.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete role assignment">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteNamespaceAssignment(assignment)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Module Assignments" Style="text-transform: none">
        @if (!_showCreateModuleAssignment)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateModuleAssignment">
                Create New
            </MudButton>
        }
        @if (_showCreateModuleAssignment)
        {
            <CreateRunnerModuleAssignment
                RunnerId="@RunnerId"
                OnSaved="async () => { 
                    _showCreateModuleAssignment = false;
                    await ReloadAssignments();
                }"
                OnCancel="() => _showCreateModuleAssignment = false"/>
        }
        <MudExpansionPanels>
            @foreach (var assignment in _runnerModuleAssignments)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@assignment.Module.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete role assignment">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteModuleAssignment(assignment)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudButton
        Variant="Variant.Filled"
        Color="Color.Secondary"
        Class="mt-2 mb-2"
        OnClick="Close">Close
    </MudButton>
</MudTabs>

@code {

    [Parameter] public Guid RunnerId { get; set; }
    [Parameter] public required EventCallback OnClose { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private RunnerStackAssignmentSecuredRepositoryFactory StackAssignmentRepoFactory { get; set; } = null!;
    [Inject] private RunnerModuleAssignmentSecuredRepositoryFactory ModuleAssignmentRepoFactory { get; set; } = null!;
    [Inject] private RunnerNamespaceAssignmentSecuredRepositoryFactory NamespaceAssignmentRepoFactory { get; set; } = null!;


    private bool _showCreateStackAssignment;
    private bool _showCreateNamespaceAssignment;
    private bool _showCreateModuleAssignment;

    private List<RunnerStackAssignment> _runnerStackAssignments = new();
    private List<RunnerModuleAssignment> _runnerModuleAssignments = new();
    private List<RunnerNamespaceAssignment> _runnerNamespaceAssignments = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAssignments();
    }


    private void ShowCreateStackAssignment()
    {
        _showCreateStackAssignment = true;
    }


    private void ShowCreateModuleAssignment()
    {
        _showCreateModuleAssignment = true;
    }


    private void ShowCreateNamespaceAssignment()
    {
        _showCreateNamespaceAssignment = true;
    }


    private async Task ReloadAssignments()
    {
        using var stackAssignmentRepo = StackAssignmentRepoFactory.Create();
        _runnerStackAssignments = await stackAssignmentRepo.ListByParentId(
            RunnerId, OrganizationId,
            x => x
                .Include(y => y.Runner)
                .Include(y => y.Stack)
        );

        using var moduleAssignmentRepo = ModuleAssignmentRepoFactory.Create();
        _runnerModuleAssignments = await moduleAssignmentRepo.ListByParentId(RunnerId, OrganizationId,
            x => x
                .Include(y => y.Runner)
                .Include(y => y.Module)
        );

        using var namespaceAssignmentRepo = NamespaceAssignmentRepoFactory.Create();
        _runnerNamespaceAssignments = await namespaceAssignmentRepo.ListByParentId(RunnerId, OrganizationId,
            x => x
                .Include(y => y.Runner)
                .Include(y => y.Namespace)
        );
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task DeleteStackAssignment(RunnerStackAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteRunnerStackAssignmentDialog>
        {
            { x => x.RunnerStackAssignmentId, assignment.Id },
            { x => x.StackName, assignment.Stack.Name },
            { x => x.RunnerName, assignment.Runner.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerStackAssignmentDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted RunnerStackAssignment \"{id}\"", Severity.Success);
            await ReloadAssignments();
        }
    }

    private async Task DeleteNamespaceAssignment(RunnerNamespaceAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteRunnerNamespaceAssignmentDialog>
        {
            { x => x.RunnerNamespaceAssignmentId, assignment.Id },
            { x => x.NamespaceName, assignment.Namespace.Name },
            { x => x.RunnerName, assignment.Runner.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerNamespaceAssignmentDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted RunnerNamespaceAssignment \"{id}\"", Severity.Success);
            await ReloadAssignments();
        }
    }

    private async Task DeleteModuleAssignment(RunnerModuleAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteRunnerModuleAssignmentDialog>
        {
            { x => x.RunnerModuleAssignmentId, assignment.Id },
            { x => x.ModuleName, assignment.Module.Name },
            { x => x.RunnerName, assignment.Runner.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerModuleAssignmentDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted RunnerModuleAssignment \"{id}\"", Severity.Success);
            await ReloadAssignments();
        }
    }

    public void Dispose()
    {
    }


}