@using SnapCd.Server.Core.Repositories.Organizations.Nonsecured
@using SnapCd.Server.Core.Services.Notification

@implements IDisposable
@inject RunnerConnectionRepositoryFactory ConnectionRepositoryFactory
@inject RunnerAvailabilityModifiedNotificationService AvailabilityNotifications

<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
    <MudIcon Icon="@SnapCdIcons.Circle"
             Size="Size.Small"
             Color="@(_isOnline ? Color.Success : Color.Default)"
             Class="mr-1" />
    @(_isOnline ? $"Online · {_connectionCount}" : "Offline")
</MudChip>

@code {
    [Parameter, EditorRequired] public Guid RunnerId { get; set; }
    [Parameter, EditorRequired] public Guid OrganizationId { get; set; }

    private int _connectionCount;
    private bool _isOnline => _connectionCount > 0;
    private Func<Guid, string, Task>? _handler;

    protected override async Task OnInitializedAsync()
    {
        _handler = HandleAvailabilityChanged;
        AvailabilityNotifications.Subscribe(RunnerId, _handler);
        await Refresh();
    }

    private async Task HandleAvailabilityChanged(Guid runnerId, string runnerInstanceName)
    {
        if (runnerId != RunnerId) return;
        await Refresh();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Refresh()
    {
        using var repo = ConnectionRepositoryFactory.Create();
        var connections = await repo.GetActiveConnectionsByRunnerId(RunnerId, OrganizationId);
        _connectionCount = connections.Count;
    }

    public void Dispose()
    {
        if (_handler is not null)
            AvailabilityNotifications.Unsubscribe(RunnerId, _handler);
    }
}
