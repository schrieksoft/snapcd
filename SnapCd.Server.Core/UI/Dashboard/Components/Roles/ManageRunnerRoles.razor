@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.RoleAssignments
@using SnapCd.Server.Core.UI.Dashboard.Helpers
@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition.RoleAssignments.Org
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RoleAssignments

@implements IDisposable

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudTabs Elevation="2"
         Rounded="true"
         ApplyEffectsToContainer="true"
         PanelClass="pa-6"
         ActivePanelIndexChanged="@OnTabChanged">

    <!-- User Tab -->
    <MudTabPanel Text="Users" Style="text-transform: none">
        @if (!_showUserCreateForm)
        {
            <MudTooltip Text="@_userAssignRefusal" Disabled="@(_userAssignRefusal is null)">
                <MudButton Disabled="@(_userAssignRefusal is not null)" Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="@ShowUserCreateForm"
                           Size="Size.Small"
                           Class="mb-4">
                    Assign Role
                </MudButton>
            </MudTooltip>
        }

        @if (_showUserCreateForm && _userAssignRefusal is null)
        {
            <MudPaper Elevation="2" Class="pa-3 mb-4">
                <MudAutocomplete T="UserMetadata?"
                                 @bind-Value="_selectedUser"
                                 SearchFunc="@SearchUsers"
                                 Label="Search User by Email or Username"
                                 ToStringFunc="@(u => u?.UserName ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="300"
                                 Class="mb-3">
                    <ItemTemplate Context="item">
                        <MudText>@item?.UserName</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                <MudSelect T="RunnerRole"
                           @bind-Value="_selectedUserRole"
                           Label="Select Role"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (RunnerRole role in Enum.GetValues(typeof(RunnerRole)))
                    {
                        <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row Class="mt-2">
                    <MudTooltip Text="Select a user first." Disabled="@(!((_selectedUser == null)))">
                        <MudButton Color="Color.Secondary"
                                   Variant="Variant.Filled"
                                   OnClick="@CreateUserRoleAssignment"
                                   Size="Size.Small"
                                   Disabled="@(_selectedUser == null)">
                            Create
                        </MudButton>
                    </MudTooltip>
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Filled"
                               OnClick="@CancelUserCreate"
                               Size="Size.Small">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (RunnerRole role in Enum.GetValues(typeof(RunnerRole)))
            {
                var roleAssignments = _userRoleAssignments.Where(r => r.RoleName == role).ToList();
                if (roleAssignments.Any())
                {
                    <MudExpansionPanel Text="@role.ToString()" Class="mb-2">
                        @foreach (var assignment in roleAssignments)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText>@assignment.Principal.UserName</MudText>
                                <MudIconButton Icon="@SnapCdIcons.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(async () => await DeleteUserRoleAssignment(assignment))"/>
                            </div>
                        }
                    </MudExpansionPanel>
                }
            }
        </MudExpansionPanels>
    </MudTabPanel>

    <!-- Service Principal Tab -->
    <MudTabPanel Text="Service Principals" Style="text-transform: none">
        @if (!_showServicePrincipalCreateForm)
        {
            <MudTooltip Text="@_servicePrincipalAssignRefusal" Disabled="@(_servicePrincipalAssignRefusal is null)">
                <MudButton Disabled="@(_servicePrincipalAssignRefusal is not null)" Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="@ShowSpCreateForm"
                           Size="Size.Small"
                           Class="mb-4">
                    Assign Role
                </MudButton>
            </MudTooltip>
        }

        @if (_showServicePrincipalCreateForm && _servicePrincipalAssignRefusal is null)
        {
            <MudPaper Elevation="2" Class="pa-3 mb-4">
                <MudAutocomplete T="ServicePrincipalMetadata?"
                                 @bind-Value="_selectedServicePrincipal"
                                 SearchFunc="@SearchServicePrincipals"
                                 Label="Search Service Principal by Client ID"
                                 ToStringFunc="@(sp => sp?.ClientId ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="300"
                                 Class="mb-3">
                    <ItemTemplate Context="item">
                        <MudText>@item?.ClientId</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                <MudSelect T="RunnerRole"
                           @bind-Value="_selectedServicePrincipalRole"
                           Label="Select Role"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (RunnerRole role in Enum.GetValues(typeof(RunnerRole)))
                    {
                        <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row Class="mt-2">
                    <MudTooltip Text="Select a service principal first." Disabled="@(!((_selectedServicePrincipal == null)))">
                        <MudButton Color="Color.Secondary"
                                   Variant="Variant.Filled"
                                   OnClick="@CreateSpRoleAssignment"
                                   Size="Size.Small"
                                   Disabled="@(_selectedServicePrincipal == null)">
                            Create
                        </MudButton>
                    </MudTooltip>
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Filled"
                               OnClick="@CancelSpCreate"
                               Size="Size.Small">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (RunnerRole role in Enum.GetValues(typeof(RunnerRole)))
            {
                var roleAssignments = _servicePrincipalRoleAssignments.Where(r => r.RoleName == role).ToList();
                if (roleAssignments.Any())
                {
                    <MudExpansionPanel Text="@role.ToString()" Class="mb-2">
                        @foreach (var assignment in roleAssignments)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText>@assignment.Principal.ClientId</MudText>
                                <MudIconButton Icon="@SnapCdIcons.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(async () => await DeleteServicePrincipalRoleAssignment(assignment))"/>
                            </div>
                        }
                    </MudExpansionPanel>
                }
            }
        </MudExpansionPanels>
    </MudTabPanel>

    <!-- Groups Tab -->
    <MudTabPanel Text="Groups" Style="text-transform: none">
        @if (!_showGroupCreateForm)
        {
            <MudTooltip Text="@_groupAssignRefusal" Disabled="@(_groupAssignRefusal is null)">
                <MudButton Disabled="@(_groupAssignRefusal is not null)" Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="@ShowGroupCreateForm"
                           Size="Size.Small"
                           Class="mb-4">
                    Assign Role
                </MudButton>
            </MudTooltip>
        }

        @if (_showGroupCreateForm && _groupAssignRefusal is null)
        {
            <MudPaper Elevation="2" Class="pa-3 mb-4">
                <MudAutocomplete T="GroupMetadata?"
                                 @bind-Value="_selectedGroup"
                                 SearchFunc="@SearchGroups"
                                 Label="Search Group by Name"
                                 ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="300"
                                 Class="mb-3">
                    <ItemTemplate Context="item">
                        <MudText>@item?.Name</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                <MudSelect T="RunnerRole"
                           @bind-Value="_selectedGroupRole"
                           Label="Select Role"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (RunnerRole role in Enum.GetValues(typeof(RunnerRole)))
                    {
                        <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row Class="mt-2">
                    <MudTooltip Text="Select a group first." Disabled="@(!((_selectedGroup == null)))">
                        <MudButton Color="Color.Secondary"
                                   Variant="Variant.Filled"
                                   OnClick="@CreateGroupRoleAssignment"
                                   Size="Size.Small"
                                   Disabled="@(_selectedGroup == null)">
                            Create
                        </MudButton>
                    </MudTooltip>
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Filled"
                               OnClick="@CancelGroupCreate"
                               Size="Size.Small">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (RunnerRole role in Enum.GetValues(typeof(RunnerRole)))
            {
                var roleAssignments = _groupRoleAssignments.Where(r => r.RoleName == role).ToList();
                if (roleAssignments.Any())
                {
                    <MudExpansionPanel Text="@role.ToString()" Class="mb-2">
                        @foreach (var assignment in roleAssignments)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText>@assignment.Principal.Name</MudText>
                                <MudIconButton Icon="@SnapCdIcons.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(async () => await DeleteGroupRoleAssignment(assignment))"/>
                            </div>
                        }
                    </MudExpansionPanel>
                }
            }
        </MudExpansionPanels>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public required Guid RunnerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private UserRunnerRoleAssignmentSecuredRepositoryFactory UserRoleRepoFactory { get; set; } = null!;
    [Inject] private ServicePrincipalRunnerRoleAssignmentSecuredRepositoryFactory ServicePrincipalRoleRepoFactory { get; set; } = null!;
    [Inject] private GroupRunnerRoleAssignmentSecuredRepositoryFactory GroupRoleRepoFactory { get; set; } = null!;
    [Inject] private OrganizationUserSecuredRepositoryFactory OrganizationUserRepoFactory { get; set; } = null!;
    [Inject] private ServicePrincipalSecuredRepositoryFactory ServicePrincipalRepoFactory { get; set; } = null!;
    [Inject] private GroupSecuredRepositoryFactory GroupRepoFactory { get; set; } = null!;

    private class UserAssignmentRow
    {
        public Guid Id { get; set; }
        public RunnerRole RoleName { get; set; }
        public UserMetadata Principal { get; set; } = null!;
    }

    private class ServicePrincipalAssignmentRow
    {
        public Guid Id { get; set; }
        public RunnerRole RoleName { get; set; }
        public ServicePrincipalMetadata Principal { get; set; } = null!;
    }

    private class GroupAssignmentRow
    {
        public Guid Id { get; set; }
        public RunnerRole RoleName { get; set; }
        public GroupMetadata Principal { get; set; } = null!;
    }

    private List<UserAssignmentRow> _userRoleAssignments = new();
    private List<ServicePrincipalAssignmentRow> _servicePrincipalRoleAssignments = new();
    private List<GroupAssignmentRow> _groupRoleAssignments = new();

    private string? _userAssignRefusal;
    private string? _servicePrincipalAssignRefusal;
    private string? _groupAssignRefusal;

    private bool _showUserCreateForm;
    private RunnerRole _selectedUserRole = RunnerRole.Reader;
    private UserMetadata? _selectedUser;

    private bool _showServicePrincipalCreateForm;
    private RunnerRole _selectedServicePrincipalRole = RunnerRole.Reader;
    private ServicePrincipalMetadata? _selectedServicePrincipal;

    private bool _showGroupCreateForm;
    private RunnerRole _selectedGroupRole = RunnerRole.Reader;
    private GroupMetadata? _selectedGroup;




    protected override void OnParametersSet()
    {
        using (var repo = UserRoleRepoFactory.Create())
        {
            _userAssignRefusal = repo.CanCreate(RunnerId, OrganizationId)
                ? null
                : "You do not have permission to assign a user role here.";
        }

        using (var repo = ServicePrincipalRoleRepoFactory.Create())
        {
            _servicePrincipalAssignRefusal = repo.CanCreate(RunnerId, OrganizationId)
                ? null
                : "You do not have permission to assign a service principal role here.";
        }

        using (var repo = GroupRoleRepoFactory.Create())
        {
            _groupAssignRefusal = repo.CanCreate(RunnerId, OrganizationId)
                ? null
                : "You do not have permission to assign a group role here.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleAssignments();
    }

    private async Task LoadRoleAssignments()
    {
        // Projected rather than included: the User entity carries the password hash and the
        // security stamp, and none of that is wanted to render a name.
        using var userRepo = UserRoleRepoFactory.Create();
        _userRoleAssignments = await userRepo.List(OrganizationId,
            q => q
                .Where(x => x.RunnerId == RunnerId)
                .Select(x => new UserAssignmentRow
                {
                    Id = x.Id,
                    RoleName = x.RoleName,
                    Principal = new UserMetadata
                    {
                        Id = x.OrganizationUser.UserId,
                        OrganizationId = x.OrganizationUser.OrganizationId,
                        UserName = x.OrganizationUser.User.Email ?? string.Empty
                    }
                }));

        using var servicePrincipalRepo = ServicePrincipalRoleRepoFactory.Create();
        _servicePrincipalRoleAssignments = await servicePrincipalRepo.List(OrganizationId,
            q => q
                .Where(x => x.RunnerId == RunnerId)
                .Select(x => new ServicePrincipalAssignmentRow
                {
                    Id = x.Id,
                    RoleName = x.RoleName,
                    Principal = new ServicePrincipalMetadata
                    {
                        Id = x.ServicePrincipal.Id,
                        OrganizationId = x.ServicePrincipal.OrganizationId,
                        ClientId = x.ServicePrincipal.ClientId!.Substring(x.ServicePrincipal.OrganizationId.ToString().Length + 1),
                        DisplayName = x.ServicePrincipal.DisplayName
                    }
                }));

        using var groupRepo = GroupRoleRepoFactory.Create();
        _groupRoleAssignments = await groupRepo.List(OrganizationId,
            q => q
                .Where(x => x.RunnerId == RunnerId)
                .Select(x => new GroupAssignmentRow
                {
                    Id = x.Id,
                    RoleName = x.RoleName,
                    Principal = new GroupMetadata
                    {
                        Id = x.Group.Id,
                        OrganizationId = x.Group.OrganizationId,
                        Name = x.Group.Name
                    }
                }));
    }

    private void OnTabChanged()
    {
        _showUserCreateForm = false;
        _showServicePrincipalCreateForm = false;
        _showGroupCreateForm = false;
        StateHasChanged();
    }

    // User methods
    private void ShowUserCreateForm()
    {
        _showUserCreateForm = true;
        _selectedUserRole = RunnerRole.Reader;
        _selectedUser = null;
    }

    private void CancelUserCreate()
    {
        _showUserCreateForm = false;
        _selectedUser = null;
    }

    private async Task<IEnumerable<UserMetadata>> SearchUsers(string searchText, CancellationToken cancellationToken)
    {
        using var repo = OrganizationUserRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(searchText)
                ? q
                : q.Where(u => u.UserName.ToLower().Contains(searchText.ToLower())),
            q => q.OrderBy(u => u.UserName),
            pageNumber: 1,
            pageSize: 20);
    }

    private async Task CreateUserRoleAssignment()
    {
        if (_selectedUser == null) return;

        try
        {
            var assignment = new UserRunnerRoleAssignment
            {
                Id = Guid.NewGuid(),
                RunnerId = RunnerId,
                UserId = _selectedUser.Id,
                RoleName = _selectedUserRole,
                OrganizationId = OrganizationId
            };

            using var repo = UserRoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("User role assignment created successfully", Severity.Success);
            _showUserCreateForm = false;
            _selectedUser = null;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "creating user role assignment");
        }
    }

    private async Task DeleteUserRoleAssignment(UserAssignmentRow assignment)
    {
        var parameters = new DialogParameters<DeleteUserRunnerRoleAssignmentDialog>
        {
            { x => x.AssignmentId, assignment.Id },
            { x => x.RoleName, assignment.RoleName.ToString() },
            { x => x.PrincipalName, assignment.Principal.UserName },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteUserRunnerRoleAssignmentDialog>("Delete User Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("User role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }


    // Service Principal methods
    private void ShowSpCreateForm()
    {
        _showServicePrincipalCreateForm = true;
        _selectedServicePrincipalRole = RunnerRole.Reader;
        _selectedServicePrincipal = null;
    }

    private void CancelSpCreate()
    {
        _showServicePrincipalCreateForm = false;
        _selectedServicePrincipal = null;
    }

    private async Task<IEnumerable<ServicePrincipalMetadata>> SearchServicePrincipals(string searchText, CancellationToken cancellationToken)
    {
        using var repo = ServicePrincipalRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(searchText)
                ? q
                : q.Where(sp => sp.ClientId.ToLower().Contains(searchText.ToLower())),
            q => q.OrderBy(sp => sp.ClientId),
            pageNumber: 1,
            pageSize: 20);
    }

    private async Task CreateSpRoleAssignment()
    {
        if (_selectedServicePrincipal == null) return;

        try
        {
            var assignment = new ServicePrincipalRunnerRoleAssignment
            {
                Id = Guid.NewGuid(),
                RunnerId = RunnerId,
                ServicePrincipalId = _selectedServicePrincipal.Id,
                RoleName = _selectedServicePrincipalRole,
                OrganizationId = OrganizationId
            };

            using var repo = ServicePrincipalRoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("Service principal role assignment created successfully", Severity.Success);
            _showServicePrincipalCreateForm = false;
            _selectedServicePrincipal = null;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "creating service principal role assignment");
        }
    }

    private async Task DeleteServicePrincipalRoleAssignment(ServicePrincipalAssignmentRow assignment)
    {
        var parameters = new DialogParameters<DeleteServicePrincipalRunnerRoleAssignmentDialog>
        {
            { x => x.AssignmentId, assignment.Id },
            { x => x.RoleName, assignment.RoleName.ToString() },
            { x => x.PrincipalName, assignment.Principal.ClientId },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteServicePrincipalRunnerRoleAssignmentDialog>("Delete Service Principal Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Service principal role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }



    // Group methods
    private void ShowGroupCreateForm()
    {
        _showGroupCreateForm = true;
        _selectedGroupRole = RunnerRole.Reader;
        _selectedGroup = null;
    }

    private void CancelGroupCreate()
    {
        _showGroupCreateForm = false;
        _selectedGroup = null;
    }

    private async Task<IEnumerable<GroupMetadata>> SearchGroups(string searchText, CancellationToken cancellationToken)
    {
        using var repo = GroupRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(searchText)
                ? q
                : q.Where(g => g.Name.ToLower().Contains(searchText.ToLower())),
            q => q.OrderBy(g => g.Name),
            pageNumber: 1,
            pageSize: 20);
    }

    private async Task CreateGroupRoleAssignment()
    {
        if (_selectedGroup == null) return;

        try
        {
            var assignment = new GroupRunnerRoleAssignment
            {
                Id = Guid.NewGuid(),
                RunnerId = RunnerId,
                GroupId = _selectedGroup.Id,
                RoleName = _selectedGroupRole,
                OrganizationId = OrganizationId
            };

            using var repo = GroupRoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("Group role assignment created successfully", Severity.Success);
            _showGroupCreateForm = false;
            _selectedGroup = null;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "creating group role assignment");
        }
    }

    private async Task DeleteGroupRoleAssignment(GroupAssignmentRow assignment)
    {
        var parameters = new DialogParameters<DeleteGroupRunnerRoleAssignmentDialog>
        {
            { x => x.AssignmentId, assignment.Id },
            { x => x.RoleName, assignment.RoleName.ToString() },
            { x => x.PrincipalName, assignment.Principal.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteGroupRunnerRoleAssignmentDialog>("Delete Group Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Group role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }


    public void Dispose()
    {
    }

}
