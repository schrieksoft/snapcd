@using SnapCd.Server.Core.UI.Dashboard.Dialogs.RoleAssignments
@using SnapCd.Server.Core.UI.Dashboard.Helpers
@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition.RoleAssignments.Org
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RoleAssignments
@using SnapCd.Server.Core.UI.Dashboard.Components.Licensing

@implements IDisposable

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<EeFeatureAlert Message="Fine-grained namespace role assignments are an Enterprise Edition feature. Enter a valid license key on the License page to enable creating and modifying role assignments."/>

<MudTabs Elevation="2"
         Rounded="true"
         ApplyEffectsToContainer="true"
         PanelClass="pa-6"
         ActivePanelIndexChanged="@OnTabChanged">

    <!-- User Tab -->
    <MudTabPanel Text="Users" Style="text-transform: none">
        @if (!_showUserCreateForm)
        {
            <MudButton Color="Color.Secondary"
                       Variant="Variant.Filled"
                       OnClick="@ShowUserCreateForm"
                       Size="Size.Small"
                       Class="mb-4">
                Assign Role
            </MudButton>
        }

        @if (_showUserCreateForm)
        {
            <MudPaper Elevation="2" Class="pa-3 mb-4">
                <MudAutocomplete T="UserDisplay?"
                                 @bind-Value="_selectedUser"
                                 SearchFunc="@SearchUsers"
                                 Label="Search User by Email or Username"
                                 ToStringFunc="@(u => u?.DisplayName ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="300"
                                 Class="mb-3">
                    <ItemTemplate Context="item">
                        <MudText>@item?.DisplayName</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                <MudSelect T="NamespaceRole"
                           @bind-Value="_selectedUserRole"
                           Label="Select Role"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (NamespaceRole role in Enum.GetValues(typeof(NamespaceRole)))
                    {
                        <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row Class="mt-2">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="@CreateUserRoleAssignment"
                               Size="Size.Small"
                               Disabled="@(_selectedUser == null)">
                        Create
                    </MudButton>
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Outlined"
                               OnClick="@CancelUserCreate"
                               Size="Size.Small">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (NamespaceRole role in Enum.GetValues(typeof(NamespaceRole)))
            {
                var roleAssignments = _userRoleAssignments.Where(r => r.RoleName == role).ToList();
                if (roleAssignments.Any())
                {
                    <MudExpansionPanel Text="@role.ToString()" Class="mb-2">
                        @foreach (var assignment in roleAssignments)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText>@GetUserDisplayName(assignment)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(async () => await DeleteUserRoleAssignment(assignment))"/>
                            </div>
                        }
                    </MudExpansionPanel>
                }
            }
        </MudExpansionPanels>
    </MudTabPanel>

    <!-- Service Principal Tab -->
    <MudTabPanel Text="Service Principals" Style="text-transform: none">
        @if (!_showSpCreateForm)
        {
            <MudButton Color="Color.Secondary"
                       Variant="Variant.Filled"
                       OnClick="@ShowSpCreateForm"
                       Size="Size.Small"
                       Class="mb-4">
                Assign Role
            </MudButton>
        }

        @if (_showSpCreateForm)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-4">
                <MudAutocomplete T="ServicePrincipalDisplay?"
                                 @bind-Value="_selectedServicePrincipal"
                                 SearchFunc="@SearchServicePrincipals"
                                 Label="Search Service Principal by Client ID"
                                 ToStringFunc="@(sp => sp?.ClientId ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="300"
                                 Class="mb-3">
                    <ItemTemplate Context="item">
                        <MudText>@item?.ClientId</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                <MudSelect T="NamespaceRole"
                           @bind-Value="_selectedSpRole"
                           Label="Select Role"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (NamespaceRole role in Enum.GetValues(typeof(NamespaceRole)))
                    {
                        <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row Class="mt-2">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="@CreateSpRoleAssignment"
                               Size="Size.Small"
                               Disabled="@(_selectedServicePrincipal == null)">
                        Create
                    </MudButton>
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Outlined"
                               OnClick="@CancelSpCreate"
                               Size="Size.Small">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (NamespaceRole role in Enum.GetValues(typeof(NamespaceRole)))
            {
                var roleAssignments = _spRoleAssignments.Where(r => r.RoleName == role).ToList();
                if (roleAssignments.Any())
                {
                    <MudExpansionPanel Text="@role.ToString()" Class="mb-2">
                        @foreach (var assignment in roleAssignments)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText>@GetServicePrincipalDisplayName(assignment)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(async () => await DeleteSpRoleAssignment(assignment))"/>
                            </div>
                        }
                    </MudExpansionPanel>
                }
            }
        </MudExpansionPanels>
    </MudTabPanel>

    <!-- Groups Tab -->
    <MudTabPanel Text="Groups" Style="text-transform: none">
        @if (!_showGroupCreateForm)
        {
            <MudButton Color="Color.Secondary"
                       Variant="Variant.Filled"
                       OnClick="@ShowGroupCreateForm"
                       Size="Size.Small"
                       Class="mb-4">
                Assign Role
            </MudButton>
        }

        @if (_showGroupCreateForm)
        {
            <MudPaper Elevation="2" Class="pa-3 mb-4">
                <MudAutocomplete T="GroupDisplay?"
                                 @bind-Value="_selectedGroup"
                                 SearchFunc="@SearchGroups"
                                 Label="Search Group by Name"
                                 ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 DebounceInterval="300"
                                 Class="mb-3">
                    <ItemTemplate Context="item">
                        <MudText>@item?.Name</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                <MudSelect T="NamespaceRole"
                           @bind-Value="_selectedGroupRole"
                           Label="Select Role"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (NamespaceRole role in Enum.GetValues(typeof(NamespaceRole)))
                    {
                        <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row Class="mt-2">
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Filled"
                               OnClick="@CreateGroupRoleAssignment"
                               Size="Size.Small"
                               Disabled="@(_selectedGroup == null)">
                        Create
                    </MudButton>
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Filled"
                               OnClick="@CancelGroupCreate"
                               Size="Size.Small">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (NamespaceRole role in Enum.GetValues(typeof(NamespaceRole)))
            {
                var roleAssignments = _groupRoleAssignments.Where(r => r.RoleName == role).ToList();
                if (roleAssignments.Any())
                {
                    <MudExpansionPanel Text="@role.ToString()" Class="mb-2">
                        @foreach (var assignment in roleAssignments)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText>@GetGroupDisplayName(assignment)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(async () => await DeleteGroupRoleAssignment(assignment))"/>
                            </div>
                        }
                    </MudExpansionPanel>
                }
            }
        </MudExpansionPanels>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public required Guid NamespaceId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private UserNamespaceRoleAssignmentSecuredRepositoryFactory UserRoleRepoFactory { get; set; } = null!;
    [Inject] private ServicePrincipalNamespaceRoleAssignmentSecuredRepositoryFactory SpRoleRepoFactory { get; set; } = null!;
    [Inject] private GroupNamespaceRoleAssignmentSecuredRepositoryFactory GroupRoleRepoFactory { get; set; } = null!;
    [Inject] private OrganizationUserSecuredRepositoryFactory OrganizationUserRepoFactory { get; set; } = null!;
    [Inject] private ServicePrincipalSecuredRepositoryFactory ServicePrincipalRepoFactory { get; set; } = null!;
    [Inject] private GroupSecuredRepositoryFactory GroupRepoFactory { get; set; } = null!;

    private List<UserNamespaceRoleAssignment> _userRoleAssignments = new();
    private List<ServicePrincipalNamespaceRoleAssignment> _spRoleAssignments = new();
    private List<GroupNamespaceRoleAssignment> _groupRoleAssignments = new();

    private bool _showUserCreateForm;
    private NamespaceRole _selectedUserRole = NamespaceRole.Reader;
    private UserDisplay? _selectedUser;

    private bool _showSpCreateForm;
    private NamespaceRole _selectedSpRole = NamespaceRole.Reader;
    private ServicePrincipalDisplay? _selectedServicePrincipal;

    private bool _showGroupCreateForm;
    private NamespaceRole _selectedGroupRole = NamespaceRole.Reader;
    private GroupDisplay? _selectedGroup;

    private class UserDisplay
    {
        public Guid UserId { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }

    private class ServicePrincipalDisplay
    {
        public Guid Id { get; set; }
        public string ClientId { get; set; } = string.Empty;
    }

    private class GroupDisplay
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleAssignments();
    }

    private async Task LoadRoleAssignments()
    {
        using var userRepo = UserRoleRepoFactory.Create();
        _userRoleAssignments = await userRepo.List(OrganizationId,
            q => q
                .Include(x => x.OrganizationUser)
                    .ThenInclude(ou => ou.User)
                .Where(x => x.NamespaceId == NamespaceId));

        using var spRepo = SpRoleRepoFactory.Create();
        _spRoleAssignments = await spRepo.List(OrganizationId,
            q => q
                .Include(x => x.ServicePrincipal)
                .Where(x => x.NamespaceId == NamespaceId));

        using var groupRepo = GroupRoleRepoFactory.Create();
        _groupRoleAssignments = await groupRepo.List(OrganizationId,
            q => q
                .Include(x => x.Group)
                .Where(x => x.NamespaceId == NamespaceId));
    }

    private void OnTabChanged()
    {
        _showUserCreateForm = false;
        _showSpCreateForm = false;
        _showGroupCreateForm = false;
        StateHasChanged();
    }

    // User methods
    private void ShowUserCreateForm()
    {
        _showUserCreateForm = true;
        _selectedUserRole = NamespaceRole.Reader;
        _selectedUser = null;
    }

    private void CancelUserCreate()
    {
        _showUserCreateForm = false;
        _selectedUser = null;
    }

    private async Task<IEnumerable<UserDisplay>> SearchUsers(string searchText, CancellationToken cancellationToken)
    {
        using var repo = OrganizationUserRepoFactory.Create();
        return await repo.List<UserDisplay>(OrganizationId,
            q =>
            {
                var query = q
                    .Include(ou => ou.User)
                    .Where(ou => ou.User.Email != null && ou.User.UserName != null);

                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    query = query.Where(ou =>
                        ou.User.Email!.ToLower().Contains(searchText.ToLower()) ||
                        ou.User.UserName!.ToLower().Contains(searchText.ToLower()));
                }

                return query
                    .Take(20)
                    .Select(ou => new UserDisplay
                    {
                        UserId = ou.UserId,
                        DisplayName = ou.User.UserName ?? ou.User.Email ?? "Unknown",
                        Email = ou.User.Email ?? string.Empty
                    });
            },
            q => q.OrderBy(x => x.DisplayName)
        );
    }

    private async Task CreateUserRoleAssignment()
    {
        if (_selectedUser == null) return;

        try
        {
            var assignment = new UserNamespaceRoleAssignment
            {
                Id = Guid.NewGuid(),
                NamespaceId = NamespaceId,
                UserId = _selectedUser.UserId,
                RoleName = _selectedUserRole,
                OrganizationId = OrganizationId
            };

            using var repo = UserRoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("User role assignment created successfully", Severity.Success);
            _showUserCreateForm = false;
            _selectedUser = null;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating role assignment: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteUserRoleAssignment(UserNamespaceRoleAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteUserNamespaceRoleAssignmentDialog>
        {
            { x => x.Assignment, assignment },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteUserNamespaceRoleAssignmentDialog>("Delete User Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("User role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }

    private string GetUserDisplayName(UserNamespaceRoleAssignment assignment)
    {
        return assignment.OrganizationUser?.User?.UserName ??
               assignment.OrganizationUser?.User?.Email ??
               $"User {assignment.UserId}";
    }

    // Service Principal methods
    private void ShowSpCreateForm()
    {
        _showSpCreateForm = true;
        _selectedSpRole = NamespaceRole.Reader;
        _selectedServicePrincipal = null;
    }

    private void CancelSpCreate()
    {
        _showSpCreateForm = false;
        _selectedServicePrincipal = null;
    }

    private async Task<IEnumerable<ServicePrincipalDisplay>> SearchServicePrincipals(string searchText, CancellationToken cancellationToken)
    {
        using var repo = ServicePrincipalRepoFactory.Create();
        return await repo.List(OrganizationId,
            q =>
            {
                var query = q.Where(sp => sp.ClientId != null);

                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    query = query.Where(sp => sp.ClientId!.ToLower().Contains(searchText.ToLower()));
                }

                return query
                    .Take(20)
                    .Select(sp => new ServicePrincipalDisplay
                    {
                        Id = sp.Id,
                        ClientId = sp.ClientId ?? string.Empty
                    });
            },
            q => q.OrderBy(x => x.ClientId)
        );
    }

    private async Task CreateSpRoleAssignment()
    {
        if (_selectedServicePrincipal == null) return;

        try
        {
            var assignment = new ServicePrincipalNamespaceRoleAssignment
            {
                Id = Guid.NewGuid(),
                NamespaceId = NamespaceId,
                ServicePrincipalId = _selectedServicePrincipal.Id,
                RoleName = _selectedSpRole,
                OrganizationId = OrganizationId
            };

            using var repo = SpRoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("Service principal role assignment created successfully", Severity.Success);
            _showSpCreateForm = false;
            _selectedServicePrincipal = null;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating role assignment: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSpRoleAssignment(ServicePrincipalNamespaceRoleAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteServicePrincipalNamespaceRoleAssignmentDialog>
        {
            { x => x.Assignment, assignment },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteServicePrincipalNamespaceRoleAssignmentDialog>("Delete Service Principal Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Service principal role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }

    private string GetServicePrincipalDisplayName(ServicePrincipalNamespaceRoleAssignment assignment)
    {
        return assignment.ServicePrincipal?.ClientId ?? $"ServicePrincipal {assignment.ServicePrincipalId}";
    }

    // Group methods
    private void ShowGroupCreateForm()
    {
        _showGroupCreateForm = true;
        _selectedGroupRole = NamespaceRole.Reader;
        _selectedGroup = null;
    }

    private void CancelGroupCreate()
    {
        _showGroupCreateForm = false;
        _selectedGroup = null;
    }

    private async Task<IEnumerable<GroupDisplay>> SearchGroups(string searchText, CancellationToken cancellationToken)
    {
        using var repo = GroupRepoFactory.Create();
        return await repo.List(OrganizationId,
            q =>
            {
                var query = q.Where(g => g.Name != null);

                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    query = query.Where(g => g.Name!.ToLower().Contains(searchText.ToLower()));
                }

                return query
                    .Take(20)
                    .Select(g => new GroupDisplay
                    {
                        Id = g.Id,
                        Name = g.Name ?? string.Empty
                    });
            },
            q => q.OrderBy(x => x.Name)
        );
    }

    private async Task CreateGroupRoleAssignment()
    {
        if (_selectedGroup == null) return;

        try
        {
            var assignment = new GroupNamespaceRoleAssignment
            {
                Id = Guid.NewGuid(),
                NamespaceId = NamespaceId,
                GroupId = _selectedGroup.Id,
                RoleName = _selectedGroupRole,
                OrganizationId = OrganizationId
            };

            using var repo = GroupRoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("Group role assignment created successfully", Severity.Success);
            _showGroupCreateForm = false;
            _selectedGroup = null;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "creating group role assignment");
        }
    }

    private async Task DeleteGroupRoleAssignment(GroupNamespaceRoleAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteGroupNamespaceRoleAssignmentDialog>
        {
            { x => x.Assignment, assignment },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteGroupNamespaceRoleAssignmentDialog>("Delete Group Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Group role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }

    private string GetGroupDisplayName(GroupNamespaceRoleAssignment assignment)
    {
        return assignment.Group?.Name ?? $"Group {assignment.GroupId}";
    }

    public void Dispose()
    {
    }

}
