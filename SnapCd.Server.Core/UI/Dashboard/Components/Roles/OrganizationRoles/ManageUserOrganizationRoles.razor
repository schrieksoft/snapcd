@using SnapCd.Server.Core.UI.Dashboard.Dialogs.RoleAssignments
@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.RoleAssignments.Org
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RoleAssignments

@implements IDisposable

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Elevation="1" Class="pa-4">

    @if (!_showCreateForm)
    {
        <MudButton Color="Color.Secondary"
                   Variant="Variant.Filled"
                   OnClick="@ShowCreateForm"
                   Size="Size.Small"
                   Class="mb-4">
            Assign Role
        </MudButton>
    }

    @if (_showCreateForm)
    {
        <MudPaper Elevation="2" Class="pa-3 mb-4">
            <MudSelect T="OrganizationRole"
                       @bind-Value="_selectedRole"
                       Label="Select Role"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                @foreach (OrganizationRole role in Enum.GetValues(typeof(OrganizationRole)))
                {
                    <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                }
            </MudSelect>

            <MudStack Row Class="mt-2">
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="@CreateRoleAssignment"
                           Size="Size.Small">
                    Assign
                </MudButton>
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           OnClick="@CancelCreate"
                           Size="Size.Small">
                    Cancel
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    <MudExpansionPanels MultiExpansion="true">
        @foreach (var assignment in _roleAssignments)
        {
            <MudExpansionPanel Text="@assignment.RoleName.ToString()" Class="mb-2">
                <MudIconButton Icon="@SnapCdIcons.Delete"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="@(async () => await DeleteRoleAssignment(assignment))"/>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</MudPaper>

@code {
    [Parameter] public required Guid UserId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private UserOrganizationRoleAssignmentSecuredRepositoryFactory RoleRepoFactory { get; set; } = null!;
    [Inject] private OrganizationUserSecuredRepositoryFactory OrganizationUserRepoFactory { get; set; } = null!;

    private List<UserOrganizationRoleAssignment> _roleAssignments = new();
    private OrganizationUser? _organizationUser;

    private bool _showCreateForm;
    private OrganizationRole _selectedRole = OrganizationRole.Reader;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleAssignments();
        await LoadOrganizationUser();
    }

    private async Task LoadRoleAssignments()
    {
        using var repo = RoleRepoFactory.Create();
        _roleAssignments = await repo.List(OrganizationId,
            q => q
                .Include(ra => ra.OrganizationUser)
                .ThenInclude(ou => ou!.User)
                .Where(ra => ra.UserId == UserId));
    }

    private async Task LoadOrganizationUser()
    {
        using var repo = OrganizationUserRepoFactory.Create();
        _organizationUser = await repo.List(OrganizationId,
                q => q
                    .Include(ou => ou.User)
                    .Where(ou => ou.UserId == UserId))
            .ContinueWith(t => t.Result.FirstOrDefault());
    }

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        _selectedRole = OrganizationRole.Reader;
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
    }

    private async Task CreateRoleAssignment()
    {
        try
        {
            var assignment = new UserOrganizationRoleAssignment
            {
                Id = Guid.NewGuid(),
                UserId = UserId,
                RoleName = _selectedRole,
                OrganizationId = OrganizationId
            };

            using var repo = RoleRepoFactory.Create();
            await repo.Create(assignment);

            Snackbar.Add("Role assignment created successfully", Severity.Success);
            _showCreateForm = false;
            await LoadRoleAssignments();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating role assignment: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteRoleAssignment(UserOrganizationRoleAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteUserOrganizationRoleAssignmentDialog>
        {
            { x => x.Assignment, assignment },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteUserOrganizationRoleAssignmentDialog>("Delete Role Assignment", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Role assignment deleted successfully", Severity.Success);
            await LoadRoleAssignments();
        }
    }

    private string GetUserDisplayName()
    {
        return _organizationUser?.User?.UserName ??
               _organizationUser?.User?.Email ??
               $"User {UserId}";
    }

    public void Dispose()
    {
    }

}
