@using SnapCd.Contracts.Dto.ServicePrincipalFederatedCredentials
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Secured.Crud
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.ServicePrincipals

<MudPaper Elevation="1" Class="pa-4 my-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5">Federated Credentials</MudText>
        <MudText Typo="Typo.body2">
            A workload presenting a token from one of these issuers authenticates as this Service
            Principal, with no client secret.
        </MudText>

        @if (_credentials.Count == 0)
        {
            <MudText Typo="Typo.body2">No Federated Credentials.</MudText>
        }
        else
        {
            <MudTable Items="_credentials" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Issuer</MudTh>
                    <MudTh>Subject</MudTh>
                    <MudTh>Audience</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Issuer">@context.Issuer</MudTd>
                    <MudTd DataLabel="Subject">@context.Subject</MudTd>
                    <MudTd DataLabel="Audience">@context.Audience</MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsDisabled)
                        {
                            <MudChip T="string" Color="Color.Error" Text="Disabled" Size="Size.Small"/>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Text="Enabled" Size="Size.Small"/>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudTooltip Text="Edit federated credential">
                            <MudIconButton Icon="@SnapCdIcons.Edit" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@(!_canUpdate)"
                                           OnClick="() => Edit(context)"/>
                        </MudTooltip>
                        <MudTooltip Text="Delete federated credential">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@(!_canUpdate)"
                                           OnClick="() => Delete(context)"/>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <div class="d-flex justify-end gap-2 mt-4">
            <MudTooltip Text="@AddDisabledReason" Disabled="@(AddDisabledReason is null)">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           Disabled="@(!_canUpdate)" OnClick="Add">
                    Add Federated Credential
                </MudButton>
            </MudTooltip>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       OnClick="Close">
                Close
            </MudButton>
        </div>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public Guid ServicePrincipalId { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ServicePrincipalFederatedCredentialService Service { get; set; } = null!;
    [Inject] private ServicePrincipalFederatedCredentialSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private List<ServicePrincipalFederatedCredentialReadDto> _credentials = [];
    private bool _canUpdate;

    private string? AddDisabledReason => _canUpdate ? null : "You do not have permission to change this.";

    protected override async Task OnParametersSetAsync()
    {
        using var repo = RepoFactory.Create();
        _canUpdate = repo.CanCreate(OrganizationId, OrganizationId);

        await Load();
    }

    private async Task Load()
    {
        var all = await Service.List(OrganizationId);
        _credentials = all
            .Where(c => c.ServicePrincipalId == ServicePrincipalId)
            .OrderBy(c => c.Name)
            .ToList();
    }

    private async Task Add()
    {
        var parameters = new DialogParameters
        {
            { nameof(CreateServicePrincipalFederatedCredentialDialog.OrganizationId), OrganizationId },
            { nameof(CreateServicePrincipalFederatedCredentialDialog.ServicePrincipalId), ServicePrincipalId }
        };

        var dialog = await DialogService.ShowAsync<CreateServicePrincipalFederatedCredentialDialog>(
            "Add Federated Credential", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await Load();
    }

    private async Task Edit(ServicePrincipalFederatedCredentialReadDto credential)
    {
        var parameters = new DialogParameters
        {
            { nameof(EditServicePrincipalFederatedCredentialDialog.OrganizationId), OrganizationId },
            { nameof(EditServicePrincipalFederatedCredentialDialog.Credential), credential }
        };

        var dialog = await DialogService.ShowAsync<EditServicePrincipalFederatedCredentialDialog>(
            "Edit Federated Credential", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await Load();
    }

    private async Task Delete(ServicePrincipalFederatedCredentialReadDto credential)
    {
        var parameters = new DialogParameters
        {
            { nameof(DeleteServicePrincipalFederatedCredentialDialog.OrganizationId), OrganizationId },
            { nameof(DeleteServicePrincipalFederatedCredentialDialog.Credential), credential }
        };

        var dialog = await DialogService.ShowAsync<DeleteServicePrincipalFederatedCredentialDialog>(
            "Delete Federated Credential", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await Load();
    }

    private Task Close() => OnCancel.InvokeAsync();
}
