@inject PersistentComponentState ApplicationState
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.Views.Metadata
@implements IDisposable

@if (_namespaces == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else if (_namespaces.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mt-2">No namespaces yet, or you do not have permission to see any.</MudText>
}
else
{
    <div class="list-heading">Namespaces</div>

    <div class="namespace-list">
        @foreach (var ns in _namespaces)
        {
            <MudExpansionPanel @key="ns.Id" Expanded="_expandedNamespaces.Contains(ns.Id)" Class="mb-1">
                <TitleContent>
                    @if (ShowCheckboxes)
                    {
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <MudCheckBox Color="Color.Secondary" T="bool"
                                         Value="@_selectedNamespaces.Contains(ns.Id)"
                                         ValueChanged="@(value => OnNamespaceSelectionChanged(ns.Id, value))"
                                         Dense="true"
                                         Style="margin: 0; padding: 0;"/>
                            <MudLink
                                Href="@($"/Namespace/{StackName}/{ns.Name}")">@GetHighlightedNamespaceName(ns.Name)</MudLink>
                        </div>
                    }
                    else
                    {
                        <MudLink
                            Href="@($"/Namespace/{StackName}/{ns.Name}")">@GetHighlightedNamespaceName(ns.Name)</MudLink>
                    }
                </TitleContent>
                <ChildContent>
                    <div class="mt-2">
                        <ListModules
                            NamespaceId="@ns.Id"
                            NamespaceName="@ns.Name"
                            StackName="@StackName"
                            SearchTerms="@SearchTerms" SearchScope="@SearchScope"/>
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }
    </div>

    @if (_totalPages > 1)
    {
        <Pagination CurrentPage="_currentPage"
                    TotalPages="_totalPages"
                    PageChanged="HandlePageChanged"/>
    }
}


<style>
    .search-highlight {
        background-color: var(--snap-accent);
        color: var(--snap-on-accent);
        padding: 0 2px;
        border-radius: 0;
    }
</style>

@code {
    [Parameter] public Guid StackId { get; set; }
    [Parameter] public string StackName { get; set; } = null!;
    [Parameter] public List<string> SearchTerms { get; set; } = new();
    [Parameter] public SearchScope SearchScope { get; set; } = SearchScope.Stack;
    [Parameter] public EventCallback<HashSet<Guid>> OnSelectionChanged { get; set; }
    [Parameter] public bool SelectAll { get; set; }
    [Parameter] public bool ShowCheckboxes { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }
    [Inject] private NamespaceSecuredRepositoryFactory NamespaceRepoFactory { get; set; } = null!;
    [Inject] private ModuleSecuredRepositoryFactory ModuleRepoFactory { get; set; } = null!;

    private List<NamespaceMetadata>? _namespaces;
    private int _matchCount;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;
    private List<string> _previousSearchTerms = new();
    private HashSet<Guid> _expandedNamespaces = new();
    private HashSet<Guid> _selectedNamespaces = new();
    private bool _previousSelectAll;

    // private PersistingComponentStateSubscription _persistenceSubscription;

    protected override async Task OnParametersSetAsync()
    {
        // Check if search terms have changed
        if (!SearchTerms.SequenceEqual(_previousSearchTerms))
        {
            _previousSearchTerms = new List<string>(SearchTerms);
            await LoadNamespaces();
        }

        // Handle select all parameter change
        if (SelectAll != _previousSelectAll)
        {
            _previousSelectAll = SelectAll;
            if (SelectAll && _namespaces != null)
            {
                // Select all current namespaces
                _selectedNamespaces = new HashSet<Guid>(_namespaces.Select(n => n.Id));
            }
            else
            {
                // Clear selection
                _selectedNamespaces.Clear();
            }

            if (OnSelectionChanged.HasDelegate)
            {
                await OnSelectionChanged.InvokeAsync(_selectedNamespaces);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNamespaces();

        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // var cacheKey = $"cachedNamespaces_{StackId}";
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(() =>
        // {
        //     ApplicationState.PersistAsJson(cacheKey, new CachedNamespacesData
        //     {
        //         Namespaces = _namespaces,
        //         CurrentPage = _currentPage,
        //         TotalPages = _totalPages,
        //         StackId = StackId
        //     });
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<CachedNamespacesData>(cacheKey, out var cachedData))
        // {
        //     _namespaces = cachedData.Namespaces;
        //     _currentPage = cachedData.CurrentPage;
        //     _totalPages = cachedData.TotalPages;
        // }
    }

    public async Task LoadNamespaces(bool resetPage = true)
    {
        using var namespaceRepository = NamespaceRepoFactory.Create();
        using var moduleRepository = ModuleRepoFactory.Create();

        if (resetPage)
        {
            _currentPage = 1; // Reset to first page when searching
        }

        _expandedNamespaces.Clear(); // Clear expanded state

        if (SearchTerms.Any() && SearchScope != SearchScope.Stack)
        {
            // The Stack above already matched; within it, narrow to what matches here. As in
            // ListStacks, the pager counts matches at the scope's level, so a Module search pages
            // through Modules while the rows are the Namespaces holding them.
            if (SearchScope == SearchScope.Namespace)
            {
                _matchCount = await namespaceRepository.CountMetadata(
                    OrganizationId,
                    q => q
                        .Where(x => x.StackId == StackId)
                        .Where(x => SearchTerms.All(term => x.Name.Contains(term))));

                _namespaces = await namespaceRepository.ListMetadata(
                    OrganizationId,
                    q => q
                        .Where(x => x.StackId == StackId)
                        .Where(x => SearchTerms.All(term => x.Name.Contains(term))),
                    orderBy: q => q.OrderBy(x => x.Name),
                    pageNumber: _currentPage,
                    pageSize: PageSize);
            }
            else
            {
                var stackNamespaceIds = (await namespaceRepository.ListMetadata(
                        OrganizationId,
                        q => q.Where(x => x.StackId == StackId)))
                    .Select(x => x.Id)
                    .ToList();

                _matchCount = stackNamespaceIds.Count == 0
                    ? 0
                    : await moduleRepository.CountMetadata(
                        OrganizationId,
                        q => q
                            .Where(x => stackNamespaceIds.Contains(x.NamespaceId))
                            .Where(x => SearchTerms.All(term => x.Name.Contains(term))));

                var modules = stackNamespaceIds.Count == 0
                    ? new List<ModuleMetadata>()
                    : await moduleRepository.ListMetadata(
                        OrganizationId,
                        q => q
                            .Where(x => stackNamespaceIds.Contains(x.NamespaceId))
                            .Where(x => SearchTerms.All(term => x.Name.Contains(term))),
                        orderBy: q => q.OrderBy(x => x.Name),
                        pageNumber: _currentPage,
                        pageSize: PageSize);

                var matchedNamespaceIds = modules.Select(x => x.NamespaceId).Distinct().ToList();

                _namespaces = matchedNamespaceIds.Count == 0
                    ? new List<NamespaceMetadata>()
                    : await namespaceRepository.ListMetadata(
                        OrganizationId,
                        q => q.Where(x => matchedNamespaceIds.Contains(x.Id)),
                        orderBy: q => q.OrderBy(x => x.Name));

                foreach (var ns in _namespaces)
                    _expandedNamespaces.Add(ns.Id);
            }

            _totalPages = (int)Math.Ceiling(_matchCount / (double)PageSize);
        }
        else
        {
            // No search terms, use normal pagination
            var totalCount = await namespaceRepository.Count(OrganizationId, q => q.Where(x => x.StackId == StackId));
            _totalPages = (int)Math.Ceiling(totalCount / (double)PageSize);

            var namespaces = await namespaceRepository.ListMetadata(
                OrganizationId,
                q => q.Where(ns => ns.StackId == StackId),
                orderBy: q => q.OrderBy(ns => ns.Name),
                pageNumber: _currentPage,
                pageSize: PageSize
            );
            _namespaces = namespaces.OrderBy(ns => ns.Name).ToList();
        }
    }


    public void TriggerStateHasChanged()
    {
        StateHasChanged();
    }


    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
    }

    private async Task HandlePageChanged(int newPage)
    {
        _currentPage = newPage;
        await LoadNamespaces(false);
    }

    private MarkupString GetHighlightedNamespaceName(string namespaceName)
    {
        if (!SearchTerms.Any())
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(namespaceName));

        var highlightedName = System.Web.HttpUtility.HtmlEncode(namespaceName);

        foreach (var term in SearchTerms.OrderByDescending(t => t.Length))
        {
            var escapedTerm = System.Text.RegularExpressions.Regex.Escape(term);
            highlightedName = System.Text.RegularExpressions.Regex.Replace(
                highlightedName,
                escapedTerm,
                match => $"<mark class=\"search-highlight\">{match.Value}</mark>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }

        return new MarkupString(highlightedName);
    }

    private async Task OnNamespaceSelectionChanged(Guid namespaceId, bool isSelected)
    {
        if (isSelected)
        {
            _selectedNamespaces.Add(namespaceId);
        }
        else
        {
            _selectedNamespaces.Remove(namespaceId);
        }

        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(_selectedNamespaces);
        }
    }

    public List<NamespaceMetadata> GetSelectedNamespaces()
    {
        return _namespaces?.Where(n => _selectedNamespaces.Contains(n.Id)).ToList() ?? new List<NamespaceMetadata>();
    }

    private class CachedNamespacesData
    {
        public Guid StackId { get; set; }
        public List<NamespaceMetadata>? Namespaces { get; set; }
        public int CurrentPage { get; set; }
        public int TotalPages { get; set; }
    }

}