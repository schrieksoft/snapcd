@using System.ComponentModel.DataAnnotations
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured

<MudPaper Elevation="1" Class="pa-4 my-4">
    <EditForm Model="Input" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator/>
        <MudGrid Class="d-flex flex-column gap-4">
            <MudItem xs="12">
                <MudTextField Label="SourceUrl"
                              @bind-Value="Input.SourceUrl"
                              Required="true"
                              UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "true" } })"/>
            </MudItem>

            <MudItem md="12">
                <MudTextField Label="RunnerInstanceName"
                              @bind-Value="Input.RunnerInstanceName"
                              Required="false"
                              UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "true" } })"/>
            </MudItem>


            <!-- Runner Selection -->
            <MudItem xs="12" md="12">
                <MudAutocomplete T="Runner?"
                                 Label="Runner"
                                 @bind-Value="Input.Runner"
                                 Disabled="false"
                                 Required="true"
                                 RequiredError="Runner is required"
                                 SearchFunc="@SearchRunners"
                                 ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 Variant="Variant.Outlined">
                </MudAutocomplete>
            </MudItem>

            <MudItem xs="12" class="d-flex justify-end gap-2">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Secondary">
                    Create
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private SourceRefresherPreselectionSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private RunnerSecuredRepositoryFactory RunnerRepoFactory { get; set; } = null!;

    private InputModel Input { get; set; } = new();

    private sealed class InputModel
    {
        [Display(Name = "RunnerInstanceName")]
        public string? RunnerInstanceName { get; set; }

        [Required]
        [Display(Name = "SourceUrl")]
        public string SourceUrl { get; set; } = string.Empty;

        [Required]
        [Display(Name = "RunnerId")]
        public Runner Runner { get; set; } = new();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            using var repo = RepoFactory.Create();
            var sourceRefresherPreselection = new SourceRefresherPreselection
            {
                Id = Guid.NewGuid(),
                RunnerId = Input.Runner.Id,
                RunnerInstanceName = Input.RunnerInstanceName,
                SourceUrl = Input.SourceUrl,
                OrganizationId = OrganizationId
            };


            await repo.Create(sourceRefresherPreselection);
            Snackbar.Add("SourceRefresherPreselection created successfully", Severity.Success);
            await OnCreated.InvokeAsync(sourceRefresherPreselection.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating sourceRefresherPreselection: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<Runner>> SearchRunners(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<Runner>();

        using var repo = RunnerRepoFactory.Create();
        return await repo.List<Runner>(OrganizationId, q => q.Where(s => s.Name.Contains(value)));
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

}