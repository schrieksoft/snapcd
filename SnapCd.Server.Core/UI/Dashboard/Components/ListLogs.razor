@implements IAsyncDisposable

@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@using AnsiConsoleToHtml
@using SnapCd.Contracts.Dto.Misc
@using Microsoft.Extensions.Options
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Settings
@inject LogService LogService
@inject IOptions<JobLogSettings> JobLogSettings
@inject NavigationManager NavigationManager
@inject IJSRuntime JS



@* <MudTooltip Text="Refresh"> *@
@*     <MudIconButton Icon="@SnapCdIcons.Refresh" Color="MudBlazor.Color.Primary" Size="Size.Medium" *@
@*                    OnClick="() => ReloadLogs()"/> *@
@* </MudTooltip> *@

@if (!_loaded)
{
    <p><em>Loading logs...</em></p>
}
else if (_tasks.Count == 0)
{
    <p><em>No logs yet.</em></p>
}
else
{
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
        <MudTooltip Text="Download all logs as text">
            <MudIconButton Icon="@SnapCdIcons.Download"
                           Size="Size.Small"
                           OnClick="() => DownloadText(null)"/>
        </MudTooltip>
        <MudTooltip Text="Download all logs as JSON">
            <MudIconButton Icon="@SnapCdIcons.Code"
                           Size="Size.Small"
                           OnClick="() => DownloadJson(null)"/>
        </MudTooltip>
    </MudStack>

    <MudExpansionPanels>


        @foreach (var taskName in _tasks.Where(Matches))
        {
            var task = taskName;
            <MudExpansionPanel @key="task"
                               Expanded="@(task == _expandedTask)"
                               ExpandedChanged="@(isExpanded => OnTaskPanelExpanded(isExpanded, task))">
                <TitleContent>
                    @if (OriginOf(task) is { } origin)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">@BareTask(task)</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Source:</MudText>
                            <MudLink Href="@($"/Module/{origin.StackName}/{origin.NamespaceName}/{origin.ModuleName}")"
                                     Typo="Typo.body2"
                                     Style="font-family: var(--snap-font-mono);"
                                     @onclick:stopPropagation="true">
                                @origin.NamespaceName/@origin.ModuleName
                            </MudLink>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@task</MudText>
                    }
                </TitleContent>
                <ChildContent>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudTooltip Text="@($"Download {task} as text")">
                            <MudIconButton Icon="@SnapCdIcons.Download"
                                           Size="Size.Small"
                                           OnClick="@(() => DownloadText(task))"/>
                        </MudTooltip>
                        <MudTooltip Text="@($"Download {task} as JSON")">
                            <MudIconButton Icon="@SnapCdIcons.Code"
                                           Size="Size.Small"
                                           OnClick="@(() => DownloadJson(task))"/>
                        </MudTooltip>
                    </MudStack>
                    @if (IsHiddenAsLarge(task))
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">
                            These logs are very large (@FormatSize(TaskBytes(task))). Consider downloading them instead of viewing them here.
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="MudBlazor.Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="@(() => Reveal(task))"
                                   Class="mb-2">
                            Show logs
                        </MudButton>
                    }
                    else
                    {
                        @if (HasOlderFor(task))
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="MudBlazor.Color.Secondary"
                                       Size="Size.Small"
                                       OnClick="LoadMoreLogs"
                                       Class="mb-2">
                                Load more logs
                            </MudButton>
                        }
                        @* No whitespace between the tags and the content: white-space: pre-wrap renders
                           the surrounding newlines as blank lines above and below the log. *@
                        <div
                            style="padding: 1em; background: #000000; color: white; font-family: monospace; white-space: pre-wrap;">@((MarkupString)(_htmlLogs.GetValueOrDefault(task) ?? string.Empty))</div>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }

    </MudExpansionPanels>
}

@code {
    [Parameter] public Guid ModuleJobId { get; set; }
    [Parameter] public string? InitialTask { get; set; }
    [Parameter] public string[]? TaskFilter { get; set; }

    /// <summary>
    /// Also keep a group whose name starts with a filtered task's, which is how a log key
    /// qualified by a correlation reads: "Probe (ProbeWave 4f2...)" for the bare task "Probe".
    /// </summary>
    [Parameter] public bool IncludeCorrelated { get; set; }

    /// <summary>Narrows the logs to one Module, for a job that two Modules share.</summary>
    [Parameter] public Guid? ModuleId { get; set; }
    [Parameter] public EventCallback<string?> OnTaskChanged { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    private readonly SemaphoreSlim _loadLock = new(1, 1);
    private bool _loaded;
    private List<LogChunkSummary> _summaries = [];
    private readonly SortedDictionary<long, List<LogEntryDto>> _chunks = new();
    private readonly List<string> _tasks = [];
    private readonly Dictionary<string, string> _htmlLogs = new();
    private readonly HashSet<string> _revealed = [];
    private string? _expandedTask;
    private string? _previousInitialTask;
    private bool _initializing;

    protected override void OnInitialized()
    {
        _expandedTask = InitialTask;
        _previousInitialTask = InitialTask;
    }

    protected override void OnParametersSet()
    {
        if (InitialTask != _previousInitialTask)
        {
            _previousInitialTask = InitialTask;
            _expandedTask = InitialTask;
        }
    }

    private async Task OnTaskPanelExpanded(bool isExpanded, string taskKey)
    {
        if (isExpanded)
        {
            if (_expandedTask == taskKey) return;
            _expandedTask = taskKey;
            await OnTaskChanged.InvokeAsync(taskKey);
        }
        else
        {
            if (_expandedTask != taskKey) return;
            _expandedTask = null;
            await OnTaskChanged.InvokeAsync(null);
        }
    }

    private string ConvertToWrappedHtml(string ansiText)
    {
        int CountOccurrences(string source, string substring)
        {
            var count = 0;
            var index = 0;

            while ((index = source.IndexOf(substring, index, StringComparison.Ordinal)) != -1)
            {
                index += substring.Length;
                count++;
            }

            return count;
        }

        var html = AnsiConsole.ToHtml(ansiText.Trim('\r', '\n'));

        // replace <pre> with <div>, since otherwise lines will not wrap properly
        const string preOpenTag = "<pre style='color:#FFFFFF;background:#000000'>";
        const string preCloseTag = "</pre>";

        const string divOpenTag = "<div style='color:#FFFFFF;background:#000000'>";
        const string divCloseTag = "</div>";

        // The converter puts a newline immediately inside its opening and closing tags. Under
        // white-space: pre-wrap those render as blank lines above and below the log.
        html = html.Replace(preOpenTag + "\n", preOpenTag).Replace("\n" + preCloseTag, preCloseTag);

        // Verify we have matching tags
        var openCount = CountOccurrences(html, preOpenTag);
        var closeCount = CountOccurrences(html, preCloseTag);

        if (openCount == 1 && closeCount == 1)
        {
            // Simple case - single pre tag
            html = html.Replace(preOpenTag, divOpenTag)
                .Replace(preCloseTag, divCloseTag);
        }
        else if (closeCount > 0)
        {
            // Complex case - replace only last closing tag
            var lastClosePos = html.LastIndexOf(preCloseTag, StringComparison.Ordinal);
            html = html.Remove(lastClosePos, preCloseTag.Length)
                .Insert(lastClosePos, divCloseTag);

            // Replace first opening tag (assuming it exists)
            var firstOpenPos = html.IndexOf(preOpenTag, StringComparison.Ordinal);
            if (firstOpenPos >= 0)
            {
                html = html.Remove(firstOpenPos, preOpenTag.Length)
                    .Insert(firstOpenPos, divOpenTag);
            }
        }

        return html;
    }

    // Terraform emits SGR colour codes; they render in the panel but are noise in a downloaded file.
    private static readonly Regex AnsiEscape = new(@"\x1B\[[0-9;]*[A-Za-z]", RegexOptions.Compiled);

    private IJSObjectReference? _downloadModule;

    private async Task<IJSObjectReference> GetDownloadModuleAsync() =>
        _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/SnapCd.Server.Core/snapcd-download.js");

    private async Task<List<LogEntryDto>> EntriesFor(string? taskName)
    {
        // A chunk is indexed by the bare task name, while a panel is keyed by that name qualified
        // by its correlation, so the chunk filter takes the part before the qualifier.
        string[]? tasks = taskName is not null ? [BareTask(taskName)] : TaskFilter;
        var summaries = await LogService.GetChunkSummaries(ModuleJobId, ModuleId);
        var sequences = summaries
            .Where(s => tasks is null || tasks.Any(s.HasTask))
            .Select(s => s.Sequence)
            .ToList();
        var entries = await LogService.ReadChunks(ModuleJobId, sequences, ModuleId);

        if (taskName is not null)
            return entries.Where(e => LogService.LogKey(e) == taskName).ToList();

        if (TaskFilter is not null)
            return entries.Where(e => Matches(LogService.LogKey(e))).ToList();

        return entries;
    }

    private string FileNameFor(string? taskName, string extension)
        => taskName is null
            ? $"job-{ModuleJobId}-logs.{extension}"
            : $"job-{ModuleJobId}-{taskName}.{extension}";

    private async Task DownloadText(string? taskName)
    {
        var entries = await EntriesFor(taskName);

        var builder = new StringBuilder();
        foreach (var entry in entries.OrderBy(e => e.Timestamp))
        {
            builder.Append(entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"))
                .Append(" [").Append(entry.TaskName ?? "Default").Append("] ")
                .AppendLine(AnsiEscape.Replace(entry.Message ?? string.Empty, string.Empty));
        }

        await Download(FileNameFor(taskName, "log"), "text/plain", builder.ToString());
    }

    private async Task DownloadJson(string? taskName)
    {
        var entries = await EntriesFor(taskName);
        var json = JsonSerializer.Serialize(entries, new JsonSerializerOptions { WriteIndented = true });

        await Download(FileNameFor(taskName, "json"), "application/json", json);
    }

    private async Task Download(string fileName, string contentType, string content)
    {
        var module = await GetDownloadModuleAsync();
        await module.InvokeVoidAsync("downloadFile", fileName, contentType, content);
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            try
            {
                await _downloadModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private long LastSequence => _summaries.Count == 0 ? -1 : _summaries[^1].Sequence;

    private long OldestLoaded => _chunks.Count == 0 ? long.MaxValue : _chunks.Keys.First();

    private IEnumerable<LogChunkSummary> Unloaded => _summaries.Where(s => s.Sequence < OldestLoaded);

    private bool HasOlderFor(string task) => Unloaded.Any(s => s.HasTask(task));

    private long TaskBytes(string task) => _summaries.Where(s => s.HasTask(task)).Sum(s => s.UncompressedBytes);

    private bool IsHiddenAsLarge(string task) =>
        !_revealed.Contains(task) && TaskBytes(task) > JobLogSettings.Value.LargeLogThresholdBytes;

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.#} MB" : $"{bytes / 1024.0:0.#} KB";

    /// <summary>The newest of <paramref name="candidates"/> that fit in one page, always at least one.</summary>
    private List<long> NewestPage(IEnumerable<LogChunkSummary> candidates)
    {
        var page = new List<long>();
        long bytes = 0;
        foreach (var summary in candidates.OrderByDescending(s => s.Sequence))
        {
            if (page.Count > 0 && bytes + summary.UncompressedBytes > JobLogSettings.Value.PageBytes)
                break;
            page.Add(summary.Sequence);
            bytes += summary.UncompressedBytes;
        }

        return page;
    }

    private async Task Load(IReadOnlyCollection<long> sequences)
    {
        if (sequences.Count == 0)
            return;

        var entries = await LogService.ReadChunks(ModuleJobId, sequences, ModuleId);

        // A page is contiguous and older or newer than everything loaded, so its lines file under its lowest sequence.
        foreach (var sequence in sequences)
            _chunks[sequence] = [];
        _chunks[sequences.Min()] = entries;

        RenderTasks(entries.Select(LogService.LogKey).Distinct());
        SortTasks();
        await LoadWaveOrigins();
    }

    private Dictionary<Guid, ProbeWaveOrigin> _waveOrigins = new();

    /// <summary>Where the wave a correlated task belongs to started, once that has been looked up.</summary>
    private ProbeWaveOrigin? OriginOf(string task)
    {
        var open = task.IndexOf(" (", StringComparison.Ordinal);
        if (open < 0 || !task.EndsWith(')')) return null;

        var inner = task[(open + 2)..^1];
        var space = inner.LastIndexOf(' ');
        if (space < 0) return null;

        return Guid.TryParse(inner[(space + 1)..], out var waveId)
               && _waveOrigins.TryGetValue(waveId, out var origin)
            ? origin
            : null;
    }

    /// <summary>
    /// A wave's id means nothing to a reader, so each correlated task is named by the Module whose
    /// change started it.
    /// </summary>
    private async Task LoadWaveOrigins()
    {
        var waveIds = _tasks
            .Select(t =>
            {
                var open = t.IndexOf(" (", StringComparison.Ordinal);
                if (open < 0 || !t.EndsWith(')')) return (Guid?)null;
                var inner = t[(open + 2)..^1];
                var space = inner.LastIndexOf(' ');
                return space >= 0 && Guid.TryParse(inner[(space + 1)..], out var id) ? id : null;
            })
            .Where(id => id is not null)
            .Select(id => id!.Value)
            .Where(id => !_waveOrigins.ContainsKey(id))
            .Distinct()
            .ToList();

        if (waveIds.Count == 0) return;

        foreach (var (id, origin) in await LogService.ProbeWaveOrigins(waveIds, OrganizationId))
            _waveOrigins[id] = origin;
    }

    private static string BareTask(string key)
    {
        var qualifier = key.IndexOf(" (", StringComparison.Ordinal);
        return qualifier < 0 ? key : key[..qualifier];
    }

    /// <summary>Whether a task name, or a log key built from one, is in scope for this list.</summary>
    private bool Matches(string name)
    {
        if (TaskFilter is null) return true;
        if (TaskFilter.Contains(name)) return true;

        return IncludeCorrelated && TaskFilter.Any(t => name.StartsWith($"{t} (", StringComparison.Ordinal));
    }

    private void RenderTasks(IEnumerable<string> tasks)
    {
        foreach (var task in tasks)
        {
            if (!_tasks.Contains(task))
                InsertTask(task);

            var text = string.Join(Environment.NewLine, LogService.InWrittenOrder(_chunks.Values
                    .SelectMany(lines => lines)
                    .Where(e => LogService.LogKey(e) == task))
                .Select(e => e.Message));

            _htmlLogs[task] = string.IsNullOrEmpty(text) ? string.Empty : ConvertToWrappedHtml(text);
        }
    }

    /// <summary>
    /// Panels follow the order the steps wrote their first log line, taken from the chunk index
    /// rather than from the order lines happen to be paged in. A chunk is indexed by the bare task
    /// name, so every correlation of one step sorts to that step's position and the correlations
    /// then follow each other in the order their lines first appear.
    /// </summary>
    private void SortTasks()
    {
        var firstSequence = new Dictionary<string, long>();

        foreach (var summary in _summaries.OrderBy(s => s.Sequence))
        foreach (var name in summary.TaskNames ?? [])
            if (!firstSequence.ContainsKey(name))
                firstSequence[name] = summary.Sequence;

        var seen = _tasks.Select((task, index) => (task, index))
            .ToDictionary(x => x.task, x => x.index);

        _tasks.Sort((left, right) =>
        {
            var byStep = Sequence(left).CompareTo(Sequence(right));
            return byStep != 0 ? byStep : seen[left].CompareTo(seen[right]);
        });

        return;

        long Sequence(string task) =>
            firstSequence.TryGetValue(BareTask(task), out var sequence) ? sequence : long.MaxValue;
    }

    /// <summary>
    /// A chunk is indexed by the bare task name, so a correlated step is first seeded from the
    /// index under that name and only becomes several once its lines are read. The bare name is
    /// dropped as soon as a correlation of it appears, or it would show as an empty panel.
    /// </summary>
    private void InsertTask(string task)
    {
        _tasks.Add(task);

        var bare = BareTask(task);
        if (bare == task) return;

        _tasks.Remove(bare);
        _htmlLogs.Remove(bare);
    }

    private void AddKnownTasks()
    {
        foreach (var task in _summaries.SelectMany(s => s.TaskNames ?? []))
            if (!_tasks.Contains(task))
                _tasks.Add(task);
    }

    private async Task ReloadLogs()
    {
        await _loadLock.WaitAsync();
        try
        {
            if (!_loaded)
            {
                _summaries = await LogService.GetChunkSummaries(ModuleJobId, ModuleId);
                AddKnownTasks();
                SortTasks();
                await Load(NewestPage(_summaries));
                _loaded = true;
                return;
            }

            var added = await LogService.GetChunkSummaries(ModuleJobId, ModuleId, LastSequence);
            if (added.Count == 0)
                return;

            _summaries.AddRange(added);
            AddKnownTasks();
            await Load(added.Select(s => s.Sequence).ToList());
        }
        finally
        {
            _loadLock.Release();
        }
    }

    private async Task LoadMoreLogs()
    {
        await _loadLock.WaitAsync();
        try
        {
            await Load(NewestPage(Unloaded));
        }
        finally
        {
            _loadLock.Release();
        }
    }

    private void Reveal(string task) => _revealed.Add(task);

    public async Task RefreshLogs(bool invokeAsync = false)
    {
        await ReloadLogs();
        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }

    public async Task InitializeLogs()
    {
        if (_loaded) return;

        await ReloadLogs();
        StateHasChanged();
    }

}