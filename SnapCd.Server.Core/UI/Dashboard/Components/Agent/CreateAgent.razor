@using System.ComponentModel.DataAnnotations
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.UI.Dashboard.Helpers
@using SnapCd.Server.Core.Views

<MudPaper Elevation="1" Class="pa-4 my-4">
    @if (!_canCreate)
    {
        <ReadOnlyNotice Message="You do not have permission to create an Agent."/>
    }
    <EditForm Model="Input" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator/>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect Disabled="@(!_canCreate)" T="Guid?" Label="Service Principal" @bind-Value="Input.ServicePrincipalId"
                           Variant="Variant.Outlined" Required="true" RequiredError="Service Principal is required">
                    @foreach (var sp in _availableServicePrincipals)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)sp.Id)">@sp.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Disabled="@(!_canCreate)" Label="Agent Name"
                              @bind-Value="Input.Name"
                              Required="true"
                              UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "true" } })"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch Disabled="@(!_canCreate)" T="bool" @bind-Value="Input.AllowMultipleInstances" Label="Allow Multiple Instances"
                           Color="Color.Secondary"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch Disabled="@(!_canCreate)" T="bool" @bind-Value="Input.IsSuppliedToAllModules" Label="Supplied to all Modules (org-wide supply)"
                           Color="Color.Secondary"/>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-2">
                @if (_canCreate)
                {
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small">
                        Create
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private AgentSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ServicePrincipalSecuredRepositoryFactory ServicePrincipalRepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private bool _canCreate = true;

    protected override void OnParametersSet()
    {
        using var permissionRepo = RepoFactory.Create();
        _canCreate = permissionRepo.CanCreate(OrganizationId, OrganizationId);
    }

    private InputModel Input { get; set; } = new();
    private List<ServicePrincipalMetadata> _availableServicePrincipals = new();

    protected override async Task OnInitializedAsync()
    {
        using var spRepo = ServicePrincipalRepoFactory.Create();
        _availableServicePrincipals = await spRepo.ListMetadata(OrganizationId,
            orderBy: q => q.OrderBy(x => x.ClientId));
    }

    private sealed class InputModel
    {
        [Required] [Display(Name = "Service Principal")] public Guid? ServicePrincipalId { get; set; }

        [Required] [Display(Name = "Name")] public string Name { get; set; } = string.Empty;

        [Required]
        [Display(Name = "AllowMultipleInstances")]
        public bool AllowMultipleInstances { get; set; }

        [Required]
        [Display(Name = "IsSuppliedToAllModules")]
        public bool IsSuppliedToAllModules { get; set; }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            using var repo = RepoFactory.Create();
            var agent = new Agent
            {
                Id = Guid.NewGuid(),
                ServicePrincipalId = Input.ServicePrincipalId!.Value,
                Name = Input.Name,
                AllowMultipleInstances = Input.AllowMultipleInstances,
                IsSuppliedToAllModules = Input.IsSuppliedToAllModules,
                IsDisabled = false,
                OrganizationId = OrganizationId
            };

            await repo.Create(agent);
            Snackbar.Add("Agent created successfully", Severity.Success);
            await OnCreated.InvokeAsync(agent.Id);
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "creating agent");
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

}
