@using System.ComponentModel.DataAnnotations
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.UI.Dashboard.Helpers

<MudPaper Elevation="1" Class="pa-4 my-4">
    <EditForm Model="Input" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator/>
        <MudGrid Class="d-flex flex-column gap-4">
            <MudItem xs="12">
                <MudTextField Label="Agent Id"
                              @bind-Value="Agent.Id"
                              Disabled="true"/>
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="Guid" Label="Service Principal" @bind-Value="Input.ServicePrincipalId"
                           Variant="Variant.Outlined" Required="true" RequiredError="Service Principal is required">
                    @foreach (var sp in _availableServicePrincipals)
                    {
                        <MudSelectItem Value="@sp.Id">@sp.DisplayName (@sp.DisplayClientId)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Agent Name"
                              @bind-Value="Input.Name"
                              Required="true"
                              UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "true" } })"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" Value="Input.AllowMultipleInstances"
                           ValueChanged="AllowMultipleInstancesChanged" Label="Allow Multiple Instances"
                           Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" Value="Input.IsAssignedToAllModules"
                           ValueChanged="IsAssignedToAllModulesChanged" Label="Assigned to all Modules (org-wide supply)"
                           Color="Color.Info"/>
            </MudItem>

            <MudItem xs="12" class="d-flex justify-end gap-2">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Style="background-color: #000; color: #fff;">
                    Save
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Style="background-color: #000; color: #fff;"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public required Agent Agent { get; set; }
    [Parameter] public required EventCallback<Agent> OnSaved { get; set; }
    [Parameter] public required EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private AgentSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ServicePrincipalSecuredRepositoryFactory ServicePrincipalRepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private InputModel Input { get; set; } = new();
    private List<ServicePrincipal> _availableServicePrincipals = new();

    protected override async Task OnInitializedAsync()
    {
        using var spRepo = ServicePrincipalRepoFactory.Create();
        _availableServicePrincipals = await spRepo.List(OrganizationId);
    }

    protected override void OnParametersSet()
    {
        Input = new InputModel
        {
            ServicePrincipalId = Agent.ServicePrincipalId,
            Name = Agent.Name,
            AllowMultipleInstances = Agent.AllowMultipleInstances,
            IsAssignedToAllModules = Agent.IsAssignedToAllModules
        };
    }

    private sealed class InputModel
    {
        [Required] [Display(Name = "Service Principal")] public Guid ServicePrincipalId { get; set; }

        [Required] [Display(Name = "Name")] public string Name { get; set; } = string.Empty;

        [Required]
        [Display(Name = "AllowMultipleInstances")]
        public bool AllowMultipleInstances { get; set; }

        [Required]
        [Display(Name = "IsAssignedToAllModules")]
        public bool IsAssignedToAllModules { get; set; }
    }

    private void AllowMultipleInstancesChanged()
    {
        Input.AllowMultipleInstances = !Input.AllowMultipleInstances;
        StateHasChanged();
    }

    private void IsAssignedToAllModulesChanged()
    {
        Input.IsAssignedToAllModules = !Input.IsAssignedToAllModules;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            using var repo = RepoFactory.Create();
            Agent.ServicePrincipalId = Input.ServicePrincipalId;
            Agent.Name = Input.Name;
            Agent.AllowMultipleInstances = Input.AllowMultipleInstances;
            Agent.IsAssignedToAllModules = Input.IsAssignedToAllModules;
            await repo.Update(Agent);
            Snackbar.Add("Agent updated successfully", Severity.Success);
            await OnSaved.InvokeAsync(Agent);
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "updating agent");
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

}
