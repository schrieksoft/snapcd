@using System.ComponentModel.DataAnnotations
@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.Missions
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.UI.Dashboard.Helpers

@implements IDisposable

@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h6" GutterBottom="true">Missions</MudText>

    <MudTabs Outlined="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="Organization" Style="text-transform: none">
            @if (!_showCreateForm && _editing is null)
            {
                <MudButton Variant="Variant.Filled" Style="background-color: #000; color: #fff;"
                           OnClick="ShowCreate" Class="mb-3">
                    Add Mission
                </MudButton>
            }

            @if (_showCreateForm || _editing is not null)
            {
                <EditForm Model="Input" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator/>
                    <MudGrid Class="d-flex flex-column gap-3">
                        <MudItem xs="12">
                            <MudSelect T="MissionType" @bind-Value="Input.MissionType"
                                       Label="Mission Type" Variant="Variant.Outlined" Required="true">
                                @foreach (var type in Enum.GetValues<MissionType>())
                                {
                                    <MudSelectItem Value="@type">@type.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Sidecar (optional)" @bind-Value="Input.SidecarName"
                                          Variant="Variant.Outlined" MaxLength="64"/>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSwitch T="bool" @bind-Value="Input.IsDisabled" Label="Disabled" Color="Color.Info"/>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end gap-2">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                       Style="background-color: #000; color: #fff;">
                                @(_editing is null ? "Create" : "Save")
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Style="background-color: #000; color: #fff;"
                                       OnClick="CancelEdit">
                                Cancel
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            }

            @if (_orgRows.Count == 0)
            {
                <MudText Typo="Typo.body2">No organization missions configured for this Agent.</MudText>
            }
            else
            {
                <AgentGroupedMissions TRow="OrganizationMission"
                                      Rows="_orgRows"
                                      AgentIdSelector="@(r => r.AgentId)"
                                      MissionTypeSelector="@(r => r.MissionType.ToString())"
                                      IsDisabledSelector="@(r => r.IsDisabled)"
                                      SidecarNameSelector="@(r => r.SidecarName)"
                                      AgentNameLookup="@LookupAgentName"
                                      OrganizationId="OrganizationId"
                                      Scope="AgentAssignmentBadge.AssignmentScope.Organization"
                                      OnEdit="BeginEdit"
                                      OnDelete="DeleteRow"/>
            }
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    [Parameter] public required Guid AgentId { get; set; }
    [Parameter] public string? AgentName { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private OrganizationMissionSecuredRepositoryFactory OrgMissionRepoFactory { get; set; } = null!;

    private sealed class InputModel
    {
        public MissionType MissionType { get; set; } = MissionType.AutoDiagnose;
        [MaxLength(64)] public string? SidecarName { get; set; }
        public bool IsDisabled { get; set; }
    }

    private InputModel Input { get; set; } = new();
    private OrganizationMission? _editing;
    private bool _showCreateForm;
    private List<OrganizationMission> _orgRows = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadRows();
    }

    private async Task ReloadRows()
    {
        using var repo = OrgMissionRepoFactory.Create();
        _orgRows = (await repo.ListByAgent(AgentId, OrganizationId))
            .OrderBy(m => m.MissionType).ToList();
    }

    private void ShowCreate()
    {
        _showCreateForm = true;
        _editing = null;
        Input = new InputModel();
    }

    private void BeginEdit(OrganizationMission row)
    {
        _editing = row;
        _showCreateForm = false;
        Input = new InputModel
        {
            MissionType = row.MissionType,
            SidecarName = row.SidecarName,
            IsDisabled = row.IsDisabled
        };
    }

    private void CancelEdit()
    {
        _showCreateForm = false;
        _editing = null;
        Input = new InputModel();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (_editing is null)
                await CreateNew();
            else
                await UpdateExisting(_editing);

            _editing = null;
            _showCreateForm = false;
            Input = new InputModel();
            await ReloadRows();
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, _editing is null ? "creating mission" : "updating mission");
        }
    }

    private async Task CreateNew()
    {
        using var repo = OrgMissionRepoFactory.Create();
        await repo.Create(new OrganizationMission
        {
            Id = Guid.NewGuid(),
            OrganizationId = OrganizationId,
            AgentId = AgentId,
            MissionType = Input.MissionType,
            SidecarName = string.IsNullOrWhiteSpace(Input.SidecarName) ? null : Input.SidecarName,
            IsDisabled = Input.IsDisabled
        });
        Snackbar.Add("Mission created", Severity.Success);
    }

    private async Task UpdateExisting(OrganizationMission row)
    {
        using var repo = OrgMissionRepoFactory.Create();
        var existing = await repo.Get(row.Id, OrganizationId);
        existing.MissionType = Input.MissionType;
        existing.SidecarName = string.IsNullOrWhiteSpace(Input.SidecarName) ? null : Input.SidecarName;
        existing.IsDisabled = Input.IsDisabled;
        await repo.Update(existing);
        Snackbar.Add("Mission updated", Severity.Success);
    }

    private async Task DeleteRow(OrganizationMission row)
    {
        try
        {
            using var repo = OrgMissionRepoFactory.Create();
            await repo.Delete(row.Id, OrganizationId);
            Snackbar.Add("Mission deleted", Severity.Success);
            await ReloadRows();
        }
        catch (Exception ex)
        {
            ExceptionHandler.HandleException(Snackbar, ex, "deleting mission");
        }
    }

    private string LookupAgentName(Guid id) => id == AgentId ? (AgentName ?? id.ToString()) : id.ToString();

    public void Dispose()
    {
    }
}
