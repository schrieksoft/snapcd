@typeparam TRow

@foreach (var group in Rows
    .GroupBy(AgentIdSelector)
    .OrderBy(g => AgentNameLookup(g.Key), StringComparer.OrdinalIgnoreCase))
{
    <div class="mb-3">
        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 4px;">
            <MudText Typo="Typo.body1"><strong>Agent: @AgentNameLookup(group.Key)</strong></MudText>
            <AgentOnlineBadge AgentId="group.Key" OrganizationId="OrganizationId" />
            @if (Scope == AgentSupplyBadge.SupplyScope.Organization)
            {
                <AgentSupplyBadge AgentId="group.Key" OrganizationId="OrganizationId"
                                      Scope="AgentSupplyBadge.SupplyScope.Organization" />
            }
            else if (ScopeId is { } sid)
            {
                <AgentSupplyBadge AgentId="group.Key" OrganizationId="OrganizationId"
                                      Scope="Scope" ScopeId="sid" />
            }
        </div>
        <MudTable Items="group.OrderBy(MissionTypeSelector).ToList()" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Mission Type</MudTh>
                <MudTh>Sidecar</MudTh>
                <MudTh>Disabled</MudTh>
                @if (OnEdit.HasDelegate || OnDelete.HasDelegate)
                {
                    <MudTh></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd>@MissionTypeSelector(context)</MudTd>
                <MudTd>@(SidecarNameSelector?.Invoke(context) ?? string.Empty)</MudTd>
                <MudTd>@(IsDisabledSelector(context) ? "yes" : "no")</MudTd>
                @if (OnEdit.HasDelegate || OnDelete.HasDelegate)
                {
                    <MudTd>
                        @if (OnEdit.HasDelegate)
                        {
                            <MudIconButton Icon="@SnapCdIcons.Edit" Size="Size.Small"
                                           OnClick="@(() => OnEdit.InvokeAsync(context))"/>
                        }
                        @if (OnDelete.HasDelegate)
                        {
                            <MudIconButton Icon="@SnapCdIcons.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => OnDelete.InvokeAsync(context))"/>
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    </div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<TRow> Rows { get; set; } = Array.Empty<TRow>();
    [Parameter, EditorRequired] public Func<TRow, Guid> AgentIdSelector { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TRow, string> MissionTypeSelector { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TRow, bool> IsDisabledSelector { get; set; } = null!;
    [Parameter] public Func<TRow, string?>? SidecarNameSelector { get; set; }
    [Parameter, EditorRequired] public Func<Guid, string> AgentNameLookup { get; set; } = null!;
    [Parameter, EditorRequired] public Guid OrganizationId { get; set; }
    [Parameter, EditorRequired] public AgentSupplyBadge.SupplyScope Scope { get; set; }
    /// <summary>Required for Stack/Namespace/Module scopes; ignored for Organization scope.</summary>
    [Parameter] public Guid? ScopeId { get; set; }
    [Parameter] public EventCallback<TRow> OnEdit { get; set; }
    [Parameter] public EventCallback<TRow> OnDelete { get; set; }
}
