@using SnapCd.Server.Core.Entities.Definition.Secrets.Scoped
@using SnapCd.Server.Core.Repositories.Organizations.Secured.Secrets.Scoped
@using SnapCd.Server.Core.Services.Crud.Secrets
@using SnapCd.Server.Core.Services.PrincipalProvider
<MudForm @ref="_form">
    <MudGrid Class="pa-4">
        <!-- Core Properties -->
        <MudItem md="12">
            <MudTextField Label="Name" @bind-Value="_newSecret.Name"
                          Variant="Variant.Outlined" Required RequiredError="Name is required"
                          MaxLength="255" Counter="255"/>
        </MudItem>

        <!-- Remote Secret Value -->
        <MudItem md="12">
            <MudTextField Label="Secret Value" @bind-Value="_secretValue"
                          Variant="Variant.Outlined" Required RequiredError="Secret value is required"
                          InputType="@_passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"/>
        </MudItem>

        <!-- Action Buttons -->
        <MudItem md="12">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveSecret" Disabled="_isSaving">
                Create
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2" OnClick="Cancel"
                       Disabled="_isSaving">Cancel
            </MudButton>
        </MudItem>
    </MudGrid>
</MudForm>


@code {
    [Parameter] public Guid ModuleId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private ModuleSecretSecuredRepositoryFactory SecretRepoFactory { get; set; } = null!;
    [Inject] private SecretServiceFactory SecretServiceFactory { get; set; } = null!;

    private MudForm? _form;
    private ModuleSecret _newSecret = new();
    private string _secretValue = string.Empty;
    private bool _isSaving = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordInputIcon = SnapCdIcons.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        InitializeNewSecret();
    }

    private void InitializeNewSecret()
    {
        _newSecret = new ModuleSecret
        {
            ModuleId = ModuleId,
            OrganizationId = OrganizationId,
            Id = Guid.NewGuid()
        };
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordInputType == InputType.Password)
        {
            _passwordInputType = InputType.Text;
            _passwordInputIcon = SnapCdIcons.Visibility;
        }
        else
        {
            _passwordInputType = InputType.Password;
            _passwordInputIcon = SnapCdIcons.VisibilityOff;
        }
    }

    private async Task SaveSecret()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        _isSaving = true;
        try
        {
            // Set the remote secret value in Key Vault
            using var secretService = SecretServiceFactory.Create(PrincipalProvider);
            await secretService.Create(_newSecret, OrganizationId, _secretValue);

            Snackbar.Add("Secret created successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating secret: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task Cancel()
    {
        InitializeNewSecret();
        _secretValue = string.Empty;
        await OnCancel.InvokeAsync();
    }

}