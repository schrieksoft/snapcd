            @* </MudItem> *@


            @* <!-- Cache Settings --> *@
            @* <MudItem md="12"> *@
            @*     <MudSwitch T="bool" @bind-Value="Module.ProviderCacheEnabled" Label="Provider Cache Enabled" Color="Color.Info"/> *@
            @* </MudItem> *@
            @* <MudItem md="12"> *@
            @*     <MudSwitch T="bool" @bind-Value="Module.ModuleCacheEnabled" Label="Module Cache Enabled" Color="Color.Info"/> *@
            @* </MudItem> *@

            <EeApprovalFieldsModule
                ApplyApprovalThreshold="@Module.ApplyApprovalThreshold"
                ApplyApprovalThresholdChanged="@(v => Module.ApplyApprovalThreshold = v)"
                DestroyApprovalThreshold="@Module.DestroyApprovalThreshold"
                DestroyApprovalThresholdChanged="@(v => Module.DestroyApprovalThreshold = v)"
                ApprovalTimeoutMinutes="@Module.ApprovalTimeoutMinutes"
                ApprovalTimeoutMinutesChanged="@(v => Module.ApprovalTimeoutMinutes = v)"/>

            <MudItem md="12">
                <MudSelect T="WaitForApplyDependencies" Label="Wait For Apply Dependencies"
                           @bind-Value="Module.WaitForApplyDependencies"
                           Variant="Variant.Outlined" Required="true"
                           RequiredError="Wait For Apply Dependencies is required">
                    <MudSelectItem Value="WaitForApplyDependencies.Always">Always</MudSelectItem>
                    <MudSelectItem Value="WaitForApplyDependencies.Never">Never</MudSelectItem>
                    <MudSelectItem Value="WaitForApplyDependencies.OnFirstApply">On First Apply</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem md="12">
                <MudSelect T="WaitForDestroyDependencies" Label="Wait For Destroy Dependencies"
                           @bind-Value="Module.WaitForDestroyDependencies"
                           Variant="Variant.Outlined" Required="true"
                           RequiredError="Wait For Destroy Dependencies is required">
                    <MudSelectItem Value="WaitForDestroyDependencies.Always">Always</MudSelectItem>
                    <MudSelectItem Value="WaitForDestroyDependencies.Never">Never</MudSelectItem>
                </MudSelect>
            </MudItem>


            <MudItem md="12">
                <MudSwitch T="bool" @bind-Value="Module.TriggerOnDefinitionChanged"
                           Label="Trigger on Definition Changed" Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" @bind-Value="Module.TriggerOnUpstreamOutputChanged"
                           Label="Trigger on Upstream Output Changed" Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" @bind-Value="Module.TriggerOnSourceChanged" Label="Trigger on Source Changed"
                           Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" @bind-Value="Module.TriggerOnSourceChangedNotification"
                           Label="Trigger on Source Changed Notification"
                           Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" @bind-Value="Module.IgnoreNamespaceExtraFiles" Label="Ignore Namespace Extra Files"
                           Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudSwitch T="bool" @bind-Value="Module.IgnoreNamespaceFlags" Label="Ignore Namespace Flags"
                           Color="Color.Info"/>
            </MudItem>

            <MudItem md="12">
                <MudText Typo="Typo.body1">Clean Init Enabled</MudText>
                <MudRadioGroup T="bool?" @bind-Value="Module.CleanInitEnabled">
                    <MudRadio Value="@((bool?)null)" Color="Color.Primary">null</MudRadio>
                    <MudRadio Value="@((bool?)true)" Color="Color.Info">true</MudRadio>
                    <MudRadio Value="@((bool?)false)" Color="Color.Info">false</MudRadio>
                </MudRadioGroup>
            </MudItem>

            <MudItem md="12">
                <MudText Typo="Typo.body1">Drift Check Enabled</MudText>
                <MudRadioGroup T="bool?" @bind-Value="Module.DriftCheckEnabled">
                    <MudRadio Value="@((bool?)null)" Color="Color.Primary">null</MudRadio>
                    <MudRadio Value="@((bool?)true)" Color="Color.Info">true</MudRadio>
                    <MudRadio Value="@((bool?)false)" Color="Color.Info">false</MudRadio>
                </MudRadioGroup>
            </MudItem>

            <MudItem md="12">
                <MudTextField T="int?" Label="Drift Check Interval Minutes" @bind-Value="Module.DriftCheckIntervalMinutes"
                              Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Hooks -->
            <MudItem md="12">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Hooks"
                                       ExpandedChanged="async (expanded) => { if (expanded) await _hooksRef.InitializeItems(); }">
                        <EditModuleHooksList Title="Hooks"
                                             ModuleId="Module.Id"
                                             PrincipalProvider="@PrincipalProvider"
                                             @ref="_hooksRef"/>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>

            <!-- Terraform Flags -->
            <MudItem md="12">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Terraform Flags"
                                       ExpandedChanged="async (expanded) => { if (expanded) await _terraformFlagsRef.InitializeItems(); }">
                        <EditModuleTerraformFlagsList Title="Terraform Flags"
                                                      ModuleId="Module.Id"
                                                      PrincipalProvider="@PrincipalProvider"
                                                      @ref="_terraformFlagsRef"/>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>

            <MudItem md="12">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Terraform Array Flags"
                                       ExpandedChanged="async (expanded) => { if (expanded) await _terraformArrayFlagsRef.InitializeItems(); }">
                        <EditModuleTerraformArrayFlagsList Title="Terraform Array Flags"
                                                           ModuleId="Module.Id"
                                                           PrincipalProvider="@PrincipalProvider"
                                                           @ref="_terraformArrayFlagsRef"/>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>

            <!-- Pulumi Flags -->
            @if (_pulumiEnabled)
            {
                <MudItem md="12">
                    <MudExpansionPanels>
                        <MudExpansionPanel Text="Pulumi Flags"
                                           ExpandedChanged="async (expanded) => { if (expanded) await _pulumiFlagsRef.InitializeItems(); }">
                            <EditModulePulumiFlagsList Title="Pulumi Flags"
                                                       ModuleId="Module.Id"
                                                       PrincipalProvider="@PrincipalProvider"
                                                       @ref="_pulumiFlagsRef"/>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>

                <MudItem md="12">
                    <MudExpansionPanels>
                        <MudExpansionPanel Text="Pulumi Array Flags"
                                           ExpandedChanged="async (expanded) => { if (expanded) await _pulumiArrayFlagsRef.InitializeItems(); }">
                            <EditModulePulumiArrayFlagsList Title="Pulumi Array Flags"
                                                            ModuleId="Module.Id"
                                                            PrincipalProvider="@PrincipalProvider"
                                                            @ref="_pulumiArrayFlagsRef"/>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
            }

            <!-- Inputs Section -->
            <MudItem md="12">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Inputs (Parameters)"
                                       ExpandedChanged="async (opened) => { if (opened) await _envVarsDefRef!.InitializeItems(); }">
                        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                            <EditModuleInputTab TEntity="ModuleParamFromDefinition"
                                                TSecuredRepositoryFactory="ModuleInputFromDefinitionSecuredRepositoryFactory<ModuleParamFromDefinition>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Definition"
                                                SecuredRepositoryFactory="@ModuleParamFromDefinitionSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_paramsDefRef"
                                                OnTabClick="async () => await _paramsDefRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleParamFromLiteral"
                                                TSecuredRepositoryFactory="ModuleInputFromLiteralSecuredRepositoryFactory<ModuleParamFromLiteral>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Literal"
                                                SecuredRepositoryFactory="@ModuleParamFromLiteralSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_paramsLiteralRef"
                                                OnTabClick="async () => await _paramsLiteralRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleParamFromNamespace"
                                                TSecuredRepositoryFactory="ModuleInputFromNamespaceSecuredRepositoryFactory<ModuleParamFromNamespace>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Namespace"
                                                SecuredRepositoryFactory="@ModuleParamFromNamespaceSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_paramsNamespaceRef"
                                                OnTabClick="async () => await _paramsNamespaceRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleParamFromOutputSet"
                                                TSecuredRepositoryFactory="ModuleInputFromOutputSetSecuredRepositoryFactory<ModuleParamFromOutputSet>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From OutputSet"
                                                SecuredRepositoryFactory="@ModuleParamFromOutputSetSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_paramsOutputSetRef"
                                                OnTabClick="async () => await _paramsOutputSetRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleParamFromOutput"
                                                TSecuredRepositoryFactory="ModuleInputFromOutputSecuredRepositoryFactory<ModuleParamFromOutput>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Output"
                                                SecuredRepositoryFactory="@ModuleParamFromOutputSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_paramsOutputRef"
                                                OnTabClick="async () => await _paramsOutputRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleParamFromSecret"
                                                TSecuredRepositoryFactory="ModuleInputFromSecretSecuredRepositoryFactory<ModuleParamFromSecret>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Secret"
                                                SecuredRepositoryFactory="@ModuleParamFromSecretSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_paramsSecretRef"
                                                OnTabClick="async () => await _paramsSecretRef!.InitializeItems()"/>
                        </MudTabs>
                    </MudExpansionPanel>

                    <!-- Environment Variables Section -->
                    <MudExpansionPanel Text="Inputs (Environment Variables)"
                                       ExpandedChanged="async (opened) => { if (opened) await _envVarsDefRef!.InitializeItems(); }">
                        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                            <EditModuleInputTab TEntity="ModuleEnvVarFromDefinition"
                                                TSecuredRepositoryFactory="ModuleInputFromDefinitionSecuredRepositoryFactory<ModuleEnvVarFromDefinition>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Definition"
                                                SecuredRepositoryFactory="@ModuleEnvVarFromDefinitionSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_envVarsDefRef"
                                                OnTabClick="async () => await _envVarsDefRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleEnvVarFromLiteral"
                                                TSecuredRepositoryFactory="ModuleInputFromLiteralSecuredRepositoryFactory<ModuleEnvVarFromLiteral>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Literal"
                                                SecuredRepositoryFactory="@ModuleEnvVarFromLiteralSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_envVarsLiteralRef"
                                                OnTabClick="async () => await _envVarsLiteralRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleEnvVarFromNamespace"
                                                TSecuredRepositoryFactory="ModuleInputFromNamespaceSecuredRepositoryFactory<ModuleEnvVarFromNamespace>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Namespace"
                                                SecuredRepositoryFactory="@ModuleEnvVarFromNamespaceSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_envVarsNamespaceRef"
                                                OnTabClick="async () => await _envVarsNamespaceRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleEnvVarFromOutput"
                                                TSecuredRepositoryFactory="ModuleInputFromOutputSecuredRepositoryFactory<ModuleEnvVarFromOutput>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Output"
                                                SecuredRepositoryFactory="@ModuleEnvVarFromOutputSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_envVarsOutputRef"
                                                OnTabClick="async () => await _envVarsOutputRef!.InitializeItems()"/>

                            <EditModuleInputTab TEntity="ModuleEnvVarFromSecret"
                                                TSecuredRepositoryFactory="ModuleInputFromSecretSecuredRepositoryFactory<ModuleEnvVarFromSecret>"
                                                ModuleId="Module.Id"
                                                NamespaceId="Module.NamespaceId"
                                                StackId="StackId"
                                                Title="From Secret"
                                                SecuredRepositoryFactory="@ModuleEnvVarFromSecretSecuredRepositoryFactory"
                                                PrincipalProvider="@PrincipalProvider"
                                                @ref="_envVarsSecretRef"
                                                OnTabClick="async () => await _envVarsSecretRef!.InitializeItems()"/>
                        </MudTabs>
                    </MudExpansionPanel>
                </MudExpansionPanels>

            </MudItem>

            <MudItem md="12">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Extra Files"
                                       ExpandedChanged="async (expanded) => { if (expanded) await _extraFilesRef.InitializeItems(); }">
                        <EditModuleExtraFilesList Title="Extra Files"
                                                  ModuleId="Module.Id"
                                                  PrincipalProvider="@PrincipalProvider"
                                                  @ref="_extraFilesRef"/>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>

            <MudItem md="12">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Depends on Modules"
                                       ExpandedChanged="async (expanded) => { if (expanded) await _dependenciesRef.InitializeItems(); }">
                        <EditModuleDependenciesList Title="Depends on Modules"
                                                    ModuleId="Module.Id"
                                                    StackId="@StackId"
                                                    PrincipalProvider="@PrincipalProvider"
                                                    @ref="_dependenciesRef"/>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>



            <!-- Action Buttons -->
            <MudItem md="12">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveModule">Save</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="OnCancel">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public required Module Module { get; set; }
    [Parameter] public required Guid StackId { get; set; }
    [Parameter] public required EventCallback OnSaved { get; set; }
    [Parameter] public required EventCallback OnCancel { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    // Repository Factories
    [Inject] private ModuleSecuredRepositoryFactory ModuleSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromDefinitionSecuredRepositoryFactory<ModuleParamFromDefinition> ModuleParamFromDefinitionSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromLiteralSecuredRepositoryFactory<ModuleParamFromLiteral> ModuleParamFromLiteralSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromNamespaceSecuredRepositoryFactory<ModuleParamFromNamespace> ModuleParamFromNamespaceSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromOutputSetSecuredRepositoryFactory<ModuleParamFromOutputSet> ModuleParamFromOutputSetSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromOutputSecuredRepositoryFactory<ModuleParamFromOutput> ModuleParamFromOutputSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromSecretSecuredRepositoryFactory<ModuleParamFromSecret> ModuleParamFromSecretSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromDefinitionSecuredRepositoryFactory<ModuleEnvVarFromDefinition> ModuleEnvVarFromDefinitionSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromLiteralSecuredRepositoryFactory<ModuleEnvVarFromLiteral> ModuleEnvVarFromLiteralSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromNamespaceSecuredRepositoryFactory<ModuleEnvVarFromNamespace> ModuleEnvVarFromNamespaceSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromOutputSecuredRepositoryFactory<ModuleEnvVarFromOutput> ModuleEnvVarFromOutputSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private ModuleInputFromSecretSecuredRepositoryFactory<ModuleEnvVarFromSecret> ModuleEnvVarFromSecretSecuredRepositoryFactory { get; set; } = null!;

    [Inject] private RunnerSecuredRepositoryFactory RunnerSecuredRepositoryFactory { get; set; } = null!;
    [Inject] private IDbContextFactory<SnapCdDbContext> DbContextFactory { get; set; } = null!;

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    private MudForm? _form;

    private EditModuleInputTab<ModuleParamFromDefinition, ModuleInputFromDefinitionSecuredRepositoryFactory<ModuleParamFromDefinition>>? _paramsDefRef;
    private EditModuleInputTab<ModuleParamFromLiteral, ModuleInputFromLiteralSecuredRepositoryFactory<ModuleParamFromLiteral>>? _paramsLiteralRef;
    private EditModuleInputTab<ModuleParamFromSecret, ModuleInputFromSecretSecuredRepositoryFactory<ModuleParamFromSecret>>? _paramsSecretRef;
    private EditModuleInputTab<ModuleParamFromOutputSet, ModuleInputFromOutputSetSecuredRepositoryFactory<ModuleParamFromOutputSet>>? _paramsOutputSetRef;
    private EditModuleInputTab<ModuleParamFromOutput, ModuleInputFromOutputSecuredRepositoryFactory<ModuleParamFromOutput>>? _paramsOutputRef;
    private EditModuleInputTab<ModuleParamFromNamespace, ModuleInputFromNamespaceSecuredRepositoryFactory<ModuleParamFromNamespace>>? _paramsNamespaceRef;

    private EditModuleInputTab<ModuleEnvVarFromDefinition, ModuleInputFromDefinitionSecuredRepositoryFactory<ModuleEnvVarFromDefinition>>? _envVarsDefRef;
    private EditModuleInputTab<ModuleEnvVarFromLiteral, ModuleInputFromLiteralSecuredRepositoryFactory<ModuleEnvVarFromLiteral>>? _envVarsLiteralRef;
    private EditModuleInputTab<ModuleEnvVarFromSecret, ModuleInputFromSecretSecuredRepositoryFactory<ModuleEnvVarFromSecret>>? _envVarsSecretRef;
    private EditModuleInputTab<ModuleEnvVarFromOutput, ModuleInputFromOutputSecuredRepositoryFactory<ModuleEnvVarFromOutput>>? _envVarsOutputRef;
    private EditModuleInputTab<ModuleEnvVarFromNamespace, ModuleInputFromNamespaceSecuredRepositoryFactory<ModuleEnvVarFromNamespace>>? _envVarsNamespaceRef;

    private EditModuleExtraFilesList _extraFilesRef = new();
    private EditModuleHooksList _hooksRef = new();
    private EditModuleDependenciesList _dependenciesRef = new();
    private EditModuleTerraformFlagsList _terraformFlagsRef = new();
    private EditModuleTerraformArrayFlagsList _terraformArrayFlagsRef = new();
    private EditModulePulumiFlagsList _pulumiFlagsRef = new();
    private EditModulePulumiArrayFlagsList _pulumiArrayFlagsRef = new();


    private List<Runner> _availableRunners = new();
    private bool _pulumiEnabled;

    protected override async Task OnInitializedAsync()
    {
        using var runnerRepo = RunnerSecuredRepositoryFactory.Create(PrincipalProvider);
        _availableRunners = await runnerRepo.ListAssignedToModule(Module.Id, OrganizationId);

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        _pulumiEnabled = await dbContext.PreviewFeatureAcceptances
            .AnyAsync(p => p.OrganizationId == OrganizationId && p.PreviewFeature == PreviewFeature.Pulumi);
    }

    private async Task SaveModule()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid)
            {
                Snackbar.Add("Please fix validation errors", Severity.Error);
                return;
            }
        }
        else throw new Exception("Form is null");

        using var repo = ModuleSecuredRepositoryFactory.Create(PrincipalProvider);

        await repo.Update(Module);
        Snackbar.Add("Module updated successfully", Severity.Success);
        await OnSaved.InvokeAsync();
    }

