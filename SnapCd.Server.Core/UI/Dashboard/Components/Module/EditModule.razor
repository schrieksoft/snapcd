@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Components.Licensing
@implements IDisposable

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudForm @ref="_form">
        <MudGrid Class="pa-4">
            <!-- Read-only IDs -->
            <MudItem md="12">
                <MudTextField Label="Module ID" @bind-Value="Module.Id" Variant="Variant.Outlined" ReadOnly
                              Disabled="true"/>
            </MudItem>
            <MudItem md="12">
                <MudTextField Label="Namespace ID" @bind-Value="Module.NamespaceId" Variant="Variant.Outlined" ReadOnly
                              Disabled="true"/>
            </MudItem>

            <!-- Core Properties -->
            <MudItem md="12">
                <MudTextField Label="Name" @bind-Value="Module.Name"
                              Variant="Variant.Outlined" Required RequiredError="Name is required"
                              MaxLength="255" Counter="255"/>
            </MudItem>

            <MudItem md="12">
                <MudTextField Label="Source Url" @bind-Value="Module.SourceUrl" Required
                              RequiredError="Source Url is required"
                              Variant="Variant.Outlined" MaxLength="800"/>
            </MudItem>

            <MudItem md="12">
                <MudTextField Label="Source Relative Path" @bind-Value="Module.SourceSubdirectory"
                              Variant="Variant.Outlined" MaxLength="800"/>
            </MudItem>

            <MudItem md="12">
                <MudTextField Label="Source Revision" @bind-Value="Module.SourceRevision" Required
                              RequiredError="Source Revision is required"
                              Variant="Variant.Outlined" MaxLength="255"/>
            </MudItem>


            <MudItem md="12">
                <MudSelect T="Guid" Label="Runner" @bind-Value="Module.RunnerId"
                           Variant="Variant.Outlined" Required="true" RequiredError="Runner is required">
                    @foreach (var runner in _availableRunners)
                    {
                        <MudSelectItem Value="@runner.Id">@runner.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem md="12">
                <MudTextField Label="Runner Instance Name" @bind-Value="Module.RunnerInstanceName"
                              Variant="Variant.Outlined" MaxLength="255"/>
            </MudItem>

            <MudItem md="12">
                <MudSelect T="StateManagementEngine?" Label="Engine" @bind-Value="Module.Engine"
                           Variant="Variant.Outlined">
                    <MudSelectItem T="StateManagementEngine?" Value="@((StateManagementEngine?)null)">Use Namespace Default</MudSelectItem>
                    <MudSelectItem T="StateManagementEngine?" Value="@((StateManagementEngine?)StateManagementEngine.OpenTofu)">OpenTofu</MudSelectItem>
                    <MudSelectItem T="StateManagementEngine?" Value="@((StateManagementEngine?)StateManagementEngine.Terraform)">Terraform</MudSelectItem>
                    @if (_pulumiEnabled)
                    {
                        <MudSelectItem T="StateManagementEngine?" Value="@((StateManagementEngine?)StateManagementEngine.Pulumi)">Pulumi</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* *@
            @* <MudItem md="12"> *@
            @*     <MudAutocomplete T="SecretStoreDisplay?" *@
            @*                      @bind-Value="_selectedSecretStore" *@
            @*                      Label="Default Output Secret Store" *@
            @*                      SearchFunc="@SearchSecretStores" *@
            @*                      ToStringFunc="@(s => s?.FormattedName ?? string.Empty)" *@
            @*                      ResetValueOnEmptyText="true" *@
