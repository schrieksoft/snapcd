    // private async Task OnOpenedExtraFiles(
    //     ModuleExtraFileSecuredRepository securedRepository,
    //     List<ModuleExtraFile>? list)
    // {
    //     if (list.IsNullOrEmpty())
    //     {
    //         var items = await securedRepository.ListByParentId(Module.Id, OrganizationId);
    //         list = items;
    //     }
    // }

    public void Dispose()
    {
        // Add any necessary cleanup logic here
    }

}