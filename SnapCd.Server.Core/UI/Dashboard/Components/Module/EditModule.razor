            @*             <MudText>@itemTemplateContext?.FormattedName</MudText> *@
            @*             <MudText Color="Color.Info" Typo="Typo.caption"> *@
            @*                 @if (itemTemplateContext != null) *@
            @*                 { *@
            @*                     @itemTemplateContext.Id *@
            @*                 } *@
            @*             </MudText> *@
            @*         </ItemTemplate> *@
            @*         <NoItemsTemplate> *@
            @*             @if (_isSearchingSecretStore) *@
            @*             { *@
            @*                 <div class="d-flex align-center gap-2"> *@
            @*                     <MudProgressCircular Size="Size.Small" Indeterminate="true"/> *@
            @*                     <MudText>Searching secret stores...</MudText> *@
            @*                 </div> *@
            @*             } *@
            @*             else *@
            @*             { *@
            @*                 <MudText>@GetNoItemsMessage()</MudText> *@
            @*             } *@
            @*         </NoItemsTemplate> *@
