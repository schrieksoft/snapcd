@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Misc.Exceptions
@using SnapCd.Server.Core.Repositories.Organizations.Nonsecured
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.ModuleJobs
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject PersistentComponentState ApplicationState
@inject JobCreatedNotificationService JobCreatedNotificationService
@inject JobUpdatedNotificationService JobUpdatedNotificationService
@inject LogReceivedNotificationService LogReceivedNotificationService
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject ModuleJobApprovalModifiedNotificationService ModuleJobApprovalModifiedNotificationService
@inject ModuleApprovalThresholdModifiedNotificationService ModuleApprovalThresholdModifiedNotificationService

@implements IDisposable


@if (IsQueued)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.body2">
                <strong>Queued: @QueuedText</strong>
                @if (!string.IsNullOrEmpty(QueuedReasonText))
                {
                    @: — @QueuedReasonText
                }
            </MudText>
            @if (ShowRunNow)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           OnClick="OnRunQueueNow">run now</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       OnClick="OnClearQueue">clear</MudButton>
        </div>
    </MudAlert>
}

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Row Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="RunApply" Size="Size.Small">apply</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="RunDestroy" Size="Size.Small">destroy</MudButton>
    </MudStack>
</MudPaper>


@* <MudTooltip Text="Refresh"> *@
@*     <MudIconButton Icon="@SnapCdIcons.Refresh" Color="Color.Primary" Size="Size.Medium" *@
@*                    OnClick="() => ReloadModuleJobs()"/> *@
@* </MudTooltip> *@

@if (_moduleJobs == null)
{
    <MudText Typo="Typo.body1"><em>Loading jobs...</em></MudText>
}
else if (!_moduleJobs.Any())
{
    <MudText Typo="Typo.body1">No jobs found for this module.</MudText>
}
else
{
    <MudExpansionPanels>
        @foreach (var job in _moduleJobs.OrderByDescending(j => j.TimestampStart))
        {
            var dotColor = job.Status switch
            {
                // Running gets a lighter accent and Failed a deeper red — the theme's warning
                // (accent) and error colors are too close to tell apart at dot size
                ExecutionStatus.Running => "var(--snap-running, #EB753C)",
                ExecutionStatus.Completed => "var(--mud-palette-success)",
                ExecutionStatus.Failed => "var(--snap-failed, #C62828)",
                ExecutionStatus.NotApproved => "var(--snap-failed, #C62828)",
                ExecutionStatus.Cancelled => "var(--mud-palette-text-disabled)",
                _ => "var(--mud-palette-text-disabled)"
            };

            var statusLabel = job.Status switch
            {
                ExecutionStatus.Running => "Running",
                ExecutionStatus.Completed => FormatJobType(job.JobType) == "Apply" ? "Applied" : "Destroyed",
                ExecutionStatus.Failed => "Failed",
                ExecutionStatus.NotApproved => "Not Approved",
                ExecutionStatus.Cancelled => "Cancelled",
                _ => job.Status.ToString()
            };

            var elapsedTime = DateTimeOffset.UtcNow - job.TimestampStart;
            var elapsedDisplay = elapsedTime.TotalMinutes < 1 ? "just now"
                : elapsedTime.TotalMinutes < 60 ? $"{(int)elapsedTime.TotalMinutes}m ago"
                : elapsedTime.TotalHours < 24 ? $"{(int)elapsedTime.TotalHours}h ago"
                : elapsedTime.TotalHours < 48 ? "yesterday"
                : $"{(int)elapsedTime.TotalDays}d ago";

            <MudExpansionPanel Class="mb-2" @key="job.Id"
                               Expanded="@(job.Id == _expandedJobId)"
                               ExpandedChanged="@(async (isExpanded) => await OnPanelExpanded(isExpanded, job.Id))">
                <TitleContent>
                    <div style="display: flex; align-items: center; gap: 12px; width: 100%;">
                        <MudTooltip Text="@job.Status.ToString()">
                            @if (job.Status == ExecutionStatus.Running)
                            {
                                <span class="job-status-running" style="color: @dotColor;">
                                    <span class="job-status-dot" style="background-color: @dotColor;"></span>
                                </span>
                            }
                            else
                            {
                                <span class="job-status-dot" style="background-color: @dotColor;"></span>
                            }
                        </MudTooltip>
                        <span style="font-weight: 500; font-size: 14px;">Job #@job.JobNumber</span>
                        @if (job.WaitingForApproval == true)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Secondary"
                                     Class="ma-0">
                                Awaiting approval
                            </MudChip>
                        }
                        <span style="flex: 1;"></span>
                        <span style="font-size: 14px; color: var(--mud-palette-text-secondary); white-space: nowrap;">
                            @statusLabel · @elapsedDisplay
                        </span>
                        @if (job.Status == ExecutionStatus.Running)
                        {
                            <MudTooltip Text="Cancel Job">
                                <MudIconButton Icon="@SnapCdIcons.Cancel"
                                               Color="Color.Primary" Size="Size.Small"
                                               OnClick="() => CancelJob(job.Id)"/>
                            </MudTooltip>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (job.FailedOnServerSideStep != null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="ma-4 mb-0">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-2">Server-Side Error</MudText>
                                    <MudText>@job.ServerSideErrorHeader</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">@job.ServerSideError</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudAlert>
                    }
                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"
                             KeepPanelsAlive="true"
                             ActivePanelIndex="@GetTabIndex(job.Id)"
                             ActivePanelIndexChanged="@(idx => OnTabChanged(job.Id, idx))">
                        <MudTabPanel Text="Logs" Style="text-transform: none">
                            <ListLogs ModuleJobId="@job.Id"
                                      InitialTask="@(job.Id == _expandedJobId ? _activeTask : null)"
                                      OnTaskChanged="@(t => OnLogTaskChanged(job.Id, t))"
                                      @ref="_listLogsRefs[job.Id]"/>
                            @if (job.WaitingForApproval == true)
                            {
                                <MudAlert Severity="Severity.Info" Class="mt-4">
                                    This job is waiting for approval. Please review and approve in the Approvals tab.
                                </MudAlert>
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="Approvals" Style="text-transform: none">
                            <ListApprovals ModuleJobId="@job.Id" ModuleId="@Module.Id" JobSagaType="@job.JobType"
                                           @ref="_listApprovalRefs[job.Id]"/>
                        </MudTabPanel>
                        <MudTabPanel Text="Missions" Style="text-transform: none">
                            <ListMissions ModuleJobId="@job.Id"/>
                        </MudTabPanel>
                    </MudTabs>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@if (_totalPages > 1)
{
    <Pagination CurrentPage="_currentPage"
                TotalPages="_totalPages"
                PageChanged="HandlePageChanged"/>
}

<style>
    .job-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    /* Running jobs keep the exact same solid dot in the exact same place. The wrapper
       has the SAME 6px footprint as a plain dot, so the dot's centre lines up perfectly
       with the dots on every other row. The spinning ring is drawn by ::after, which
       overflows the footprint (centred on the dot) without affecting layout.
       `currentColor` picks up the inline `color` set on the wrapper (= dotColor). */
    .job-status-running {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 6px;
        height: 6px;
        flex-shrink: 0;
    }

    .job-status-running::after {
        content: "";
        position: absolute;
        /* 14px ring centred on the 6px dot: -4px inset on every side keeps it
           symmetric around the wrapper (and therefore around the dot), with a small
           gap between the thicker ring and the dot. */
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border-radius: 50%;
        border: 3px solid rgba(128, 128, 128, 0.25);
        border-top-color: currentColor;
        animation: job-status-spin 1.1s linear infinite;
    }

    @@keyframes job-status-spin {
        to { transform: rotate(360deg); }
    }

</style>

@code {
    [Parameter] public required Module Module { get; set; }
    [Parameter] public Guid? InitialJobId { get; set; }
    [Parameter] public string? InitialTab { get; set; }
    [Parameter] public string? InitialTask { get; set; }
    [Parameter] public EventCallback<(Guid? JobId, string? Tab, string? Task)> OnJobsStateChanged { get; set; }
    [Parameter] public string? QueuedText { get; set; }
    [Parameter] public string? QueuedReasonText { get; set; }
    [Parameter] public bool IsQueued { get; set; }
    [Parameter] public bool ShowRunNow { get; set; }
    [Parameter] public EventCallback OnRunQueueNow { get; set; }
    [Parameter] public EventCallback OnClearQueue { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] ModuleJobRepositoryFactory JobRepoFactory { get; set; } = null!;
    [Inject] ModuleSecuredRepositoryFactory ModuleRepoFactory { get; set; } = null!;

    private const int PageSize = 10;
    private int _currentPage = 1;
    private int _totalJobs;
    private int _totalPages;

    private Timer? _timer;

    private Guid _principalId;
    private PrincipalDiscriminator _principalDiscriminator;

    // private List<Guid> _recentlyCreatedJobIds = new();
    private HashSet<Guid> _loadedLogs = new();
    private HashSet<Guid> _openPanels = new();
    private Dictionary<Guid, ListLogs> _listLogsRefs = new();
    private Dictionary<Guid, ListApprovals> _listApprovalRefs = new();
    private List<ModuleJobView>? _moduleJobs;

    private Guid? _expandedJobId;
    private string _activeTab = "logs";
    private string? _activeTask;
    private Guid? _previousInitialJobId;
    private string? _previousInitialTab;
    private string? _previousInitialTask;
    private bool _initialHydrationDone;

    // private bool _hasRecentlyCreatedJobs;
    // private PersistingComponentStateSubscription _persistenceSubscription;

    private record ModuleJobsState(List<ModuleJobView>? Jobs, int TotalJobs, int CurrentPage);

    protected override async Task OnInitializedAsync()
    {
        _principalId = HttpContextPrincipalProvider.GetSubject(OrganizationId);
        _principalDiscriminator = HttpContextPrincipalProvider.GetPrincipalDiscriminator();

        await ReloadModuleJobs();

        _expandedJobId = InitialJobId;
        _activeTab = NormalizeTab(InitialTab) ?? "logs";
        _activeTask = InitialTask;
        _previousInitialJobId = InitialJobId;
        _previousInitialTab = InitialTab;
        _previousInitialTask = InitialTask;

        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(() =>
        // {
        //     ApplicationState.PersistAsJson("module_jobs", new ModuleJobsState(_moduleJobs, _totalJobs, _currentPage));
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<ModuleJobsState>("module_jobs", out var persistedData))
        // {
        //     _moduleJobs = persistedData.Jobs;
        //     _totalJobs = persistedData.TotalJobs;
        //     _currentPage = persistedData.CurrentPage;
        //     _totalPages = (int)Math.Ceiling((double)_totalJobs / PageSize);
        // }

        JobCreatedNotificationService.Subscribe(Module.Id, HandleJobCreated);
        JobUpdatedNotificationService.Subscribe(Module.Id, HandleJobUpdated);
        LogReceivedNotificationService.Subscribe(Module.Id, HandleLogReceived);
        ModuleJobApprovalModifiedNotificationService.Subscribe(Module.Id, HandleApprovalModified);
        ModuleApprovalThresholdModifiedNotificationService.Subscribe(Module.Id, HandleApprovalThresholdModified);

        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, 60000, 60000); // invoke StateHasChanged every 60 secs so that "x minutes ago" keeps ticking on
    }


    private async Task HandleJobCreated(Guid jobId, Guid moduleId)
    {
        if (moduleId != Module.Id) return;

        ModuleJobView? newJob = null;
        for (var attempt = 0; attempt < 5; attempt++)
        {
            try
            {
                using var repo = JobRepoFactory.Create();
                newJob = await repo.Get<ModuleJobView>(
                    jobId, OrganizationId,
                    q => q.Select(j => new ModuleJobView
                    {
                        Id = j.Id,
                        JobNumber = j.JobNumber,
                        TimestampStart = j.TimestampStart,
                        TimestampEnd = j.TimestampEnd,
                        Status = j.Status,
                        JobType = j.JobType,
                        FailedOnServerSideStep = j.FailedOnServerSideStep,
                        ServerSideErrorHeader = j.ServerSideErrorHeader,
                        ServerSideError = j.ServerSideError,
                        WaitingForApproval = j.WaitingForApproval
                    }));
                break;
            }
            catch (EntityNotFoundException)
            {
                await Task.Delay(500);
            }
        }

        if (newJob == null) return;

        _moduleJobs ??= new List<ModuleJobView>();
        _moduleJobs.Insert(0, newJob);

        if (_moduleJobs.Count > PageSize)
            _moduleJobs.RemoveAt(_moduleJobs.Count - 1);

        _totalJobs++;
        _totalPages = (int)Math.Ceiling((double)_totalJobs / PageSize);

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleJobUpdated(Guid jobId, Guid moduleId, ExecutionStatus status)
    {
        if (moduleId != Module.Id) return;

        var job = _moduleJobs?.FirstOrDefault(j => j.Id == jobId);
        if (job != null)
        {
            ModuleJobView? updated = null;
            for (var attempt = 0; attempt < 5; attempt++)
            {
                try
                {
                    using var repo = JobRepoFactory.Create();
                    updated = await repo.Get<ModuleJobView>(
                        jobId, OrganizationId,
                        q => q.Select(j => new ModuleJobView
                        {
                            Id = j.Id,
                            JobNumber = j.JobNumber,
                            TimestampStart = j.TimestampStart,
                            Status = j.Status,
                            JobType = j.JobType,
                            FailedOnServerSideStep = j.FailedOnServerSideStep,
                            ServerSideErrorHeader = j.ServerSideErrorHeader,
                            ServerSideError = j.ServerSideError,
                            WaitingForApproval = j.WaitingForApproval
                        }));
                    break;
                }
                catch (EntityNotFoundException)
                {
                    await Task.Delay(500);
                }
            }

            if (updated != null)
            {
                job.Status = updated.Status;
                job.TimestampEnd = updated.TimestampEnd;
                job.WaitingForApproval = updated.WaitingForApproval;
                job.FailedOnServerSideStep = updated.FailedOnServerSideStep;
                job.ServerSideErrorHeader = updated.ServerSideErrorHeader;
                job.ServerSideError = updated.ServerSideError;
            }
        }

        await InvokeAsync(StateHasChanged);

        if (_openPanels.Contains(jobId))
            if (_listApprovalRefs.TryGetValue(jobId, out var listApprovals))
            {
                await listApprovals.RefreshModuleJobStatus(true);
            }
    }

    private async Task HandleApprovalThresholdModified(Guid moduleId)
    {
        if (moduleId != Module.Id) return;


        foreach (var listApprovals in _listApprovalRefs.Values)
        {
            await listApprovals.RefreshApprovalThreshold(true);
        }
    }

    private async Task HandleApprovalModified(Guid jobId, Guid moduleId)
    {
        if (moduleId != Module.Id) return;

        if (_openPanels.Contains(jobId))
            if (_listApprovalRefs.TryGetValue(jobId, out var listApprovals))
            {
                await listApprovals.RefreshAll(true);
            }
    }


    private async Task HandleLogReceived(Guid jobId, Guid moduleId)
    {
        if (moduleId != Module.Id) return;

        // Check if we have a ListLogs reference regardless of panel state tracking
        // This fixes issues where inner expansion panels interfere with outer panel state
        if (_listLogsRefs.TryGetValue(jobId, out var listLogs))
        {
            // Only refresh if the logs have been initialized (to avoid unnecessary API calls)
            if (_loadedLogs.Contains(jobId))
            {
                await listLogs.RefreshLogs(true);
            }
        }
    }

    private async Task ReloadModuleJobs(bool invokeAsync = false)
    {
        // Verify user can read the parent Module (single EXISTS query)
        using var moduleRepo = ModuleRepoFactory.Create(new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]));
        if (!moduleRepo.CanRead(Module.Id, OrganizationId))
            return;

        // Use nonsecured repo for job listing — permission inherited from Module
        using var repo = JobRepoFactory.Create();
        _totalJobs = await repo.Count(OrganizationId, queryModifier: q => q.Where(x => x.ModuleId == Module.Id));
        _totalPages = (int)Math.Ceiling((double)_totalJobs / PageSize);

        _moduleJobs = await repo.ListByParentId<ModuleJobView>(
            Module.Id,
            OrganizationId,
            projection: q => q.Select(j => new ModuleJobView
            {
                Id = j.Id,
                JobNumber = j.JobNumber,
                TimestampStart = j.TimestampStart,
                Status = j.Status,
                JobType = j.JobType,
                FailedOnServerSideStep = j.FailedOnServerSideStep,
                ServerSideErrorHeader = j.ServerSideErrorHeader,
                ServerSideError = j.ServerSideError,
                WaitingForApproval = j.WaitingForApproval
            }),
            orderBy: x => x.OrderByDescending(j => j.TimestampStart),
            pageNumber: _currentPage,
            pageSize: PageSize);

        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }


    private async Task CancelJob(Guid jobId)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<CancelModuleJobDialog>
        {
            { x => x.JobId, jobId },
            { x => x.ModuleId, Module.Id },
            { x => x.NamespaceId, Module.NamespaceId },
            { x => x.OrganizationId, OrganizationId }
        };

        var dialog = await DialogService.ShowAsync<CancelModuleJobDialog>("Cancel", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadModuleJobs();
        }
    }


    private async Task OnPanelExpanded(bool isExpanded, Guid jobId)
    {
        if (isExpanded)
        {
            _openPanels.Add(jobId);
            if (!_loadedLogs.Contains(jobId) && _listLogsRefs.TryGetValue(jobId, out var listLogs))
            {
                await listLogs.InitializeLogs();
                _loadedLogs.Add(jobId);
            }

            if (_listApprovalRefs.TryGetValue(jobId, out var listApprovals))
            {
                await listApprovals.RefreshAll();
            }

            if (_expandedJobId != jobId)
            {
                _expandedJobId = jobId;
                _activeTab = "logs";
                _activeTask = null;
                await RaiseJobsStateChanged();
            }
        }
        else
        {
            _openPanels.Remove(jobId);
            if (_expandedJobId == jobId)
            {
                _expandedJobId = null;
                _activeTab = "logs";
                _activeTask = null;
                await RaiseJobsStateChanged();
            }
        }
    }

    private async Task OnTabChanged(Guid jobId, int idx)
    {
        // Ignore ActivePanelIndexChanged from non-expanded panels — MudTabs fires this when its
        // ActivePanelIndex prop changes for any reason (including a re-render after a different
        // panel becomes expanded), not only on user click. Treating those as clicks would let the
        // collapsed panel's tab "yank" focus back to itself.
        if (jobId != _expandedJobId) return;

        var tabName = GetTabName(idx);
        if (_activeTab == tabName) return;

        _activeTab = tabName;
        if (tabName != "logs") _activeTask = null;
        await RaiseJobsStateChanged();
    }

    private async Task OnLogTaskChanged(Guid jobId, string? taskKey)
    {
        if (jobId != _expandedJobId) return;
        if (_activeTask == taskKey) return;

        _activeTask = taskKey;
        await RaiseJobsStateChanged();
    }

    private Task RaiseJobsStateChanged()
    {
        var tab = _expandedJobId.HasValue ? _activeTab : null;
        var task = _expandedJobId.HasValue && _activeTab == "logs" ? _activeTask : null;
        return OnJobsStateChanged.InvokeAsync((_expandedJobId, tab, task));
    }

    private int GetTabIndex(Guid jobId)
    {
        if (jobId != _expandedJobId) return 0;
        return _activeTab switch
        {
            "approvals" => 1,
            "missions" => 2,
            _ => 0
        };
    }

    private string GetTabName(int idx) => idx switch
    {
        1 => "approvals",
        2 => "missions",
        _ => "logs"
    };

    private static string? NormalizeTab(string? tab) => tab?.ToLowerInvariant() switch
    {
        "logs" => "logs",
        "approvals" => "approvals",
        "missions" => "missions",
        _ => null
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialHydrationDone)
        {
            await base.OnParametersSetAsync();
            return;
        }

        if (InitialJobId != _previousInitialJobId
            || InitialTab != _previousInitialTab
            || InitialTask != _previousInitialTask)
        {
            _previousInitialJobId = InitialJobId;
            _previousInitialTab = InitialTab;
            _previousInitialTask = InitialTask;
            _expandedJobId = InitialJobId;
            _activeTab = NormalizeTab(InitialTab) ?? "logs";
            _activeTask = InitialTask;
            _pendingExpansionHydration = true;
            StateHasChanged();
        }

        await base.OnParametersSetAsync();
    }

    private bool _pendingExpansionHydration;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _pendingExpansionHydration)
        {
            _pendingExpansionHydration = false;
            if (_expandedJobId is { } eid
                && _moduleJobs?.Any(j => j.Id == eid) == true
                && !_loadedLogs.Contains(eid))
            {
                await OnPanelExpanded(true, eid);
            }
            if (firstRender) _initialHydrationDone = true;
        }
    }

    private async Task RunApply()
    {
        var jobId = Guid.NewGuid();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<CreateApplyJobDialog>
        {
            { x => x.ModuleId, Module.Id },
            { x => x.NamespaceId, Module.NamespaceId },
            { x => x.JobId, jobId },
            { x => x.OrganizationId, OrganizationId }
        };

        var dialog = await DialogService.ShowAsync<CreateApplyJobDialog>("Create Job", parameters, options);
        var _ = await dialog.Result;
    }

    private async Task RunDestroy()
    {
        var jobId = Guid.NewGuid();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<CreateDestroyJobDialog>
        {
            { x => x.ModuleId, Module.Id },
            { x => x.NamespaceId, Module.NamespaceId },
            { x => x.JobId, jobId },
            { x => x.OrganizationId, OrganizationId }
        };

        var dialog = await DialogService.ShowAsync<CreateDestroyJobDialog>("Create Job", parameters, options);
        var _ = await dialog.Result;
    }

    private async Task HandlePageChanged(int newPage)
    {
        _currentPage = newPage;
        await ReloadModuleJobs();
    }

    private static string FormatJobType(string jobType) => jobType switch
    {
        "ApplyJobSaga" => "Apply",
        "DestroyJobSaga" => "Destroy",
        _ => jobType
    };

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();

        JobCreatedNotificationService.Unsubscribe(Module.Id, HandleJobCreated);
        JobUpdatedNotificationService.Unsubscribe(Module.Id, HandleJobUpdated);
        LogReceivedNotificationService.Unsubscribe(Module.Id, HandleLogReceived);
        ModuleJobApprovalModifiedNotificationService.Unsubscribe(Module.Id, HandleApprovalModified);
        ModuleApprovalThresholdModifiedNotificationService.Unsubscribe(Module.Id, HandleApprovalThresholdModified);
        _timer?.Dispose();
    }


}