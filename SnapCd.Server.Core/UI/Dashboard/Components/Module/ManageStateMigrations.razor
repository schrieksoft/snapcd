@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Sagas
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Crud.Jobs
@using SnapCd.Server.Core.Services.Crud.Transfers
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Modules
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.ModuleJobs
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using SnapCd.Server.Core.UI.Dashboard.Components.Approvals
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Transfers
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.StateMigrations

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LogReceivedNotificationService LogReceivedNotificationService
@inject StateMigrationUpdatedNotificationService StateMigrationUpdatedNotificationService
@inject ILogger<ManageStateMigrations> Logger

@implements IDisposable

@* A paused module says so in its header and in the page's own notice; repeating it here says
   nothing. What is worth a block is the module not being paused, which is what stops these jobs. *@
@if (ModuleSaga is not { Paused: true })
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">
                State migrations run against a module that is held still. Pause the module to make them available.
            </MudText>
            <MudTooltip Text="@PauseDisabledReason" Disabled="@(PauseDisabledReason is null)">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           Disabled="@(!_canPause || _busy)" OnClick="Pause">pause</MudButton>
            </MudTooltip>
        </MudStack>
    </MudPaper>
}

@if (ModuleSaga is { Paused: true })
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        @if (IsDraining)
        {
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Small"/>
                <MudText Typo="Typo.body2"><strong>Waiting for the current job to finish.</strong> @_blockedReason</MudText>
            </MudStack>
        }
        else
        {
            @if (_transfer is not null)
            {
                @* An unanswered request is a question, not a status line: it gets its own surface
                   and blocks the rest of the panel until it is answered. *@
                @if (NeedsMyAnswer)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Module
                            @if (_otherModuleHref is { } askingHref)
                            {
                                <MudLink Href="@askingHref" Typo="Typo.body2" Color="Color.Secondary">
                                    <strong>@OtherModuleName</strong>
                                </MudLink>
                            }
                            else
                            {
                                <strong>@OtherModuleName</strong>
                            }
                            has asked to transfer resources
                            between it and this module. You must agree or refuse before anything else
                            on this module is available. Agreeing starts the transfer immediately.
                        </MudText>

                        <MudStack Row Spacing="2">
                            <MudTooltip Text="@AnswerDisabledReason" Disabled="@(AnswerDisabledReason is null)">
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                           Disabled="@(!_canPause || _busy || RunningStateMigration is not null)"
                                           OnClick="@(() => Answer(true))">agree</MudButton>
                            </MudTooltip>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                       Disabled="@(!_canPause || _busy || RunningStateMigration is not null)"
                                       OnClick="@(() => Answer(false))">refuse</MudButton>
                        </MudStack>
                    </MudAlert>
                }
            }

            @if (!EngineSupportsStateMigrations)
            {
                <MudText Typo="Typo.body2">
                    State migrations move addresses within a module's state, which needs the
                    <strong>terraform state</strong> commands. This module runs on
                    <strong>@EngineName</strong>, so they are not available here.
                </MudText>
            }
            else
            {
                @* MudRadio pads its own control, which would sit the dot right of the panel edge. *@
                <style>
                    /* Gutters="false" drops MudBlazor's 24px header inset, so the headings, the
                       radios and the bullets share one left edge at the container's own padding. */
                    .snapcd-job-panels, .snapcd-job-head { max-width: 50%; }
                    .snapcd-job-panels .mud-expand-panel-text { padding-left: 0; }
                    .snapcd-job-panels .snapcd-substeps { margin: 0; padding-left: 1.1rem; }
                    .snapcd-job-panels .snapcd-substeps li { margin-bottom: .25rem; }
                    .snapcd-job-panels .mud-radio .mud-icon-button { padding: 0; margin-left: 0; }
                    .snapcd-job-panels .mud-radio > .mud-typography { margin-left: .5rem; }
                </style>

                <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Class="mb-1 snapcd-job-head">
                    <MudText Typo="Typo.subtitle2" Style="width: 16rem">Job</MudText>
                    <MudText Typo="Typo.subtitle2">Approximate command</MudText>
                    <MudTooltip Text="Not everything the job runs, but the crux of what it does.">
                        <MudIcon Icon="@SnapCdIcons.HelpOutline" Size="Size.Small" Color="Color.Default"/>
                    </MudTooltip>
                </MudStack>

                <MudRadioGroup T="StateMigrationKind" @bind-Value="_chosenJob">
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true"
                                        Class="snapcd-job-panels">
                        @foreach (var choice in JobChoices)
                        {
                            <MudExpansionPanel Dense="true" Gutters="false">
                                <TitleContent>
                                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                        <div style="width: 16rem">
                                            <MudRadio T="StateMigrationKind" Value="@choice.Kind"
                                                      Color="Color.Secondary" Size="Size.Small"
                                                      Disabled="@IsJobDisabled()">@choice.Label</MudRadio>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="snapcd-mono">@choice.Command</MudText>
                                    </MudStack>
                                </TitleContent>
                                <ChildContent>
                                    <MudText Typo="Typo.body2" Component="ul" Class="snapcd-substeps">
                                        @foreach (var step in choice.Steps)
                                        {
                                            <li>@step</li>
                                        }
                                    </MudText>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudRadioGroup>

                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           Class="mt-3"
                           Disabled="@IsJobDisabled()"
                           OnClick="RunChosenJob">Run</MudButton>
            }
        }
    </MudPaper>
}

@if (_jobs.Count == 0)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.body2">No state migrations have run on this module.</MudText>
    </MudPaper>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var job in _jobs.OrderByDescending(j => j.TimestampStart))
        {
            var dotColor = job.Status switch
            {
                ExecutionStatus.Running => "var(--snap-running, #EB753C)",
                ExecutionStatus.Completed => "var(--mud-palette-success)",
                // The part that worked did work, so a partial is green and says so beside the dot.
                ExecutionStatus.PartiallyCompleted => "var(--mud-palette-success)",
                ExecutionStatus.Failed => "var(--snap-failed, #C62828)",
                ExecutionStatus.NotApproved => "var(--snap-failed, #C62828)",
                ExecutionStatus.Cancelled => "var(--mud-palette-text-disabled)",
                _ => "var(--mud-palette-text-disabled)"
            };

            var elapsed = DateTimeOffset.UtcNow - job.TimestampStart;
            var elapsedDisplay = elapsed.TotalMinutes < 1 ? "just now"
                : elapsed.TotalMinutes < 60 ? $"{(int)elapsed.TotalMinutes}m ago"
                : elapsed.TotalHours < 24 ? $"{(int)elapsed.TotalHours}h ago"
                : elapsed.TotalHours < 48 ? "yesterday"
                : $"{(int)elapsed.TotalDays}d ago";

            <MudExpansionPanel Class="mb-2" @key="job.Id"
                               Expanded="@(job.Id == _selected?.Id)"
                               ExpandedChanged="@(isExpanded => OnPanelExpanded(isExpanded, job))">
                <TitleContent>
                    <div style="display: flex; align-items: center; gap: 12px; width: 100%;">
                        <MudTooltip Text="@job.Status.ToString()">
                            @if (job.Status == ExecutionStatus.Running)
                            {
                                <span class="job-status-running" style="color: @dotColor;">
                                    <span class="job-status-dot" style="background-color: @dotColor;"></span>
                                </span>
                            }
                            else
                            {
                                <span class="job-status-dot" style="background-color: @dotColor;"></span>
                            }
                        </MudTooltip>
                        <span style="font-weight: 500; font-size: 14px;">@FormatJobType(job.JobType) #@job.JobNumber</span>
                        @if (job.WaitingForApproval == true)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">Awaiting approval</MudChip>
                        }
                        @if (job.WaitingForConsent == true)
                        {
                            <MudTooltip Text="Waiting for the other module to agree to the transfer. There is no timeout: it goes ahead when that module agrees, and ends if it refuses.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">
                                    Waiting for the other module
                                </MudChip>
                            </MudTooltip>
                        }
                        @if (job.WaitingForRunner == true)
                        {
                            <MudTooltip Text="The runner this job is pinned to is not connected. It carries on as soon as that runner is back; nothing is lost in the meantime.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">
                                    Waiting for runner
                                </MudChip>
                            </MudTooltip>
                        }
                        @* A transfer has two sides; from one there was no way to reach the other. *@
                        @if (job.JobType == StateMigrationTypes.TransferMigrate && _otherModuleHref is { } href)
                        {
                            <MudLink Href="@href" Typo="Typo.body2" Color="Color.Secondary">
                                @OtherModuleName
                            </MudLink>
                        }
                        @if (job.Status == ExecutionStatus.Failed && WasRefused(job))
                        {
                            <MudTooltip Text="The other module refused the transfer, so this side wrote nothing.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">Counterparty refused</MudChip>
                            </MudTooltip>
                        }
                        @if (job.Status == ExecutionStatus.PartiallyCompleted)
                        {
                            <MudTooltip Text="Some addresses were done and some were not. The ones that failed are listed below and can be run again.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">partial</MudChip>
                            </MudTooltip>
                        }
                        <span style="flex: 1;"></span>
                        <span style="font-size: 14px; color: var(--mud-palette-text-secondary); white-space: nowrap;">
                            @job.Status · @elapsedDisplay
                        </span>
                        @if (job.Status == ExecutionStatus.Running && _canRunJob)
                        {
                            <MudTooltip Text="Cancel Job">
                                <MudIconButton Icon="@SnapCdIcons.Cancel"
                                               Color="Color.Primary" Size="Size.Small"
                                               OnClick="() => CancelJob(job.Id, job.WaitingForApproval == true)"/>
                            </MudTooltip>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (!string.IsNullOrWhiteSpace(job.ServerSideError))
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="ma-4 mb-0">
                            <MudText Typo="Typo.h6" Class="mb-2">Server-Side Error</MudText>
                            <MudText>@job.ServerSideErrorHeader</MudText>
                            <MudText Typo="Typo.subtitle2" Class="mb-1">@job.ServerSideError</MudText>
                        </MudAlert>
                    }

                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" KeepPanelsAlive="true">
                        <MudTabPanel Text="Logs" Style="text-transform: none">
                            @* A job that has not dispatched a step has nothing to show, which is
                               indistinguishable from a job whose logs failed to load. *@
                            @if (job.WaitingForConsent == true)
                            {
                                <MudText Typo="Typo.body2">
                                    Waiting for the other module to answer. Nothing has been
                                    dispatched to a runner yet, so there is nothing to show.
                                </MudText>
                            }
                            else
                            {
                                <ListLogs ModuleJobId="@job.Id" @key="job.Id"
                                          @ref="_listLogsRefs[job.Id]"/>
                            }
                        </MudTabPanel>
                        @if (_addresses.TryGetValue(job.Id, out var addresses)
                             && addresses.Any(a => a.Operation == AddressOperation.List))
                        {
                            <MudTabPanel Text="Addresses" Style="text-transform: none">
                                @* Where the addresses ended up. What the migration reported of its
                                   own work is the job's status and its log; repeating it here gave
                                   every address two rows that read as competing verdicts. *@
                                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                    <thead>
                                    <tr>
                                        <th>Address</th>
                                        <th>In state afterwards</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var address in addresses.Where(a => a.Operation == AddressOperation.List))
                                    {
                                        <tr>
                                            <td><code>@address.Address</code></td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                         Color="@OutcomeColor(address, addresses, job.JobType)" Class="ma-0">
                                                    @address.Outcome
                                                </MudChip>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            </MudTabPanel>
                        }
                        <MudTabPanel Text="Approvals" Style="text-transform: none">
                            @if (job is { WaitingForApproval: true })
                            {
                                <MudAlert Severity="Severity.Info" Class="mb-3">
                                    This job has proved every module plans to zero changes and is waiting for approval
                                    before it pushes state. The push cannot be undone.
                                </MudAlert>
                            }

                            <ApprovalPanel Source="@GetApprovalSource()"
                                           JobId="@job.Id"
                                           ModuleId="@Module.Id"
                                           Enabled="@(_canPause && !_busy)"
                                           OnDecided="Reload"
                                           @key="job.Id"/>
                        </MudTabPanel>
                    </MudTabs>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private string? PauseDisabledReason =>
        !_canPause ? "You do not have permission to pause this module."
        : _busy ? "An operation is already in progress."
        : null;

    private string? AnswerDisabledReason =>
        !_canPause ? "You do not have permission to answer this."
        : _busy ? "An operation is already in progress."
        : RunningStateMigration is not null ? "A state migration is already running."
        : null;

    [Parameter] public required Module Module { get; set; }
    [Parameter] public required ModuleSaga ModuleSaga { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ModuleSagaSecuredRepositoryFactory SagaRepoFactory { get; set; } = null!;
    [Inject] private ModuleSecuredRepositoryFactory ModuleRepoFactory { get; set; } = null!;
    [Inject] private ModuleJobSecuredRepositoryFactory JobSecuredRepoFactory { get; set; } = null!;
    [Inject] private StateMigrationServiceFactory StateMigrationServiceFactory { get; set; } = null!;
    [Inject] private TransferServiceFactory TransferServiceFactory { get; set; } = null!;
    [Inject] private IDbContextFactory<SnapCdDbContext> TransferDbContextFactory { get; set; } = null!;
    [Inject] private StateMigrationJobSecuredRepositoryFactory StateMigrationRepoFactory { get; set; } = null!;
    [Inject] private IDbContextFactory<SnapCdDbContext> DbContextFactory { get; set; } = null!;

    private string? _blockedReason;
    private List<StateMigrationJob> _jobs = [];
    private Dictionary<Guid, List<StateMigrationJobAddress>> _addresses = [];

    /// <summary>
    /// Green for what worked or is there, red for what did not. A "Present" is the same good news
    /// as a "Succeeded", so they read the same.
    /// </summary>
    /// <summary>
    /// Whether an address being in state is good news depends on what was asked for. A remove wants
    /// it gone, and so does the end a move came from, so the same outcome is a success in one job
    /// and a failure in another.
    /// </summary>
    private static Color OutcomeColor(
        StateMigrationJobAddress address,
        IReadOnlyCollection<StateMigrationJobAddress> all,
        string jobType) =>
        address.Outcome switch
        {
            AddressOutcome.Succeeded => Color.Success,
            AddressOutcome.Failed => Color.Error,
            AddressOutcome.Absent => WantsItGone(address, all, jobType) ? Color.Success : Color.Error,
            AddressOutcome.Present => WantsItGone(address, all, jobType) ? Color.Error : Color.Success,
            _ => Color.Error
        };

    /// <summary>
    /// Whether an address should still be in state once the job is done. The confirming list files
    /// every row as List, so a move - which verifies both ends, wanting one gone and one present -
    /// is only answerable by looking at what the migration recorded for that same address.
    /// </summary>
    private static bool WantsItGone(
        StateMigrationJobAddress address,
        IReadOnlyCollection<StateMigrationJobAddress> all,
        string jobType)
    {
        if (address.Operation != AddressOperation.List)
            return Leaves(address.Operation);

        var migrated = all.FirstOrDefault(a =>
            a.Operation != AddressOperation.List && a.Address == address.Address);

        return migrated is not null
            ? Leaves(migrated.Operation)
            : jobType == StateMigrationTypes.Remove;
    }

    private static bool Leaves(AddressOperation operation) =>
        operation is AddressOperation.Remove or AddressOperation.MoveFrom or AddressOperation.TransferOut;

    /// <summary>The Namespace's default engine, which a Module without its own falls back to.</summary>
    private async Task LoadNamespaceDefaultEngine()
    {
        if (Module.Engine != null) return;

        await using var db = await TransferDbContextFactory.CreateDbContextAsync();

        _namespaceDefaultEngine = await db.Namespaces.AsNoTracking()
            .Where(n => n.Id == Module.NamespaceId && n.OrganizationId == OrganizationId)
            .Select(n => n.DefaultEngine)
            .FirstOrDefaultAsync();
    }

    /// <summary>What each job on this page did to which addresses, for the addresses tab.</summary>
    private async Task LoadAddresses()
    {
        var jobIds = _jobs.Select(j => j.Id).ToList();

        await using var db = await TransferDbContextFactory.CreateDbContextAsync();

        _addresses = (await db.StateMigrationJobAddresses.AsNoTracking()
                .Where(a => jobIds.Contains(a.JobId) && a.OrganizationId == OrganizationId)
                .OrderBy(a => a.Address)
                .ToListAsync())
            .GroupBy(a => a.JobId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }
    private readonly Dictionary<Guid, ListLogs> _listLogsRefs = new();
    private readonly HashSet<Guid> _loadedLogs = [];
    private Guid? _subscribedModuleId;
    private StateMigrationJob? _selected;

    private IApprovalSource GetApprovalSource() =>
        _approvalSource ??= new StateMigrationApprovalSource(
            StateMigrationRepoFactory,
            ModuleRepoFactory,
            StateMigrationServiceFactory,
            DbContextFactory,
            PrincipalProvider ?? new HttpContextPrincipalProvider(new HttpContextAccessor()));

    private IApprovalSource? _approvalSource;

    /// A state migration of this module's own, still going. Its own panel below shows what it is doing.
    private StateMigrationJob? RunningStateMigration =>
        _jobs.FirstOrDefault(j => j.Status == ExecutionStatus.Running);

    /// Inside a paused module, any remaining block is work still draining: the pause itself is not
    /// one, and neither is an engine that has no state migrations, which never drains.
    private bool IsDraining =>
        ModuleSaga is { Paused: true } && _blockedReason is not null && RunningStateMigration is null
        && EngineSupportsStateMigrations;

    /// <summary>The manual jobs this page can start, as the radio list names them.</summary>
    private enum StateMigrationKind
    {
        Split,
        SplitProve,
        Transfer,
        Move,
        Import,
        Remove,
        LookupAddresses
    }

    private StateMigrationKind _chosenJob = StateMigrationKind.Split;

    private sealed record JobChoice(
        StateMigrationKind Kind, string Label, string Command, IReadOnlyList<string> Steps);

    private IReadOnlyList<JobChoice> JobChoices =>
    [
        new(StateMigrationKind.Split, "split", "demonolith split migrate",
        [
            "Checks out the ref and confirms the committed module directories still match the source.",
            "Checks that the engine accepts each of those directories.",
            "Pulls the monolith's state read-only and splits a local copy per module.",
            "Plans each new module, then waits for approval before writing any state.",
            "Writes each module's state, then checks that every one has nothing left to change."
        ]),
        // Not offered for now. Its kind, handler and dialog are all still here.
        // new(StateMigrationKind.SplitProve, "split (prove only)", "demonolith split migrate prove",
        // [
        //     "Checks out the ref and confirms the committed module directories still match the source.",
        //     "Checks that the engine accepts each of those directories.",
        //     "Pulls the monolith's state read-only and splits a local copy per module.",
        //     "Plans each new module, so you can see what the split would do.",
        //     "Stops there. Nothing is written."
        // ]),
        new(StateMigrationKind.Transfer, "transfer", "demonolith transfer migrate",
        [
            "Asks the module on the other side to agree to the transfer of resources, and waits for its answer.",
            "Reads the committed map to find out which side this module is on: the one giving the "
            + "resources up, or the one taking them in.",
            "Pulls this module's state. The giving side also writes out the resources that are "
            + "moving, for the other side to pick up.",
            "Plans both modules as their state will look once the move is done, then waits for "
            + "approval before writing anything.",
            "Writes both modules' state, then checks that each has nothing left to change."
        ]),
        new(StateMigrationKind.Import, "import", $"{EngineCommand} import",
        [
            "Takes an address and the id the resource already has.",
            "Imports them one at a time, so you can see which worked if some do not.",
            "Reads the state afterwards to confirm each one landed."
        ]),
        new(StateMigrationKind.Move, "move", $"{EngineCommand} state mv",
        [
            "Takes each address and the address it should become.",
            "Moves them one at a time, so you can see which worked if some do not.",
            "Reads the state afterwards to confirm each one moved."
        ]),
        new(StateMigrationKind.Remove, "remove", $"{EngineCommand} state rm",
        [
            "Removes each address from this module's state, one at a time.",
            "Does not touch the resources themselves. They keep running; this module stops managing them.",
            "Reads the state afterwards to confirm each one is gone."
        ]),
        new(StateMigrationKind.LookupAddresses, "lookup addresses", $"{EngineCommand} state list",
        [
            "Reads this module's state and looks for the addresses you give it.",
            "Tells you which are there and which are not.",
            "Writes nothing. The state itself never leaves the runner."
        ])
    ];

    /// <summary>A transfer also needs there not to be one already; the rest share one condition.</summary>
    /// <summary>
    /// What the server refuses, which is the same for every job kind. An open transfer is not among
    /// them: a second one is refused by TransferLocks' primary key, and the rest are unaffected.
    /// </summary>
    private bool IsJobDisabled() =>
        NeedsMyAnswer || !_canPause || _busy || RunningStateMigration is not null;

    private Task RunChosenJob() => _chosenJob switch
    {
        StateMigrationKind.Split => StartSplit(),
        StateMigrationKind.SplitProve => StartSplitProve(),
        StateMigrationKind.Transfer => StartTransfer(),
        StateMigrationKind.Move => StartMove(),
        StateMigrationKind.Import => StartImport(),
        StateMigrationKind.Remove => StartRemove(),
        StateMigrationKind.LookupAddresses => StartLookupAddresses(),
        _ => Task.CompletedTask
    };

    private bool _canPause;
    private bool _canRunJob;
    private bool _busy;
    private List<Module> _transferCandidates = [];
    private Transfer? _transfer;
    private string? _otherModuleName;
    private string? _otherModuleHref;

    /// <summary>Qualified, since the same module name can exist in another namespace.</summary>
    private string OtherModuleName => _otherModuleName ?? "the other module";

    /// <summary>This Module is the counterparty and has not answered yet.</summary>
    private bool NeedsMyAnswer =>
        _transfer is { ConsentStatus: ConsentStatus.Pending }
        && _transfer.CounterpartyModuleId == Module.Id;

    /// <summary>The open transfer this Module is in, and who is on the other side of it.</summary>
    /// <summary>
    /// The asking side of a transfer the other module refused. Only that side is told: for the one
    /// that refused, its own answer is not news.
    /// </summary>
    private bool WasRefused(StateMigrationJob job) =>
        job.Transfer is { ConsentStatus: ConsentStatus.Refused } transfer
        && transfer.ModuleId == Module.Id;

    private async Task LoadTransfer()
    {
        using var transfers = TransferServiceFactory.Create(PrincipalProvider);
        _transfer = await transfers.FindOpenForModule(Module.Id, OrganizationId);

        if (_transfer is not { } transfer)
        {
            _otherModuleName = null;
            _otherModuleHref = null;
            return;
        }

        var otherId = transfer.ModuleId == Module.Id
            ? transfer.CounterpartyModuleId
            : transfer.ModuleId;

        await using var db = await TransferDbContextFactory.CreateDbContextAsync();
        var other = await db.Modules.AsNoTracking()
            .Where(m => m.Id == otherId && m.OrganizationId == OrganizationId)
            .Select(m => new { m.Name, Namespace = m.Namespace.Name, Stack = m.Namespace.Stack.Name })
            .FirstOrDefaultAsync();

        _otherModuleName = other is null ? null : $"{other.Namespace}/{other.Name}";
        _otherModuleHref = other is null
            ? null
            : $"/Module/{other.Stack}/{other.Namespace}/{other.Name}?action=StateMigrations";
    }

    /// <summary>Answers a transfer this Module has been asked to agree to.</summary>
    private async Task Answer(bool granted)
    {
        if (_transfer is not { } transfer) return;

        var parameters = new DialogParameters
        {
            { nameof(TransferConsentDialog.Granted), granted },
            { nameof(TransferConsentDialog.ModuleRef), Module.SourceRevision }
        };

        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TransferConsentDialog>(
            granted ? "Agree" : "Refuse", parameters, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not TransferConsentDialog.Decision decision) return;

        _busy = true;
        try
        {
            using var service = TransferServiceFactory.Create(PrincipalProvider);
            await service.Decide(
                transfer.Id, Module.Id, OrganizationId, granted, decision.ModuleRef);

            Snackbar.Add(
                granted ? "Agreed; both modules are moving their state." : "Refused.",
                Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private StateManagementEngine? _namespaceDefaultEngine;

    /// <summary>
    /// The engine the state commands in the second tab run against, resolved the way a job
    /// resolves it: the Module's engine, else its Namespace's default, else OpenTofu.
    /// </summary>
    private StateManagementEngine ResolvedEngine =>
        Module.Engine ?? _namespaceDefaultEngine ?? StateManagementEngine.OpenTofu;

    private string EngineName => ResolvedEngine.ToString();

    /// <summary>The binary the runner invokes, which is not the enum's name: OpenTofu is `tofu`.</summary>
    private string EngineCommand => ResolvedEngine switch
    {
        StateManagementEngine.OpenTofu => "tofu",
        StateManagementEngine.Terraform => "terraform",
        StateManagementEngine.Pulumi => "pulumi",
        _ => ResolvedEngine.ToString().ToLowerInvariant()
    };

    /// <summary>State migrations drive `terraform state` operations, so not every engine has them.</summary>
    private bool EngineSupportsStateMigrations => ResolvedEngine.SupportsStateMigrations();

    /// <summary>Asks this Module's state about specific addresses. Writes nothing.</summary>
    private async Task StartLookupAddresses()
    {
        var options = new DialogOptions
        {
            CloseButton = true, CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium, FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<LookupAddressesDialog>("Lookup addresses", options);

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not List<string> addresses || addresses.Count == 0) return;

        _busy = true;
        try
        {
            using var service = StateMigrationServiceFactory.Create(PrincipalProvider);
            await service.StartLookupAddresses(Module.Id, OrganizationId, addresses);

            Snackbar.Add($"Checking {addresses.Count} addresses against this module's state.", Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_subscribedModuleId != Module.Id)
        {
            if (_subscribedModuleId is { } previous)
            {
                LogReceivedNotificationService.Unsubscribe(previous, HandleLogReceived);
                StateMigrationUpdatedNotificationService.Unsubscribe(previous, HandleJobUpdated);
            }
            LogReceivedNotificationService.Subscribe(Module.Id, HandleLogReceived);
            StateMigrationUpdatedNotificationService.Subscribe(Module.Id, HandleJobUpdated);
            _subscribedModuleId = Module.Id;

            Logger.LogDebug("State migrations panel is listening for Module {ModuleId}", Module.Id);
        }

        using var moduleRepo = ModuleRepoFactory.Create(PrincipalProvider);
        _canPause = moduleRepo.CanPause(Module.Id, OrganizationId);

        using (var jobSecuredRepo = JobSecuredRepoFactory.Create(PrincipalProvider))
        {
            _canRunJob = jobSecuredRepo.CanRunJob(Module.Id, OrganizationId);
        }

        using var stateMigrationService = StateMigrationServiceFactory.Create(PrincipalProvider);
        _blockedReason = await stateMigrationService.GetBlockedReason(Module.Id, OrganizationId);

        using var jobRepo = StateMigrationRepoFactory.Create(PrincipalProvider);
        _jobs = await jobRepo.ListByModule(Module.Id, OrganizationId);
        await LoadAddresses();
        await LoadNamespaceDefaultEngine();
        await LoadTransfer();

    }

    private async Task Pause()
    {
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<PauseModuleDialog>("Pause module", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;
        await SetPaused(true, result.Data as string);
    }

    /// <summary>
    /// Starts this Module's half of a transfer. The other Module is started the same way on its own
    /// page; nothing here coordinates the two, so both should be paused first.
    /// </summary>
    private async Task StartTransfer()
    {
        await LoadTransferCandidates();

        var parameters = new DialogParameters
        {
            { nameof(StartTransferDialog.Candidates), (IReadOnlyList<Module>)_transferCandidates },
            { nameof(StartTransferDialog.ModuleRef), Module.SourceRevision }
        };

        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<StartTransferDialog>("Transfer resources", parameters, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not StartTransferDialog.Choice choice) return;

        _busy = true;
        try
        {
            using var service = TransferServiceFactory.Create(PrincipalProvider);
            await service.Open(
                Module.Id, choice.CounterpartyModuleId, OrganizationId,
                choice.ModuleRef);

            Snackbar.Add(
                "The other module has been asked to agree. Both start once it does.",
                Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task StartMove() => StartTerraformStateMigration<MoveDialog>(
        "Move", (service, choice) => service.StartMove(Module.Id, OrganizationId, choice.Instructions));

    private Task StartImport() => StartTerraformStateMigration<ImportDialog>(
        "Import", (service, choice) => service.StartImport(Module.Id, OrganizationId, choice.Instructions));

    private Task StartRemove() => StartTerraformStateMigration<RemoveDialog>(
        "Remove", (service, choice) => service.StartRemove(Module.Id, OrganizationId, choice.Instructions));

    /// <summary>Opens one edit's dialog and runs what it returns. The dialog names the edit.</summary>
    private async Task StartTerraformStateMigration<TDialog>(
        string verb,
        Func<StateMigrationService, TerraformStateMigrationDialogBase.Choice, Task<StateMigrationJob>> start)
        where TDialog : ComponentBase
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<TDialog>(verb, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not TerraformStateMigrationDialogBase.Choice choice) return;

        _busy = true;
        try
        {
            using var service = StateMigrationServiceFactory.Create(PrincipalProvider);
            await start(service, choice);

            Snackbar.Add($"Running {verb} over {choice.Instructions.Count} addresses.", Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadTransferCandidates()
    {
        await using var db = await TransferDbContextFactory.CreateDbContextAsync();

        // Any Module in the same Stack, not just the same Namespace: a transfer moves resources
        // between two roots of one deployment, and those need not share a Namespace.
        _transferCandidates = await db.Modules.AsNoTracking()
            .Where(m => m.OrganizationId == OrganizationId
                        && m.Namespace.StackId == Module.Namespace.StackId
                        && m.Id != Module.Id)
            .OrderBy(m => m.Name)
            .ToListAsync();
    }

