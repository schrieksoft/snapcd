@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.OutputSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Interfaces.PrincipalProvider

<MudTabPanel Text="@Title" OnClick="@OnTabClick" Style="text-transform: none">
    @if (_items == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    }
    else
    {
        <MudExpansionPanels>
            @foreach (var item in _items)
            {
                <MudExpansionPanel Text="@Describe(item)">
                    <EditModuleOutputNamespaceSupply Context="@item"
                            StackId="StackId"
                            PrincipalProvider="@PrincipalProvider"
                            OnDelete="() => ResetAll()"
                            OnUpdate="() => ResetAll()"
                            OnCreate="() => ResetAll()"
                            OnCancel="() => ResetAll()"
                            IsCreateMode="false"/>
                </MudExpansionPanel>
            }

            @if (_isCreating)
            {
                <MudExpansionPanel Expanded="_newItemExpanded" ExpandedChanged="OnNewItemExpandedChanged">
                    <EditModuleOutputNamespaceSupply Context="_newItem"
                            StackId="StackId"
                            PrincipalProvider="@PrincipalProvider"
                            OnDelete="() => ResetAll()"
                            OnUpdate="() => ResetAll()"
                            OnCreate="() => ResetAll()"
                            OnCancel="() => ResetAll()"
                            IsCreateMode="true"/>
                </MudExpansionPanel>
            }

            <MudTooltip Text="@(_canAdd ? null : "You do not have permission to supply Outputs here.")"
                        Disabled="@_canAdd">
                <MudButton Disabled="@(!_canAdd)" Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="StartCreate"
                           Class="mt-2">
                    Add New
                </MudButton>
            </MudTooltip>
        </MudExpansionPanels>
    }
</MudTabPanel>

@code {
    [Parameter] public string Title { get; set; } = null!;
    [Parameter] public Guid ModuleId { get; set; }
    [Parameter] public Guid StackId { get; set; }
    [Parameter] public EventCallback OnTabClick { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private OutputNamespaceSupplySecuredRepositoryFactory RepositoryFactory { get; set; } = null!;

    private bool _canAdd = true;
    private bool _isCreating;
    private bool _newItemExpanded;
    private OutputNamespaceSupply? _newItem;
    private List<OutputNamespaceSupply>? _items;

    protected override void OnParametersSet()
    {
        using var repo = RepositoryFactory.Create(PrincipalProvider);
        _canAdd = repo.CanCreate(ModuleId, OrganizationId);
    }

    private static string Describe(OutputNamespaceSupply item) => item.OutputName + " to " + item.ConsumingNamespace.Name;

    private void StartCreate()
    {
        _newItem = new OutputNamespaceSupply { Id = Guid.NewGuid(), ModuleId = ModuleId, OrganizationId = OrganizationId };
        _isCreating = true;
        _newItemExpanded = true;
        StateHasChanged();
    }

    private void OnNewItemExpandedChanged(bool expanded)
    {
        _newItemExpanded = expanded;
        if (!expanded && _isCreating)
        {
            ResetAll();
        }
    }

    private async void ResetAll()
    {
        _isCreating = false;
        _newItemExpanded = false;
        _newItem = null;
        await ReloadItems();
        StateHasChanged();
    }

    private async Task ReloadItems()
    {
        using var repo = RepositoryFactory.Create(PrincipalProvider);
        _items = await repo.ListByParentId(ModuleId, OrganizationId,
            q => q.Include(x => x.ConsumingNamespace));
    }

    public async Task InitializeItems()
    {
        if (_items == null)
        {
            await ReloadItems();
            StateHasChanged();
        }
    }
}
