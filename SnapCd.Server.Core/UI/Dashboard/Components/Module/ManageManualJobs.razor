@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Sagas
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Crud.Jobs
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Modules
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.ModuleJobs
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using SnapCd.Server.Core.UI.Dashboard.Components.Approvals
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Transfers
@using SnapCd.Server.Core.Services.Crud.Transfers

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LogReceivedNotificationService LogReceivedNotificationService
@inject ManualJobUpdatedNotificationService ManualJobUpdatedNotificationService

@implements IDisposable

<MudPaper Elevation="1" Class="pa-4 mb-4">
    @if (ModuleSaga is { Paused: true })
    {
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">
                <strong>@(IsDraining ? "Pausing" : "Paused")</strong>
                @if (!string.IsNullOrEmpty(ModuleSaga.PauseReason))
                {
                    @: — @ModuleSaga.PauseReason
                }
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       Disabled="@(!_canPause || _busy)" OnClick="Resume">resume</MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">
                Manual jobs run against a module that is held still. Pause the module to make them available.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       Disabled="@(!_canPause || _busy)" OnClick="Pause">pause</MudButton>
        </MudStack>
    }
</MudPaper>

@if (ModuleSaga is { Paused: true })
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        @if (IsDraining)
        {
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Small"/>
                <MudText Typo="Typo.body2"><strong>Waiting for the current job to finish.</strong> @_blockedReason</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2">Prove a split against a branch. Nothing is written.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               Disabled="@(!_canPause || _busy)" OnClick="StartProve">prove split</MudButton>
                </MudStack>
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2">Split this module's monolith and migrate its state.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               Disabled="@(!_canPause || _busy)" OnClick="StartSplit">split monolith</MudButton>
                </MudStack>

                @* A transfer is two jobs, one per Module. This starts this Module's. *@
                @if (_transfer == null)
                {
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2">Move resources into another module's state.</MudText>
                        <MudTooltip Text="What moves is decided in the code, by the transfer map the code move writes. Each module moves its own state, as its own job.">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                       Disabled="@(!_canPause || _busy)" OnClick="StartTransfer">transfer resources</MudButton>
                        </MudTooltip>
                    </MudStack>
                }
                else
                {
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2">
                            Transfer @(_transfer.SourceModuleId == Module.Id ? "to" : "from") @OtherModuleName.
                        </MudText>

                        @if (_transfer.Scope != TransferScope.Both)
                        {
                            <MudTooltip Text="@($"This transfer covers {(_transfer.Scope == TransferScope.SourceOnly ? "the source" : "the receiver")} only. Finishing the other side is a transfer of its own.")">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                                    @(_transfer.Scope == TransferScope.SourceOnly ? "source only" : "receiver only")
                                </MudChip>
                            </MudTooltip>
                        }

                        @if (NeedsMyConsent)
                        {
                            <MudTooltip Text="Consenting lets this transfer move resources into this module's state. It is asked once, and holds until the job starts.">
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                           Disabled="@(!_canPause || _busy)"
                                           OnClick="@(() => Consent(true))">grant consent</MudButton>
                            </MudTooltip>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                       Disabled="@(!_canPause || _busy)"
                                       OnClick="@(() => Consent(false))">refuse</MudButton>
                        }
                        else if (CanRunTransfer)
                        {
                            <MudTooltip Text="Plans both modules, proves the move changes nothing, and - once approved - writes their state. They run at once.">
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                           Disabled="@(!_canPause || _busy)"
                                           OnClick="RunTransfer">move state</MudButton>
                            </MudTooltip>
                        }
                    </MudStack>

                }
            </MudStack>
        }
    </MudPaper>
}

@if (_jobs.Count == 0)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.body2">No manual jobs have run on this module.</MudText>
    </MudPaper>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var job in _jobs.OrderByDescending(j => j.TimestampStart))
        {
            var dotColor = job.Status switch
            {
                ExecutionStatus.Running => "var(--snap-running, #EB753C)",
                ExecutionStatus.Completed => "var(--mud-palette-success)",
                ExecutionStatus.Failed => "var(--snap-failed, #C62828)",
                ExecutionStatus.NotApproved => "var(--snap-failed, #C62828)",
                ExecutionStatus.Cancelled => "var(--mud-palette-text-disabled)",
                _ => "var(--mud-palette-text-disabled)"
            };

            var elapsed = DateTimeOffset.UtcNow - job.TimestampStart;
            var elapsedDisplay = elapsed.TotalMinutes < 1 ? "just now"
                : elapsed.TotalMinutes < 60 ? $"{(int)elapsed.TotalMinutes}m ago"
                : elapsed.TotalHours < 24 ? $"{(int)elapsed.TotalHours}h ago"
                : elapsed.TotalHours < 48 ? "yesterday"
                : $"{(int)elapsed.TotalDays}d ago";

            <MudExpansionPanel Class="mb-2" @key="job.Id"
                               Expanded="@(job.Id == _selected?.Id)"
                               ExpandedChanged="@(isExpanded => OnPanelExpanded(isExpanded, job))">
                <TitleContent>
                    <div style="display: flex; align-items: center; gap: 12px; width: 100%;">
                        <MudTooltip Text="@job.Status.ToString()">
                            @if (job.Status == ExecutionStatus.Running)
                            {
                                <span class="job-status-running" style="color: @dotColor;">
                                    <span class="job-status-dot" style="background-color: @dotColor;"></span>
                                </span>
                            }
                            else
                            {
                                <span class="job-status-dot" style="background-color: @dotColor;"></span>
                            }
                        </MudTooltip>
                        <span style="font-weight: 500; font-size: 14px;">@FormatJobType(job.JobType) #@job.JobNumber</span>
                        @if (job.WaitingForApproval == true)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">Awaiting approval</MudChip>
                        }
                        <span style="flex: 1;"></span>
                        <span style="font-size: 14px; color: var(--mud-palette-text-secondary); white-space: nowrap;">
                            @job.Status · @elapsedDisplay
                        </span>
                        @if (job.Status == ExecutionStatus.Running)
                        {
                            <MudTooltip Text="Cancel Job">
                                <MudIconButton Icon="@SnapCdIcons.Cancel"
                                               Color="Color.Primary" Size="Size.Small"
                                               OnClick="() => CancelJob(job.Id, job.WaitingForApproval == true)"/>
                            </MudTooltip>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (!string.IsNullOrWhiteSpace(job.ServerSideError))
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="ma-4 mb-0">
                            <MudText Typo="Typo.h6" Class="mb-2">Server-Side Error</MudText>
                            <MudText>@job.ServerSideErrorHeader</MudText>
                            <MudText Typo="Typo.subtitle2" Class="mb-1">@job.ServerSideError</MudText>
                        </MudAlert>
                    }

                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" KeepPanelsAlive="true">
                        <MudTabPanel Text="Logs" Style="text-transform: none">
                            <ListLogs ModuleJobId="@job.Id" @key="job.Id"
                                      @ref="_listLogsRefs[job.Id]"/>
                        </MudTabPanel>
                        <MudTabPanel Text="Approvals" Style="text-transform: none">
                            @if (job is { WaitingForApproval: true })
                            {
                                <MudAlert Severity="Severity.Info" Class="mb-3">
                                    This job has proved every module plans to zero changes and is waiting for approval
                                    before it pushes state. The push cannot be undone.
                                </MudAlert>
                            }

                            <ApprovalPanel Source="@GetApprovalSource()"
                                           JobId="@job.Id"
                                           ModuleId="@Module.Id"
                                           Enabled="@(_canPause && !_busy)"
                                           OnDecided="Reload"
                                           @key="job.Id"/>
                        </MudTabPanel>
                    </MudTabs>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    [Parameter] public required Module Module { get; set; }
    [Parameter] public required ModuleSaga ModuleSaga { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ModuleSagaSecuredRepositoryFactory SagaRepoFactory { get; set; } = null!;
    [Inject] private ModuleSecuredRepositoryFactory ModuleRepoFactory { get; set; } = null!;
    [Inject] private ManualJobServiceFactory ManualJobServiceFactory { get; set; } = null!;
    [Inject] private TransferServiceFactory TransferServiceFactory { get; set; } = null!;
    [Inject] private TransferOpenerFactory TransferOpenerFactory { get; set; } = null!;
    [Inject] private IDbContextFactory<SnapCdDbContext> TransferDbContextFactory { get; set; } = null!;
    [Inject] private ManualModuleJobSecuredRepositoryFactory ManualJobRepoFactory { get; set; } = null!;
    [Inject] private IDbContextFactory<SnapCdDbContext> DbContextFactory { get; set; } = null!;

    private string? _blockedReason;
    private List<ManualModuleJob> _jobs = [];
    private readonly Dictionary<Guid, ListLogs> _listLogsRefs = new();
    private readonly HashSet<Guid> _loadedLogs = [];
    private Guid? _subscribedModuleId;
    private ManualModuleJob? _selected;

    private IApprovalSource GetApprovalSource() =>
        _approvalSource ??= new ManualJobApprovalSource(
            ManualJobRepoFactory,
            ManualJobServiceFactory,
            DbContextFactory,
            PrincipalProvider ?? new HttpContextPrincipalProvider(new HttpContextAccessor()));

    private IApprovalSource? _approvalSource;

    /// Inside a paused module, any remaining block is work still draining: the pause itself is not one.
    private bool IsDraining => ModuleSaga is { Paused: true } && _blockedReason is not null;

    private bool _canPause;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        if (_subscribedModuleId != Module.Id)
        {
            if (_subscribedModuleId is { } previous)
            {
                LogReceivedNotificationService.Unsubscribe(previous, HandleLogReceived);
                ManualJobUpdatedNotificationService.Unsubscribe(previous, HandleJobUpdated);
            }
            LogReceivedNotificationService.Subscribe(Module.Id, HandleLogReceived);
            ManualJobUpdatedNotificationService.Subscribe(Module.Id, HandleJobUpdated);
            _subscribedModuleId = Module.Id;
        }

        using var moduleRepo = ModuleRepoFactory.Create(PrincipalProvider);
        _canPause = moduleRepo.CanPause(Module.Id, OrganizationId);

        using var manualJobService = ManualJobServiceFactory.Create(PrincipalProvider);
        _blockedReason = await manualJobService.GetBlockedReason(Module.Id, OrganizationId);

        using var jobRepo = ManualJobRepoFactory.Create(PrincipalProvider);
        _jobs = await jobRepo.ListByModule(Module.Id, OrganizationId);

        using var transfers = TransferServiceFactory.Create(PrincipalProvider);
        _transfer = (await transfers.ListForModule(Module.Id, OrganizationId))
            .FirstOrDefault(t => _jobs.All(j => j.TransferId != t.Id || j.Status == ExecutionStatus.Running));

        if (_transfer is { } transfer)
        {
            var otherId = transfer.SourceModuleId == Module.Id
                ? transfer.ReceiverModuleId
                : transfer.SourceModuleId;

            await using var db = await TransferDbContextFactory.CreateDbContextAsync();
            _otherModuleName = await db.Modules.AsNoTracking()
                .Where(m => m.Id == otherId && m.OrganizationId == OrganizationId)
                .Select(m => m.Name)
                .FirstOrDefaultAsync();
        }
    }

    private async Task Pause()
    {
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<PauseModuleDialog>("Pause module", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;
        await SetPaused(true, result.Data as string);
    }

    private async Task Resume() => await SetPaused(false, null);

    private Transfer? _transfer;
    private string? _otherModuleName;
    private List<Module> _transferCandidates = [];

    private string OtherModuleName => _otherModuleName ?? "the other module";

    /// <summary>This Module is the receiver and has not answered yet.</summary>
    private bool NeedsMyConsent =>
        _transfer is { ReceiverConsentStatus: ConsentStatus.Pending }
        && _transfer.ReceiverModuleId == Module.Id;

    /// <summary>
    /// Consent is in and nothing has run yet. Both Modules move at once, so either side's page
    /// starts the whole transfer.
    /// </summary>
    private bool CanRunTransfer =>
        _transfer is not null
        && _transfer.ReceiverConsentStatus is ConsentStatus.Granted or ConsentStatus.NotRequired
        && _jobs.All(j => j.TransferId != _transfer.Id);


    /// <summary>Opens a transfer from this Module. Its map is read from the ref, in the background.</summary>
    private async Task StartTransfer()
    {
        await LoadTransferCandidates();

        var parameters = new DialogParameters
        {
            { nameof(StartTransferDialog.Candidates), (IReadOnlyList<Module>)_transferCandidates },
            { nameof(StartTransferDialog.ProveRef), Module.SourceRevision }
        };

        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<StartTransferDialog>("Transfer resources", parameters, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not StartTransferDialog.Choice choice) return;

        _busy = true;
        try
        {
            var opener = TransferOpenerFactory.Create(PrincipalProvider);
            await opener.Open(
                Module.Id, choice.ReceiverModuleId, OrganizationId, choice.ProveRef, choice.Scope);

            Snackbar.Add("Transfer opened; the receiving module has been asked to consent.", Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Consent(bool granted)
    {
        if (_transfer is not { } transfer) return;

        var parameters = new DialogParameters
        {
            { nameof(TransferConsentDialog.Granted), granted },
            { nameof(TransferConsentDialog.ProveRef), transfer.ReceiverProveRef ?? Module.SourceRevision }
        };

        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TransferConsentDialog>(
            granted ? "Grant consent" : "Refuse", parameters, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not TransferConsentDialog.Decision decision) return;

        _busy = true;
        try
        {
            using var service = TransferServiceFactory.Create(PrincipalProvider);
            await service.Decide(
                transfer.Id, Module.Id, OrganizationId, granted, decision.ProveRef, decision.Reason);

            Snackbar.Add(granted ? "Consent granted." : "Consent refused.", Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Starts this Module's half of the transfer. The other Module runs its own.</summary>
    private async Task RunTransfer()
    {
        if (_transfer is not { } transfer) return;

        _busy = true;
        try
        {
            using var service = ManualJobServiceFactory.Create(PrincipalProvider);
            var jobs = await service.StartTransfer(transfer.Id, OrganizationId);

            Snackbar.Add(
                jobs.Count > 1 ? "Moving both modules' state." : "Moving this module's state.",
                Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadTransferCandidates()
    {
        await using var db = await TransferDbContextFactory.CreateDbContextAsync();

        _transferCandidates = await db.Modules.AsNoTracking()
            .Where(m => m.OrganizationId == OrganizationId
                        && m.NamespaceId == Module.NamespaceId
                        && m.Id != Module.Id)
            .OrderBy(m => m.Name)
            .ToListAsync();
    }

    private async Task StartSplit()
    {
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SplitMigrateDialog>("SplitMigrate", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;
        if (result.Data is not SplitMigrateDialog.SplitMigrateOptions choice) return;

        _busy = true;
        try
        {
            using var service = ManualJobServiceFactory.Create(PrincipalProvider);
            await service.StartSplitMigrate(Module.Id, OrganizationId, choice.RootDirectory, choice.Force, rederiveBackend: choice.RederiveBackend);

            Snackbar.Add("Split started.", Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartProve()
    {
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<SplitProveDialog>("Prove split", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;
        if (result.Data is not SplitProveDialog.SplitProveOptions choice) return;

        _busy = true;
        try
        {
            using var service = ManualJobServiceFactory.Create(PrincipalProvider);
            await service.StartSplitProve(Module.Id, OrganizationId, choice.RootDirectory, choice.SourceRevision);

            Snackbar.Add("Prove started.", Severity.Success);
            await Reload();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelJob(Guid jobId, bool waitingForApproval)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<CancelManualModuleJobDialog>
        {
            { x => x.JobId, jobId },
            { x => x.ModuleId, Module.Id },
            { x => x.OrganizationId, OrganizationId },
            { x => x.PrincipalProvider, PrincipalProvider },
            { x => x.WaitingForApproval, waitingForApproval }
        };

        var dialog = await DialogService.ShowAsync<CancelManualModuleJobDialog>("Cancel", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false }) await Reload();
    }

    private async Task HandleJobUpdated(Guid jobId, Guid moduleId)
    {
        if (moduleId != Module.Id) return;

        using var jobRepo = ManualJobRepoFactory.Create(PrincipalProvider);
        _jobs = await jobRepo.ListByModule(Module.Id, OrganizationId);

        using var transfers = TransferServiceFactory.Create(PrincipalProvider);
        _transfer = (await transfers.ListForModule(Module.Id, OrganizationId))
            .FirstOrDefault(t => _jobs.All(j => j.TransferId != t.Id || j.Status == ExecutionStatus.Running));

        if (_transfer is { } transfer)
        {
            var otherId = transfer.SourceModuleId == Module.Id
                ? transfer.ReceiverModuleId
                : transfer.SourceModuleId;

            await using var db = await TransferDbContextFactory.CreateDbContextAsync();
            _otherModuleName = await db.Modules.AsNoTracking()
                .Where(m => m.Id == otherId && m.OrganizationId == OrganizationId)
                .Select(m => m.Name)
                .FirstOrDefaultAsync();
        }

        using var manualJobService = ManualJobServiceFactory.Create(PrincipalProvider);
        _blockedReason = await manualJobService.GetBlockedReason(Module.Id, OrganizationId);

        await InvokeAsync(StateHasChanged);
    }

    // A running job's logs arrive after the panel is open, so the open panel is
    // told to refresh rather than waiting to be reopened.
    private async Task HandleLogReceived(Guid jobId, Guid moduleId)
    {
        if (moduleId != Module.Id) return;

        if (_loadedLogs.Contains(jobId) && _listLogsRefs.TryGetValue(jobId, out var listLogs))
            await listLogs.RefreshLogs(true);
    }

    public void Dispose()
    {
        if (_subscribedModuleId is { } moduleId)
        {
            LogReceivedNotificationService.Unsubscribe(moduleId, HandleLogReceived);
            ManualJobUpdatedNotificationService.Unsubscribe(moduleId, HandleJobUpdated);
        }
    }

    private async Task OnPanelExpanded(bool isExpanded, ManualModuleJob job)
    {
        if (!isExpanded)
        {
            if (_selected?.Id == job.Id) _selected = null;
            return;
        }

        _selected = job;

        // ListLogs does not load itself; the panel that opens it asks it to.
        if (!_loadedLogs.Contains(job.Id) && _listLogsRefs.TryGetValue(job.Id, out var listLogs))
        {
            await listLogs.InitializeLogs();
            _loadedLogs.Add(job.Id);
        }
    }

    private async Task Reload()
    {
        using var manualJobService = ManualJobServiceFactory.Create(PrincipalProvider);
        _blockedReason = await manualJobService.GetBlockedReason(Module.Id, OrganizationId);

        using var jobRepo = ManualJobRepoFactory.Create(PrincipalProvider);
        _jobs = await jobRepo.ListByModule(Module.Id, OrganizationId);

        using var transfers = TransferServiceFactory.Create(PrincipalProvider);
        _transfer = (await transfers.ListForModule(Module.Id, OrganizationId))
            .FirstOrDefault(t => _jobs.All(j => j.TransferId != t.Id || j.Status == ExecutionStatus.Running));

        if (_transfer is { } transfer)
        {
            var otherId = transfer.SourceModuleId == Module.Id
                ? transfer.ReceiverModuleId
                : transfer.SourceModuleId;

            await using var db = await TransferDbContextFactory.CreateDbContextAsync();
            _otherModuleName = await db.Modules.AsNoTracking()
                .Where(m => m.Id == otherId && m.OrganizationId == OrganizationId)
                .Select(m => m.Name)
                .FirstOrDefaultAsync();
        }
    }

    private async Task SetPaused(bool paused, string? reason)
    {
        _busy = true;
        try
        {
            using var sagaRepo = SagaRepoFactory.Create(PrincipalProvider);
            await sagaRepo.SetPaused(Module.Id, OrganizationId, paused, reason);
            // The page re-renders from ModuleSagaModifiedEvent via the fanout notification service.
            Snackbar.Add(paused ? "Module paused." : "Module resumed.", Severity.Success);
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// The stored value names the saga table; the tab shows the operation.
    private static string FormatJobType(string jobType) =>
        jobType == ManualJobTypes.SplitMigrate ? "SplitMigrate" : jobType;
}
