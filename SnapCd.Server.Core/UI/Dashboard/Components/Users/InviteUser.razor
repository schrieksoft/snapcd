@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@using SnapCd.Server.Core.Factories

@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-4">Invite User</MudText>

    @if (_noOpInvitationLink is null)
    {
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator/>

            <MudTextField @bind-Value="_model.Email"
                          Label="Email Address"
                          For="@(() => _model.Email)"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          HelperText="Enter the email address of the user to invite"/>

            <MudStack Row Class="mt-2">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           Disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    }
                    Send Invitation
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="HandleCancel"
                           Disabled="@_isSubmitting">
                    Cancel
                </MudButton>
            </MudStack>
        </EditForm>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            <MudText Typo="Typo.body2" Class="mb-2">
                <strong>Email delivery is not configured on this server.</strong>
                Send the invitation link below to the user manually (Slack, SMS, in person, etc.).
            </MudText>
        </MudAlert>
        <MudTextField @bind-Value="_noOpInvitationLink" ReadOnly="true" Variant="Variant.Outlined"
                      Label="Invitation link" Class="mb-2" />
        <MudStack Row Class="mt-2">
            <MudButton OnClick="CopyLink" Variant="Variant.Filled" Color="Color.Secondary"
                                                                   Size="Size.Small"
                       StartIcon="@SnapCdIcons.ContentCopy">
                Copy link
            </MudButton>
            <MudButton OnClick="DismissAfterNoOp" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small">
                Done
            </MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public EventCallback<Guid> OnInvited { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private MemberServiceFactory MemberServiceFactory { get; set; } = null!;
    [Inject] private IdentityUserAccessorFactory UserAccessorFactory { get; set; } = null!;

    private InviteUserModel _model = new();
    private bool _isSubmitting;
    private Guid? _invitedOrgUserId;
    private string? _noOpInvitationLink;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        try
        {
            using var userAccessor = UserAccessorFactory.Create();
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUser = await userAccessor.UserAccessor.GetRequiredUserAsync(authState);

            using var memberService = MemberServiceFactory.Create();
            var (orgUser, invitationLink, emailSent) = await memberService.Service.InviteMemberAsync(
                OrganizationId,
                _model.Email!,
                currentUser.Id);

            if (emailSent)
            {
                await OnInvited.InvokeAsync(orgUser.Id);
            }
            else
            {
                // Email was no-op'd (NoOp transport, or licence gate downgraded). Surface the link
                // inline so the admin can relay it manually.
                _invitedOrgUserId = orgUser.Id;
                _noOpInvitationLink = invitationLink;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to send invitation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CopyLink()
    {
        if (_noOpInvitationLink is null) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _noOpInvitationLink);
        Snackbar.Add("Link copied to clipboard", Severity.Success);
    }

    private async Task DismissAfterNoOp()
    {
        if (_invitedOrgUserId is { } id)
        {
            await OnInvited.InvokeAsync(id);
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private class InviteUserModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string? Email { get; set; }
    }
}
