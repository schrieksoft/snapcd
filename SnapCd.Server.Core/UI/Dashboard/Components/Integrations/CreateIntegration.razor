@using System.Text.Json
@using SnapCd.Contracts
@using SnapCd.Contracts.Dto.Integrations
@inject SnapCd.Server.Core.Services.Integrations.IntegrationService Service
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" GutterBottom="true">New Integration</MudText>
    @if (!_canCreate)
    {
        <ReadOnlyNotice Message="You do not have permission to create an Integration."/>
    }
    <MudGrid>
        <MudItem xs="12">
            <MudSelect Disabled="@(!_canCreate)" T="IntegrationType" @bind-Value="_model.IntegrationType" Label="Integration Type">
                @foreach (var t in Enum.GetValues<IntegrationType>())
                {
                    <MudSelectItem T="IntegrationType" Value="t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudTextField Disabled="@(!_canCreate)" @bind-Value="_model.Name" Label="Name"/>
        </MudItem>

        @if (_model.IntegrationType == IntegrationType.Slack)
        {
            <MudItem xs="12">
                <MudTextField Disabled="@(!_canCreate)" @bind-Value="_model.DefaultChannel"
                              Label="Default channel (e.g. #alerts or channel id)"/>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Disabled="@(!_canCreate)" @bind-Value="_model.BotToken"
                              Label="Bot token (xoxb-…)" InputType="MudBlazor.InputType.Password"/>
            </MudItem>
        }

        <MudItem xs="12">
            <MudSwitch Disabled="@(!_canCreate)" T="bool" @bind-Value="_model.IsSuppliedToAllModules" Label="Supplied to all modules" Color="Color.Secondary"/>
        </MudItem>

        <MudItem xs="12">
            <MudSwitch Disabled="@(!_canCreate)" T="bool" @bind-Value="_model.Enabled" Label="Enabled" Color="Color.Secondary"/>
        </MudItem>

        <MudItem xs="12">
            <MudStack Row Spacing="2">
                @if (_canCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="Submit">Create</MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public EventCallback OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    private readonly Model _model = new();
    private bool _canCreate = true;

    protected override void OnParametersSet() => _canCreate = Service.CanCreate(OrganizationId);

    private async Task Submit()
    {
        try
        {
            await Service.Create(OrganizationId, new IntegrationCreateDto
            {
                Name = _model.Name,
                IntegrationType = _model.IntegrationType,
                Enabled = _model.Enabled,
                IsSuppliedToAllModules = _model.IsSuppliedToAllModules,
                Connection = BuildConnection(_model.IntegrationType, _model.BotToken, _model.DefaultChannel)
            });

            Snackbar.Add("Integration created.", Severity.Success);
            await OnCreated.InvokeAsync();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

    private Task Cancel() => OnCancel.InvokeAsync();

    /// <summary>Slack is the only type with a connection shape; the rest carry an empty object.</summary>
    private static JsonElement BuildConnection(IntegrationType type, string botToken, string defaultChannel)
    {
        return type switch
        {
            IntegrationType.Slack => JsonSerializer.SerializeToElement(new { botToken, defaultChannel }),
            _ => JsonSerializer.SerializeToElement(new { })
        };
    }

    private sealed class Model
    {
        public IntegrationType IntegrationType { get; set; } = IntegrationType.Slack;
        public string Name { get; set; } = "";
        public string DefaultChannel { get; set; } = "";
        public string BotToken { get; set; } = "";
        public bool IsSuppliedToAllModules { get; set; }
        public bool Enabled { get; set; } = true;
    }
}
