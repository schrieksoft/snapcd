@typeparam TRow

@foreach (var group in Rows
    .GroupBy(IntegrationIdSelector)
    .OrderBy(g => IntegrationNameLookup(g.Key), StringComparer.OrdinalIgnoreCase))
{
    <div class="mb-3">
        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 4px;">
            <MudText Typo="Typo.body1"><strong>Integration: @IntegrationNameLookup(group.Key)</strong></MudText>
        </div>
        <MudTable Items="group.OrderBy(TriggerSelector).ToList()" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Trigger</MudTh>
                <MudTh>Template</MudTh>
                <MudTh>Filter</MudTh>
                <MudTh>Disabled</MudTh>
                @if (OnEdit.HasDelegate || OnDelete.HasDelegate)
                {
                    <MudTh></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd>@TriggerSelector(context)</MudTd>
                <MudTd>@(TemplateSelector?.Invoke(context) ?? string.Empty)</MudTd>
                <MudTd>@(FilterSelector?.Invoke(context) ?? string.Empty)</MudTd>
                <MudTd>@(IsDisabledSelector(context) ? "yes" : "no")</MudTd>
                @if (OnEdit.HasDelegate || OnDelete.HasDelegate)
                {
                    <MudTd>
                        @if (OnEdit.HasDelegate)
                        {
                            <MudIconButton Icon="@SnapCdIcons.Edit" Size="Size.Small"
                                           OnClick="@(() => OnEdit.InvokeAsync(context))"/>
                        }
                        @if (OnDelete.HasDelegate)
                        {
                            <MudIconButton Icon="@SnapCdIcons.Delete" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OnDelete.InvokeAsync(context))"/>
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    </div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<TRow> Rows { get; set; } = Array.Empty<TRow>();
    [Parameter, EditorRequired] public Func<TRow, Guid> IntegrationIdSelector { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TRow, string> TriggerSelector { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TRow, bool> IsDisabledSelector { get; set; } = null!;
    [Parameter] public Func<TRow, string?>? TemplateSelector { get; set; }
    [Parameter] public Func<TRow, string?>? FilterSelector { get; set; }
    [Parameter, EditorRequired] public Func<Guid, string> IntegrationNameLookup { get; set; } = null!;
    [Parameter] public EventCallback<TRow> OnEdit { get; set; }
    [Parameter] public EventCallback<TRow> OnDelete { get; set; }
}
