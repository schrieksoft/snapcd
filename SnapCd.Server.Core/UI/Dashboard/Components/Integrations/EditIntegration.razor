@using System.Text.Json
@using SnapCd.Contracts
@using SnapCd.Contracts.Dto.Integrations
@inject SnapCd.Server.Core.Services.Integrations.IntegrationService Service
@inject ISnackbar Snackbar

@if (_model is null)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
}
else
{
    <MudForm ReadOnly="@(!_canSave)">
        @if (!_canSave)
        {
            <ReadOnlyNotice/>
        }

        <MudPaper Elevation="0" Class="pa-4">
            <MudTextField @bind-Value="_model.Name" Label="Name" Class="mb-2"/>
            @if (IntegrationType == IntegrationType.Slack)
            {
                <MudTextField @bind-Value="_model.DefaultChannel" Label="Default channel" Class="mb-2"/>
                <MudTextField @bind-Value="_model.BotToken" Label="Bot token (leave masked to keep)" InputType="MudBlazor.InputType.Password" Class="mb-2"/>
            }
            <MudSwitch T="bool" @bind-Value="_model.IsSuppliedToAllModules" Label="Supplied to all modules" Color="Color.Secondary"/>
            <MudSwitch T="bool" @bind-Value="_model.Enabled" Label="Enabled" Color="Color.Secondary"/>
            <div class="mt-2">
                <MudTooltip Text="@SaveDisabledReason" Disabled="@(SaveDisabledReason is null)">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               Disabled="@(!_canSave)" OnClick="Save">
                        Save
                    </MudButton>
                </MudTooltip>
            </div>
        </MudPaper>
    </MudForm>
}

@code {
    [Parameter] public required Guid IntegrationId { get; set; }
    [Parameter] public required IntegrationType IntegrationType { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    private Model? _model;
    private bool _canSave;

    private string? SaveDisabledReason => _canSave ? null : "You do not have permission to change this.";

    protected override async Task OnInitializedAsync()
    {
        _canSave = Service.CanUpdate(IntegrationId, OrganizationId);

        var detail = await Service.Get(IntegrationId, OrganizationId);
        var model = new Model
        {
            Name = detail.Name,
            Enabled = detail.Enabled,
            IsSuppliedToAllModules = detail.IsSuppliedToAllModules
        };

        if (!string.IsNullOrEmpty(detail.Connection))
        {
            using var doc = JsonDocument.Parse(detail.Connection);
            if (detail.IntegrationType == IntegrationType.Slack)
            {
                if (doc.RootElement.TryGetProperty("defaultChannel", out var channel))
                    model.DefaultChannel = channel.GetString() ?? "";
                if (doc.RootElement.TryGetProperty("botToken", out var token))
                    model.BotToken = token.GetString() ?? "";
            }
        }

        _model = model;
    }

    private async Task Save()
    {
        if (_model is null) return;

        try
        {
            await Service.Update(IntegrationId, OrganizationId, new IntegrationUpdateDto
            {
                Name = _model.Name,
                Enabled = _model.Enabled,
                IsSuppliedToAllModules = _model.IsSuppliedToAllModules,
                Connection = BuildConnection(IntegrationType, _model.BotToken, _model.DefaultChannel)
            });

            Snackbar.Add("Saved.", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

    /// <summary>Slack is the only type with a connection shape; the rest carry an empty object.</summary>
    private static JsonElement BuildConnection(IntegrationType type, string botToken, string defaultChannel)
    {
        return type switch
        {
            IntegrationType.Slack => JsonSerializer.SerializeToElement(new { botToken, defaultChannel }),
            _ => JsonSerializer.SerializeToElement(new { })
        };
    }

    private sealed class Model
    {
        public string Name { get; set; } = "";
        public string DefaultChannel { get; set; } = "";
        public string BotToken { get; set; } = "";
        public bool IsSuppliedToAllModules { get; set; }
        public bool Enabled { get; set; }
    }
}
