@using SnapCd.Server.Core.Entities.Definition.Secrets.Scoped
@using SnapCd.Server.Core.Services.Crud.Secrets
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Secrets


<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudForm @ref="_form">
        <MudGrid Class="pa-4">
            <!-- Read-only IDs -->
            <MudItem md="12">
                <MudTextField Label="Stack ID" @bind-Value="Secret.Id" Variant="Variant.Outlined" ReadOnly
                              Disabled="true"/>
            </MudItem>

            <!-- Core Properties -->
            <MudItem md="12">
                <MudTextField Label="Name" @bind-Value="Secret.Name"
                              Variant="Variant.Outlined" Required RequiredError="Name is required"
                              MaxLength="255" Counter="255"/>
            </MudItem>

            <!-- Remote Secret Value Section -->
            <MudItem md="11">
                <MudTextField Label="Secret Value" @bind-Value="_remoteSecretValue"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="TogglePasswordVisibility"/>
            </MudItem>
            <MudItem md="1" Class="d-flex align-center">
                <MudTooltip Text="Fetch remote value from Key Vault">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary"
                                   OnClick="LoadRemoteValue" Disabled="_isLoadingRemote"/>
                </MudTooltip>
            </MudItem>

            <!-- Action Buttons -->
            <MudItem md="12">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveStack">Save</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2" OnClick="OnCancel">Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2" OnClick="DeleteSecret">Delete
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public required StackSecret Secret { get; set; }
    [Parameter] public required EventCallback OnSaved { get; set; }
    [Parameter] public required EventCallback OnCancel { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    [Inject] private SecretServiceFactory SecretServiceFactory { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;

    private MudForm? _form;
    private string _remoteSecretValue = string.Empty;
    private bool _isLoadingRemote = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordInputType == InputType.Password)
        {
            _passwordInputType = InputType.Text;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordInputType = InputType.Password;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task LoadRemoteValue()
    {
        _isLoadingRemote = true;
        try
        {
            using var secretService = SecretServiceFactory.Create(PrincipalProvider);
            _remoteSecretValue = await secretService.GetRemote(Secret.Id, OrganizationId);
            Snackbar.Add("Remote secret value loaded successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading remote secret: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingRemote = false;
        }
    }

    private async Task SaveStack()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            using var secretService = SecretServiceFactory.Create(PrincipalProvider);
            await secretService.Update(Secret, OrganizationId, _remoteSecretValue);

            Snackbar.Add("Secret updated successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving secret: {ex.Message}", Severity.Error);
        }
    }


    private async Task DeleteSecret()
    {
        var parameters = new DialogParameters<DeleteStackSecretDialog>
        {
            { x => x.StackSecret, Secret },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<DeleteStackSecretDialog>(
            "Delete Secret",
            parameters,
            options
        );

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            try
            {
                using var secretService = SecretServiceFactory.Create(PrincipalProvider);
                await secretService.Delete(Secret.Id, OrganizationId);

                Snackbar.Add("Secret deleted successfully", Severity.Success);
                await OnSaved.InvokeAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting secret: {ex.Message}", Severity.Error);
            }
        }
    }

}