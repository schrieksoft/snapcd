@using SnapCd.Server.Core.UI.Dashboard.Components.Stack.Secrets
@using Microsoft.AspNetCore.Components
@using SnapCd.Server.Core.Entities.Definition.Secrets.Scoped
@using SnapCd.Server.Core.Repositories.Organizations.Secured.Secrets.Scoped
@using SnapCd.Server.Core.Services.PrincipalProvider

@implements IDisposable

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PersistentComponentState ApplicationState


@if (!_showCreateSecret)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   Class="mb-4"
                   OnClick="() => _showCreateSecret = true">
            Create
        </MudButton>
    }


    @if (_showCreateSecret)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudItem xs="12" md="12">

                        <CreateStackSecret
                            StackId="@StackId"
                            PrincipalProvider="@PrincipalProvider"
                            OnSaved="async () => { _showCreateSecret = false; await ReloadSecrets(); }"
                            OnCancel="() => _showCreateSecret = false"/>

                    </MudItem>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }


    @foreach (var secret in _secrets)
    {
        <MudExpansionPanel Class="custom-panel" @key="secret.Id">
            <TitleContent>
                <MudText Class="d-flex">@secret.Name</MudText>
            </TitleContent>
            <ChildContent>
                <EditStackSecret
                    Secret="@secret"
                    PrincipalProvider="@PrincipalProvider"
                    OnSaved="async () => await ReloadSecrets()"
                    OnCancel="EventCallback.Empty"/>
            </ChildContent>
        </MudExpansionPanel>
    }


<style>
    .custom-panel {
        box-shadow: none !important;
        border-radius: 0 !important;
        border-bottom: 1px solid #e0e0e0 !important;
    }

    .custom-panel > .mud-expand-panel {
        border-top: 1px solid #e0e0e0 !important;
        border-bottom: 1px solid #e0e0e0 !important;
    }
</style>


@code {
    [Parameter] public required Guid StackId { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private StackSecretSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    private List<StackSecret> _secrets = new();
    private bool _showCreateSecret;
    // private PersistingComponentStateSubscription _persistenceSubscription;

    protected override async Task OnInitializedAsync()
    {
        await ReloadSecrets();

        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // var cacheKey = $"ManageStackSecrets_{StackId}";
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(() =>
        // {
        //     ApplicationState.PersistAsJson(cacheKey, _secrets);
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<List<StackSecret>>(cacheKey, out var cachedSecrets))
        // {
        //     _secrets = cachedSecrets ?? new List<StackSecret>();
        // }
    }

    private async Task ReloadSecrets()
    {
        using var repo = RepoFactory.Create(PrincipalProvider);
        _secrets = await repo.ListByParentId(StackId, OrganizationId);
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
    }

}