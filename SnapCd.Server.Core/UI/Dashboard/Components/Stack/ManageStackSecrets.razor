@using SnapCd.Server.Core.UI.Dashboard.Components.Stack.Secrets
@using Microsoft.AspNetCore.Components
@using SnapCd.Server.Core.Entities.Definition.Secrets.Scoped
@using SnapCd.Server.Core.Repositories.Organizations.Secured.Secrets.Scoped
@using SnapCd.Server.Core.Services.PrincipalProvider

@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* A Stack is the top scope for secrets, so there is nothing to inherit and no
   tab bar here. Module and Namespace show "Inherited from ..." tabs instead. *@

@if (!_showCreateSecret)
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Size="Size.Small"
               Class="mb-3"
               OnClick="() => _showCreateSecret = true">
        Add Secret
    </MudButton>
}

@if (_showCreateSecret)
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <CreateStackSecret
            StackId="@StackId"
            PrincipalProvider="@PrincipalProvider"
            OnSaved="async () => { _showCreateSecret = false; await ReloadSecrets(); }"
            OnCancel="() => _showCreateSecret = false"/>
    </MudPaper>
}

@if (_secrets.Count == 0)
{
    <MudText Typo="Typo.body2">No secrets configured directly on this Stack.</MudText>
}
else
{
    @* Own container: without this the panels are adopted by the outer accordion in
       ConfigureStack (MultiExpansion="false"), so expanding a secret collapses the
       "Manage Secrets" section around it. *@
    <MudExpansionPanels MultiExpansion="true" Elevation="0">
        @foreach (var secret in _secrets)
        {
            <MudExpansionPanel @key="secret.Id">
                <TitleContent>
                    <MudText>@secret.Name</MudText>
                </TitleContent>
                <ChildContent>
                    <EditStackSecret
                        Secret="@secret"
                        PrincipalProvider="@PrincipalProvider"
                        OnSaved="async () => await ReloadSecrets()"
                        OnCancel="EventCallback.Empty"/>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    [Parameter] public required Guid StackId { get; set; }
    [Parameter] public IPrincipalProvider? PrincipalProvider { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private StackSecretSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    private List<StackSecret> _secrets = new();

    private bool _showCreateSecret;

    protected override async Task OnInitializedAsync()
    {
        await ReloadSecrets();
    }

    private async Task ReloadSecrets()
    {
        using var repo = RepoFactory.Create(PrincipalProvider);
        _secrets = await repo.ListByParentId(StackId, OrganizationId);
    }
}
