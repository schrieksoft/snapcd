@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Entities.Definition.AgentAssignments
@using SnapCd.Server.Core.Repositories.Organizations.Secured.AgentAssignments
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.AgentAssignments

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Stack Assignments" Style="text-transform: none">
        @if (!_showCreateStackAssignment)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateStackAssignment">
                Create New
            </MudButton>
        }
        @if (_showCreateStackAssignment)
        {
            <CreateAgentStackAssignment
                AgentId="@AgentId"
                OnSaved="async () => {
                    _showCreateStackAssignment = false;
                    await ReloadAssignments();
                }"
                OnCancel="() => _showCreateStackAssignment = false"/>
        }
        <MudExpansionPanels>
            @foreach (var assignment in _agentStackAssignments)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@assignment.Stack.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete assignment">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteStackAssignment(assignment)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Namespace Assignments" Style="text-transform: none">
        @if (!_showCreateNamespaceAssignment)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateNamespaceAssignment">
                Create New
            </MudButton>
        }
        @if (_showCreateNamespaceAssignment)
        {
            <CreateAgentNamespaceAssignment
                AgentId="@AgentId"
                OnSaved="async () => {
                    _showCreateNamespaceAssignment = false;
                    await ReloadAssignments();
                }"
                OnCancel="() => _showCreateNamespaceAssignment = false"/>
        }

        <MudExpansionPanels>
            @foreach (var assignment in _agentNamespaceAssignments)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@assignment.Namespace.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete assignment">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteNamespaceAssignment(assignment)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Module Assignments" Style="text-transform: none">
        @if (!_showCreateModuleAssignment)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateModuleAssignment">
                Create New
            </MudButton>
        }
        @if (_showCreateModuleAssignment)
        {
            <CreateAgentModuleAssignment
                AgentId="@AgentId"
                OnSaved="async () => {
                    _showCreateModuleAssignment = false;
                    await ReloadAssignments();
                }"
                OnCancel="() => _showCreateModuleAssignment = false"/>
        }
        <MudExpansionPanels>
            @foreach (var assignment in _agentModuleAssignments)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@assignment.Module.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete assignment">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteModuleAssignment(assignment)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudButton
        Variant="Variant.Filled"
        Color="Color.Secondary"
        Class="mt-2 mb-2"
        OnClick="Close">Close
    </MudButton>
</MudTabs>

@code {

    [Parameter] public Guid AgentId { get; set; }
    [Parameter] public required EventCallback OnClose { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private AgentStackAssignmentSecuredRepositoryFactory StackAssignmentRepoFactory { get; set; } = null!;
    [Inject] private AgentModuleAssignmentSecuredRepositoryFactory ModuleAssignmentRepoFactory { get; set; } = null!;
    [Inject] private AgentNamespaceAssignmentSecuredRepositoryFactory NamespaceAssignmentRepoFactory { get; set; } = null!;


    private bool _showCreateStackAssignment;
    private bool _showCreateNamespaceAssignment;
    private bool _showCreateModuleAssignment;

    private List<AgentStackAssignment> _agentStackAssignments = new();
    private List<AgentModuleAssignment> _agentModuleAssignments = new();
    private List<AgentNamespaceAssignment> _agentNamespaceAssignments = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAssignments();
    }


    private void ShowCreateStackAssignment()
    {
        _showCreateStackAssignment = true;
    }


    private void ShowCreateModuleAssignment()
    {
        _showCreateModuleAssignment = true;
    }


    private void ShowCreateNamespaceAssignment()
    {
        _showCreateNamespaceAssignment = true;
    }


    private async Task ReloadAssignments()
    {
        using var stackAssignmentRepo = StackAssignmentRepoFactory.Create();
        _agentStackAssignments = await stackAssignmentRepo.ListByParentId(
            AgentId, OrganizationId,
            x => x
                .Include(y => y.Agent)
                .Include(y => y.Stack)
        );

        using var moduleAssignmentRepo = ModuleAssignmentRepoFactory.Create();
        _agentModuleAssignments = await moduleAssignmentRepo.ListByParentId(AgentId, OrganizationId,
            x => x
                .Include(y => y.Agent)
                .Include(y => y.Module)
        );

        using var namespaceAssignmentRepo = NamespaceAssignmentRepoFactory.Create();
        _agentNamespaceAssignments = await namespaceAssignmentRepo.ListByParentId(AgentId, OrganizationId,
            x => x
                .Include(y => y.Agent)
                .Include(y => y.Namespace)
        );
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task DeleteStackAssignment(AgentStackAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteAgentStackAssignmentDialog>
        {
            { x => x.AgentStackAssignmentId, assignment.Id },
            { x => x.StackName, assignment.Stack.Name },
            { x => x.AgentName, assignment.Agent.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteAgentStackAssignmentDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted AgentStackAssignment \"{id}\"", Severity.Success);
            await ReloadAssignments();
        }
    }

    private async Task DeleteNamespaceAssignment(AgentNamespaceAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteAgentNamespaceAssignmentDialog>
        {
            { x => x.AgentNamespaceAssignmentId, assignment.Id },
            { x => x.NamespaceName, assignment.Namespace.Name },
            { x => x.AgentName, assignment.Agent.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteAgentNamespaceAssignmentDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted AgentNamespaceAssignment \"{id}\"", Severity.Success);
            await ReloadAssignments();
        }
    }

    private async Task DeleteModuleAssignment(AgentModuleAssignment assignment)
    {
        var parameters = new DialogParameters<DeleteAgentModuleAssignmentDialog>
        {
            { x => x.AgentModuleAssignmentId, assignment.Id },
            { x => x.ModuleName, assignment.Module.Name },
            { x => x.AgentName, assignment.Agent.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteAgentModuleAssignmentDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted AgentModuleAssignment \"{id}\"", Severity.Success);
            await ReloadAssignments();
        }
    }

    public void Dispose()
    {
    }


}
