@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.RunnerSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RunnerSupplies
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.Views.Metadata
<MudPaper Elevation="1" Class="pa-4 mb-4">
    @if (!_canCreate)
    {
        <ReadOnlyNotice Message="You do not have permission to add a supply to this runner."/>
    }
    <MudForm @ref="_form">
        <MudGrid Class="pa-4" Spacing="3">
            <MudItem xs="12" md="6">
                <!-- Runner Selection -->
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="RunnerMetadata?"
                                     Label="Runner"
                                     @bind-Value="_selectedRunner"
                                     Disabled="@(!_canCreate || (RunnerId.HasValue))"
                                     Required="@(!RunnerId.HasValue)"
                                     RequiredError="Runner is required"
                                     SearchFunc="@SearchRunners"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <!-- Namespace Selection -->
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="NamespaceMetadata?"
                                     Label="Namespace"
                                     @bind-Value="_selectedNamespace"
                                     Disabled="@(!_canCreate || (NamespaceId.HasValue))"
                                     Required="@(!NamespaceId.HasValue)"
                                     RequiredError="Namespace is required"
                                     SearchFunc="@SearchNamespaces"
                                     ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12" md="12">
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Left" Dense="true">
                        Only Namespaces that you have at least ReadMetadata permissions on will appear here.
                    </MudAlert>
                </MudItem>
            </MudItem>

            <!-- Action Buttons -->
            <MudItem xs="12">
                @if (_canCreate)
                {
    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="SaveSupply"
                               Class="mr-2">
                        Create
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public Guid? NamespaceId { get; set; }
    [Parameter] public Guid? RunnerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private RunnerNamespaceSupplySecuredRepositoryFactory SupplyRepoFactory { get; set; } = null!;
    [Inject] private NamespaceSecuredRepositoryFactory NamespaceRepoFactory { get; set; } = null!;
    [Inject] private RunnerSecuredRepositoryFactory RunnerRepoFactory { get; set; } = null!;

    private MudForm? _form;
    private NamespaceMetadata? _selectedNamespace;
    private RunnerMetadata? _selectedRunnerBacking;
    private RunnerMetadata? _selectedRunner
    {
        get => _selectedRunnerBacking;
        set { _selectedRunnerBacking = value; RefreshCanCreate(); }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialValues();
    }

    private bool _canCreate = true;

    protected override void OnParametersSet() => RefreshCanCreate();

    private void RefreshCanCreate()
    {
        var ownerId = RunnerId ?? _selectedRunner?.Id;
        if (ownerId is null)
        {
            _canCreate = true;
            return;
        }

        using var permissionRepo = SupplyRepoFactory.Create();
        _canCreate = permissionRepo.CanCreate(ownerId.Value, OrganizationId);
    }

    private async Task LoadInitialValues()
    {
        if (NamespaceId.HasValue)
        {
            using var namespaceRepo = NamespaceRepoFactory.Create();
            _selectedNamespace = await namespaceRepo.GetMetadata(NamespaceId.Value, OrganizationId);
        }

        if (RunnerId.HasValue)
        {
            using var storeRepo = RunnerRepoFactory.Create();
            _selectedRunner = await storeRepo.GetMetadata(RunnerId.Value, OrganizationId);
        }
    }


    private async Task<IEnumerable<NamespaceMetadata>> SearchNamespaces(string value, CancellationToken token)
    {
        using var repo = NamespaceRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(value)
                ? q
                : q.Where(x => x.Name.Contains(value)),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 20);
    }

    private async Task<IEnumerable<RunnerMetadata>> SearchRunners(string value, CancellationToken token)
    {
        using var repo = RunnerRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(value)
                ? q
                : q.Where(x => x.Name.Contains(value)),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 20);
    }

    private async Task SaveSupply()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            var supply = new RunnerNamespaceSupply
            {
                Id = Guid.NewGuid(),
                NamespaceId = NamespaceId ?? _selectedNamespace?.Id ?? Guid.Empty,
                RunnerId = RunnerId ?? _selectedRunner?.Id ?? Guid.Empty,
                OrganizationId = OrganizationId
            };

            if (supply.NamespaceId == Guid.Empty || supply.RunnerId == Guid.Empty)
            {
                Snackbar.Add("Please select both namespace and Runner", Severity.Error);
                return;
            }

            using var repo = SupplyRepoFactory.Create();
            await repo.Create(supply);

            Snackbar.Add("Supply created successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating supply: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        _selectedNamespace = null;
        _selectedRunner = null;
        await OnCancel.InvokeAsync();
    }

}