@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.RunnerSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RunnerSupplies
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudForm @ref="_form">
        <MudGrid Class="pa-4" Spacing="3">
            <MudItem xs="12" md="6">
                <!-- Runner Selection -->
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="Runner?"
                                     Label="Runner"
                                     @bind-Value="_selectedRunner"
                                     Disabled="@(RunnerId.HasValue)"
                                     Required="@(!RunnerId.HasValue)"
                                     RequiredError="Runner is required"
                                     SearchFunc="@SearchRunners"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <!-- Namespace Selection -->
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="Namespace?"
                                     Label="Namespace"
                                     @bind-Value="_selectedNamespace"
                                     Disabled="@(NamespaceId.HasValue)"
                                     Required="@(!NamespaceId.HasValue)"
                                     RequiredError="Namespace is required"
                                     SearchFunc="@SearchNamespaces"
                                     ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>
            </MudItem>

            <!-- Action Buttons -->
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="SaveSupply"
                           Class="mr-2">
                    Create
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public Guid? NamespaceId { get; set; }
    [Parameter] public Guid? RunnerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private RunnerNamespaceSupplySecuredRepositoryFactory SupplyRepoFactory { get; set; } = null!;
    [Inject] private NamespaceSecuredRepositoryFactory NamespaceRepoFactory { get; set; } = null!;
    [Inject] private RunnerSecuredRepositoryFactory RunnerRepoFactory { get; set; } = null!;

    private MudForm? _form;
    private Namespace? _selectedNamespace;
    private Runner? _selectedRunner;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialValues();
    }

    private async Task LoadInitialValues()
    {
        if (NamespaceId.HasValue)
        {
            using var namespaceRepo = NamespaceRepoFactory.Create();
            _selectedNamespace = await namespaceRepo.Get(NamespaceId.Value, OrganizationId);
        }

        if (RunnerId.HasValue)
        {
            using var storeRepo = RunnerRepoFactory.Create();
            _selectedRunner = await storeRepo.Get(RunnerId.Value, OrganizationId);
        }
    }


    private async Task<IEnumerable<Namespace>> SearchNamespaces(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<Namespace>();

        using var repo = NamespaceRepoFactory.Create();
        return await repo.List<Namespace>(OrganizationId, q => q.Where(m => m.Name.Contains(value)));
    }

    private async Task<IEnumerable<Runner>> SearchRunners(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<Runner>();

        using var repo = RunnerRepoFactory.Create();
        return await repo.List<Runner>(OrganizationId, q => q.Where(s => s.Name.Contains(value)));
    }

    private async Task SaveSupply()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            var supply = new RunnerNamespaceSupply
            {
                Id = Guid.NewGuid(),
                NamespaceId = NamespaceId ?? _selectedNamespace?.Id ?? Guid.Empty,
                RunnerId = RunnerId ?? _selectedRunner?.Id ?? Guid.Empty,
                OrganizationId = OrganizationId
            };

            if (supply.NamespaceId == Guid.Empty || supply.RunnerId == Guid.Empty)
            {
                Snackbar.Add("Please select both namespace and Runner", Severity.Error);
                return;
            }

            using var repo = SupplyRepoFactory.Create();
            await repo.Create(supply);

            Snackbar.Add("Supply created successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating supply: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        _selectedNamespace = null;
        _selectedRunner = null;
        await OnCancel.InvokeAsync();
    }

}