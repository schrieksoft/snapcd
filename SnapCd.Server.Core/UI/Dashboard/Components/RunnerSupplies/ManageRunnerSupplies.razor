@* @page "/RoleAssignments" *@

@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Entities.Definition.RunnerSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured.RunnerSupplies
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.RunnerSupplies
@using SnapCd.Server.Core.Views

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Stack Supplies" Style="text-transform: none">
        @if (!_showCreateStackSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateStackSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateStackSupply)
        {
            <CreateRunnerStackSupply
                RunnerId="@RunnerId"
                OnSaved="async () => { 
                    _showCreateStackSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateStackSupply = false"/>
        }
        @if (!_runnerStackSupplies.Any())
        {
            <MudText Typo="Typo.body2" Class="mt-2">No stack supplies yet.</MudText>
        }
        <MudExpansionPanels>
            @foreach (var supply in _runnerStackSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                            <MudLink Href="@supply.Href" @onclick:stopPropagation="true">@supply.ScopeName</MudLink>
                            @if (supply.ParentPath is not null)
                            {
                                <MudText Typo="Typo.caption">in @supply.ParentPath</MudText>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteStackSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Namespace Supplies" Style="text-transform: none">
        @if (!_showCreateNamespaceSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateNamespaceSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateNamespaceSupply)
        {
            <CreateRunnerNamespaceSupply
                RunnerId="@RunnerId"
                OnSaved="async () => { 
                    _showCreateNamespaceSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateNamespaceSupply = false"/>
        }

        @if (!_runnerNamespaceSupplies.Any())
        {
            <MudText Typo="Typo.body2" Class="mt-2">No namespace supplies yet.</MudText>
        }
        <MudExpansionPanels>
            @foreach (var supply in _runnerNamespaceSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                            <MudLink Href="@supply.Href" @onclick:stopPropagation="true">@supply.ScopeName</MudLink>
                            @if (supply.ParentPath is not null)
                            {
                                <MudText Typo="Typo.caption">in @supply.ParentPath</MudText>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteNamespaceSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Module Supplies" Style="text-transform: none">
        @if (!_showCreateModuleSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateModuleSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateModuleSupply)
        {
            <CreateRunnerModuleSupply
                RunnerId="@RunnerId"
                OnSaved="async () => { 
                    _showCreateModuleSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateModuleSupply = false"/>
        }
        @if (!_runnerModuleSupplies.Any())
        {
            <MudText Typo="Typo.body2" Class="mt-2">No module supplies yet.</MudText>
        }
        <MudExpansionPanels>
            @foreach (var supply in _runnerModuleSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                            <MudLink Href="@supply.Href" @onclick:stopPropagation="true">@supply.ScopeName</MudLink>
                            @if (supply.ParentPath is not null)
                            {
                                <MudText Typo="Typo.caption">in @supply.ParentPath</MudText>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteModuleSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
</MudTabs>

@code {

    [Parameter] public Guid RunnerId { get; set; }
    [Parameter] public required EventCallback OnClose { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private RunnerStackSupplySecuredRepositoryFactory StackSupplyRepoFactory { get; set; } = null!;
    [Inject] private RunnerModuleSupplySecuredRepositoryFactory ModuleSupplyRepoFactory { get; set; } = null!;
    [Inject] private RunnerNamespaceSupplySecuredRepositoryFactory NamespaceSupplyRepoFactory { get; set; } = null!;


    private bool _showCreateStackSupply;
    private bool _showCreateNamespaceSupply;
    private bool _showCreateModuleSupply;

    private List<SuppliedScopeRow> _runnerStackSupplies = new();
    private List<SuppliedScopeRow> _runnerModuleSupplies = new();
    private List<SuppliedScopeRow> _runnerNamespaceSupplies = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadSupplies();
    }


    private void ShowCreateStackSupply()
    {
        _showCreateStackSupply = true;
    }


    private void ShowCreateModuleSupply()
    {
        _showCreateModuleSupply = true;
    }


    private void ShowCreateNamespaceSupply()
    {
        _showCreateNamespaceSupply = true;
    }


    private async Task ReloadSupplies()
    {
        // Projected rather than loaded: the list needs the names above the scope to tell one
        // "default" from another, not the entities themselves.
        using var stackSupplyRepo = StackSupplyRepoFactory.Create();
        _runnerStackSupplies = await stackSupplyRepo.ListByParentId(
            RunnerId, OrganizationId,
            x => x.Select(y => new SuppliedScopeRow
            {
                SupplyId = y.Id,
                OwnerName = y.Runner.Name,
                StackName = y.Stack.Name
            }));

        using var moduleSupplyRepo = ModuleSupplyRepoFactory.Create();
        _runnerModuleSupplies = await moduleSupplyRepo.ListByParentId(
            RunnerId, OrganizationId,
            x => x.Select(y => new SuppliedScopeRow
            {
                SupplyId = y.Id,
                OwnerName = y.Runner.Name,
                StackName = y.Module.Namespace.Stack.Name,
                NamespaceName = y.Module.Namespace.Name,
                ModuleName = y.Module.Name
            }));

        using var namespaceSupplyRepo = NamespaceSupplyRepoFactory.Create();
        _runnerNamespaceSupplies = await namespaceSupplyRepo.ListByParentId(
            RunnerId, OrganizationId,
            x => x.Select(y => new SuppliedScopeRow
            {
                SupplyId = y.Id,
                OwnerName = y.Runner.Name,
                StackName = y.Namespace.Stack.Name,
                NamespaceName = y.Namespace.Name
            }));
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task DeleteStackSupply(SuppliedScopeRow supply)
    {
        var parameters = new DialogParameters<DeleteRunnerStackSupplyDialog>
        {
            { x => x.RunnerStackSupplyId, supply.SupplyId },
            { x => x.StackName, supply.ScopeName },
            { x => x.RunnerName, supply.OwnerName },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerStackSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted RunnerStackSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    private async Task DeleteNamespaceSupply(SuppliedScopeRow supply)
    {
        var parameters = new DialogParameters<DeleteRunnerNamespaceSupplyDialog>
        {
            { x => x.RunnerNamespaceSupplyId, supply.SupplyId },
            { x => x.NamespaceName, supply.ScopeName },
            { x => x.RunnerName, supply.OwnerName },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerNamespaceSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted RunnerNamespaceSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    private async Task DeleteModuleSupply(SuppliedScopeRow supply)
    {
        var parameters = new DialogParameters<DeleteRunnerModuleSupplyDialog>
        {
            { x => x.RunnerModuleSupplyId, supply.SupplyId },
            { x => x.ModuleName, supply.ScopeName },
            { x => x.RunnerName, supply.OwnerName },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerModuleSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted RunnerModuleSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    public void Dispose()
    {
    }


}