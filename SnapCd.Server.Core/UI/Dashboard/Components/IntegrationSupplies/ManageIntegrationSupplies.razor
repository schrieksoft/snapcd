@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Entities.Definition.IntegrationSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured.IntegrationSupplies
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.IntegrationSupplies

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Stack Supplies" Style="text-transform: none">
        @if (!_showCreateStackSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #000; color: #fff;"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateStackSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateStackSupply)
        {
            <CreateIntegrationStackSupply
                IntegrationId="@IntegrationId"
                OnSaved="async () => {
                    _showCreateStackSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateStackSupply = false"/>
        }
        <MudExpansionPanels>
            @foreach (var supply in _integrationStackSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@supply.Stack.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteStackSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Namespace Supplies" Style="text-transform: none">
        @if (!_showCreateNamespaceSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #000; color: #fff;"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateNamespaceSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateNamespaceSupply)
        {
            <CreateIntegrationNamespaceSupply
                IntegrationId="@IntegrationId"
                OnSaved="async () => {
                    _showCreateNamespaceSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateNamespaceSupply = false"/>
        }

        <MudExpansionPanels>
            @foreach (var supply in _integrationNamespaceSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@supply.Namespace.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteNamespaceSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Module Supplies" Style="text-transform: none">
        @if (!_showCreateModuleSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Style="background-color: #000; color: #fff;"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateModuleSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateModuleSupply)
        {
            <CreateIntegrationModuleSupply
                IntegrationId="@IntegrationId"
                OnSaved="async () => {
                    _showCreateModuleSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateModuleSupply = false"/>
        }
        <MudExpansionPanels>
            @foreach (var supply in _integrationModuleSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@supply.Module.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteModuleSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudButton
        Variant="Variant.Filled"
        Style="background-color: #000; color: #fff;"
        Class="mt-2 mb-2"
        OnClick="Close">Close
    </MudButton>
</MudTabs>

@code {

    [Parameter] public Guid IntegrationId { get; set; }
    [Parameter] public required EventCallback OnClose { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private IntegrationStackSupplySecuredRepositoryFactory StackSupplyRepoFactory { get; set; } = null!;
    [Inject] private IntegrationModuleSupplySecuredRepositoryFactory ModuleSupplyRepoFactory { get; set; } = null!;
    [Inject] private IntegrationNamespaceSupplySecuredRepositoryFactory NamespaceSupplyRepoFactory { get; set; } = null!;


    private bool _showCreateStackSupply;
    private bool _showCreateNamespaceSupply;
    private bool _showCreateModuleSupply;

    private List<IntegrationStackSupply> _integrationStackSupplies = new();
    private List<IntegrationModuleSupply> _integrationModuleSupplies = new();
    private List<IntegrationNamespaceSupply> _integrationNamespaceSupplies = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadSupplies();
    }


    private void ShowCreateStackSupply()
    {
        _showCreateStackSupply = true;
    }


    private void ShowCreateModuleSupply()
    {
        _showCreateModuleSupply = true;
    }


    private void ShowCreateNamespaceSupply()
    {
        _showCreateNamespaceSupply = true;
    }


    private async Task ReloadSupplies()
    {
        using var stackSupplyRepo = StackSupplyRepoFactory.Create();
        _integrationStackSupplies = await stackSupplyRepo.ListByParentId(
            IntegrationId, OrganizationId,
            x => x
                .Include(y => y.Integration)
                .Include(y => y.Stack)
        );

        using var moduleSupplyRepo = ModuleSupplyRepoFactory.Create();
        _integrationModuleSupplies = await moduleSupplyRepo.ListByParentId(IntegrationId, OrganizationId,
            x => x
                .Include(y => y.Integration)
                .Include(y => y.Module)
        );

        using var namespaceSupplyRepo = NamespaceSupplyRepoFactory.Create();
        _integrationNamespaceSupplies = await namespaceSupplyRepo.ListByParentId(IntegrationId, OrganizationId,
            x => x
                .Include(y => y.Integration)
                .Include(y => y.Namespace)
        );
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task DeleteStackSupply(IntegrationStackSupply supply)
    {
        var parameters = new DialogParameters<DeleteIntegrationStackSupplyDialog>
        {
            { x => x.IntegrationStackSupplyId, supply.Id },
            { x => x.StackName, supply.Stack.Name },
            { x => x.IntegrationName, supply.Integration.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteIntegrationStackSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted IntegrationStackSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    private async Task DeleteNamespaceSupply(IntegrationNamespaceSupply supply)
    {
        var parameters = new DialogParameters<DeleteIntegrationNamespaceSupplyDialog>
        {
            { x => x.IntegrationNamespaceSupplyId, supply.Id },
            { x => x.NamespaceName, supply.Namespace.Name },
            { x => x.IntegrationName, supply.Integration.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteIntegrationNamespaceSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted IntegrationNamespaceSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    private async Task DeleteModuleSupply(IntegrationModuleSupply supply)
    {
        var parameters = new DialogParameters<DeleteIntegrationModuleSupplyDialog>
        {
            { x => x.IntegrationModuleSupplyId, supply.Id },
            { x => x.ModuleName, supply.Module.Name },
            { x => x.IntegrationName, supply.Integration.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteIntegrationModuleSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted IntegrationModuleSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    public void Dispose()
    {
    }


}
