@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.IntegrationSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.IntegrationSupplies
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.Views.Metadata
<MudPaper Elevation="1" Class="pa-4 mb-4">
    @if (!_canCreate)
    {
        <ReadOnlyNotice Message="You do not have permission to add a supply to this integration."/>
    }
    <MudForm @ref="_form">
        <MudGrid Class="pa-4" Spacing="3">
            <MudItem xs="12" md="6">
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="IntegrationMetadata?"
                                     Label="Integration"
                                     @bind-Value="_selectedIntegration"
                                     Disabled="@(!_canCreate || (IntegrationId.HasValue))"
                                     Required="@(!IntegrationId.HasValue)"
                                     RequiredError="Integration is required"
                                     SearchFunc="@SearchIntegrations"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12" md="12">
                    <MudAutocomplete T="StackMetadata?"
                                     Label="Stack"
                                     @bind-Value="_selectedStack"
                                     Disabled="@(!_canCreate || (StackId.HasValue))"
                                     Required="@(!StackId.HasValue)"
                                     RequiredError="Stack is required"
                                     SearchFunc="@SearchStacks"
                                     ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12" md="12">
                    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Left" Dense="true">
                        Only Stacks that you have at least ReadMetadata permissions on will appear here.
                    </MudAlert>
                </MudItem>
            </MudItem>

            <MudItem xs="12">
                @if (_canCreate)
                {
    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="SaveSupply"
                               Class="mr-2">
                        Create
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public Guid? StackId { get; set; }
    [Parameter] public Guid? IntegrationId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IntegrationStackSupplySecuredRepositoryFactory SupplyRepoFactory { get; set; } = null!;
    [Inject] private StackSecuredRepositoryFactory StackRepoFactory { get; set; } = null!;
    [Inject] private IntegrationSecuredRepositoryFactory IntegrationRepoFactory { get; set; } = null!;

    private MudForm? _form;
    private StackMetadata? _selectedStack;
    private IntegrationMetadata? _selectedIntegrationBacking;
    private IntegrationMetadata? _selectedIntegration
    {
        get => _selectedIntegrationBacking;
        set { _selectedIntegrationBacking = value; RefreshCanCreate(); }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialValues();
    }

    private bool _canCreate = true;

    protected override void OnParametersSet() => RefreshCanCreate();

    private void RefreshCanCreate()
    {
        var ownerId = IntegrationId ?? _selectedIntegration?.Id;
        if (ownerId is null)
        {
            _canCreate = true;
            return;
        }

        using var permissionRepo = SupplyRepoFactory.Create();
        _canCreate = permissionRepo.CanCreate(ownerId.Value, OrganizationId);
    }

    private async Task LoadInitialValues()
    {
        if (StackId.HasValue)
        {
            using var stackRepo = StackRepoFactory.Create();
            _selectedStack = await stackRepo.GetMetadata(StackId.Value, OrganizationId);
        }

        if (IntegrationId.HasValue)
        {
            using var repo = IntegrationRepoFactory.Create();
            _selectedIntegration = await repo.GetMetadata(IntegrationId.Value, OrganizationId);
        }
    }

    private async Task<IEnumerable<StackMetadata>> SearchStacks(string value, CancellationToken token)
    {
        using var repo = StackRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(value)
                ? q
                : q.Where(x => x.Name.Contains(value)),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 20);
    }

    private async Task<IEnumerable<IntegrationMetadata>> SearchIntegrations(string value, CancellationToken token)
    {
        using var repo = IntegrationRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => string.IsNullOrWhiteSpace(value)
                ? q
                : q.Where(x => x.Name.Contains(value)),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 20);
    }

    private async Task SaveSupply()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            var supply = new IntegrationStackSupply
            {
                Id = Guid.NewGuid(),
                StackId = StackId ?? _selectedStack?.Id ?? Guid.Empty,
                IntegrationId = IntegrationId ?? _selectedIntegration?.Id ?? Guid.Empty,
                OrganizationId = OrganizationId
            };

            if (supply.StackId == Guid.Empty || supply.IntegrationId == Guid.Empty)
            {
                Snackbar.Add("Please select both stack and integration", Severity.Error);
                return;
            }

            using var repo = SupplyRepoFactory.Create();
            await repo.Create(supply);

            Snackbar.Add("Supply created successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating supply: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        _selectedStack = null;
        _selectedIntegration = null;
        await OnCancel.InvokeAsync();
    }

}
