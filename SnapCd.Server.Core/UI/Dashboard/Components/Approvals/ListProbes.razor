@implements IDisposable
@using SnapCd.Contracts
@using SnapCd.Contracts.Dto.Misc
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.Services.RippleProbes
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Confirm
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using SnapCd.Server.Core.Views
@using Color = MudBlazor.Color

@inject ProbeWaveReadServiceFactory ProbeWaveReadServiceFactory
@inject SnapCd.Server.Core.Services.RippleProbes.ProbeRerunServiceFactory ProbeRerunServiceFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ModuleSecuredRepositoryFactory ModuleRepoFactory
@inject SnapCd.Server.Core.Services.Notification.ProbeWaveUpdatedNotificationService ProbeWaveUpdatedNotificationService
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider

@if (_wave == null && _propagationFailure is { Length: > 0 })
{
    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Downstream Impacts</MudText>
            <MudIcon Icon="@SnapCdIcons.Warning" Color="Color.Error" Size="Size.Small"/>
            <MudText Typo="Typo.body2" Color="Color.Error">Not asked for</MudText>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mb-3">
            Nothing was asked of the Modules downstream of this one, so this decision is being made
            without them. The apply itself is unaffected.
        </MudText>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3"
                 Style="font-family: var(--snap-font-mono);">@_propagationFailure</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   Disabled="@_retryingPropagation"
                   OnClick="RetryPropagation">
            ask again
        </MudButton>
    </MudPaper>
}

@if (_wave != null)
{
    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Downstream Impacts</MudText>
            @{
                var (impactIcon, impactColor, impactLabel) = ImpactBadge(_wave.Impact);
            }
            <MudIcon Icon="@impactIcon" Color="@impactColor" Size="Size.Small"/>
            <MudText Typo="Typo.subtitle2" Color="@impactColor">@impactLabel</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Summary()</MudText>
        </MudStack>

        @if (_wave.ModulesOmitted > 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                @_wave.ModulesOmitted other @(_wave.ModulesOmitted == 1 ? "Module is" : "Modules are") taking part that you cannot see.
            </MudText>
        }

        @if (_relevant.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing downstream reads what this plan changes.</MudText>
        }
        else
        {
            <MudExpansionPanels>
                @foreach (var module in _relevant)
                {
                    var (icon, color, label) = Badge(module);

                    <MudExpansionPanel Expanded="@(module.ModuleId == _expandedId)"
                                       ExpandedChanged="@(e => HandleExpansionChanged(module.ModuleId, e))">
                        <TitleContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@icon" Color="@color" Size="Size.Small"/>
                                <MudLink Href="@($"/Module/{module.StackName}/{module.NamespaceName}/{module.ModuleName}")"
                                         Typo="Typo.body1"
                                         Style="font-family: var(--snap-font-mono);"
                                         @onclick:stopPropagation="true">
                                    @module.NamespaceName/@module.ModuleName
                                </MudLink>
                                <MudText Typo="Typo.body2" Color="@color">@label</MudText>
                                @if (module.Attempts.FirstOrDefault()?.IsStale == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                        stale
                                    </MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Waiting on</MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">@Upstreams(module)</MudText>

                            @if (module.Attempts.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">No probe has run yet, so there are no logs.</MudText>
                            }
                            else
                            {
                                @foreach (var (attempt, index) in module.Attempts.Select((a, i) => (a, i)))
                                {
                                    @* A Module probed once reads as it always did; only a repeat gets a heading. *@
                                    @if (module.Attempts.Count > 1)
                                    {
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-3 mb-1">
                                            <MudText Typo="Typo.overline" Class="mud-text-secondary">
                                                @(index == 0 ? "Latest probe" : $"Probe {module.Attempts.Count - index}")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Probed(attempt)</MudText>
                                        </MudStack>
                                    }

                                    @if (attempt.IsStale)
                                    {
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                                            <MudIcon Icon="@SnapCdIcons.Warning" Color="Color.Warning" Size="Size.Small"/>
                                            <MudText Typo="Typo.body2" Color="Color.Warning">
                                                @StaleSummary(attempt)
                                            </MudText>
                                        </MudStack>
                                    }

                                    @if (index == 0 && _wave?.IsLive == true)
                                    {
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       Disabled="@_rerunning.Contains(module.ModuleId)"
                                                       OnClick="@(() => Rerun(module))">
                                                probe again
                                            </MudButton>
                                        </MudStack>
                                    }

                                    @if (attempt.Signals.Count > 0)
                                    {
                                        <MudText Typo="Typo.overline" Class="mud-text-secondary">Predicted output changes</MudText>
                                        <MudSimpleTable Dense="true" Class="mb-3">
                                            <tbody>
                                            @foreach (var signal in attempt.Signals)
                                            {
                                                <tr>
                                                    <td style="font-family: var(--snap-font-mono);">@signal.Name</td>
                                                    <td>
                                                        <MudText Typo="Typo.body2" Color="@ActionColor(signal)">@(signal.Action ?? "unknown")</MudText>
                                                    </td>
                                                    <td>
                                                        @if (signal.Sensitive)
                                                        {
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">sensitive</MudText>
                                                        }
                                                        else if (signal.AfterIsUnknown)
                                                        {
                                                            <MudText Typo="Typo.body2" Color="Color.Warning">value not knowable until applied</MudText>
                                                        }
                                                        else if (!signal.HasBefore)
                                                        {
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">new</MudText>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                    else if (!attempt.HasProbed)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">This probe ended without reporting a prediction. Its log says why.</MudText>
                                    }

                                    @if (attempt.ProbeModuleJobId != null)
                                    {
                                        <MudText Typo="Typo.overline" Class="mud-text-secondary">Logs</MudText>
                                        <ListLogs TJob="ModuleJob" TChunk="ModuleJobLogChunk" TLogEntry="ModuleJobLogEntryDto"
                                                  @ref="_logRefs[attempt.ProbeModuleJobId.Value]"
                                                  JobId="@attempt.ProbeModuleJobId.Value"
                                                  ModuleId="@module.ModuleId"
                                                  TaskFilter="@(new[] { "Probe" })"
                                                  IncludeCorrelated="true"/>
                                    }
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudPaper>
}

@code {
    [Parameter] public required Guid ModuleJobId { get; set; }
    [Parameter] public required Guid ModuleId { get; set; }

    /// <summary>
    /// Raised whenever the wave is read, so the approval decision beside this panel can warn
    /// about what has not been checked. Null where this change starts no wave.
    /// </summary>
    [Parameter] public EventCallback<DownstreamImpact?> OnImpactChanged { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    private Guid _principalId;
    private PrincipalDiscriminator _principalDiscriminator;

    private ProbeWaveView? _wave;
    private List<ProbeWaveModuleView> _relevant = [];
    private Guid? _expandedId;

    private Guid? _subscribedWaveId;

    protected override async Task OnInitializedAsync()
    {
        _principalId = HttpContextPrincipalProvider.GetSubject(OrganizationId);
        _principalDiscriminator = HttpContextPrincipalProvider.GetPrincipalDiscriminator();

        await Reload();
        Resubscribe();
    }

    public void Dispose()
    {
        if (_subscribedWaveId != null)
            ProbeWaveUpdatedNotificationService.Unsubscribe(_subscribedWaveId.Value, HandleWaveUpdated);
    }

    /// <summary>
    /// The subscription is keyed on the wave, which is only known once it has been read, and a
    /// job's wave is created after its plan completes, so the first read can find none.
    /// </summary>
    private void Resubscribe()
    {
        if (_wave?.Id == _subscribedWaveId) return;

        if (_subscribedWaveId != null)
            ProbeWaveUpdatedNotificationService.Unsubscribe(_subscribedWaveId.Value, HandleWaveUpdated);

        _subscribedWaveId = _wave?.Id;

        if (_subscribedWaveId != null)
            ProbeWaveUpdatedNotificationService.Subscribe(_subscribedWaveId.Value, HandleWaveUpdated);
    }

    private async Task HandleWaveUpdated(Guid probeWaveId)
    {
        await Reload();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The signed-in principal, from the identity captured while the HTTP context was still in
    /// scope. A reload also arrives from a notification, which carries no HTTP context.
    /// </summary>
    private LiteralPrincipalProvider Principal() =>
        new(_principalId, _principalDiscriminator, [OrganizationId]);

    public async Task Reload()
    {
        var principalProvider = Principal();

        using var moduleRepo = ModuleRepoFactory.Create(principalProvider);
        using var service = ProbeWaveReadServiceFactory.Create();

        _wave = await service.GetByOriginJob(
            ModuleJobId,
            OrganizationId,
            moduleId => moduleRepo.CanRead(moduleId, OrganizationId));

        _propagationFailure = _wave != null
            ? null
            : await service.PropagationFailure(ModuleJobId, OrganizationId);

        // The origin answers from its own plan rather than being probed, and a Module nothing
        // reaches has no probe to show. Neither is a panel a reader would open.
        _relevant = _wave == null
            ? []
            : _wave.Modules
                .Where(p => p.ModuleId != _wave.OriginModuleId && !p.NothingToProbe)
                .OrderBy(p => p.NamespaceName)
                .ThenBy(p => p.ModuleName)
                .ToList();

        Resubscribe();

        await OnImpactChanged.InvokeAsync(_wave?.Impact);
    }

    /// <summary>
    /// Pending is deliberately not coloured: the wave has found nothing to report yet, and an
    /// amber chip on every change that is merely still running would be read as a finding.
    /// </summary>
    private static (string Icon, Color Color, string Label) ImpactBadge(DownstreamImpact impact) =>
        impact switch
        {
            DownstreamImpact.Failed => (SnapCdIcons.Error, Color.Error, "Failed"),
            DownstreamImpact.Impact => (SnapCdIcons.Error, Color.Error, "Impact"),
            DownstreamImpact.Cleared => (SnapCdIcons.CheckCircle, Color.Success, "Cleared"),
            _ => (SnapCdIcons.HourglassTop, Color.Default, "Pending")
        };

    /// <summary>
    /// The counts behind the badge. A failed probe is counted apart from the ones still running,
    /// so this line cannot say "still running" about a probe the badge calls failed.
    /// </summary>
    private string Summary()
    {
        if (_relevant.Count == 0) return "nothing affected";

        var reported = _relevant.Count(p => p.Progress == ProbeProgress.Reported);
        var failed = _relevant.Count(p => p.Progress == ProbeProgress.Faulted);
        var running = _relevant.Count - reported - failed;

        var parts = new List<string> { $"{reported} of {_relevant.Count} reported" };

        if (running > 0) parts.Add($"{running} still running");
        if (failed > 0) parts.Add($"{failed} failed");

        var disruptive = _relevant.Count(p => p.HasDisruptiveSignal);
        if (disruptive > 0) parts.Add($"{disruptive} predicting a destroy or replace");

        return string.Join(", ", parts);
    }

    private static string Upstreams(ProbeWaveModuleView module)
    {
        if (module.Edges.Count == 0) return "nothing";

        return string.Join(", ", module.Edges
            .OrderBy(c => c.UpstreamModuleName)
            .Select(c => $"{c.UpstreamModuleName} ({c.Status.ToString().ToLowerInvariant()})"));
    }

    private static string Probed(ProbeAttemptView attempt) =>
        DateTimeOffset.FromUnixTimeMilliseconds(attempt.Timestamp).DateTime.ToString("yyyy-MM-dd HH:mm:ss");

    private static Color ActionColor(SignalOutputView signal)
    {
        if (signal.Actions.Contains("delete")) return Color.Error;
        if (signal.Actions.Contains("update")) return Color.Warning;
        if (signal.Actions.Contains("create")) return Color.Success;
        return Color.Default;
    }

    /// <summary>
    /// A destroy or replace downstream is the finding worth colouring red, since it is the one a
    /// reader might stop for. An unknown value is amber: the probe worked and the answer is that
    /// the plan cannot know yet.
    /// </summary>
    private static (string Icon, Color Color, string Label) Badge(ProbeWaveModuleView p) =>
        p.Progress switch
        {
            ProbeProgress.Reported when p.HasDisruptiveSignal =>
                (SnapCdIcons.Error, Color.Error, "destroys or replaces"),
            ProbeProgress.Reported when p.HasUnknownSignal =>
                (SnapCdIcons.Warning, Color.Warning, "changes, some unknown"),
            ProbeProgress.Reported when p.Signals.Count > 0 =>
                (SnapCdIcons.Warning, Color.Warning, "changes"),
            ProbeProgress.Reported =>
                (SnapCdIcons.CheckCircle, Color.Success, "no change"),
            ProbeProgress.Faulted =>
                (SnapCdIcons.Error, Color.Error, "probe failed"),
            ProbeProgress.Running =>
                (SnapCdIcons.HourglassTop, Color.Default, "running"),
            ProbeProgress.Queued =>
                (SnapCdIcons.HourglassEmpty, Color.Default, "queued"),
            _ =>
                (SnapCdIcons.HourglassEmpty, Color.Default, "waiting on an upstream")
        };

    private readonly Dictionary<Guid, ListLogs<ModuleJob, ModuleJobLogChunk, ModuleJobLogEntryDto>> _logRefs = new();
    private readonly HashSet<Guid> _loadedLogs = [];

    private string? _propagationFailure;
    private bool _retryingPropagation;

    /// <summary>
    /// Starts the propagation this job's plan should have started. The plan is already recorded, so
    /// what is re-run is the asking rather than the plan.
    /// </summary>
    private async Task RetryPropagation()
    {
        if (_retryingPropagation) return;

        using var service = ProbeRerunServiceFactory.Create(Principal());

        var originModuleId = await service.OriginModuleOf(ModuleJobId, OrganizationId);

        var refusal = originModuleId is { } id && service.MayAsk(id, OrganizationId)
            ? null
            : "You are not allowed to run jobs on this Module.";

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "This asks the Modules downstream of this one to predict their outputs again." },
            { x => x.ButtonText, "Ask again" },
            { x => x.RefusalReason, refusal }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Ask the downstream Modules again", parameters, options);
        var result = await dialog.Result;

        if (result is not { Canceled: false }) return;

        _retryingPropagation = true;

        try
        {
            var refused = await service.RetryPropagation(ModuleJobId, OrganizationId);

            if (refused is null)
            {
                Snackbar.Add("Asked the downstream Modules again.", Severity.Success);
                await Reload();
            }
            else
            {
                Snackbar.Add($"Cannot ask again: {refused}.", Severity.Warning);
            }
        }
        finally
        {
            _retryingPropagation = false;
        }
    }

    private readonly HashSet<Guid> _rerunning = [];

    /// <summary>
    /// Asks this Module to predict again. The wave stays open and the old answer stays on the
    /// record; what arrives is another attempt, which becomes the latest.
    /// </summary>
    private async Task Rerun(ProbeWaveModuleView module)
    {
        if (_wave is null || _rerunning.Contains(module.ModuleId)) return;

        using var service = ProbeRerunServiceFactory.Create(Principal());

        var refusal = service.MayAsk(_wave.OriginModuleId, OrganizationId)
            ? null
            : $"You are not allowed to run jobs on {_wave.OriginModuleName}.";

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"This runs a plan on \"{module.NamespaceName}/{module.ModuleName}\" to predict its outputs again. The earlier prediction stays on the record." },
            { x => x.ButtonText, "Probe again" },
            { x => x.RefusalReason, refusal }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Ask for another prediction", parameters, options);
        var result = await dialog.Result;

        if (result is not { Canceled: false }) return;

        _rerunning.Add(module.ModuleId);

        try
        {
            var refused = await service.Rerun(_wave.Id, module.ModuleId, OrganizationId);

            if (refused is null)
                Snackbar.Add("Asked for another prediction.", Severity.Success);
            else
                Snackbar.Add($"Cannot probe again: {refused}.", Severity.Warning);
        }
        finally
        {
            _rerunning.Remove(module.ModuleId);
        }
    }

    /// <summary>
    /// What has moved under this prediction since it was made. A probe plans against the code, the
    /// declaration and the resolved input values of one moment, so it answers for that moment.
    /// </summary>
    private static string StaleSummary(ProbeAttemptView attempt)
    {
        var moved = (attempt.Stale ?? []).Select(reason => reason switch
        {
            StalenessReason.Revision => "the code",
            StalenessReason.Declaration => "the configuration",
            StalenessReason.Parameters => "an input value",
            StalenessReason.EnvironmentVariables => "an environment variable",
            _ => reason.ToString()
        }).ToList();

        return moved.Count switch
        {
            0 => string.Empty,
            1 => $"{moved[0]} has changed since this was predicted",
            _ => $"{string.Join(", ", moved[..^1])} and {moved[^1]} have changed since this was predicted"
        };
    }

    private void HandleExpansionChanged(Guid moduleId, bool expanded)
    {
        _expandedId = expanded ? moduleId : null;
    }

    /// <summary>
    /// ListLogs loads nothing until it is asked to, and its @ref is only assigned once the open
    /// panel's content has rendered.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_expandedId is not { } moduleId) return;

        var module = _wave?.Modules.FirstOrDefault(m => m.ModuleId == moduleId);
        if (module is null) return;

        foreach (var attempt in module.Attempts)
        {
            if (attempt.ProbeModuleJobId is not { } jobId) continue;
            if (!_loadedLogs.Add(jobId)) continue;

            if (_logRefs.TryGetValue(jobId, out var logs))
                await logs.InitializeLogs();
            else
                _loadedLogs.Remove(jobId);
        }
    }
}
