@implements IDisposable
@using SnapCd.Contracts.Dto.Misc
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.Services.RippleProbes
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using SnapCd.Server.Core.Views
@using Color = MudBlazor.Color

@inject ProbeWaveReadServiceFactory ProbeWaveReadServiceFactory
@inject ModuleSecuredRepositoryFactory ModuleRepoFactory
@inject SnapCd.Server.Core.Services.Notification.ProbeWaveUpdatedNotificationService ProbeWaveUpdatedNotificationService
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider

@if (_wave != null)
{
    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Downstream Impacts</MudText>
            @{
                var (impactIcon, impactColor, impactLabel) = ImpactBadge(_wave.Impact);
            }
            <MudIcon Icon="@impactIcon" Color="@impactColor" Size="Size.Small"/>
            <MudText Typo="Typo.subtitle2" Color="@impactColor">@impactLabel</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Summary()</MudText>
        </MudStack>

        @if (_wave.ModulesOmitted > 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                @_wave.ModulesOmitted other @(_wave.ModulesOmitted == 1 ? "Module is" : "Modules are") taking part that you cannot see.
            </MudText>
        }

        @if (_relevant.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing downstream reads what this plan changes.</MudText>
        }
        else
        {
            <MudExpansionPanels>
                @foreach (var module in _relevant)
                {
                    var (icon, color, label) = Badge(module);

                    <MudExpansionPanel Expanded="@(module.ModuleId == _expandedId)"
                                       ExpandedChanged="@(e => HandleExpansionChanged(module.ModuleId, e))">
                        <TitleContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@icon" Color="@color" Size="Size.Small"/>
                                <MudText Typo="Typo.body1" Style="font-family: var(--snap-font-mono);">
                                    @module.NamespaceName/@module.ModuleName
                                </MudText>
                                <MudText Typo="Typo.body2" Color="@color">@label</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Waiting on</MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">@Upstreams(module)</MudText>

                            @if (module.Signals.Count > 0)
                            {
                                <MudText Typo="Typo.overline" Class="mud-text-secondary">Predicted output changes</MudText>
                                <MudSimpleTable Dense="true" Class="mb-3">
                                    <tbody>
                                    @foreach (var signal in module.Signals)
                                    {
                                        <tr>
                                            <td style="font-family: var(--snap-font-mono);">@signal.Name</td>
                                            <td>
                                                <MudText Typo="Typo.body2" Color="@ActionColor(signal.Action)">@(signal.Action ?? "unknown")</MudText>
                                            </td>
                                            <td>
                                                @if (signal.Sensitive)
                                                {
                                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">sensitive</MudText>
                                                }
                                                else if (signal.AfterIsUnknown)
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Warning">value not knowable until applied</MudText>
                                                }
                                                else if (!signal.HasBefore)
                                                {
                                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">new</MudText>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            }

                            @if (module.ProbeModuleJobId != null)
                            {
                                <MudText Typo="Typo.overline" Class="mud-text-secondary">Logs</MudText>
                                <ListLogs TJob="ModuleJob" TLogEntry="ModuleJobLogEntryDto"
                                          JobId="@module.ProbeModuleJobId.Value"
                                          ModuleId="@module.ModuleId"
                                          TaskFilter="@(new[] { "Probe" })"/>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">No probe has run yet, so there are no logs.</MudText>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudPaper>
}

@code {
    [Parameter] public required Guid ModuleJobId { get; set; }
    [Parameter] public required Guid ModuleId { get; set; }

    /// <summary>
    /// Raised whenever the wave is read, so the approval decision beside this panel can warn
    /// about what has not been checked. Null where this change starts no wave.
    /// </summary>
    [Parameter] public EventCallback<DownstreamImpact?> OnImpactChanged { get; set; }

    [CascadingParameter] public Guid OrganizationId { get; set; }

    private ProbeWaveView? _wave;
    private List<ProbeWaveModuleView> _relevant = [];
    private Guid? _expandedId;

    private Guid? _subscribedWaveId;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        Resubscribe();
    }

    public void Dispose()
    {
        if (_subscribedWaveId != null)
            ProbeWaveUpdatedNotificationService.Unsubscribe(_subscribedWaveId.Value, HandleWaveUpdated);
    }

    /// <summary>
    /// The subscription is keyed on the wave, which is only known once it has been read, and a
    /// job's wave is created after its plan completes, so the first read can find none.
    /// </summary>
    private void Resubscribe()
    {
        if (_wave?.Id == _subscribedWaveId) return;

        if (_subscribedWaveId != null)
            ProbeWaveUpdatedNotificationService.Unsubscribe(_subscribedWaveId.Value, HandleWaveUpdated);

        _subscribedWaveId = _wave?.Id;

        if (_subscribedWaveId != null)
            ProbeWaveUpdatedNotificationService.Subscribe(_subscribedWaveId.Value, HandleWaveUpdated);
    }

    private async Task HandleWaveUpdated(Guid probeWaveId)
    {
        await Reload();
        await InvokeAsync(StateHasChanged);
    }

    public async Task Reload()
    {
        var principalId = HttpContextPrincipalProvider.GetSubject(OrganizationId);
        var discriminator = HttpContextPrincipalProvider.GetPrincipalDiscriminator();
        var principalProvider = new LiteralPrincipalProvider(principalId, discriminator, [OrganizationId]);

        using var moduleRepo = ModuleRepoFactory.Create(principalProvider);
        using var service = ProbeWaveReadServiceFactory.Create();

        _wave = await service.GetByOriginJob(
            ModuleJobId,
            OrganizationId,
            moduleId => moduleRepo.CanRead(moduleId, OrganizationId));

        // The origin answers from its own plan rather than being probed, and a Module nothing
        // reaches has no probe to show. Neither is a panel a reader would open.
        _relevant = _wave == null
            ? []
            : _wave.Modules
                .Where(p => p.ModuleId != _wave.OriginModuleId && !p.NothingToProbe)
                .OrderBy(p => p.NamespaceName)
                .ThenBy(p => p.ModuleName)
                .ToList();

        Resubscribe();

        await OnImpactChanged.InvokeAsync(_wave?.Impact);
    }

    /// <summary>
    /// Pending is deliberately not coloured: the wave has found nothing to report yet, and an
    /// amber chip on every change that is merely still running would be read as a finding.
    /// </summary>
    private static (string Icon, Color Color, string Label) ImpactBadge(DownstreamImpact impact) =>
        impact switch
        {
            DownstreamImpact.Failed => (SnapCdIcons.Error, Color.Error, "Failed"),
            DownstreamImpact.Impact => (SnapCdIcons.Error, Color.Error, "Impact"),
            DownstreamImpact.Cleared => (SnapCdIcons.CheckCircle, Color.Success, "Cleared"),
            _ => (SnapCdIcons.HourglassTop, Color.Default, "Pending")
        };

    /// <summary>
    /// The counts behind the badge. A failed probe is counted apart from the ones still running,
    /// so this line cannot say "still running" about a probe the badge calls failed.
    /// </summary>
    private string Summary()
    {
        if (_relevant.Count == 0) return "nothing affected";

        var reported = _relevant.Count(p => p.Progress == ProbeProgress.Reported);
        var failed = _relevant.Count(p => p.Progress == ProbeProgress.Faulted);
        var running = _relevant.Count - reported - failed;

        var parts = new List<string> { $"{reported} of {_relevant.Count} reported" };

        if (running > 0) parts.Add($"{running} still running");
        if (failed > 0) parts.Add($"{failed} failed");

        var disruptive = _relevant.Count(p => p.HasDisruptiveSignal);
        if (disruptive > 0) parts.Add($"{disruptive} predicting a destroy or replace");

        return string.Join(", ", parts);
    }

    private static string Upstreams(ProbeWaveModuleView module)
    {
        if (module.Edges.Count == 0) return "nothing";

        return string.Join(", ", module.Edges
            .OrderBy(c => c.UpstreamModuleName)
            .Select(c => $"{c.UpstreamModuleName} ({c.Status.ToString().ToLowerInvariant()})"));
    }

    private static Color ActionColor(string? action) => action switch
    {
        "delete" or "replace" => Color.Error,
        "update" => Color.Warning,
        "create" => Color.Success,
        _ => Color.Default
    };

    /// <summary>
    /// A destroy or replace downstream is the finding worth colouring red, since it is the one a
    /// reader might stop for. An unknown value is amber: the probe worked and the answer is that
    /// the plan cannot know yet.
    /// </summary>
    private static (string Icon, Color Color, string Label) Badge(ProbeWaveModuleView p) =>
        p.Progress switch
        {
            ProbeProgress.Reported when p.HasDisruptiveSignal =>
                (SnapCdIcons.Error, Color.Error, "destroys or replaces"),
            ProbeProgress.Reported when p.HasUnknownSignal =>
                (SnapCdIcons.Warning, Color.Warning, "changes, some unknown"),
            ProbeProgress.Reported when p.Signals.Count > 0 =>
                (SnapCdIcons.Warning, Color.Warning, "changes"),
            ProbeProgress.Reported =>
                (SnapCdIcons.CheckCircle, Color.Success, "no change"),
            ProbeProgress.Faulted =>
                (SnapCdIcons.Error, Color.Error, "probe failed"),
            ProbeProgress.Running =>
                (SnapCdIcons.HourglassTop, Color.Default, "running"),
            ProbeProgress.Queued =>
                (SnapCdIcons.HourglassEmpty, Color.Default, "queued"),
            _ =>
                (SnapCdIcons.HourglassEmpty, Color.Default, "waiting on an upstream")
        };

    private void HandleExpansionChanged(Guid moduleId, bool expanded)
    {
        _expandedId = expanded ? moduleId : null;
    }
}
