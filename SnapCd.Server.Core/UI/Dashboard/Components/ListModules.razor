@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Views
@implements IDisposable

@inject PersistentComponentState ApplicationState

<div class="list-heading">Modules</div>

<div class="module-list">
    @foreach (var module in _paginatedModules)
    {
        <MudExpansionPanel @key="module.Id" Disabled="true" HideIcon="true" Class="mb-1">
            <TitleContent>
                @if (ShowCheckboxes)
                {
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <MudCheckBox Color="Color.Secondary" T="bool"
                                     Value="@_selectedModules.Contains(module.Id)"
                                     ValueChanged="@(value => OnModuleSelectionChanged(module.Id, value))"
                                     Dense="true"
                                     Style="margin: 0; padding: 0;"/>
                        <MudLink
                            Href="@($"/Module/{StackName}/{NamespaceName}/{module.Name}")">@GetHighlightedModuleName(module.Name)</MudLink>
                    </div>
                }
                else
                {
                    <MudLink
                        Href="@($"/Module/{StackName}/{NamespaceName}/{module.Name}")">@GetHighlightedModuleName(module.Name)</MudLink>
                }
            </TitleContent>
            <ChildContent>
            </ChildContent>
        </MudExpansionPanel>
    }
</div>

@if (_totalPages > 1)
{
    <Pagination CurrentPage="_currentPage"
                TotalPages="_totalPages"
                PageChanged="HandlePageChanged"/>
}

<style>

    .search-highlight {
        background-color: var(--snap-accent);
        color: var(--snap-on-accent);
        padding: 0 2px;
        border-radius: 0;
    }
</style>

@code {
    [Parameter] public required Guid NamespaceId { get; set; }
    [Parameter] public required string NamespaceName { get; set; }
    [Parameter] public required string StackName { get; set; }
    [Parameter] public List<string> SearchTerms { get; set; } = new();
    [Parameter] public EventCallback<HashSet<Guid>> OnSelectionChanged { get; set; }
    [Parameter] public bool SelectAll { get; set; }
    [Parameter] public bool ShowCheckboxes { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ModuleSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    private List<TruncatedModule> _paginatedModules = new();
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;
    // private PersistingComponentStateSubscription _persistenceSubscription;
    private List<string> _previousSearchTerms = new();
    private HashSet<Guid> _selectedModules = new();
    private bool _previousSelectAll;

    protected override async Task OnParametersSetAsync()
    {
        // Check if search terms have changed
        if (!SearchTerms.SequenceEqual(_previousSearchTerms))
        {
            _previousSearchTerms = new List<string>(SearchTerms);
            await LoadModules();
        }

        // Handle select all parameter change
        if (SelectAll != _previousSelectAll)
        {
            _previousSelectAll = SelectAll;
            if (SelectAll)
            {
                // Select all current modules
                _selectedModules = new HashSet<Guid>(_paginatedModules.Select(m => m.Id));
            }
            else
            {
                // Clear selection
                _selectedModules.Clear();
            }

            if (OnSelectionChanged.HasDelegate)
            {
                await OnSelectionChanged.InvokeAsync(_selectedModules);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadModules();

        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // var cacheKey = $"cachedModules_{NamespaceId}";
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(() =>
        // {
        //     ApplicationState.PersistAsJson(cacheKey, new CachedModulesData
        //     {
        //         Modules = _paginatedModules,
        //         CurrentPage = _currentPage,
        //         TotalPages = _totalPages,
        //         NamespaceId = NamespaceId
        //     });
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<CachedModulesData>(cacheKey, out var cachedData))
        // {
        //     _paginatedModules = cachedData.Modules;
        //     _currentPage = cachedData.CurrentPage;
        //     _totalPages = cachedData.TotalPages;
        // }
    }

    public async Task LoadModules(bool resetPage = true)
    {
        using var repo = RepoFactory.Create();
        if (resetPage)
        {
            _currentPage = 1; // Reset to first page when searching
        }

        // Build query with search terms
        if (SearchTerms.Any())
        {
            // Get all modules and filter client-side for now since we need to count them
            var allModules = await repo.List(OrganizationId,
                q => q
                    .Where(m => m.NamespaceId == NamespaceId)
                    .Where(m => SearchTerms.All(term => m.Name.Contains(term)))
                    .Select(m => new TruncatedModule { Id = m.Id, Name = m.Name }),
                orderBy: q => q.OrderBy(m => m.Name)
            );

            var sortedModules = allModules.OrderBy(m => m.Name).ToList();
            var totalCount = sortedModules.Count;
            _totalPages = (int)Math.Ceiling(totalCount / (double)PageSize);

            // Apply pagination
            _paginatedModules = sortedModules
                .Skip((_currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        else
        {
            // No search terms, use normal pagination
            var totalCount = await repo.Count(OrganizationId, q => q.Where(x => x.NamespaceId == NamespaceId));
            _totalPages = (int)Math.Ceiling(totalCount / (double)PageSize);

            var modules = await repo.List(OrganizationId,
                q => q
                    .Where(m => m.NamespaceId == NamespaceId)
                    .Select(m => new TruncatedModule { Id = m.Id, Name = m.Name }),
                orderBy: q => q.OrderBy(m => m.Name),
                pageNumber: _currentPage,
                pageSize: PageSize
            );
            _paginatedModules = modules.OrderBy(m => m.Name).ToList();
        }
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
    }

    public List<TruncatedModule> GetSelectedModules()
    {
        return _paginatedModules.Where(m => _selectedModules.Contains(m.Id)).ToList();
    }

    private async Task HandlePageChanged(int newPage)
    {
        _currentPage = newPage;
        await LoadModules(false);
    }

    private async Task OnModuleSelectionChanged(Guid moduleId, bool isSelected)
    {
        if (isSelected)
        {
            _selectedModules.Add(moduleId);
        }
        else
        {
            _selectedModules.Remove(moduleId);
        }

        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(_selectedModules);
        }
    }

    private MarkupString GetHighlightedModuleName(string moduleName)
    {
        if (!SearchTerms.Any())
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(moduleName));

        var highlightedName = System.Web.HttpUtility.HtmlEncode(moduleName);

        foreach (var term in SearchTerms.OrderByDescending(t => t.Length))
        {
            var escapedTerm = System.Text.RegularExpressions.Regex.Escape(term);
            highlightedName = System.Text.RegularExpressions.Regex.Replace(
                highlightedName,
                escapedTerm,
                match => $"<mark class=\"search-highlight\">{match.Value}</mark>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }

        return new MarkupString(highlightedName);
    }

    private class CachedModulesData
    {
        public Guid NamespaceId { get; set; }
        public List<TruncatedModule> Modules { get; set; } = new();
        public int CurrentPage { get; set; }
        public int TotalPages { get; set; }
    }

}

<style>
    .module-list {
        margin-left: 0;
    }

    .search-highlight {
        background-color: var(--snap-accent);
        color: var(--snap-on-accent);
        padding: 0 2px;
        border-radius: 0;
    }
</style>