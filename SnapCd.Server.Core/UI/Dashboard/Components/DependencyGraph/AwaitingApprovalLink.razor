@using SnapCd.Server.Core.Dtos

@if (Href is not null)
{
    <MudLink Href="@Href"
             Color="Color.Info"
             Typo="Typo.caption"
             Class="font-weight-medium"
             Style="font-size: 0.8rem;"
             @onclick:stopPropagation="true">
        awaiting approval
    </MudLink>
}
else
{
    <MudText Color="Color.Info" Typo="Typo.caption" Class="font-weight-medium" Style="font-size: 0.8rem;">
        awaiting approval
    </MudText>
}

@code {
    [Parameter] public required DependencyGraphNodeStateDto Node { get; set; }

    /// <summary>
    /// The job's Approvals tab, in the shape ModulePage routes and IntegrationEventDispatcher
    /// builds for the same purpose. Null where no job is in flight, which leaves plain text.
    /// </summary>
    private string? Href => Node.CurrentModuleJobId is { } jobId
        ? $"/Module/{Node.DisplayName}?action=Jobs&job={jobId}&tab=approvals"
        : null;
}
