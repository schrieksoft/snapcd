@using SnapCd.Contracts.Dto
@using System.Collections.Generic
@using MudBlazor
@using SnapCd.Contracts
@using SnapCd.Server.Core.Dtos
@inject NavigationManager Navigation

<div class="dag-stages"
     style="display: flex; gap: 24px; min-width: max-content; padding: 16px;">
    @{
        // Group stages and order them
        var stages = DependencyGraphWithStates.NodeStates
            .GroupBy(n => n.Stage)
            .OrderBy(g => g.Key);

        var stagesList = stages.ToList();
    }

    @foreach (var stage in stagesList)
    {
        <div class="stage-column" style="min-width: 240px; flex-shrink: 0;">
            @{
                var executionOrder = stagesList.IndexOf(stage) + 1;
            }
            <MudText Typo="Typo.subtitle1" Class="mb-2" Align="Align.Center">
                Stage @executionOrder
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-2" Align="Align.Center" Style="font-size: 0.8rem;">
                Must
                be @(DependencyGraphWithStates.Direction == "Destroy" ? "destroyed" : "applied") @(executionOrder == 1 ? "first" : stage.First().StageOrdinal)
            </MudText>

            <MudStack Spacing="1">
                @{
                    var namespaceGroups = stage.GroupBy(n => n.NamespaceDisplayName)
                        .OrderBy(g => g.Key);
                }

                @foreach (var namespaceGroup in namespaceGroups)
                {
                    var namespaceStyle = GetNamespaceCardStyle(namespaceGroup.Key);
                    <MudCard Elevation="1" Class="mb-1" Style="@namespaceStyle">
                        <MudCardHeader Class="pa-2 pb-1">
                            <CardHeaderContent>
                                <MudLink Href="@($"/Stacks/{namespaceGroup.Key}")"
                                         Typo="Typo.body2" Class="font-weight-bold">
                                    @namespaceGroup.First().NamespaceName
                                </MudLink>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-2 pt-0">
                            <MudStack Spacing="0">
                                @foreach (var nodeState in namespaceGroup.OrderBy(n => n.ModuleName))
                                {
                                    var isUninvolved = UninvolvedModuleIds?.Contains(nodeState.ModuleId) ?? false;
                                    var hasDeps = nodeState.IncomingEdges.Any() || nodeState.OutgoingEdges.Any();
                                    var moduleStyle = GetModuleCardStyle(nodeState, isUninvolved);
                                    var isRoot = nodeState.ModuleId == RootModuleId;

                                    @if (hasDeps)
                                    {
                                        <MudExpansionPanels Elevation="0" Class="ma-0 dag-module-panel">
                                            <MudExpansionPanel Class="pa-0" Style="@moduleStyle">
                                                <TitleContent>
                                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                                                        <MudLink Href="@($"/Stacks/{nodeState.DisplayName}")"
                                                                 Typo="Typo.caption" Class="font-weight-medium"
                                                                 Style="@(isRoot ? "color: white !important; font-size: 0.8rem;" : "font-size: 0.8rem;")"
                                                                 @onclick:stopPropagation="true">
                                                            @nodeState.ModuleName@(isRoot ? " (This module)" : "")
                                                        </MudLink>
                                                        <MudIcon Icon="@nodeState.StateIcon"
                                                                 Color="@nodeState.StateColor"
                                                                 Size="Size.Small" Style="font-size: 1rem;"/>
                                                    </div>
                                                    @if (isRoot)
                                                    {
                                                        <MudText Typo="Typo.caption" Style="color: white; font-size: 0.75rem;">
                                                            @nodeState.StateDisplayText
                                                        </MudText>
                                                    }
                                                    else if (isUninvolved)
                                                    {
                                                        <MudText Typo="Typo.caption" Style="color: #616161; font-size: 0.75rem;">
                                                            Not involved in @(DependencyGraphWithStates.Direction == "Destroy" ? "destruction" : "apply")
                                                        </MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Color="@nodeState.StateColor" Style="font-size: 0.75rem;">
                                                            @nodeState.StateDisplayText
                                                        </MudText>
                                                    }
                                                </TitleContent>
                                                <ChildContent>
                                                    <MudStack Spacing="1" Class="pa-1">
                                                        @if (nodeState.IncomingEdges.Any())
                                                        {
                                                            <div>
                                                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 0.75rem;">
                                                                    @(DependencyGraphWithStates.Direction == "Destroy" ? "Depended on by:" : "Depends on:")
                                                                </MudText>
                                                                <MudStack Spacing="0" Class="ml-2">
                                                                    @foreach (var dep in nodeState.IncomingEdges)
                                                                    {
                                                                        <MudLink Typo="Typo.caption"
                                                                                 Href="@($"/Stacks/{dep.DisplayName}")"
                                                                                 Style="font-size: 0.8rem;">
                                                                            @dep.ShortDisplayName
                                                                        </MudLink>
                                                                    }
                                                                </MudStack>
                                                            </div>
                                                        }

                                                        @if (nodeState.IncomingEdges.Any() && nodeState.OutgoingEdges.Any())
                                                        {
                                                            <MudDivider/>
                                                        }

                                                        @if (nodeState.OutgoingEdges.Any())
                                                        {
                                                            <div>
                                                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 0.75rem;">
                                                                    @(DependencyGraphWithStates.Direction == "Destroy" ? "Depends on:" : "Depended on by:")
                                                                </MudText>
                                                                <MudStack Spacing="0" Class="ml-2">
                                                                    @foreach (var trigger in nodeState.OutgoingEdges)
                                                                    {
                                                                        <MudLink Typo="Typo.caption"
                                                                                 Href="@($"/Stacks/{trigger.DisplayName}")"
                                                                                 Style="font-size: 0.8rem;">
                                                                            @trigger.ShortDisplayName
                                                                        </MudLink>
                                                                    }
                                                                </MudStack>
                                                            </div>
                                                        }
                                                    </MudStack>
                                                </ChildContent>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                    else
                                    {
                                        <div class="dag-module-nodeps" style="@moduleStyle">
                                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                                                <MudLink Href="@($"/Stacks/{nodeState.DisplayName}")"
                                                         Typo="Typo.caption" Class="font-weight-medium"
                                                         Style="@(isRoot ? "color: white !important; font-size: 0.8rem;" : "font-size: 0.8rem;")">
                                                    @nodeState.ModuleName@(isRoot ? " (This module)" : "")
                                                </MudLink>
                                                <MudIcon Icon="@nodeState.StateIcon"
                                                         Color="@nodeState.StateColor"
                                                         Size="Size.Small" Style="font-size: 1rem;"/>
                                            </div>
                                            @if (isRoot)
                                            {
                                                <MudText Typo="Typo.caption" Style="color: white; font-size: 0.75rem;">
                                                    @nodeState.StateDisplayText
                                                </MudText>
                                            }
                                            else if (isUninvolved)
                                            {
                                                <MudText Typo="Typo.caption" Style="color: #616161; font-size: 0.75rem;">
                                                    Not involved in @(DependencyGraphWithStates.Direction == "Destroy" ? "destruction" : "apply")
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="@nodeState.StateColor" Style="font-size: 0.75rem;">
                                                    @nodeState.StateDisplayText
                                                </MudText>
                                            }
                                        </div>
                                    }
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        </div>

        @if (stage != stagesList.Last())
        {
            <div class="stage-arrow"
                 style="display: flex; align-items: center; justify-content: center; min-width: 32px; height: 100%;">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" Color="Color.Default"/>
            </div>
        }
    }
</div>

@if (!DependencyGraphWithStates.NodeStates.Any())
{
    <MudAlert Severity="Severity.Info">
        No dependencies found for this module.
    </MudAlert>
}

<style>
    .stage-column {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 12px;
    }

    .stage-arrow {
        opacity: 0.5;
    }

    .dag-module-panel .mud-expand-panel {
        margin: 2px 0;
    }

    .dag-module-panel .mud-expand-panel-header {
        padding: 4px 8px;
        min-height: unset;
    }

    .dag-module-panel .mud-expand-panel-content {
        padding: 4px 8px;
    }

    .dag-module-nodeps {
        padding: 4px 8px;
        margin: 2px 0;
        border-radius: 4px;
    }
</style>

@code {
    [Parameter] public ModuleDependencyGraphDto DependencyGraphWithStates { get; set; } = null!;
    [Parameter] public HashSet<Guid>? UninvolvedModuleIds { get; set; }
    [Parameter] public Guid RootModuleId { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    private string GetNamespaceCardStyle(string namespaceDisplayName)
    {
        // All namespace cards use the same styling (no special styling for external namespaces)
        return "";
    }

    private string GetModuleCardStyle(DependencyGraphNodeStateDto nodeState, bool isUninvolved)
    {
        // Black with white text for THE module being viewed
        if (nodeState.ModuleId == RootModuleId)
        {
            return "background-color: var(--mud-palette-black) !important; color: white !important; " + nodeState.NodeBorderStyle;
        }
        // Grey for uninvolved modules
        else if (isUninvolved)
        {
            return "background-color: #d0d0d0 !important; color: #616161 !important; " + nodeState.NodeBorderStyle;
        }
        // Normal styling with state colors/borders
        else
        {
            return nodeState.NodeBorderStyle;
        }
    }

}