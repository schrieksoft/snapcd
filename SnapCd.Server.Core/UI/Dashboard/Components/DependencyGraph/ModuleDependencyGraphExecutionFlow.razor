@using SnapCd.Contracts.Dto
@using System.Collections.Generic
@using MudBlazor
@using SnapCd.Contracts
@using SnapCd.Server.Core.Dtos

@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.PrincipalProvider
@implements IDisposable

@inject UserColorSecuredRepositoryFactory ColorRepoFactory
@inject ColorsModifiedNotificationService ColorsModifiedNotificationService
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject NavigationManager Navigation

<div class="dag-stages"
     style="display: flex; gap: 24px; min-width: max-content; padding: 16px;">
    @{
        // Group stages and order them
        var stages = DependencyGraphWithStates.NodeStates
            .GroupBy(n => n.Stage)
            .OrderBy(g => g.Key);

        var stagesList = stages.ToList();
    }

    @foreach (var stage in stagesList)
    {
        <div class="stage-column" style="min-width: 240px; flex-shrink: 0;">
            @{
                var executionOrder = stagesList.IndexOf(stage) + 1;
            }
            <MudStack Spacing="1">
                @{
                    var namespaceGroups = stage.GroupBy(n => n.NamespaceDisplayName)
                        .OrderBy(g => g.Key);
                }

                @foreach (var namespaceGroup in namespaceGroups)
                {
                    var nsId = namespaceGroup.First().NamespaceId;
                    var nsColor = GetColor(nsId);
                    var namespaceClass = GetNamespaceCardClass(namespaceGroup.Key);
                    <MudCard Elevation="1" Class="@($"mb-1 dag-namespace-card {namespaceClass}")"
                             Style="@(nsColor != null ? $"--ns-color: {nsColor};" : "")">
                        <MudCardHeader Class="pa-2 pb-1">
                            <CardHeaderContent>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <MudLink Href="@($"/Namespace/{namespaceGroup.Key}")"
                                             Typo="Typo.body2" Class="font-weight-bold">
                                        @namespaceGroup.First().NamespaceName
                                    </MudLink>
                                    <ColorPicker TargetType="ColorTargetType.Namespace" TargetId="@nsId"/>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-2 pt-0">
                            <MudStack Spacing="0">
                                @foreach (var nodeState in namespaceGroup.OrderBy(n => n.ModuleName))
                                {
                                    var isUninvolved = UninvolvedModuleIds?.Contains(nodeState.ModuleId) ?? false;
                                    var hasDeps = nodeState.IncomingEdges.Any() || nodeState.OutgoingEdges.Any();
                                    var moduleStyle = GetModuleCardStyle(nodeState, isUninvolved);
                                    var isRoot = nodeState.ModuleId == RootModuleId;

                                    @if (hasDeps)
                                    {
                                        <MudExpansionPanels Elevation="0" Class="ma-0 dag-module-panel">
                                            <MudExpansionPanel Class="pa-0" Style="@moduleStyle">
                                                <TitleContent>
                                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                                                        <MudLink Href="@($"/Module/{nodeState.DisplayName}")"
                                                                 Typo="Typo.caption" Class="font-weight-medium"
                                                                 Style="@(isRoot ? "color: white !important; font-size: 0.8rem;" : "font-size: 0.8rem;")"
                                                                 @onclick:stopPropagation="true">
                                                            @nodeState.ModuleName@(isRoot ? " (This module)" : "")
                                                        </MudLink>
                                                    </div>
                                                    @if (isRoot)
                                                    {
                                                        <MudText Typo="Typo.caption" Style="color: white; font-size: 0.75rem;">
                                                            @nodeState.StateDisplayText
                                                        </MudText>
                                                    }
                                                    else if (isUninvolved)
                                                    {
                                                        <MudText Typo="Typo.caption" Style="color: #616161; font-size: 0.75rem;">
                                                            Not involved in @(DependencyGraphWithStates.Direction == "Destroy" ? "destruction" : "apply")
                                                        </MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Color="@nodeState.StateColor" Style="font-size: 0.75rem;">
                                                            @nodeState.StateDisplayText
                                                        </MudText>
                                                    }
                                                </TitleContent>
                                                <ChildContent>
                                                    <MudStack Spacing="1" Class="pa-1">
                                                        @if (nodeState.IncomingEdges.Any())
                                                        {
                                                            <div>
                                                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 0.75rem;">
                                                                    @(DependencyGraphWithStates.Direction == "Destroy" ? "Depended on by:" : "Depends on:")
                                                                </MudText>
                                                                <MudStack Spacing="0" Class="ml-2">
                                                                    @foreach (var dep in nodeState.IncomingEdges)
                                                                    {
                                                                        <MudLink Typo="Typo.caption"
                                                                                 Href="@($"/Module/{dep.DisplayName}")"
                                                                                 Style="font-size: 0.8rem;">
                                                                            @dep.ShortDisplayName
                                                                        </MudLink>
                                                                    }
                                                                </MudStack>
                                                            </div>
                                                        }

                                                        @if (nodeState.IncomingEdges.Any() && nodeState.OutgoingEdges.Any())
                                                        {
                                                            <MudDivider/>
                                                        }

                                                        @if (nodeState.OutgoingEdges.Any())
                                                        {
                                                            <div>
                                                                <MudText Typo="Typo.caption" Class="font-weight-bold" Style="font-size: 0.75rem;">
                                                                    @(DependencyGraphWithStates.Direction == "Destroy" ? "Depends on:" : "Depended on by:")
                                                                </MudText>
                                                                <MudStack Spacing="0" Class="ml-2">
                                                                    @foreach (var trigger in nodeState.OutgoingEdges)
                                                                    {
                                                                        <MudLink Typo="Typo.caption"
                                                                                 Href="@($"/Module/{trigger.DisplayName}")"
                                                                                 Style="font-size: 0.8rem;">
                                                                            @trigger.ShortDisplayName
                                                                        </MudLink>
                                                                    }
                                                                </MudStack>
                                                            </div>
                                                        }
                                                    </MudStack>
                                                </ChildContent>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                    else
                                    {
                                        <div class="dag-module-nodeps" style="@moduleStyle">
                                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                                                <MudLink Href="@($"/Module/{nodeState.DisplayName}")"
                                                         Typo="Typo.caption" Class="font-weight-medium"
                                                         Style="@(isRoot ? "color: white !important; font-size: 0.8rem;" : "font-size: 0.8rem;")">
                                                    @nodeState.ModuleName@(isRoot ? " (This module)" : "")
                                                </MudLink>
                                            </div>
                                            @if (isRoot)
                                            {
                                                <MudText Typo="Typo.caption" Style="color: white; font-size: 0.75rem;">
                                                    @nodeState.StateDisplayText
                                                </MudText>
                                            }
                                            else if (isUninvolved)
                                            {
                                                <MudText Typo="Typo.caption" Style="color: #616161; font-size: 0.75rem;">
                                                    Not involved in @(DependencyGraphWithStates.Direction == "Destroy" ? "destruction" : "apply")
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="@nodeState.StateColor" Style="font-size: 0.75rem;">
                                                    @nodeState.StateDisplayText
                                                </MudText>
                                            }
                                        </div>
                                    }
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        </div>

        @if (stage != stagesList.Last())
        {
            <div class="stage-arrow"
                 style="display: flex; align-items: center; justify-content: center; min-width: 32px; height: 100%;">
                <MudIcon Icon="@SnapCdIcons.ArrowForward" Size="Size.Medium" Color="Color.Default"/>
            </div>
        }
    }
</div>

@if (!DependencyGraphWithStates.NodeStates.Any())
{
    <MudAlert Severity="Severity.Info">
        No dependencies found for this module.
    </MudAlert>
}

<style>
    .stage-column {
        background: transparent;
        border: none;
        border-radius: 8px;
        padding: 12px;
    }

    /* Namespace grouping cards get an inset background so they stand out from
       the transparent stage columns and the surface-coloured module nodes */
    .dag-namespace-card {
        background: var(--snap-bg-inset, var(--mud-palette-background-grey));
    }

    /* A personal colour (--ns-color, set by ColorPicker) is painted as a wash at the top
       of the card: full strength at the top-left, fading out downwards (gone by 38px, a
       little past the ~32px header) and out to the right edge.

       It lives on a ::before layer rather than on the card's own background because the two
       axes need different tools — a colour gradient down, a mask across — and a mask on the
       card itself would fade the module rows out with it. On its own layer it cannot touch
       real content: the module cards inside must look identical whether or not the
       namespace is coloured or external.

       Fading via color-mix keeps the hue constant; interpolating to `transparent` would
       drag it through black (rgba(0,0,0,0) in sRGB) and muddy the midtones on light
       surfaces. Eased, not linear, so it reads as a band rather than a wash. Nothing but
       the heading sits in the opaque part, so it can be full neon with no contrast cost. */
    .dag-namespace-card[style*="--ns-color"] {
        position: relative;
    }

    .dag-namespace-card[style*="--ns-color"]::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 38px;
        pointer-events: none;
        z-index: 0;
        background-image: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--ns-color) 100%, transparent) 0,
            color-mix(in srgb, var(--ns-color) 40%, transparent) 13px,
            color-mix(in srgb, var(--ns-color) 10%, transparent) 26px,
            color-mix(in srgb, var(--ns-color) 0%, transparent) 38px
        );
        -webkit-mask-image: linear-gradient(to right, black 0, black 25%, transparent 100%);
        mask-image: linear-gradient(to right, black 0, black 25%, transparent 100%);
    }

    /* Header content sits above the wash. */
    .dag-namespace-card[style*="--ns-color"] > .mud-card-header {
        position: relative;
        z-index: 1;
    }


    /* A namespace outside the one being viewed is rendered INVERTED against the current
       surface, so the whole card reads as "not from here" at a glance. It flips with the
       theme — dark card in light mode, light card in dark mode — which is why this is a
       class and not an inline style (a static helper cannot know the theme). */
    .dag-namespace-card-external {
        background: var(--snap-ink, #12171D) !important;
    }

    .mud-dark .dag-namespace-card-external {
        background: var(--snap-mist, #DDE3E8) !important;
    }

    /* Only the card's own header text inverts. Scoped with `>` so it cannot reach the
       module rows: those must look identical whether or not the namespace is external. */
    .dag-namespace-card-external > .mud-card-header,
    .dag-namespace-card-external > .mud-card-header .mud-typography,
    .dag-namespace-card-external > .mud-card-header a {
        color: var(--snap-paper, #FAFBFB) !important;
    }

    .mud-dark .dag-namespace-card-external > .mud-card-header,
    .mud-dark .dag-namespace-card-external > .mud-card-header .mud-typography,
    .mud-dark .dag-namespace-card-external > .mud-card-header a {
        color: var(--snap-ink, #12171D) !important;
    }

    /* The module rows carry no background of their own (GetModuleCardStyle returns
       border-only styling for a normal module), so on an inverted card they would inherit
       it and their text would become unreadable. Give them back the surface they expect —
       this is what keeps module content identical inside and outside the namespace. */
    .dag-namespace-card-external > .mud-card-content .mud-expand-panel,
    .dag-namespace-card-external > .mud-card-content .dag-module-nodeps {
        background: var(--snap-bg-raised, var(--mud-palette-surface)) !important;
        color: var(--snap-text, var(--mud-palette-text-primary)) !important;
    }

    .stage-arrow {
        opacity: 0.5;
    }

    .dag-module-panel .mud-expand-panel {
        margin: 2px 0;
    }

    /* The gutters class is more specific than the shorthand, so it must be named to be overridden. */
    .dag-module-panel .mud-expand-panel-header,
    .dag-module-panel .mud-expand-panel-header.mud-expand-panel-header-gutters {
        padding: 4px 8px;
        min-height: unset;
    }

    .dag-module-panel .mud-expand-panel-content,
    .dag-module-panel .mud-expand-panel-content.mud-expand-panel-gutters {
        padding: 4px 8px;
    }

    /* MudBlazor gives .mud-expand-panel a surface background; a dependency-free module renders
       as a plain div instead, so it needs the same one to match the panels beside it. */
    .dag-module-nodeps {
        padding: 4px 8px;
        margin: 2px 0;
        border-radius: 4px;
        background-color: var(--mud-palette-surface);
    }
</style>

@code {
    [Parameter] public ModuleDependencyGraphDto DependencyGraphWithStates { get; set; } = null!;
    [Parameter] public HashSet<Guid>? UninvolvedModuleIds { get; set; }
    [Parameter] public Guid RootModuleId { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    private string GetNamespaceCardClass(string namespaceDisplayName)
    {
        // All namespace cards use the same styling (no special styling for external namespaces)
        return "";
    }

    private string GetModuleCardStyle(DependencyGraphNodeStateDto nodeState, bool isUninvolved)
    {
        // Black with white text for THE module being viewed
        if (nodeState.ModuleId == RootModuleId)
        {
            return "background-color: var(--mud-palette-black) !important; color: white !important; " + nodeState.NodeBorderStyle;
        }
        // Grey for uninvolved modules
        else if (isUninvolved)
        {
            return "background-color: #d0d0d0 !important; color: #616161 !important; " + nodeState.NodeBorderStyle;
        }
        // Normal styling with state colors/borders
        else
        {
            return nodeState.NodeBorderStyle;
        }
    }

    // The caller's personal colours, keyed by target id. Fetched once for the whole graph —
    // the cards resolve against this in memory rather than each hitting the database.
    private Dictionary<Guid, string> _colors = new();
    private Guid _colorUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadColors();

        if (_colorUserId != Guid.Empty)
            ColorsModifiedNotificationService.Subscribe(_colorUserId, OnColorsModified);
    }

    private async Task LoadColors()
    {
        if (OrganizationId == Guid.Empty) return;

        _colorUserId = HttpContextPrincipalProvider.GetSubjectOrDefault(OrganizationId);

        using var repo = ColorRepoFactory.Create();
        var colors = await repo.List(OrganizationId);
        _colors = colors.ToDictionary(c => c.TargetId, c => c.Color);
    }

    private async Task OnColorsModified(Guid userId)
    {
        await LoadColors();
        await InvokeAsync(StateHasChanged);
    }

    private string? GetColor(Guid targetId)
    {
        return _colors.GetValueOrDefault(targetId);
    }

    public void Dispose()
    {
        if (_colorUserId != Guid.Empty)
            ColorsModifiedNotificationService.Unsubscribe(_colorUserId, OnColorsModified);
    }
}
