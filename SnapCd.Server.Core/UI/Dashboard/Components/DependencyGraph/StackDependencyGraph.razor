@using SnapCd.Server.Core.Dtos
@inherits DependencyGraphViewBase<StackDependencyGraphDto>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true"/>
    <MudText Typo="Typo.body2" Class="mt-2">Loading dependency graph...</MudText>
}
else if (Graph != null)
{
    <MudStack Class="mb-3">
        <MudTooltip Text="@GetToggleTooltipText()">
            <MudSwitch Color="Color.Secondary" Value="ShowDestroyGraph"
                       ValueChanged="@(async (bool val) => await OnShowDestroyGraphChanged(val))"
                       Disabled="DisableDirectionToggle">
                Show Destroy Graph
            </MudSwitch>
        </MudTooltip>
    </MudStack>

    <div @ref="ScrollContainer" data-dag-scroll style="overflow: auto; height: @(ScrollContainerHeight)px;">
        <StackDependencyGraphExecutionFlow DependencyGraphWithStates="Graph"/>
    </div>
}
else if (Error != null)
{
    <MudAlert Severity="Severity.Error">
        Error loading dependency graph: @Error
    </MudAlert>
}

@code {
    [Parameter] public Guid StackId { get; set; }
    [Parameter] public string StackName { get; set; } = null!;

    protected override Guid ScopeId => StackId;

    protected override Task<StackDependencyGraphDto> BuildApplyGraph() =>
        ApplyServiceFactory.Create().BuildStackApplyGraphAsync(StackId, StackName);

    protected override Task<StackDependencyGraphDto> BuildDestroyGraph() =>
        DestroyServiceFactory.Create().BuildStackDestroyGraphAsync(StackId, StackName);
}
