@using SnapCd.Server.Core.Dtos
@inherits DependencyGraphViewBase<NamespaceDependencyGraphDto>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true"/>
    <MudText Typo="Typo.body2" Class="mt-2">Loading dependency graph...</MudText>
}
else if (Graph != null)
{
    <MudStack Row="true" Class="graph-toggles">
        <MudSwitch @bind-Value="_showModulesOutsideNamespace" Color="Color.Secondary">
            Show Modules outside Namespace
        </MudSwitch>
        <MudTooltip Text="@GetToggleTooltipText()">
            <MudSwitch Color="Color.Secondary" Value="ShowDestroyGraph"
                       ValueChanged="@(async (bool val) => await OnShowDestroyGraphChanged(val))"
                       Disabled="DisableDirectionToggle">
                Show Destroy Graph
            </MudSwitch>
        </MudTooltip>
    </MudStack>

    <div @ref="ScrollContainer" data-dag-scroll class="dag-scroll">
        <NamespaceDependencyGraphExecutionFlow DependencyGraphWithStates="GetFilteredGraph()"
                                               UninvolvedModuleIds="UninvolvedModuleIds"
                                               PrimaryNamespaceId="NamespaceId"/>
    </div>
}
else if (Error != null)
{
    <MudAlert Severity="Severity.Error">
        Error loading dependency graph: @Error
    </MudAlert>
}

@code {
    [Parameter] public Guid NamespaceId { get; set; }
    [Parameter] public string NamespaceName { get; set; } = null!;

    /// <summary>
    /// Modules the pending operation leaves alone, drawn greyed out. A Namespace is not bounded: a
    /// module in it can depend on one elsewhere, so a selection does not cover everything shown.
    /// </summary>
    [Parameter] public HashSet<Guid>? UninvolvedModuleIds { get; set; }

    private bool _showModulesOutsideNamespace;

    protected override Guid ScopeId => NamespaceId;

    protected override Task<NamespaceDependencyGraphDto> BuildApplyGraph() =>
        ApplyServiceFactory.Create().BuildNamespaceApplyGraphAsync(NamespaceId, NamespaceName);

    protected override Task<NamespaceDependencyGraphDto> BuildDestroyGraph() =>
        DestroyServiceFactory.Create().BuildNamespaceDestroyGraphAsync(NamespaceId, NamespaceName);

    /// <summary>Shows the modules outside this Namespace that its own modules depend on.</summary>
    private NamespaceDependencyGraphDto GetFilteredGraph()
    {
        if (Graph == null || _showModulesOutsideNamespace) return Graph!;

        return new NamespaceDependencyGraphDto
        {
            NamespaceId = Graph.NamespaceId,
            NamespaceName = Graph.NamespaceName,
            Direction = Graph.Direction,
            TargetState = Graph.TargetState,
            NodeStates = Graph.NodeStates.Where(n => n.NamespaceId == NamespaceId).ToList()
        };
    }
}
