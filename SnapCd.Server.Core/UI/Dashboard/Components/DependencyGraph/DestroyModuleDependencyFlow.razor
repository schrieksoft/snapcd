@using SnapCd.Contracts
@using SnapCd.Server.Core.Dtos
@using SnapCd.Server.Core.Enums

@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.PrincipalProvider
@implements IDisposable

@inject UserColorSecuredRepositoryFactory ColorRepoFactory
@inject ColorsModifiedNotificationService ColorsModifiedNotificationService
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject NavigationManager Navigation

@* ColorPicker reads OrganizationId as a cascading parameter; supply it here since the
   dialog this renders in does not. *@
<CascadingValue Value="OrganizationId">
<div class="dag-stages"
     style="display: flex; gap: 24px; min-width: max-content; padding: 16px; overflow-x: auto; width: 100%;">
    @{
        // Group nodes by stage, lowest stage number first (Stage 1 = first to be destroyed).
        var stagesList = DestroyGraph.NodeStates
            .GroupBy(n => n.Stage)
            .OrderBy(g => g.Key)
            .ToList();
    }

    @foreach (var stage in stagesList)
    {
        <div class="stage-column" style="min-width: 280px; flex-shrink: 0;">
            @{
                var executionOrder = stagesList.IndexOf(stage) + 1;
            }
            <MudText Typo="Typo.h6" Class="mb-3" Align="Align.Center">
                Stage @executionOrder
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-3" Align="Align.Center">
                Destroyed @(executionOrder == 1 ? "first" : $"after Stage {executionOrder - 1}")
            </MudText>

            <MudStack Spacing="2">
                @{
                    var namespaceGroups = stage
                        .GroupBy(n => n.NamespaceName)
                        .OrderBy(g => g.Key);
                }

                @foreach (var namespaceGroup in namespaceGroups)
                {
                    var nsId = namespaceGroup.First().NamespaceId;
                    var nsColor = GetColor(nsId);

                    <MudCard Elevation="1" Class="mb-2 dag-namespace-card"
                             Style="@(nsColor != null ? $"--ns-color: {nsColor};" : "")">
                        <MudCardHeader Class="pb-2">
                            <CardHeaderContent>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <MudText Typo="Typo.body1" Class="font-weight-bold">
                                        @namespaceGroup.Key
                                    </MudText>
                                    <ColorPicker TargetType="ColorTargetType.Namespace" TargetId="@nsId"/>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            <MudStack Spacing="1">
                                @foreach (var node in namespaceGroup.OrderBy(n => n.ModuleName))
                                {
                                    var isRoot = node.ModuleId == DestroyGraph.RootModuleId;

                                    <MudCard Elevation="0" Style="@GetModuleCardStyle(node, isRoot)">
                                        <MudCardHeader Class="pb-2">
                                            <CardHeaderContent>
                                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                    <MudLink Href="@($"/Module/{node.DisplayName}")"
                                                             Typo="Typo.body2"
                                                             Class="font-weight-medium"
                                                             Style="@(isRoot ? "color: white !important;" : "")">
                                                        @node.ModuleName@(isRoot ? " (This module)" : "")
                                                    </MudLink>
                                                </MudStack>
                                                <MudText Typo="Typo.caption"
                                                         Style="@(isRoot ? "color: white;" : "")"
                                                         Color="@(isRoot ? Color.Default : GetStateColor(node))">
                                                    @GetStateText(node)
                                                </MudText>
                                            </CardHeaderContent>
                                        </MudCardHeader>

                                        @if (node.DependentModules.Any() || node.DependencyModules.Any())
                                        {
                                            <MudExpansionPanels Elevation="0" Class="ma-0">
                                                <MudExpansionPanel Class="pa-2"
                                                                   Style="@(isRoot ? "background-color: var(--mud-palette-black) !important; color: white !important;" : "")">
                                                    <TitleContent>
                                                        <div style="display: flex; align-items: center;">
                                                            <MudIcon Icon="@SnapCdIcons.AccountTree" Class="mr-3" />
                                                            <MudText Typo="Typo.body2">Dependencies</MudText>
                                                        </div>
                                                    </TitleContent>
                                                    <ChildContent>
                                                        <MudStack Spacing="2" Class="pa-2">
                                                            @if (node.DependentModules.Any())
                                                            {
                                                                <div>
                                                                    <MudText Typo="Typo.caption" Class="font-weight-bold mb-1">
                                                                        This module is depended on by (destroyed first):
                                                                    </MudText>
                                                                    <MudStack Spacing="1" Class="ml-3 mb-2" AlignItems="AlignItems.Start">
                                                                        @foreach (var dep in node.DependentModules)
                                                                        {
                                                                            <MudChip T="string" Size="Size.Small"
                                                                                     Color="Color.Default"
                                                                                     Variant="Variant.Text"
                                                                                     OnClick="@(() => Navigation.NavigateTo($"/Module/{dep}"))">
                                                                                @dep
                                                                            </MudChip>
                                                                        }
                                                                    </MudStack>
                                                                </div>
                                                            }

                                                            @if (node.DependencyModules.Any())
                                                            {
                                                                @if (node.DependentModules.Any())
                                                                {
                                                                    <MudDivider />
                                                                }
                                                                <div>
                                                                    <MudText Typo="Typo.caption" Class="font-weight-bold mb-1">
                                                                        This module depends on (destroyed after):
                                                                    </MudText>
                                                                    <MudStack Spacing="1" Class="ml-3" AlignItems="AlignItems.Start">
                                                                        @foreach (var trigger in node.DependencyModules)
                                                                        {
                                                                            <MudChip T="string" Size="Size.Small"
                                                                                     Color="Color.Default"
                                                                                     Variant="Variant.Text"
                                                                                     OnClick="@(() => Navigation.NavigateTo($"/Module/{trigger}"))">
                                                                                @trigger
                                                                            </MudChip>
                                                                        }
                                                                    </MudStack>
                                                                </div>
                                                            }
                                                        </MudStack>
                                                    </ChildContent>
                                                </MudExpansionPanel>
                                            </MudExpansionPanels>
                                        }
                                    </MudCard>
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        </div>

        @if (stage != stagesList.Last())
        {
            <div class="stage-arrow"
                 style="display: flex; align-items: center; justify-content: center; min-width: 40px; height: 100%;">
                <MudIcon Icon="@SnapCdIcons.ArrowForward" Size="Size.Large" Color="Color.Default" />
            </div>
        }
    }
</div>

@if (!DestroyGraph.NodeStates.Any())
{
    <MudAlert Severity="Severity.Info">
        Nothing to destroy — the graph is empty.
    </MudAlert>
}

</CascadingValue>

<style>
    .stage-column {
        background: transparent;
        border: none;
        border-radius: 8px;
        padding: 16px;
    }

    /* Namespace grouping cards get an inset background so they stand out from
       the transparent stage columns and the surface-coloured module nodes */
    .dag-namespace-card {
        background: var(--snap-bg-inset, var(--mud-palette-background-grey));
    }

    /* A personal colour (--ns-color, set by ColorPicker) is painted as a wash at the top
       of the card: full strength at the top-left, fading out downwards (gone by 38px, a
       little past the ~32px header) and out to the right edge.

       It lives on a ::before layer rather than on the card's own background because the two
       axes need different tools — a colour gradient down, a mask across — and a mask on the
       card itself would fade the module rows out with it. On its own layer it cannot touch
       real content: the module cards inside must look identical whether or not the
       namespace is coloured or external.

       Fading via color-mix keeps the hue constant; interpolating to `transparent` would
       drag it through black (rgba(0,0,0,0) in sRGB) and muddy the midtones on light
       surfaces. Eased, not linear, so it reads as a band rather than a wash. Nothing but
       the heading sits in the opaque part, so it can be full neon with no contrast cost. */
    .dag-namespace-card[style*="--ns-color"] {
        position: relative;
    }

    .dag-namespace-card[style*="--ns-color"]::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 38px;
        pointer-events: none;
        z-index: 0;
        background-image: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--ns-color) 100%, transparent) 0,
            color-mix(in srgb, var(--ns-color) 40%, transparent) 13px,
            color-mix(in srgb, var(--ns-color) 10%, transparent) 26px,
            color-mix(in srgb, var(--ns-color) 0%, transparent) 38px
        );
        -webkit-mask-image: linear-gradient(to right, black 0, black 25%, transparent 100%);
        mask-image: linear-gradient(to right, black 0, black 25%, transparent 100%);
    }

    /* Header content sits above the wash. */
    .dag-namespace-card[style*="--ns-color"] > .mud-card-header {
        position: relative;
        z-index: 1;
    }


    /* A namespace outside the one being viewed is rendered INVERTED against the current
       surface, so the whole card reads as "not from here" at a glance. It flips with the
       theme — dark card in light mode, light card in dark mode — which is why this is a
       class and not an inline style (a static helper cannot know the theme). */
    .dag-namespace-card-external {
        background: var(--snap-ink, #12171D) !important;
    }

    .mud-dark .dag-namespace-card-external {
        background: var(--snap-mist, #DDE3E8) !important;
    }

    /* Only the card's own header text inverts. Scoped with `>` so it cannot reach the
       module rows: those must look identical whether or not the namespace is external. */
    .dag-namespace-card-external > .mud-card-header,
    .dag-namespace-card-external > .mud-card-header .mud-typography,
    .dag-namespace-card-external > .mud-card-header a {
        color: var(--snap-paper, #FAFBFB) !important;
    }

    .mud-dark .dag-namespace-card-external > .mud-card-header,
    .mud-dark .dag-namespace-card-external > .mud-card-header .mud-typography,
    .mud-dark .dag-namespace-card-external > .mud-card-header a {
        color: var(--snap-ink, #12171D) !important;
    }

    /* The module rows carry no background of their own (GetModuleCardStyle returns
       border-only styling for a normal module), so on an inverted card they would inherit
       it and their text would become unreadable. Give them back the surface they expect —
       this is what keeps module content identical inside and outside the namespace. */
    .dag-namespace-card-external > .mud-card-content .mud-expand-panel,
    .dag-namespace-card-external > .mud-card-content .dag-module-nodeps {
        background: var(--snap-bg-raised, var(--mud-palette-surface)) !important;
        color: var(--snap-text, var(--mud-palette-text-primary)) !important;
    }

    .stage-arrow {
        opacity: 0.5;
    }
</style>

@code {
    [Parameter] public DestroyModuleGraphDto DestroyGraph { get; set; } = null!;

    /// <summary>
    /// Passed explicitly rather than cascaded: this component renders inside a dialog, which
    /// sits outside the page's CascadingValue tree.
    /// </summary>
    [Parameter] public Guid OrganizationId { get; set; }

    private static string GetModuleCardStyle(DestroyModuleNodeDto node, bool isRoot)
    {
        if (isRoot)
        {
            return "background-color: var(--mud-palette-black) !important; color: white !important; border: 2px solid var(--mud-palette-error);";
        }
        if (node.IsAlreadyDestroyed)
        {
            // Already destroyed — render as no-op so the user can see it's a passthrough.
            return "background-color: #d0d0d0 !important; color: #616161 !important;";
        }
        if (node.CanBeDestroyed)
        {
            return "border: 1px solid var(--mud-palette-error);";
        }
        // Currently in some non-Applied, non-Destroyed state (failed, cancelled, etc.) — flag it.
        return "border: 1px solid var(--mud-palette-warning);";
    }

    private static string GetStateIcon(DestroyModuleNodeDto node) => node.ActualState switch
    {
        ActualStateHeadline.Applied => SnapCdIcons.CheckCircle,
        ActualStateHeadline.Destroyed => SnapCdIcons.RemoveCircleOutline,
        ActualStateHeadline.ApplyFailed or ActualStateHeadline.DestroyFailed => SnapCdIcons.Error,
        ActualStateHeadline.ApplyCancelled or ActualStateHeadline.DestroyCancelled => SnapCdIcons.Cancel,
        ActualStateHeadline.ApplyTimeout or ActualStateHeadline.DestroyTimeout => SnapCdIcons.Schedule,
        ActualStateHeadline.ApplyNotApproved or ActualStateHeadline.DestroyNotApproved => SnapCdIcons.Block,
        _ => SnapCdIcons.HelpOutline
    };

    private static Color GetStateColor(DestroyModuleNodeDto node) => node.ActualState switch
    {
        ActualStateHeadline.Applied => Color.Success,
        ActualStateHeadline.Destroyed => Color.Default,
        ActualStateHeadline.ApplyFailed or ActualStateHeadline.DestroyFailed => Color.Error,
        ActualStateHeadline.ApplyCancelled or ActualStateHeadline.DestroyCancelled => Color.Warning,
        ActualStateHeadline.ApplyTimeout or ActualStateHeadline.DestroyTimeout => Color.Warning,
        ActualStateHeadline.ApplyNotApproved or ActualStateHeadline.DestroyNotApproved => Color.Warning,
        _ => Color.Default
    };

    private static string GetStateText(DestroyModuleNodeDto node)
    {
        if (node.IsAlreadyDestroyed) return "Already destroyed — will be skipped";
        if (node.CanBeDestroyed) return "Will be destroyed";
        return node.ActualState?.ToString() ?? "Unknown state";
    }

    // The caller's personal colours, keyed by target id. Fetched once for the whole graph —
    // the cards resolve against this in memory rather than each hitting the database.
    private Dictionary<Guid, string> _colors = new();
    private Guid _colorUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadColors();

        if (_colorUserId != Guid.Empty)
            ColorsModifiedNotificationService.Subscribe(_colorUserId, OnColorsModified);
    }

    private async Task LoadColors()
    {
        if (OrganizationId == Guid.Empty) return;

        _colorUserId = HttpContextPrincipalProvider.GetSubjectOrDefault(OrganizationId);

        using var repo = ColorRepoFactory.Create();
        var colors = await repo.List(OrganizationId);
        _colors = colors.ToDictionary(c => c.TargetId, c => c.Color);
    }

    private async Task OnColorsModified(Guid userId)
    {
        await LoadColors();
        await InvokeAsync(StateHasChanged);
    }

    private string? GetColor(Guid targetId)
    {
        return _colors.GetValueOrDefault(targetId);
    }

    public void Dispose()
    {
        if (_colorUserId != Guid.Empty)
            ColorsModifiedNotificationService.Unsubscribe(_colorUserId, OnColorsModified);
    }
}
