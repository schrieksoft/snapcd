@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.AgentSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.AgentSupplies
@using SnapCd.Server.Core.Views
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudForm @ref="_form">
        <MudGrid Class="pa-4" Spacing="3">
            <MudItem xs="12" md="6">
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="AgentMetadata?"
                                     Label="Agent"
                                     @bind-Value="_selectedAgent"
                                     Disabled="@(AgentId.HasValue)"
                                     Required="@(!AgentId.HasValue)"
                                     RequiredError="Agent is required"
                                     SearchFunc="@SearchAgents"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12" md="12">
                    <MudAutocomplete T="ModuleMetadata?"
                                     Label="Module"
                                     @bind-Value="_selectedModule"
                                     Disabled="@(ModuleId.HasValue)"
                                     Required="@(!ModuleId.HasValue)"
                                     RequiredError="Module is required"
                                     SearchFunc="@SearchModules"
                                     ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>
            </MudItem>

            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="SaveSupply"
                           Class="mr-2">
                    Create
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public Guid? ModuleId { get; set; }
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private AgentModuleSupplySecuredRepositoryFactory SupplyRepoFactory { get; set; } = null!;
    [Inject] private ModuleSecuredRepositoryFactory ModuleRepoFactory { get; set; } = null!;
    [Inject] private AgentSecuredRepositoryFactory AgentRepoFactory { get; set; } = null!;

    private MudForm? _form;
    private ModuleMetadata? _selectedModule;
    private AgentMetadata? _selectedAgent;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialValues();
    }

    private async Task LoadInitialValues()
    {
        if (ModuleId.HasValue)
        {
            using var moduleRepo = ModuleRepoFactory.Create();
            _selectedModule = await moduleRepo.GetMetadata(ModuleId.Value, OrganizationId);
        }

        if (AgentId.HasValue)
        {
            using var storeRepo = AgentRepoFactory.Create();
            _selectedAgent = await storeRepo.GetMetadata(AgentId.Value, OrganizationId);
        }
    }


    private async Task<IEnumerable<ModuleMetadata>> SearchModules(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<ModuleMetadata>();

        using var repo = ModuleRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => q.Where(x => x.Name.Contains(value)),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 20);
    }

    private async Task<IEnumerable<AgentMetadata>> SearchAgents(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<AgentMetadata>();

        using var repo = AgentRepoFactory.Create();
        return await repo.ListMetadata(OrganizationId,
            q => q.Where(x => x.Name.Contains(value)),
            orderBy: q => q.OrderBy(x => x.Name),
            pageSize: 20);
    }

    private async Task SaveSupply()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            var supply = new AgentModuleSupply
            {
                Id = Guid.NewGuid(),
                ModuleId = ModuleId ?? _selectedModule?.Id ?? Guid.Empty,
                AgentId = AgentId ?? _selectedAgent?.Id ?? Guid.Empty,
                OrganizationId = OrganizationId
            };

            if (supply.ModuleId == Guid.Empty || supply.AgentId == Guid.Empty)
            {
                Snackbar.Add("Please select both module and Agent", Severity.Error);
                return;
            }

            using var repo = SupplyRepoFactory.Create();
            await repo.Create(supply);

            Snackbar.Add("Supply created successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating supply: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        _selectedModule = null;
        _selectedAgent = null;
        await OnCancel.InvokeAsync();
    }

}
