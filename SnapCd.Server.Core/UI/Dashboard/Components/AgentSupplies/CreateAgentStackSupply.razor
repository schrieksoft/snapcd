@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Definition.AgentSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured.AgentSupplies
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudForm @ref="_form">
        <MudGrid Class="pa-4" Spacing="3">
            <MudItem xs="12" md="6">
                <MudItem xs="12" md="12">
                    <MudAutocomplete T="Agent?"
                                     Label="Agent"
                                     @bind-Value="_selectedAgent"
                                     Disabled="@(AgentId.HasValue)"
                                     Required="@(!AgentId.HasValue)"
                                     RequiredError="Agent is required"
                                     SearchFunc="@SearchAgents"
                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12" md="12">
                    <MudAutocomplete T="Stack?"
                                     Label="Stack"
                                     @bind-Value="_selectedStack"
                                     Disabled="@(StackId.HasValue)"
                                     Required="@(!StackId.HasValue)"
                                     RequiredError="Stack is required"
                                     SearchFunc="@SearchStacks"
                                     ToStringFunc="@(m => m?.Name ?? string.Empty)"
                                     AdornmentIcon="@SnapCdIcons.Search"
                                     Variant="Variant.Outlined">
                    </MudAutocomplete>
                </MudItem>
            </MudItem>

            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="SaveSupply"
                           Class="mr-2">
                    Create
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public Guid? StackId { get; set; }
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private AgentStackSupplySecuredRepositoryFactory SupplyRepoFactory { get; set; } = null!;
    [Inject] private StackSecuredRepositoryFactory StackRepoFactory { get; set; } = null!;
    [Inject] private AgentSecuredRepositoryFactory AgentRepoFactory { get; set; } = null!;

    private MudForm? _form;
    private Stack? _selectedStack;
    private Agent? _selectedAgent;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialValues();
    }

    private async Task LoadInitialValues()
    {
        if (StackId.HasValue)
        {
            using var stackRepo = StackRepoFactory.Create();
            _selectedStack = await stackRepo.Get(StackId.Value, OrganizationId);
        }

        if (AgentId.HasValue)
        {
            using var storeRepo = AgentRepoFactory.Create();
            _selectedAgent = await storeRepo.Get(AgentId.Value, OrganizationId);
        }
    }


    private async Task<IEnumerable<Stack>> SearchStacks(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<Stack>();

        using var repo = StackRepoFactory.Create();
        return await repo.List<Stack>(OrganizationId, q => q.Where(m => m.Name.Contains(value)));
    }

    private async Task<IEnumerable<Agent>> SearchAgents(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<Agent>();

        using var repo = AgentRepoFactory.Create();
        return await repo.List<Agent>(OrganizationId, q => q.Where(s => s.Name.Contains(value)));
    }

    private async Task SaveSupply()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            var supply = new AgentStackSupply
            {
                Id = Guid.NewGuid(),
                StackId = StackId ?? _selectedStack?.Id ?? Guid.Empty,
                AgentId = AgentId ?? _selectedAgent?.Id ?? Guid.Empty,
                OrganizationId = OrganizationId
            };

            if (supply.StackId == Guid.Empty || supply.AgentId == Guid.Empty)
            {
                Snackbar.Add("Please select both stack and Agent", Severity.Error);
                return;
            }

            using var repo = SupplyRepoFactory.Create();
            await repo.Create(supply);

            Snackbar.Add("Supply created successfully", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating supply: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        _selectedStack = null;
        _selectedAgent = null;
        await OnCancel.InvokeAsync();
    }

}
