@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Entities.Definition.AgentSupplies
@using SnapCd.Server.Core.Repositories.Organizations.Secured.AgentSupplies
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.AgentSupplies

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Stack Supplies" Style="text-transform: none">
        @if (!_showCreateStackSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateStackSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateStackSupply)
        {
            <CreateAgentStackSupply
                AgentId="@AgentId"
                OnSaved="async () => {
                    _showCreateStackSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateStackSupply = false"/>
        }
        <MudExpansionPanels>
            @foreach (var supply in _agentStackSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@supply.Stack.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteStackSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Namespace Supplies" Style="text-transform: none">
        @if (!_showCreateNamespaceSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateNamespaceSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateNamespaceSupply)
        {
            <CreateAgentNamespaceSupply
                AgentId="@AgentId"
                OnSaved="async () => {
                    _showCreateNamespaceSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateNamespaceSupply = false"/>
        }

        <MudExpansionPanels>
            @foreach (var supply in _agentNamespaceSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@supply.Namespace.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteNamespaceSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudTabPanel Text="Module Supplies" Style="text-transform: none">
        @if (!_showCreateModuleSupply)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="mt-2 mb-2"
                       OnClick="ShowCreateModuleSupply">
                Create New
            </MudButton>
        }
        @if (_showCreateModuleSupply)
        {
            <CreateAgentModuleSupply
                AgentId="@AgentId"
                OnSaved="async () => {
                    _showCreateModuleSupply = false;
                    await ReloadSupplies();
                }"
                OnCancel="() => _showCreateModuleSupply = false"/>
        }
        <MudExpansionPanels>
            @foreach (var supply in _agentModuleSupplies)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudText>@supply.Module.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Delete supply">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => DeleteModuleSupply(supply)"/>
                        </MudTooltip>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>
    <MudButton
        Variant="Variant.Filled"
        Color="Color.Secondary"
        Class="mt-2 mb-2"
        OnClick="Close">Close
    </MudButton>
</MudTabs>

@code {

    [Parameter] public Guid AgentId { get; set; }
    [Parameter] public required EventCallback OnClose { get; set; }
    [CascadingParameter] public Guid OrganizationId { get; set; }

    [Inject] private AgentStackSupplySecuredRepositoryFactory StackSupplyRepoFactory { get; set; } = null!;
    [Inject] private AgentModuleSupplySecuredRepositoryFactory ModuleSupplyRepoFactory { get; set; } = null!;
    [Inject] private AgentNamespaceSupplySecuredRepositoryFactory NamespaceSupplyRepoFactory { get; set; } = null!;


    private bool _showCreateStackSupply;
    private bool _showCreateNamespaceSupply;
    private bool _showCreateModuleSupply;

    private List<AgentStackSupply> _agentStackSupplies = new();
    private List<AgentModuleSupply> _agentModuleSupplies = new();
    private List<AgentNamespaceSupply> _agentNamespaceSupplies = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadSupplies();
    }


    private void ShowCreateStackSupply()
    {
        _showCreateStackSupply = true;
    }


    private void ShowCreateModuleSupply()
    {
        _showCreateModuleSupply = true;
    }


    private void ShowCreateNamespaceSupply()
    {
        _showCreateNamespaceSupply = true;
    }


    private async Task ReloadSupplies()
    {
        using var stackSupplyRepo = StackSupplyRepoFactory.Create();
        _agentStackSupplies = await stackSupplyRepo.ListByParentId(
            AgentId, OrganizationId,
            x => x
                .Include(y => y.Agent)
                .Include(y => y.Stack)
        );

        using var moduleSupplyRepo = ModuleSupplyRepoFactory.Create();
        _agentModuleSupplies = await moduleSupplyRepo.ListByParentId(AgentId, OrganizationId,
            x => x
                .Include(y => y.Agent)
                .Include(y => y.Module)
        );

        using var namespaceSupplyRepo = NamespaceSupplyRepoFactory.Create();
        _agentNamespaceSupplies = await namespaceSupplyRepo.ListByParentId(AgentId, OrganizationId,
            x => x
                .Include(y => y.Agent)
                .Include(y => y.Namespace)
        );
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task DeleteStackSupply(AgentStackSupply supply)
    {
        var parameters = new DialogParameters<DeleteAgentStackSupplyDialog>
        {
            { x => x.AgentStackSupplyId, supply.Id },
            { x => x.StackName, supply.Stack.Name },
            { x => x.AgentName, supply.Agent.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteAgentStackSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted AgentStackSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    private async Task DeleteNamespaceSupply(AgentNamespaceSupply supply)
    {
        var parameters = new DialogParameters<DeleteAgentNamespaceSupplyDialog>
        {
            { x => x.AgentNamespaceSupplyId, supply.Id },
            { x => x.NamespaceName, supply.Namespace.Name },
            { x => x.AgentName, supply.Agent.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteAgentNamespaceSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted AgentNamespaceSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    private async Task DeleteModuleSupply(AgentModuleSupply supply)
    {
        var parameters = new DialogParameters<DeleteAgentModuleSupplyDialog>
        {
            { x => x.AgentModuleSupplyId, supply.Id },
            { x => x.ModuleName, supply.Module.Name },
            { x => x.AgentName, supply.Agent.Name },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteAgentModuleSupplyDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var id);
            Snackbar.Add($"Successfully deleted AgentModuleSupply \"{id}\"", Severity.Success);
            await ReloadSupplies();
        }
    }

    public void Dispose()
    {
    }


}
