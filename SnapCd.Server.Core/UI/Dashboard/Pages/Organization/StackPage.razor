@page "/Stack/{stackName}"
@layout OrganizationMainLayout
@using Microsoft.AspNetCore.Authorization
@using SnapCd.Contracts
@using SnapCd.Contracts.Dto
@using SnapCd.Server.Core.Dtos
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Misc.Exceptions
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.Crud.Jobs
@using SnapCd.Server.Core.Services.DependencyGraph
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.UI.Dashboard.Components.DependencyGraph
@using Stack = SnapCd.Server.Core.Entities.Definition.Stack
@using SnapCd.Server.Core.UI.Dashboard.Components.Roles
@using SnapCd.Server.Core.UI.Dashboard.Components.Stack
@using SnapCd.Server.Core.UI.Dashboard.Components.Namespace
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Namespaces
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.ModuleJobs

@implements IDisposable

@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject PersistentComponentState ApplicationState
@inject SecuredJobServiceFactory SecuredJobServiceFactory
@inject ModuleJobSecuredRepositoryFactory ModuleJobSecuredRepositoryFactory
@inject IOrganizationContext OrganizationContext

@inject ApplyModuleGraphServiceFactory ApplyServiceFactory
@inject DestroyModuleGraphServiceFactory DestroyServiceFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@inject OrganizationServiceFactory OrganizationServiceFactory

@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@attribute [OrganizationScopedFeature]

<CascadingValue Value="OrganizationId">
    @if (_stack != null)
    {
        <div class="page-header">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h4" Class="page-header-title">@StackName</MudText>
                <FavoriteToggle TargetType="FavoriteTargetType.Stack" TargetId="_stack.Id"/>
            </div>
        </div>

        <TabBar Tabs="_tabs" ActiveKey="@_showing.ToString()" OnTabChanged="HandleTabChanged"/>

        @* Everything stack-scoped lives inside this keyed container. When the route
           switches to a different stack, @key changes, so Blazor tears down and
           recreates every child here — running each one's Dispose and OnInitialized
           automatically.

           IMPORTANT: any component you add that loads data for THIS stack (typically
           in OnInitialized) MUST go inside this container. Placed outside it, it would
           be reused across stack switches and show stale data. *@
        <div @key="_stack.Id">

        @if (_showing == ShowingType.Namespaces && _stack != null)
        {
            @if (_showCreate)
            {
                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <CreateNamespace
                        StackId="@_stack.Id"
                        PrincipalProvider="_literalPrincipalProvider"
                        OnCreated="HandleCreated"
                        OnCancel="HandleCreateCanceled"/>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               OnClick="ShowCreate">
                        Create
                    </MudButton>
                </MudPaper>
            }

            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <div class="namespace-header">
                    <MudTooltip Text="Select multiple">
                        <MudIconButton Icon="@SnapCdIcons.Checklist"
                                       Color="@(_showSelectionMode ? Color.Secondary : Color.Primary)"
                                       Size="Size.Small"
                                       OnClick="() => ToggleSelectionMode()"/>
                    </MudTooltip>

                    <MudTooltip Text="Search namespaces">
                        <MudIconButton Icon="@SnapCdIcons.Search"
                                       Color="@(_showNamespaceSearch ? Color.Secondary : Color.Primary)"
                                       Size="Size.Small"
                                       OnClick="@(() => _showNamespaceSearch = !_showNamespaceSearch)"/>
                    </MudTooltip>

                    @if (_searchTerms.Any())
                    {
                        <div class="search-chips-header">
                            @foreach (var term in _searchTerms)
                            {
                                <MudChip T="string"
                                         Text="@term"
                                         Size="Size.Small"
                                         Color="Color.Secondary"
                                         OnClose="@(() => RemoveSearchTerm(term))"/>
                            }
                        </div>
                    }

                    @if (_showNamespaceSearch)
                    {
                        <div class="search-input-container">
                            <MudTextField @bind-Value="_searchInput"
                                          Label="Search namespaces by name"
                                          HelperText="Press Enter to search (minimum 2 characters)"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@SnapCdIcons.Search"
                                          OnKeyDown="@HandleKeyDown"
                                          Immediate="true"
                                          Class="search-field-inline"/>
                        </div>
                    }
                </div>

                @if (_showSelectionMode)
                {
                    <div class="selection-controls">
                        <MudCheckBox T="bool"
                                     @bind-Value="_selectAllNamespaces"
                                     Label="Select all Namespaces"
                                     Color="Color.Secondary"
                                     Dense="true"/>

                        @if (_selectedNamespaces.Any())
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@SnapCdIcons.Delete"
                                       OnClick="DeleteSelectedNamespaces"
                                       Size="Size.Small">
                                Delete Selected (@_selectedNamespaces.Count)
                            </MudButton>
                        }
                    </div>
                }
            </MudPaper>

                @if (_truncatedStack != null)
                {
                    <ListNamespaces @ref="_listNamespacesComponent"
                                    StackName="@_truncatedStack.Name"
                                    StackId="@_truncatedStack.Id"
                                    SearchTerms="@_searchTerms"
                                    ShowCheckboxes="@_showSelectionMode"
                                    SelectAll="@_selectAllNamespaces"
                                    OnSelectionChanged="@HandleNamespaceSelectionChanged"/>
                }
        }

        @if (_showing == ShowingType.Configure && _stack != null)
        {
            <ConfigureStack Stack="_stack"
                            PrincipalProvider="_literalPrincipalProvider"
                            InitialSection="@_configureSection"
                            OnSectionChanged="HandleConfigureSectionChanged"
                            OnStackDeleted="HandleStackDeleted"
                            OnStackSaved="HandleStackSaved"/>
        }

        @if (_showing == ShowingType.DependencyGraph && _stack != null)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">

                @if (!_showApplyComponent && !_showDestroyComponent)
                {
                    <MudStack Row Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="ShowApplyComponent">
                            Apply All
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="ShowDestroyComponent">
                            Destroy All
                        </MudButton>
                    </MudStack>
                }

                @if (_showApplyComponent)
                {
                    <MudText Typo="Typo.h6" Class="mb-3">Apply All</MudText>

                    @if (_modulesToApply.Any())
                    {
                        <MudText Typo="Typo.body1" Class="mb-2">
                            These modules will be applied:
                        </MudText>
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var module in _modulesToApply)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled"
                                             Size="Size.Medium">@module.DisplayName</MudChip>
                                    @if (!_modulePermissions.GetValueOrDefault(module.ModuleId, false))
                                    {
                                        <MudTooltip Text="You do not have permission to apply this module">
                                            <MudIcon Icon="SnapCdIcons.Warning" Color="Color.Warning"
                                                     Size="Size.Small"/>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_alreadyAppliedModules.Any())
                    {
                        <MudText Typo="Typo.body1" Class="mb-2">
                            These modules are already applied:
                        </MudText>
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var module in _alreadyAppliedModules)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled"
                                             Size="Size.Medium">@module.DisplayName</MudChip>
                                    @if (!_modulePermissions.GetValueOrDefault(module.ModuleId, false))
                                    {
                                        <MudTooltip Text="You do not have permission to apply this module">
                                            <MudIcon Icon="SnapCdIcons.Warning" Color="Color.Warning"
                                                     Size="Size.Small"/>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <MudDivider Class="my-4"/>

                    <MudStack Row>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="ExecuteApply"
                                   Disabled="@_isApplying">
                            @if (_isApplying)
                            {
                                @:Applying...
                            }
                            else
                            {
                                @:Apply All (@_modulesToApply.Count modules)
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="CancelApply"
                                   Disabled="@_isApplying">
                            Cancel
                        </MudButton>
                    </MudStack>
                }

                @if (_showDestroyComponent)
                {
                    <MudText Typo="Typo.h6" Class="mb-3">Destroy All</MudText>

                    @if (_alreadyDestroyedModules.Any())
                    {
                        <MudText Typo="Typo.body1" Class="mb-2">
                            <strong>These modules are already destroyed:</strong>
                        </MudText>
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var module in _alreadyDestroyedModules)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled"
                                             Size="Size.Medium">@module.DisplayName</MudChip>
                                    @if (!_modulePermissions.GetValueOrDefault(module.ModuleId, false))
                                    {
                                        <MudTooltip Text="You do not have permission to destroy this module">
                                            <MudIcon Icon="SnapCdIcons.Warning" Color="Color.Warning"
                                                     Size="Size.Small"/>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_modulesToDestroy.Any())
                    {
                        <MudText Typo="Typo.body1" Class="mb-2">
                            These modules will be destroyed:
                        </MudText>
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var module in _modulesToDestroy)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled"
                                             Size="Size.Medium">@module.DisplayName</MudChip>
                                    @if (!_modulePermissions.GetValueOrDefault(module.ModuleId, false))
                                    {
                                        <MudTooltip Text="You do not have permission to destroy this module">
                                            <MudIcon Icon="SnapCdIcons.Warning" Color="Color.Warning"
                                                     Size="Size.Small"/>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <MudDivider Class="my-4"/>

                    <MudText Typo="Typo.body1" Class="mb-3">
                        Enter <strong>DESTROY</strong> in the box below to confirm:
                    </MudText>

                    <MudTextField T="string"
                                  Value="_destroyConfirmationText"
                                  ValueChanged="@((string value) =>
                                                {
                                                    _destroyConfirmationText = value;
                                                    _destroyValidationError = null;
                                                    StateHasChanged();
                                                })"
                                  Label="Confirmation"
                                  Placeholder="Type DESTROY to confirm"
                                  Variant="Variant.Outlined"
                                  Class="mb-3"
                                  Disabled="@_isDestroying"/>

                    @if (!string.IsNullOrEmpty(_destroyValidationError))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">
                            @_destroyValidationError
                        </MudAlert>
                    }

                    <MudStack Row>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="ExecuteDestroy"
                                   Disabled="@_isDestroying">
                            @if (_isDestroying)
                            {
                                @:Destroying...
                            }
                            else
                            {
                                @:Destroy All (@_modulesToDestroy.Count modules)
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="CancelDestroy"
                                   Disabled="@_isDestroying">
                            Cancel
                        </MudButton>
                    </MudStack>
                }
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h5" Class="mb-4">Dependency Graph</MudText>

                <StackDependencyGraph
                    StackId="_stack.Id"
                    StackName="_stack.Name"
                    Direction="@GetGraphDirection()"
                    DisableDirectionToggle="@(_showApplyComponent || _showDestroyComponent)"/>
            </MudPaper>
        }
        </div>
    }
</CascadingValue>

@code {
    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
    [Parameter] public required string StackName { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Direction { get; set; }
    [SupplyParameterFromQuery] public string? Section { get; set; }
    [Inject] private StackSecuredRepositoryFactory RepoFactory { get; set; } = null!;

    private Stack? _stack;
    private TruncatedStack? _truncatedStack;

    // Name of the stack currently loaded into _stack. Blazor reuses this component
    // when navigating between two /Stack/... routes, so OnInitializedAsync does not
    // re-run — we reload in OnParametersSetAsync whenever this changes.
    private string? _loadedStackName;

    private ShowingType _showing = ShowingType.None;
    private string? _configureSection;

    private readonly List<TabBar.TabBarItem> _tabs =
    [
        new() { Key = nameof(ShowingType.Namespaces), Label = "Namespaces" },
        new() { Key = nameof(ShowingType.DependencyGraph), Label = "Dependencies" },
        new() { Key = nameof(ShowingType.Configure), Label = "Configuration" }
    ];

    // private PersistingComponentStateSubscription _persistenceSubscription;
    private bool _showCreate;
    private Guid _principalId;
    private PrincipalDiscriminator _principalDiscriminator;
    private IPrincipalProvider _literalPrincipalProvider = null!;
    private ListNamespaces? _listNamespacesComponent;
    private bool _showNamespaceSearch;
    private string _searchInput = string.Empty;
    private List<string> _searchTerms = new();
    private bool _selectAllNamespaces;
    private HashSet<Guid> _selectedNamespaces = new();
    private bool _showSelectionMode;
    private bool _showDestroyGraph = false;

    // Inline action components state
    private bool _showApplyComponent = false;
    private bool _showDestroyComponent = false;
    private bool _isApplying = false;
    private bool _isDestroying = false;
    private string _destroyConfirmationText = "";
    private string? _destroyValidationError = null;
    private List<DependencyGraphNodeStateDto> _modulesToApply = new();
    private List<DependencyGraphNodeStateDto> _alreadyAppliedModules = new();
    private List<DependencyGraphNodeStateDto> _modulesToDestroy = new();
    private List<DependencyGraphNodeStateDto> _alreadyDestroyedModules = new();
    private Dictionary<Guid, bool> _modulePermissions = new();

    protected override async Task OnInitializedAsync()
    {
        _principalId = HttpContextPrincipalProvider.GetSubject(OrganizationId);
        _principalDiscriminator = HttpContextPrincipalProvider.GetPrincipalDiscriminator();
        _literalPrincipalProvider = new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]);

        await LoadStackAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Blazor reuses this component when navigating between two /Stack/... routes
        // (e.g. via a favourites link), so OnInitializedAsync does not re-run. If the
        // route now points at a different stack, reload it here. Skipped on the very
        // first render, where OnInitializedAsync has already loaded the stack.
        if (_loadedStackName != null && _loadedStackName != StackName)
        {
            await LoadStackAsync();
        }

        await base.OnParametersSetAsync();
    }

    // Loads (or reloads) everything tied to the route's stack. Called once from
    // OnInitializedAsync and again from OnParametersSetAsync whenever the route
    // switches to a different stack on the same reused component instance.
    private async Task LoadStackAsync()
    {
        // Parse search terms from URL query parameter
        if (!string.IsNullOrEmpty(Search))
        {
            _searchTerms = Search.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        }
        else
        {
            _searchTerms = new List<string>();
        }

        using var repo = RepoFactory.Create();
        try
        {
            _stack = await repo.GetByName(StackName, OrganizationId);
        }
        catch (EntityNotFoundException)
        {
            Snackbar.Add($"Stack \"{StackName}\" does not exist.", Severity.Error);
            NavigationManager.NavigateTo("/Stacks", true);
            return;
        }

        _truncatedStack = new TruncatedStack
        {
            Id = _stack.Id,
            Name = _stack.Name,
            Namespaces = new List<TruncatedNamespace>()
        };

        _loadedStackName = StackName;

        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(() =>
        // {
        //     ApplicationState.PersistAsJson(cacheKey, new CachedStackData
        //     {
        //         Stack = _stack!,
        //         TruncatedStack = _truncatedStack!,
        //         ShowingState = _showing
        //     });
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<CachedStackData>(cacheKey, out var cachedData))
        // {
        //     _stack = cachedData.Stack;
        //     _truncatedStack = cachedData.TruncatedStack;
        //     _showing = cachedData.ShowingState;
        // }

        // Set initial showing based on query parameter
        _showing = GetShowingTypeFromAction(Action) ?? ShowingType.Namespaces;
        _configureSection = Section;
    }

    private Color GetColor(ShowingType showTypeToMatch)
    {
        return _showing == showTypeToMatch ? Color.Secondary : Color.Primary;
    }

    private void SwitchShowing(ShowingType newShowing)
    {
        var targetShowing = newShowing != _showing ? newShowing : ShowingType.None;
        _showing = targetShowing;

        if (targetShowing != ShowingType.Configure)
            _configureSection = null;

        UpdateUrl();
    }

    private void HandleTabChanged(string key)
    {
        if (Enum.TryParse<ShowingType>(key, out var parsed))
        {
            _showing = parsed;
            if (parsed != ShowingType.Configure)
                _configureSection = null;
            UpdateUrl();
        }
    }

    private enum ShowingType
    {
        None,
        Namespaces,
        DependencyGraph,
        Configure
    }


    private void HandleConfigureSectionChanged(string? section)
    {
        _configureSection = section;
        UpdateUrl();
    }

    private void HandleStackDeleted()
    {
        NavigationManager.NavigateTo("/Stacks");
    }

    private async Task HandleStackSaved()
    {
        using var repo = RepoFactory.Create();
        _stack = await repo.GetByName(StackName, OrganizationId);
    }

    private async Task HandleCreated()
    {
        _showCreate = false;

        if (_listNamespacesComponent != null)
        {
            await _listNamespacesComponent.LoadNamespaces();
            _listNamespacesComponent.TriggerStateHasChanged();
        }
    }

    private void HandleCreateCanceled()
    {
        _showCreate = false;
    }

    private void ShowCreate()
    {
        _showCreate = true;
    }

    private async Task AddSearchTerm()
    {
        if (!string.IsNullOrWhiteSpace(_searchInput) &&
            _searchInput.Length >= 2 &&
            !_searchTerms.Contains(_searchInput))
        {
            _searchTerms.Add(_searchInput);
            _searchInput = string.Empty;
            _showNamespaceSearch = false; // Hide search box after adding term

            // Update URL with search terms
            UpdateUrl();

            if (_listNamespacesComponent != null)
                await _listNamespacesComponent.LoadNamespaces();
        }
    }

    private async Task RemoveSearchTerm(string term)
    {
        _searchTerms.Remove(term);

        // Update URL with search terms
        UpdateUrl();

        if (_listNamespacesComponent != null)
            await _listNamespacesComponent.LoadNamespaces();
    }

    private void UpdateUrl()
    {
        var queryParams = new List<string>();

        var actionQuery = GetActionFromShowingType(_showing);
        if (actionQuery != null)
            queryParams.Add($"action={actionQuery}");

        if (_showing == ShowingType.Configure && !string.IsNullOrEmpty(_configureSection))
            queryParams.Add($"section={Uri.EscapeDataString(_configureSection)}");

        if (_searchTerms.Any())
            queryParams.Add($"search={Uri.EscapeDataString(string.Join(",", _searchTerms))}");

        var queryString = queryParams.Any() ? "?" + string.Join("&", queryParams) : "";
        var newUrl = $"/Stack/{StackName}{queryString}";
        NavigationManager.NavigateTo(newUrl, false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddSearchTerm();
        }
    }


    private void ToggleSelectionMode()
    {
        _showSelectionMode = !_showSelectionMode;

        // Clear selections when exiting selection mode
        if (!_showSelectionMode)
        {
            _selectAllNamespaces = false;
            _selectedNamespaces.Clear();
        }
    }

    private void HandleNamespaceSelectionChanged(HashSet<Guid> selectedNamespaces)
    {
        _selectedNamespaces = selectedNamespaces;
        StateHasChanged();
    }

    private async Task DeleteSelectedNamespaces()
    {
        if (!_selectedNamespaces.Any() || _listNamespacesComponent == null)
            return;

        var selectedNamespaces = _listNamespacesComponent.GetSelectedNamespaces();

        var parameters = new DialogParameters<DeleteSelectedNamespacesDialog>
        {
            { x => x.Namespaces, selectedNamespaces },
            { x => x.StackName, StackName },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<DeleteSelectedNamespacesDialog>("Delete Selected Namespaces", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            // Clear selection
            _selectAllNamespaces = false;
            _selectedNamespaces.Clear();

            // Reload namespaces list
            if (_listNamespacesComponent != null)
                await _listNamespacesComponent.LoadNamespaces();

            Snackbar.Add($"Successfully deleted {selectedNamespaces.Count} namespace(s)", Severity.Success);
        }
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
    }

    private class CachedStackData
    {
        public Stack Stack { get; set; } = null!;
        public TruncatedStack TruncatedStack { get; set; } = null!;
        public ShowingType ShowingState { get; set; }
    }

    private ShowingType? GetShowingTypeFromAction(string? action)
    {
        return action?.ToLower() switch
        {
            "namespaces" => ShowingType.Namespaces,
            "dependencygraph" => ShowingType.DependencyGraph,
            "configure" => ShowingType.Configure,
            _ => null
        };
    }

    private string? GetActionFromShowingType(ShowingType showingType)
    {
        return showingType switch
        {
            ShowingType.Namespaces => "Namespaces",
            ShowingType.DependencyGraph => "DependencyGraph",
            ShowingType.Configure => "Configure",
            _ => null
        };
    }

    private string GetGraphDirection()
    {
        // When inline components are active, they control the graph direction
        if (_showDestroyComponent)
        {
            return "Destroy";
        }
        else if (_showApplyComponent)
        {
            return "Apply";
        }

        // When no inline components are active, use the toggle
        return _showDestroyGraph ? "Destroy" : "Apply";
    }

    private async Task ShowApplyComponent()
    {
        _showDestroyComponent = false;
        _showApplyComponent = true;
        _showDestroyGraph = false; // Force apply graph
        _destroyConfirmationText = "";
        _destroyValidationError = null;

        await LoadApplyModules();
        StateHasChanged();
    }

    private async Task ShowDestroyComponent()
    {
        _showApplyComponent = false;
        _showDestroyComponent = true;
        _showDestroyGraph = true; // Activate destroy graph switch
        _destroyConfirmationText = "";
        _destroyValidationError = null;

        await LoadDestroyModules();
        StateHasChanged();
    }

    private void CancelApply()
    {
        _showApplyComponent = false;
        _isApplying = false;
        StateHasChanged();
    }

    private void CancelDestroy()
    {
        _showDestroyComponent = false;
        _isDestroying = false;
        _destroyConfirmationText = "";
        _destroyValidationError = null;
        StateHasChanged();
    }

    private async Task LoadApplyModules()
    {
        try
        {
            using var applyService = ApplyServiceFactory.Create();
            var dependencyGraph = await applyService.BuildStackApplyGraphAsync(_stack!.Id, _stack.Name);

            _modulesToApply = dependencyGraph.NodeStates
                .Where(n => n.LatestActualState != ActualStateHeadline.Applied &&
                            (n.DesiredState == null || n.DesiredState != DesiredStateHeadline.Applied))
                .ToList();

            _alreadyAppliedModules = dependencyGraph.NodeStates
                .Where(n => n.LatestActualState == ActualStateHeadline.Applied)
                .ToList();

            await LoadModulePermissions(dependencyGraph.NodeStates);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load modules: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDestroyModules()
    {
        try
        {
            using var destroyService = DestroyServiceFactory.Create();
            var dependencyGraph = await destroyService.BuildStackDestroyGraphAsync(_stack!.Id, _stack.Name);

            _modulesToDestroy = dependencyGraph.NodeStates
                .Where(n => n.LatestActualState != ActualStateHeadline.Destroyed &&
                            (n.DesiredState == null || n.DesiredState != DesiredStateHeadline.Destroyed))
                .ToList();

            _alreadyDestroyedModules = dependencyGraph.NodeStates
                .Where(n => n.LatestActualState == ActualStateHeadline.Destroyed)
                .ToList();

            await LoadModulePermissions(dependencyGraph.NodeStates);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load modules: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadModulePermissions(List<DependencyGraphNodeStateDto> nodeStates)
    {
        var modulesToCheck = nodeStates
            .Select(n => new ModuleNamespaceIdTuple
            {
                ModuleId = n.ModuleId,
                NamespaceId = n.NamespaceId
            })
            .ToList();

        if (!modulesToCheck.Any()) return;

        using var jobSecuredRepository = ModuleJobSecuredRepositoryFactory.Create();
        var permissions = await jobSecuredRepository.ListHasRunJobPermission(modulesToCheck, OrganizationId);

        _modulePermissions = permissions.ToDictionary(p => p.ModuleId, p => p.HasPermission);
    }

    private async Task ExecuteApply()
    {
        if (_isApplying) return;

        _isApplying = true;
        StateHasChanged();

        try
        {
            var modulesToActuallyApply = _modulesToApply
                .Where(m => _modulePermissions.GetValueOrDefault(m.ModuleId, false))
                .ToList();

            if (!modulesToActuallyApply.Any())
            {
                Snackbar.Add("No modules to apply - insufficient permissions", Severity.Warning);
                _isApplying = false;
                StateHasChanged();
                return;
            }

            var modulesWithoutPermission = _modulesToApply
                .Where(m => !_modulePermissions.GetValueOrDefault(m.ModuleId, false))
                .ToList();

            if (modulesWithoutPermission.Any())
            {
                Snackbar.Add($"Skipping {modulesWithoutPermission.Count} module(s) due to insufficient permissions", Severity.Warning);
            }

            foreach (var nodeState in modulesToActuallyApply)
            {
                using var securedJobService = SecuredJobServiceFactory.Create();
                await securedJobService.Apply(nodeState.ModuleId, OrganizationId, Guid.NewGuid());
            }

            Snackbar.Add($"Apply initiated for {modulesToActuallyApply.Count} modules", Severity.Success);
            _showApplyComponent = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initiate application: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isApplying = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteDestroy()
    {
        if (_isDestroying) return;

        if (_destroyConfirmationText != "DESTROY")
        {
            _destroyValidationError = "You must type 'DESTROY' exactly to confirm destruction.";
            StateHasChanged();
            return;
        }

        _isDestroying = true;
        StateHasChanged();

        try
        {
            var modulesToActuallyDestroy = _modulesToDestroy
                .Where(m => _modulePermissions.GetValueOrDefault(m.ModuleId, false))
                .ToList();

            if (!modulesToActuallyDestroy.Any())
            {
                Snackbar.Add("No modules to destroy - insufficient permissions", Severity.Warning);
                _isDestroying = false;
                StateHasChanged();
                return;
            }

            var modulesWithoutPermission = _modulesToDestroy
                .Where(m => !_modulePermissions.GetValueOrDefault(m.ModuleId, false))
                .ToList();

            if (modulesWithoutPermission.Any())
            {
                Snackbar.Add($"Skipping {modulesWithoutPermission.Count} module(s) due to insufficient permissions", Severity.Warning);
            }

            foreach (var nodeState in modulesToActuallyDestroy)
            {
                using var securedJobService = SecuredJobServiceFactory.Create();
                await securedJobService.Destroy(nodeState.ModuleId, OrganizationId, Guid.NewGuid());
            }

            Snackbar.Add($"Destruction initiated for {modulesToActuallyDestroy.Count} modules", Severity.Success);
            _showDestroyComponent = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initiate destruction: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDestroying = false;
            StateHasChanged();
        }
    }

