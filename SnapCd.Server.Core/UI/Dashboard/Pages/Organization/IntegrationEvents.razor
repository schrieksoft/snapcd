@page "/IntegrationEvents"
@layout OrganizationMainLayout

@inject SnapCd.Server.Core.Services.Integrations.IntegrationEventService EventService
@inject SnapCd.Server.Core.Services.Integrations.IntegrationService IntegrationService
@inject SnapCd.Server.Core.Services.OrganizationContext.IOrganizationContext OrganizationContext
@inject ISnackbar Snackbar

@using Microsoft.AspNetCore.Authorization
@using SnapCd.Contracts
@using SnapCd.Contracts.Dto.Integrations
@using SnapCd.Server.Core.Filters

@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@attribute [OrganizationScopedFeature]
<PageTitle>Integration events</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Integration events</MudText>
<MudText Typo="Typo.body2" GutterBottom="true">Subscribe a trigger on a scope to an integration. The integration must also be <i>supplied</i> to that scope.</MudText>

@if (_integrations is null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4 mb-3" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">New subscription</MudText>
        <div class="d-flex flex-wrap gap-2">
            <MudSelect T="IntegrationEventScope" @bind-Value="_new.Scope" Dense="true" Label="Scope" Style="min-width:140px">
                @foreach (var s in Enum.GetValues<IntegrationEventScope>())
                {
                    <MudSelectItem Value="s">@s</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_new.ScopeId" Label="Scope id (omit for Organization)" Dense="true" Style="min-width:280px" />
            <MudSelect T="Guid" @bind-Value="_new.IntegrationId" Dense="true" Label="Integration" Style="min-width:200px">
                @foreach (var i in _integrations)
                {
                    <MudSelectItem Value="i.Id">@i.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="IntegrationTrigger" @bind-Value="_new.Trigger" Dense="true" Label="Trigger" Style="min-width:220px">
                @foreach (var t in Enum.GetValues<IntegrationTrigger>())
                {
                    <MudSelectItem Value="t">@t</MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudTextField @bind-Value="_new.Template" Label="Template (optional; {{token}} substitution)" Lines="2" Class="mt-2" />
        <MudTextField @bind-Value="_new.Filter" Label="Filter (optional)" Class="mt-2" />
        <MudSwitch T="bool" @bind-Value="_new.IsDisabled" Label="Disabled" Color="Color.Default" />
        <div class="mt-2">
            <MudButton Variant="Variant.Filled" Style="background-color: #000; color: #fff;" OnClick="Create">Create</MudButton>
        </div>
    </MudPaper>

    @if (_events is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudSimpleTable Dense="true">
            <thead>
                <tr><th>Scope</th><th>Scope id</th><th>Integration</th><th>Trigger</th><th>Disabled</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var e in _events)
                {
                    <tr>
                        <td>@e.Scope</td>
                        <td><code>@(e.ScopeId?.ToString() ?? "—")</code></td>
                        <td>@IntegrationName(e.IntegrationId)</td>
                        <td>@e.Trigger</td>
                        <td>@(e.IsDisabled ? "yes" : "no")</td>
                        <td style="text-align:right">
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Delete(e))">Delete</MudButton>
                        </td>
                    </tr>
                }
                @if (_events.Count == 0)
                {
                    <tr><td colspan="6"><MudText Typo="Typo.caption">No subscriptions yet.</MudText></td></tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;

    private List<IntegrationReadDto>? _integrations;
    private List<IntegrationEventDto>? _events;
    private readonly NewModel _new = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _integrations = await IntegrationService.List(OrganizationId);
            await LoadEvents();
        }
        catch (Exception e) { Snackbar.Add(e.Message, Severity.Error); }
    }

    private async Task LoadEvents() => _events = await EventService.List(OrganizationId);

    private string IntegrationName(Guid id) => _integrations?.FirstOrDefault(i => i.Id == id)?.Name ?? id.ToString();

    private async Task Create()
    {
        Guid? scopeId = null;
        if (_new.Scope != IntegrationEventScope.Organization)
        {
            if (!Guid.TryParse(_new.ScopeId, out var sid))
            {
                Snackbar.Add("Scope id (GUID) is required for non-Organization scope.", Severity.Warning);
                return;
            }
            scopeId = sid;
        }
        try
        {
            await EventService.Create(OrganizationId, new IntegrationEventCreateDto
            {
                Scope = _new.Scope,
                ScopeId = scopeId,
                IntegrationId = _new.IntegrationId,
                Trigger = _new.Trigger,
                Template = string.IsNullOrWhiteSpace(_new.Template) ? null : _new.Template,
                Filter = string.IsNullOrWhiteSpace(_new.Filter) ? null : _new.Filter,
                IsDisabled = _new.IsDisabled
            });
            _new.ScopeId = "";
            _new.Template = "";
            _new.Filter = "";
            Snackbar.Add("Subscription created.", Severity.Success);
            await LoadEvents();
        }
        catch (Exception e) { Snackbar.Add(e.Message, Severity.Error); }
    }

    private async Task Delete(IntegrationEventDto e)
    {
        try
        {
            await EventService.Delete(OrganizationId, e.Scope, e.Id);
            await LoadEvents();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private class NewModel
    {
        public IntegrationEventScope Scope { get; set; } = IntegrationEventScope.Module;
        public string ScopeId { get; set; } = "";
        public Guid IntegrationId { get; set; }
        public IntegrationTrigger Trigger { get; set; } = IntegrationTrigger.JobFailed;
        public string Template { get; set; } = "";
        public string Filter { get; set; } = "";
        public bool IsDisabled { get; set; }
    }
}
