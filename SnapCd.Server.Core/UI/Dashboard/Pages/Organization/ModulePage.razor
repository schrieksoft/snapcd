    private void SwitchShowing(ShowingType newShowing)
    {
        var targetShowing = newShowing != _showing ? newShowing : ShowingType.None;
        _showing = targetShowing;

        if (targetShowing != ShowingType.Configure)
            _configureSection = null;

        UpdateUrl();
    }

    private void HandleJobsStateChanged((Guid? JobId, string? Tab, string? Task) state)
    {
        var queryParams = new List<string> { "action=Jobs" };

        if (state.JobId.HasValue)
            queryParams.Add($"job={state.JobId.Value}");

        if (!string.IsNullOrEmpty(state.Tab))
            queryParams.Add($"tab={state.Tab}");

        if (!string.IsNullOrEmpty(state.Task))
            queryParams.Add($"task={Uri.EscapeDataString(state.Task)}");

        if (!string.IsNullOrEmpty(Search))
            queryParams.Add($"search={Uri.EscapeDataString(Search)}");

        var newUrl = $"/Stacks/{StackName}/{NamespaceName}/{ModuleName}?" + string.Join("&", queryParams);
        NavigationManager.NavigateTo(newUrl, forceLoad: false, replace: true);
    }

