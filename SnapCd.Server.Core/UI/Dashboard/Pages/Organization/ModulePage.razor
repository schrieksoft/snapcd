    // Disposes the timer and unsubscribes the notifications tied to the currently
    // loaded module. Called both when switching to a different module (before the
    // reload) and on component disposal, so subscriptions never leak or fire against
    // a stale module.
    private void TeardownModuleResources()
    {
        _runnerAvailabilityRefreshTimer?.Dispose();
        _runnerAvailabilityRefreshTimer = null;

        if (_loadedModuleKey != null && _module != null)
        {
            RunnerAvailabilityModifiedNotificationService.Unsubscribe(_module.RunnerId, HandleRunnerAvailabilityModified);
            ModuleSagaModifiedNotificationService.Unsubscribe(_module.Id, HandleModuleSagaModified);
        }
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
        TeardownModuleResources();
    }

