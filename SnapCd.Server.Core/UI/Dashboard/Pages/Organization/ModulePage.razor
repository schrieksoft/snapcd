    // Route identity of the module currently requested by the URL.
    private string ModuleKey => $"{StackName}/{NamespaceName}/{ModuleName}";

    protected override async Task OnParametersSetAsync()
    {
        // Blazor reuses this component when navigating between two /Module/... routes
        // (e.g. via a favourites link), so OnInitializedAsync does not re-run. If the
        // route now points at a different module, reload it here. Skipped on the very
        // first render, where OnInitializedAsync has already loaded the module.
        if (_loadedModuleKey != null && _loadedModuleKey != ModuleKey)
        {
            await LoadModuleAsync();
        }

        // Update showing state when URL parameters change
        var newShowing = GetShowingTypeFromAction(Action) ?? ShowingType.Jobs;
        if (_showing != newShowing)
        {
            _showing = newShowing;
            StateHasChanged();
        }

        await base.OnParametersSetAsync();
    }

