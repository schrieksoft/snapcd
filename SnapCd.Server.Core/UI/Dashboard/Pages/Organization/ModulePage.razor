    private async Task<bool> IsWaitingOnDependencies()
    {
        // Only check if there's a queued desired state
        if (!_moduleSaga.QueuedDesiredStateHeadline.HasValue)
            return false;

        var desiredState = _moduleSaga.QueuedDesiredStateHeadline.Value;

        // Check if we should wait for dependencies based on module settings
        var shouldCheckDependencies = desiredState switch
        {
            DesiredStateHeadline.Applied => ShouldCheckApplyDependencies(_module),
            DesiredStateHeadline.Destroyed => ShouldCheckDestroyDependencies(_module),
            _ => false
        };

        if (!shouldCheckDependencies)
            return false;

        // Check actual dependency states
        return desiredState switch
        {
            DesiredStateHeadline.Applied => await CheckApplyDependenciesBlocked(),
            DesiredStateHeadline.Destroyed => await CheckDestroyDependenciesBlocked(),
            _ => false
        };
    }

    private bool ShouldCheckApplyDependencies(Module module)
    {
        return module.WaitForApplyDependencies switch
        {
            WaitForApplyDependencies.Always => true,
            WaitForApplyDependencies.Never => false,
            WaitForApplyDependencies.OnFirstApply => IsFirstApplyAttempt(module),
            _ => false
        };
    }

    private bool ShouldCheckDestroyDependencies(Module module)
    {
        return module.WaitForDestroyDependencies switch
        {
            WaitForDestroyDependencies.Always => true,
            WaitForDestroyDependencies.Never => false,
            _ => false
        };
    }

    private bool IsFirstApplyAttempt(Module module)
    {
        return !module.ModuleJobs.Any(j => j.ActualStateHeadline == ActualStateHeadline.Applied);
    }

    private async Task<bool> CheckApplyDependenciesBlocked()
    {
        using var dependencyService = DependencyGraphServiceFactory.Create();
        // For Apply: this module (DefinedModule) depends on ReferencedModules
        var dependencies = await dependencyService.ListForDefinedModule(_module.Id);

        // Check if any ReferencedModule is not Applied (using the state from the view)
        return dependencies.Any(d => d.ReferencedLatestActualState != ActualStateHeadline.Applied);
    }

    private async Task<bool> CheckDestroyDependenciesBlocked()
    {
        using var destroyService = DependencyGraphServiceFactory.Create();
        // For Destroy: DefinedModules depend on this module (ReferencedModule)
        var dependencies = await destroyService.ListForReferencedModule(_module.Id);

        // Check if any DefinedModule is not Destroyed (using the state from the view)
        return dependencies.Any(d => d.DefinedLatestActualState != ActualStateHeadline.Destroyed);
    }

