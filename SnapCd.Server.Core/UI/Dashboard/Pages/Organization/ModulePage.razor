    {
        // Tear down anything bound to the previously-loaded module before we swap it out.
        TeardownModuleResources();

        var queryString = !string.IsNullOrEmpty(Search)
            ? $"?search={Uri.EscapeDataString(Search)}"
            : "";

        // Carried onto the parent links in the header so search context survives navigation.
        _parentQuery = queryString;

        async Task Reload()
        {
            using var moduleRepo = RepoFactory.Create();

            _module = await moduleRepo.Get(StackName, NamespaceName, ModuleName, OrganizationId);
            _stackId = _module.Namespace.StackId;

            // Load Runner to check if it's active
            if (_module.RunnerId != Guid.Empty)
            {
                using var runnerRepo = RunnerRepoFactory.Create();
                _runner = await runnerRepo.Get(_module.RunnerId, OrganizationId);
            }

            await ReloadRunnerAvailability(false);
            await ReloadModuleSaga(false);
        }

        try
        {
            await Reload();
        }
        catch (EntityNotFoundException)
        {
            Snackbar.Add($"Module \"{StackName}/{NamespaceName}/{ModuleName}\" does not exist.", Severity.Error);
            NavigationManager.NavigateTo("/Stacks", true);
            return;
        }

        _loadedModuleKey = ModuleKey;

        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(() =>
        // {
        //     ApplicationState.PersistAsJson(cacheKey, new CachedModuleData
        //     {
        //         Module = _module,
        //         ModuleSaga = _moduleSaga,
        //         ShowingState = _showing,
        //         StackId = _stackId,
        //         ActiveRunners = _activeRunners,
        //         Runner = _runner,
        //         RevisionSummary = _revisionSummary,
        //         ActualStateSummary = _actualStateSummary,
        //         JobSummary = _jobSummary,
        //         QueuedSummary = _queuedSummary,
        //         RunnerAvailabilitySummary = _runnerAvailabilitySummary
        //     });
        //     return Task.CompletedTask;
        // });
        //
        // if (ApplicationState.TryTakeFromJson<CachedModuleData>(cacheKey, out var cachedData))
        // {
        //     _module = cachedData.Module;
        //     _stackId = cachedData.StackId;
        //     _showing = cachedData.ShowingState;
        //     _moduleSaga = cachedData.ModuleSaga;
        //     _activeRunners = cachedData.ActiveRunners;
        //     _runner = cachedData.Runner;
        //     _revisionSummary = cachedData.RevisionSummary;
