    private async Task LoadApplyModules()
    {
        try
        {
            using var applyService = ApplyModuleGraphServiceFactory.Create();
            var dependencyGraph = await applyService.BuildModuleApplyGraphAsync(_module.Id, _module.Name);

            // Get the current module's node state
            _currentModuleNodeState = dependencyGraph.NodeStates.FirstOrDefault(n => n.ModuleId == _module.Id);

            // Check if this module can be applied (not already applied)
            _moduleCanBeApplied = _currentModuleNodeState?.LatestActualState != ActualStateHeadline.Applied &&
                                  (_currentModuleNodeState?.DesiredState == null || _currentModuleNodeState?.DesiredState != DesiredStateHeadline.Applied);

            // Get all prerequisite modules (this module depends on them)
            var allPrerequisiteModules = dependencyGraph.NodeStates
                .Where(n => n.ModuleId == _module.Id)
                .SelectMany(n => n.OutgoingEdges)
                .Select(e => dependencyGraph.NodeStates.FirstOrDefault(ns => ns.ModuleId == e.ModuleId))
                .Where(n => n != null)
                .Select(n => n!)
                .ToList();

            // Categorize prerequisites based on their state
            _prerequisiteModules = allPrerequisiteModules
                .Where(n => n.LatestActualState != ActualStateHeadline.Applied &&
                            (n.DesiredState == null || n.DesiredState != DesiredStateHeadline.Applied))
                .ToList();

            _alreadyAppliedPrerequisiteModules = allPrerequisiteModules
                .Where(n => n.LatestActualState == ActualStateHeadline.Applied)
                .ToList();

            await LoadModulePermissions(dependencyGraph.NodeStates);

            // Check permission for this module
            _hasApplyPermission = await CheckModulePermission(_module.Id, _module.NamespaceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load modules: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDestroyModules()
    {
        try
        {
            using var destroyService = DestroyModuleGraphServiceFactory.Create();
            var dependencyGraph = await destroyService.BuildModuleDestroyGraphAsync(_module.Id, _module.Name);

            // Get the current module's node state
            _currentModuleNodeState = dependencyGraph.NodeStates.FirstOrDefault(n => n.ModuleId == _module.Id);

            // Check if this module can be destroyed (not already destroyed)
            _moduleCanBeDestroyed = _currentModuleNodeState?.LatestActualState != ActualStateHeadline.Destroyed &&
                                    (_currentModuleNodeState?.DesiredState == null || _currentModuleNodeState?.DesiredState != DesiredStateHeadline.Destroyed);

            // Get all dependent modules (modules that depend on this one)
            var allDependentModules = dependencyGraph.NodeStates
                .Where(n => n.ModuleId == _module.Id)
                .SelectMany(n => n.OutgoingEdges)
                .Select(e => dependencyGraph.NodeStates.FirstOrDefault(ns => ns.ModuleId == e.ModuleId))
                .Where(n => n != null)
                .Select(n => n!)
                .ToList();

            // Categorize dependents based on their state
            _dependentModules = allDependentModules
                .Where(n => n.LatestActualState != ActualStateHeadline.Destroyed &&
                            (n.DesiredState == null || n.DesiredState != DesiredStateHeadline.Destroyed))
                .ToList();

            _alreadyDestroyedDependentModules = allDependentModules
                .Where(n => n.LatestActualState == ActualStateHeadline.Destroyed)
                .ToList();

            await LoadModulePermissions(dependencyGraph.NodeStates);

            // Check permission for this module
            _hasDestroyPermission = await CheckModulePermission(_module.Id, _module.NamespaceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load modules: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadModulePermissions(List<DependencyGraphNodeStateDto> nodeStates)
    {
        var modulesToCheck = nodeStates
            .Select(n => new ModuleNamespaceIdTuple
            {
                ModuleId = n.ModuleId,
                NamespaceId = n.NamespaceId
            })
            .ToList();

        if (!modulesToCheck.Any()) return;


        using var jobSecuredRepository = ModuleJobSecuredRepositoryFactory.Create();
        var permissions = await jobSecuredRepository.ListHasRunJobPermission(modulesToCheck, OrganizationId);

        _modulePermissions = permissions.ToDictionary(p => p.ModuleId, p => p.HasPermission);
    }

    private async Task<bool> CheckModulePermission(Guid moduleId, Guid namespaceId)
    {
        using var jobSecuredRepository = ModuleJobSecuredRepositoryFactory.Create();
        var permissions = await jobSecuredRepository.ListHasRunJobPermission(new List<ModuleNamespaceIdTuple> { new() { ModuleId = moduleId, NamespaceId = namespaceId } }, OrganizationId);

        return permissions.FirstOrDefault()?.HasPermission ?? false;
    }

    private async Task ExecuteApply()
    {
        if (_isApplying) return;

        _isApplying = true;
        StateHasChanged();

        try
        {
            var totalApplied = 0;
            var skipped = 0;

            // Apply this module only if it needs to be applied
            if (_moduleCanBeApplied && _hasApplyPermission)
            {
                using var securedJobService = SecuredJobServiceFactory.Create();
                await securedJobService.Apply(_module.Id, OrganizationId, Guid.NewGuid());
                totalApplied++;
            }
            else if (_moduleCanBeApplied && !_hasApplyPermission)
            {
                skipped++;
            }

            // Apply prerequisites if selected - only those that need to be applied
            if (_applyPrerequisiteModules)
            {
                var modulesToApply = _prerequisiteModules
                    .Where(m => _modulePermissions.GetValueOrDefault(m.ModuleId, false))
                    .ToList();

                foreach (var nodeState in modulesToApply)
                {
                    using var securedJobService = SecuredJobServiceFactory.Create();
                    await securedJobService.Apply(nodeState.ModuleId, OrganizationId, Guid.NewGuid());
                    totalApplied++;
                }

                skipped += _prerequisiteModules.Count - modulesToApply.Count;
            }

            if (totalApplied > 0)
            {
                Snackbar.Add($"Apply initiated successfully for {totalApplied} module(s)", Severity.Success);
            }

            if (skipped > 0)
            {
                Snackbar.Add($"Skipped {skipped} module(s) due to insufficient permissions", Severity.Warning);
            }

            if (totalApplied == 0 && skipped == 0)
            {
                Snackbar.Add("No modules needed to be applied", Severity.Info);
            }

            _showApplyComponent = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initiate apply: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isApplying = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteDestroy()
    {
        if (_isDestroying) return;

        if (_destroyConfirmationText != "DESTROY")
        {
            _destroyValidationError = "You must type 'DESTROY' exactly to confirm destruction.";
            StateHasChanged();
            return;
        }

        _isDestroying = true;
        StateHasChanged();

        try
        {
            var totalDestroyed = 0;
            var skipped = 0;

            // Destroy dependent modules first if selected - only those that need to be destroyed
            if (_destroyDependentModules)
            {
                var modulesToDestroy = _dependentModules
                    .Where(m => _modulePermissions.GetValueOrDefault(m.ModuleId, false))
                    .ToList();

                foreach (var nodeState in modulesToDestroy)
                {
                    using var securedJobService = SecuredJobServiceFactory.Create();
                    await securedJobService.Destroy(nodeState.ModuleId, OrganizationId, Guid.NewGuid());
                    totalDestroyed++;
                }

                skipped += _dependentModules.Count - modulesToDestroy.Count;
            }

            // Destroy this module only if it needs to be destroyed
            if (_moduleCanBeDestroyed && _hasDestroyPermission)
            {
                using var securedJobService = SecuredJobServiceFactory.Create();
                await securedJobService.Destroy(_module.Id, OrganizationId, Guid.NewGuid());
                totalDestroyed++;
            }
            else if (_moduleCanBeDestroyed && !_hasDestroyPermission)
            {
                skipped++;
            }

            if (totalDestroyed > 0)
            {
                Snackbar.Add($"Destruction initiated successfully for {totalDestroyed} module(s)", Severity.Success);
            }

            if (skipped > 0)
            {
                Snackbar.Add($"Skipped {skipped} module(s) due to insufficient permissions", Severity.Warning);
            }

            if (totalDestroyed == 0 && skipped == 0)
            {
                Snackbar.Add("No modules needed to be destroyed", Severity.Info);
            }

            _showDestroyComponent = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initiate destruction: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDestroying = false;
            StateHasChanged();
        }
    }

    private string GetGraphDirection()
    {
        // When inline components are active, they control the graph direction
        if (_showDestroyComponent)
        {
            return "Destroy";
        }
        else if (_showApplyComponent)
        {
            return "Apply";
        }

        // Default to the query parameter or Apply
        return Direction ?? "Apply";
    }

    private HashSet<Guid>? GetUninvolvedModuleIds()
    {
        // Only filter modules when inline components are active
        if (!_showApplyComponent && !_showDestroyComponent)
        {
            return null;
        }

        var uninvolvedModuleIds = new HashSet<Guid>();

        if (_showDestroyComponent)
        {
            // If not destroying dependent modules, mark them as uninvolved
            if (!_destroyDependentModules && _dependentModules.Any())
            {
                foreach (var module in _dependentModules)
                {
                    uninvolvedModuleIds.Add(module.ModuleId);
                }
            }
        }
        else if (_showApplyComponent)
        {
            // If not applying prerequisite modules, mark them as uninvolved
            if (!_applyPrerequisiteModules && _prerequisiteModules.Any())
            {
                foreach (var module in _prerequisiteModules)
                {
                    uninvolvedModuleIds.Add(module.ModuleId);
                }
            }
        }

        return uninvolvedModuleIds.Any() ? uninvolvedModuleIds : null;
    }

    private string GetCurrentModuleDisplayName()
    {
        // Try to use the display name from the node state first
        if (_currentModuleNodeState?.DisplayName != null)
        {
            return _currentModuleNodeState.DisplayName;
        }

        // Fallback to constructing it manually, with null checks
        try
        {
            if (_module?.Namespace?.Stack?.Name != null &&
                _module?.Namespace?.Name != null &&
                _module?.Name != null)
            {
                return $"{_module.Namespace.Stack.Name}/{_module.Namespace.Name}/{_module.Name}";
            }
        }
        catch
        {
            // If anything fails, fall back to a safe default
        }

        // Final fallback
        return _module?.Name ?? "Unknown Module";
    }

    private bool CanExecuteApply()
    {
        // Can execute if the main module can be applied OR there are prerequisite modules to apply
        return _moduleCanBeApplied || (_applyPrerequisiteModules && _prerequisiteModules.Any());
    }

    private bool CanExecuteDestroy()
    {
        // Can execute if the main module can be destroyed OR there are dependent modules to destroy
        return _moduleCanBeDestroyed || (_destroyDependentModules && _dependentModules.Any());
    }

    private int GetApplyModuleCount()
    {
        var count = 0;
        if (_moduleCanBeApplied) count++;
        if (_applyPrerequisiteModules) count += _prerequisiteModules.Count;
        return count;
    }

    private int GetDestroyModuleCount()
    {
        var count = 0;
        if (_moduleCanBeDestroyed) count++;
        if (_destroyDependentModules) count += _dependentModules.Count;
        return count;
    }


