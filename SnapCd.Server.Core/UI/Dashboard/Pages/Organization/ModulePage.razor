    private void UpdateUrl()
    {
        var queryParams = new List<string>();

        var actionQuery = GetActionFromShowingType(_showing);
        if (actionQuery != null)
            queryParams.Add($"action={actionQuery}");

        if (_showing == ShowingType.Configure && !string.IsNullOrEmpty(_configureSection))
            queryParams.Add($"section={Uri.EscapeDataString(_configureSection)}");

        if (!string.IsNullOrEmpty(Search))
            queryParams.Add($"search={Uri.EscapeDataString(Search)}");

        var queryString = queryParams.Any() ? "?" + string.Join("&", queryParams) : "";
        var newUrl = $"/Stacks/{StackName}/{NamespaceName}/{ModuleName}{queryString}";
        NavigationManager.NavigateTo(newUrl, false);
    }

