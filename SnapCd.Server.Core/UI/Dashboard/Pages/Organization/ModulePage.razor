@page "/Module/{stackName}/{namespaceName}/{moduleName}"
@layout OrganizationMainLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.IdentityModel.Tokens
@using SnapCd.Server.Core.UI.Dashboard.Components.Module
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Queue
@using SnapCd.Server.Core.UI.Dashboard.Components.DependencyGraph
@using SnapCd.Contracts.Dto
@using System.Threading
@using SnapCd.Contracts
@using SnapCd.Server.Core.Dtos
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Entities.Sagas
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Misc.Exceptions
@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Nonsecured
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.Crud.Jobs
@using SnapCd.Server.Core.Services.DependencyGraph
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider

@implements IDisposable

@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject PersistentComponentState ApplicationState
@inject ModuleSagaModifiedNotificationService ModuleSagaModifiedNotificationService
@inject RunnerAvailabilityModifiedNotificationService RunnerAvailabilityModifiedNotificationService
@inject DependencyGraphServiceFactory DependencyGraphServiceFactory
@inject RunnerConnectionRepositoryFactory RunnerConnectionRepositoryFactory
@inject IOrganizationContext OrganizationContext
@inject ApplyModuleGraphServiceFactory ApplyModuleGraphServiceFactory
@inject DestroyModuleGraphServiceFactory DestroyModuleGraphServiceFactory
@inject SecuredJobServiceFactory SecuredJobServiceFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@inject OrganizationServiceFactory OrganizationServiceFactory
@inject ModuleJobSecuredRepositoryFactory ModuleJobSecuredRepositoryFactory



@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@attribute [OrganizationScopedFeature]

<PageTitle>Module: @ModuleName</PageTitle>

<CascadingValue Value="OrganizationId">
    @if (_module != null)
    {
        <div class="module-page-header">
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.h4" Class="module-page-title">@ModuleName</MudText>
                @if (_actualStateSummary != null)
                {
                    <span class="module-status-badge module-status-badge--@GetStatusBadgeClass(_actualStateSummary.State)">
                        <span class="module-status-dot"></span>
                        @FormatActualState(_actualStateSummary.State)
                    </span>
                }
                @if (_moduleSaga is { Paused: true })
                {
                    <span class="module-status-badge module-status-badge--default">
                        <span class="module-status-dot"></span>
                        @(IsDraining ? "Pausing" : "Paused")
                    </span>
                }
                <FavoriteToggle TargetType="FavoriteTargetType.Module" TargetId="_module.Id"/>
            </div>
            <MudText Typo="Typo.body2" Class="module-page-subtitle">
                <span class="module-page-parents">
                    Stack: <MudLink Href="@($"/Stack/{StackName}{_parentQuery}")">@StackName</MudLink>
                    ·
                    Namespace: <MudLink Href="@($"/Namespace/{StackName}/{NamespaceName}{_parentQuery}")">@NamespaceName</MudLink>
                </span>
                @if (_moduleSaga?.ActualResourceCount.HasValue == true
                     || _revisionSummary != null
                     || _runnerAvailabilitySummary != null)
                {
                    @: ·
                }
                @if (_moduleSaga?.ActualResourceCount.HasValue == true)
                {
                    @:@_moduleSaga.ActualResourceCount.Value @(_moduleSaga.ActualResourceCount.Value == 1 ? "resource" : "resources")
                    @: ·
                }
                @if (_revisionSummary != null)
                {
                    @:@FormatRevisionState(_revisionSummary.State)
                    @if (!string.IsNullOrEmpty(_revisionSummary.Subtext))
                    {
                        @: <span class="module-page-mono">@ShortenRevision(_revisionSummary.Subtext)</span>
                    }
                }
                @if (_runnerAvailabilitySummary != null)
                {
                    @: · @_runnerAvailabilitySummary.Text
                }
            </MudText>
        </div>

        @if (_runnerAvailabilitySummary is { ActiveCount: 0 })
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
                No active runners are connected. Jobs for this module will remain queued until a runner instance
                checks in.
            </MudAlert>
        }

        @if (_runner != null && _runner.IsDisabled)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                <MudIcon Icon="@SnapCdIcons.Warning" Class="mr-2"/>
                The Runner "@_runner.Name" assigned to this module is currently inactive and will not process new
                jobs.
            </MudAlert>
        }

        @if (_moduleSaga is { Paused: true })
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                @if (IsDraining)
                {
                    @:This module is pausing. The job already in flight runs to completion; no further work is dispatched.
                }
                else
                {
                    @:This module is paused. Triggered and dependency-driven work is queued rather than dispatched,
                    @:and apply and destroy are unavailable until it is resumed.
                }
                @if (!string.IsNullOrEmpty(_moduleSaga.PauseReason))
                {
                    @: — @_moduleSaga.PauseReason
                }
            </MudAlert>
        }

        <TabBar Tabs="_tabs" ActiveKey="@_showing.ToString()" OnTabChanged="HandleTabChanged"/>

        @* Everything module-scoped lives inside this keyed container. When the route
           switches to a different module, @key changes, so Blazor tears down and
           recreates every child here — running each one's Dispose (clean teardown of
           timers/subscriptions) and OnInitialized (fresh load) automatically.

           IMPORTANT: any component you add that loads data for THIS module (typically
           in OnInitialized) MUST go inside this container. Placed outside it, it would
           be reused across module switches and show stale data. *@
        <div @key="_module.Id">
            @if (_showing == ShowingType.Jobs)
            {
                <ManageModuleJobs Module="_module"
                                  InitialJobId="@(Guid.TryParse(Job, out var __jid) ? __jid : (Guid?)null)"
                                  InitialTab="@Tab"
                                  InitialTask="@Task"
                                  OnJobsStateChanged="HandleJobsStateChanged"
                                  IsQueued="@(_queuedSummary is { State: true })"
                                  QueuedText="@(_queuedSummary?.Text)"
                                  QueuedReasonText="@GetQueuedReasonDisplayText()"
                                  ShowRunNow="@(_queuedSummary is { State: true } && _moduleSaga.QueuedReason != QueuedReason.WaitingOnRunnerCheckin && _runnerAvailabilitySummary is not { ActiveCount: 0 })"
                                  IsPaused="@(_moduleSaga is { Paused: true })"
                                  OnRunQueueNow="RunQueueNow"
                                  OnClearQueue="ClearQueue"/>
            }

            @if (_showing == ShowingType.Configure)
            {
                <ConfigureModule Module="_module"
                                 StackId="_stackId"
                                 StackName="@StackName"
                                 NamespaceName="@NamespaceName"
                                 PrincipalProvider="_literalPrincipalProvider"
                                 InitialSection="@_configureSection"
                                 OnSectionChanged="HandleConfigureSectionChanged"
                                 OnModuleDeleted="HandleModuleDeleted"
                                 OnModuleSaved="HandleModuleSaved"/>
            }

            @if (_showing == ShowingType.Outputs)
            {
                <ViewOutputs Module="_module" StackName="@StackName"/>
            }

            @if (_showing == ShowingType.Variables)
            {
                <ViewVariables Module="_module" StackName="@StackName"/>
            }

            @if (_showing == ShowingType.ManualJobs)
            {
                <ManageManualJobs Module="_module"
                                  ModuleSaga="_moduleSaga"
                                  PrincipalProvider="_literalPrincipalProvider"/>
            }
        </div>

    }
</CascadingValue>

<style>
    .module-page-header {
        margin-bottom: 16px;
    }

    .module-page-title {
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .module-page-subtitle {
        color: var(--mud-palette-text-secondary);
        margin-top: 2px;
    }

    .module-page-mono {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.85em;
    }

    /* Parent links (Stack / Namespace) in the subtitle line, replacing the old
       breadcrumb trail. */
    .module-page-parents .mud-link {
        color: var(--mud-palette-text-secondary);
    }

    .module-page-parents .mud-link:hover {
        color: var(--snap-accent);
    }

    .module-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 10px;
        font-size: 14px;
        font-weight: 500;
        margin-top: 4px;
    }

    .module-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .module-status-badge--success {
        background: #DFF7EC;
        color: #00B368;
    }

    .module-status-badge--error {
        background: #FDEAEA;
        color: #D32F2F;
    }

    .module-status-badge--default {
        background: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-secondary);
    }

    .mud-dark .module-status-badge--success {
        background: #0a2618;
        color: #34D399;
    }

    .mud-dark .module-status-badge--error {
        background: #2a0a0a;
        color: #EF5350;
    }

    .mud-dark .module-status-badge--default {
        background: rgba(255, 255, 255, 0.08);
        color: var(--mud-palette-text-secondary);
    }
</style>

@code {
    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
    [Parameter] public required string StackName { get; set; }
    [Parameter] public required string NamespaceName { get; set; }
    [Parameter] public required string ModuleName { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Direction { get; set; }
    [SupplyParameterFromQuery] public string? Tab { get; set; }
    [SupplyParameterFromQuery] public string? Job { get; set; }
    [SupplyParameterFromQuery] public string? Task { get; set; }
    [SupplyParameterFromQuery] public string? Section { get; set; }
    [Inject] private ModuleSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ModuleSagaSecuredRepositoryFactory SagaRepoFactory { get; set; } = null!;
    [Inject] private ModuleJobSecuredRepositoryFactory JobRepoFactory { get; set; } = null!;
    [Inject] private RunnerSecuredRepositoryFactory RunnerRepoFactory { get; set; } = null!;

    private Module _module = null!;
    private ModuleSaga _moduleSaga = null!;
    private List<RunnerConnection> _activeRunners = new();
    private Runner? _runner;
    private string? _actualDefinitiveRevision;
    private string? _actualDefinitiveClosureHash;
    private ActualStateHeadline? _actualStateHeadline;
    private string _parentQuery = "";

    private ShowingType _showing = ShowingType.None;
    private string? _configureSection;

    private readonly List<TabBar.TabBarItem> _tabs =
    [
        new() { Key = nameof(ShowingType.Jobs), Label = "Jobs" },
        new() { Key = nameof(ShowingType.Variables), Label = "Variables" },
        new() { Key = nameof(ShowingType.Outputs), Label = "Outputs" },
        new() { Key = nameof(ShowingType.Configure), Label = "Configuration" },
        new() { Key = nameof(ShowingType.ManualJobs), Label = "Manual Jobs" }
    ];

    // private PersistingComponentStateSubscription _persistenceSubscription;
    private Guid _stackId;

    private Guid _principalId;
    private PrincipalDiscriminator _principalDiscriminator;
    private IPrincipalProvider _literalPrincipalProvider = null!;


    private RunnerAvailabilitySummary? _runnerAvailabilitySummary;
    private RevisionSummary? _revisionSummary;
    private QueuedSummary? _queuedSummary;
    private JobSummary? _jobSummary;
    private ActualStateSummary? _actualStateSummary;

    /// A paused module is still draining while its in-flight job runs; the gate stops new work only.
    private bool IsDraining => _moduleSaga is { Paused: true } && GetJobState() == JobState.Running;
    private Timer? _runnerAvailabilityRefreshTimer;
    private bool? _isWaitingOnDependencies = null;

    // Identity of the module currently loaded into _module. Blazor reuses this
    // component instance when navigating from one /Module/... route to another,
    // so OnInitializedAsync does NOT re-run — we reload in OnParametersSetAsync
    // whenever this key changes.
    private string? _loadedModuleKey;

    // Inline action components state for Dependencies
    private bool _showApplyComponent = false;
    private bool _showDestroyComponent = false;
    private bool _isApplying = false;
    private bool _isDestroying = false;
    private string _destroyConfirmationText = "";
    private string? _destroyValidationError = null;
    private bool _applyPrerequisiteModules = false;
    private bool _destroyDependentModules = false;
    private List<DependencyGraphNodeStateDto> _prerequisiteModules = new();
    private List<DependencyGraphNodeStateDto> _alreadyAppliedPrerequisiteModules = new();
    private List<DependencyGraphNodeStateDto> _dependentModules = new();
    private List<DependencyGraphNodeStateDto> _alreadyDestroyedDependentModules = new();
    private Dictionary<Guid, bool> _modulePermissions = new();
    private bool _hasApplyPermission = false;
    private bool _hasDestroyPermission = false;
    private DependencyGraphNodeStateDto? _currentModuleNodeState = null;
    private bool _moduleCanBeApplied = false;
    private bool _moduleCanBeDestroyed = false;

    private async Task RunQueueNow()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };

        var parameters = new DialogParameters<RunQueueNowDialog>
        {
            { x => x.ModuleId, _module.Id },
            { x => x.NamespaceId, _module.NamespaceId },
            { x => x.PrincipalProvider, new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]) },
            { x => x.OrganizationId, OrganizationId }
        };

        var dialog = await DialogService.ShowAsync<RunQueueNowDialog>("Run Queued Job Now", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add($"Successfully ran queued job");
        }
    }

    private async Task ClearQueue()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<ClearQueueDialog>
        {
            { x => x.ModuleId, _module.Id },
            { x => x.NamespaceId, _module.NamespaceId },
            { x => x.PrincipalProvider, new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId]) },
            { x => x.OrganizationId, OrganizationId }
        };

        var dialog = await DialogService.ShowAsync<ClearQueueDialog>("Clear Queued Job Now", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add($"Successfully cleared queued job");
        }
    }

    public class Icon
    {
        public required string Name { get; set; }
        public required Color Color { get; set; }
        public required string Tooltip { get; set; }
    }

    public class RunnerAvailabilitySummary
    {
        public string Text { get; set; } = "Unknown";
        public int ActiveCount { get; set; }
        public bool State { get; set; }

        public Icon Icon { get; set; } = new()
        {
            Color = Color.Default,
            Name = SnapCdIcons.StopCircle,
            Tooltip = "Unknown"
        };
    }

    public class RevisionSummary
    {
        public string Subtext { get; set; } = "";
        public RevisionState State { get; set; } = RevisionState.Unknown;

        public Icon Icon { get; set; } = new()
        {
            Color = Color.Default,
            Name = SnapCdIcons.StopCircle,
            Tooltip = "Unknown"
        };
    }

    public class QueuedSummary
    {
        public string Text { get; set; } = "";
        public bool State { get; set; }

        public Icon Icon { get; set; } = new()
        {
            Color = Color.Default,
            Name = SnapCdIcons.StopCircle,
            Tooltip = "Unknown"
        };
    }

    public class JobSummary
    {
        public string Text { get; set; } = "";
        public JobState State { get; set; } = JobState.Unknown;

        public Icon Icon { get; set; } = new()
        {
            Color = Color.Default,
            Name = SnapCdIcons.StopCircle,
            Tooltip = "Unknown"
        };
    }

    public class ActualStateSummary
    {
        public ActualStateHeadline State { get; set; } = ActualStateHeadline.None;

        public Icon Icon { get; set; } = new()
        {
            Color = Color.Default,
            Name = SnapCdIcons.StopCircle,
            Tooltip = "Unknown"
        };
    }


    private async Task ReloadModuleSaga(bool invokeAsync)
    {
        using var moduleSagaRepo = SagaRepoFactory.Create(
            // when notification callback there is no HttpContext, so we have to persist the principal beforehand in _principalId and _principalDiscriminator, the create the secured repo with a permission service that uses a LiteralPrincipalProvider
            new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId])
        );
        _moduleSaga = await moduleSagaRepo.Get(_module.Id, OrganizationId);

        // Load revision and state data from ModuleJob
        using var jobRepo = JobRepoFactory.Create(
            new LiteralPrincipalProvider(_principalId, _principalDiscriminator, [OrganizationId])
        );
        (_actualDefinitiveRevision, _actualDefinitiveClosureHash) = await jobRepo.GetActualDefinitiveState(_module.Id, OrganizationId);
        _actualStateHeadline = await jobRepo.GetCurrentActualStateHeadline(_module.Id, OrganizationId);

        var revisionState = GetRevisionState();
        _revisionSummary = new RevisionSummary
        {
            Subtext = GetRevisionSubtext(revisionState),
            State = revisionState,
            Icon = GetRevisionIcon(revisionState)
        };

        var queuedState = GetQueuedState();
        _queuedSummary = new QueuedSummary
        {
            Text = GetQueuedStateText(queuedState),
            State = queuedState,
            Icon = GetQueuedStateIcon(queuedState)
        };

        var jobState = GetJobState();
        _jobSummary = new JobSummary
        {
            Text = GetJobStateText(jobState),
            State = jobState,
            Icon = GetJobStateIcon(jobState)
        };

        var actualState = GetActualStateHeadline();
        _actualStateSummary = new ActualStateSummary
        {
            State = actualState,
            Icon = GetActualStateHeadlineIcon(actualState)
        };

        // Check if waiting on dependencies
        _isWaitingOnDependencies = await IsWaitingOnDependencies();

        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }


    private async Task ReloadRunnerAvailability(bool invokeAsync)
    {
        // Query database for active runner connections
        _activeRunners.Clear();

        if (_runner != null)
        {
            using var connectionRepository = RunnerConnectionRepositoryFactory.Create();
            _activeRunners = await connectionRepository.GetActiveConnectionsByRunnerId(_runner.Id, OrganizationId);
        }

        var count = _activeRunners.Count;
        var state = count > 0;
        _runnerAvailabilitySummary = new RunnerAvailabilitySummary
        {
            Text = GetRunnerAvailabilityStateText(count),
            ActiveCount = count,
            State = state,
            Icon = GetRunnerAvailabilityStateIcon(state)
        };

        if (invokeAsync)
            // needed when call comes in via callback, since in that case the thread is not associated with the Dispatcher.
            await InvokeAsync(StateHasChanged);
        else
            StateHasChanged();
    }

    #region runner availability

    private string GetRunnerAvailabilityStateText(int count)
    {
        var pluralModifier = count == 1 ? "" : "s";

        return $"{count} Active Runner{pluralModifier}";
    }

    private Icon GetRunnerAvailabilityStateIcon(bool state)
    {
        switch (state)
        {
            case false:
                return new Icon
                {
                    Color = Color.Default,
                    Name = SnapCdIcons.StopCircle,
                    Tooltip = "No currently connected runners"
                };

            case true:
                return new Icon
                {
                    Color = Color.Success,
                    Name = SnapCdIcons.CheckCircle,
                    Tooltip = "Runners currently connected"
                };
        }
    }

    # endregion

    #region job

    private string GetJobStateText(JobState jobState)
    {
        if (jobState == JobState.Unknown)
            return nameof(JobState.Unknown);
        if (jobState == JobState.Running)
            return $"{nameof(JobState.Running)} ({FormatHeadline(_moduleSaga.DesiredStateHeadline)})";
        if (jobState == JobState.Idle)
            return $"{nameof(JobState.Idle)} ({FormatHeadline(_moduleSaga.DesiredStateHeadline)})";

        return _moduleSaga.CurrentState;
    }

    private JobState GetJobState()
    {
        switch (_moduleSaga.CurrentState)
        {
            case "Running":
                return JobState.Running;
            case "PrimedForNextQueued":
                return JobState.Running;
            case "Idle":
                return JobState.Idle;
            default:
                return JobState.Unknown;
        }
    }

    private Icon GetJobStateIcon(JobState jobstate)
    {
        switch (jobstate)
        {
            case JobState.Idle:
                return new Icon
                {
                    Color = Color.Default,
                    Name = SnapCdIcons.StopCircle,
                    Tooltip = "There are currently no running jobs."
                };

            case JobState.Running:
                return new Icon
                {
                    Color = Color.Warning,
                    Name = SnapCdIcons.RunCircle,
                    Tooltip = "A job is currently running"
                };

            default:
                return new Icon
                {
                    Color = Color.Default,
                    Name = SnapCdIcons.StopCircle,
                    Tooltip = "Unknown"
                };
        }
    }

    # endregion

    # region queued

    private string GetQueuedStateText(bool queuedState)
    {
        if (queuedState)
            return $"{FormatHeadline(_moduleSaga.QueuedDesiredStateHeadline)}";

        return "None";
    }


    private bool GetQueuedState()
    {
        if (!_moduleSaga.QueuedDesiredStateHeadline.HasValue)
            return false;

        return true;
    }

    private Icon GetQueuedStateIcon(bool queuedState)
    {
        switch (queuedState)
        {
            case true:
                return new Icon
                {
                    Color = Color.Warning,
                    Name = SnapCdIcons.AccessTimeFilled,
                    Tooltip = "A job is currently queued"
                };

            case false:
                return new Icon
                {
                    Color = Color.Default,
                    Name = SnapCdIcons.StopCircle,
                    Tooltip = "No jobs currently queued"
                };
        }
    }


    private string FormatHeadline(DesiredStateHeadline? headline)
    {
        switch (headline)
        {
            case DesiredStateHeadline.Applied:
                return "Apply";
            case DesiredStateHeadline.Destroyed:
                return "Destroy";
            default:
                return "Unknown";
        }
    }

    private string? GetQueuedReasonDisplayText()
    {
        if (_moduleSaga?.QueuedReason == null)
            return null;

        var text = GetQueuedReasonText(_moduleSaga.QueuedReason.Value);

        // No connected runner instance is the more restrictive condition — surface it alongside
        // whatever the job is queued on, unless that is already the runner itself.
        if (_moduleSaga.QueuedReason != QueuedReason.WaitingOnRunnerCheckin
            && _runnerAvailabilitySummary is { ActiveCount: 0 })
            text += " · also waiting for an active runner";

        return text;
    }

    private string GetQueuedReasonText(QueuedReason reason)
    {
        return reason switch
        {
            QueuedReason.WaitingOnDependencies => "Waiting on dependencies",
            QueuedReason.WaitingOnRunnerCheckin => "Waiting for active runner",
            QueuedReason.WaitingOnRunningJob => "Waiting on current job",
            QueuedReason.Maintenance => "Waiting on maintenance mode",
            QueuedReason.Paused => "Module is paused",
            _ => ""
        };
    }

    # endregion

    private string ShortenRevision(string text)
    {
        return System.Text.RegularExpressions.Regex.Replace(text, @"[0-9a-fA-F]{12,}", m => m.Value[..12]);
    }

    # region revision

    private string GetRevisionSubtext(RevisionState revisionState)
    {
        if (revisionState == RevisionState.Synced)
            return $"{_actualDefinitiveRevision}";

        var currentState = "Unknown";
        if (!string.IsNullOrEmpty(_actualDefinitiveRevision))
            currentState = _actualDefinitiveRevision ?? string.Empty;

        if (revisionState == RevisionState.OutOfSync)
            return $"{currentState} (Desired {_moduleSaga.DesiredDefinitiveRevision})";

        return "";
    }


    private RevisionState GetRevisionState()
    {
        if (_moduleSaga.DesiredDefinitiveRevision == null)
            return RevisionState.Unknown;

        // When both sides carry a closure hash (path-scoped triggering), content fingerprints are the sync
        // criterion: revisions may differ while every watched directory is byte-identical, and vice versa.
        if (_moduleSaga.DesiredClosureHash != null && _actualDefinitiveClosureHash != null)
            return _actualDefinitiveClosureHash == _moduleSaga.DesiredClosureHash
                ? RevisionState.Synced
                : RevisionState.OutOfSync;

        if (_actualDefinitiveRevision == _moduleSaga.DesiredDefinitiveRevision)
            return RevisionState.Synced;

        return RevisionState.OutOfSync;
    }

    private Icon GetRevisionIcon(RevisionState state)
    {
        switch (state)
        {
            case RevisionState.Unknown:
                return new Icon
                {
                    Color = Color.Default,
                    Name = SnapCdIcons.StopCircle,
                    Tooltip = "No revision information yet"
                };

            case RevisionState.Synced:
                return new Icon
                {
                    Color = Color.Success,
                    Name = SnapCdIcons.CheckCircle,
                    Tooltip = "Synced"
                };

            case RevisionState.OutOfSync:
                return new Icon
                {
                    Color = Color.Warning,
                    Name = SnapCdIcons.ChangeCircle,
                    Tooltip = "Out of sync"
                };

            default:
                return new Icon
                {
                    Color = Color.Default,
                    Name = SnapCdIcons.StopCircle,
                    Tooltip = "No revision information yet"
                };
        }
    }

