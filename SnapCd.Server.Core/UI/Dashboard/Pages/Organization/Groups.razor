@page "/Groups"
@layout OrganizationMainLayout

@implements IDisposable


@* TODO, move this to Account/Pages/Manage and add to nav menu Account/Shared/ManageNavMenu.razor. For some reason when in that location the buttons do not work! *@

@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@inject OrganizationServiceFactory OrganizationServiceFactory
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject IOrganizationContext OrganizationContext
@using Microsoft.AspNetCore.Authorization
@using SnapCd.Contracts
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Groups
@using SnapCd.Server.Core.UI.Dashboard.Components.Group
@using SnapCd.Server.Core.UI.Dashboard.Components.Roles
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.RoleAssignments
@using SnapCd.Server.Core.UI.Dashboard.Components.GroupMember
@using SnapCd.Server.Core.UI.Dashboard.Components.Roles.OrganizationRoles

@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission(OrganizationRole.Owner, OrganizationRole.IdentityAccessManager)]
@attribute [OrganizationScopedIAM]
<PageTitle>Groups</PageTitle>

<CascadingValue Value="OrganizationId">
    <MudText Typo="Typo.h4" GutterBottom="true">Groups</MudText>

    @if (_showCreateGroup)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <CreateGroup OnCreated="HandleGroupCreated"
                         OnCancel="HandleCancelCreate"/>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       OnClick="ShowCreateGroup">
                Create
            </MudButton>
        </MudPaper>
    }

    @if (_groups == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    }
    else
    {
        <MudExpansionPanels>
            @foreach (var group in _groups)
            {
                <MudExpansionPanel Expanded="@(group.Id == _expandedId)"
                                   ExpandedChanged="@(e => HandleExpansionChanged(group.Id, e))">
                    <TitleContent>
                        <MudText>@group.Name</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Edit group">
                            <MudIconButton Icon="@SnapCdIcons.Edit"
                                           Color="@GetColor(group.Id, ShowingType.Edit)"
                                           Size="Size.Small" OnClick="() => Edit(group)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage groups's roles">
                            <MudIconButton Icon="@SnapCdIcons.Shield"
                                           Color="@GetColor(group.Id, ShowingType.Roles)" Size="Size.Small"
                                           OnClick="() => ManageRoles(group)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage groups's members">
                            <MudIconButton Icon="@SnapCdIcons.Group"
                                           Color="@GetColor(group.Id, ShowingType.Members)" Size="Size.Small"
                                           OnClick="() => ManageMembers(group)"/>
                        </MudTooltip>

                        <MudTooltip Text="Delete group">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => Delete(group)"/>
                        </MudTooltip>

                        @if (IsShowing(group.Id, ShowingType.Edit))
                        {
                            <MudItem Class="mt-2">
                                <EditGroup Group="_selectedGroup"
                                           OnSaved="HandleGroupSaved"
                                           OnCancel="HandleCancelEdit"/>
                            </MudItem>
                        }

                        @if (IsShowing(group.Id, ShowingType.Roles))
                        {
                            <MudItem Class="mt-2">
                                <ManageGroupOrganizationRoles
                                    GroupId="group.Id"
                                    OnClose="HandleRoleAssignmentsClosed"/>
                            </MudItem>
                        }

                        @if (IsShowing(group.Id, ShowingType.Members))
                        {
                            <MudItem Class="mt-2">
                                <GroupMembers
                                    GroupId=group.Id
                                    OnClose="HandleGroupMembersClosed"/>
                            </MudItem>
                        }

                    </ChildContent>
                </MudExpansionPanel>
            }

        </MudExpansionPanels>
    }
</CascadingValue>



@code {
    [Inject] private GroupSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    [SupplyParameterFromQuery] public string? Group { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }

    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;

    private List<Group>? _groups;
    private bool _showCreateGroup;
    private Group? _selectedGroup;
    private Guid? _expandedId;
    private ShowingType _showing;


    private enum ShowingType
    {
        None,
        Edit,
        Roles,
        Members
    }

    private Color GetColor(Guid groupId, ShowingType showTypeToMatch)
    {
        if (_selectedGroup == null)
            return Color.Primary;
        if (groupId == _selectedGroup.Id)
            return _showing == showTypeToMatch ? Color.Secondary : Color.Primary;
        return Color.Primary;
    }

    private bool IsShowing(Guid groupId, ShowingType showTypeToMatch)
    {
        if (_selectedGroup == null)
            return false;
        if (groupId == _selectedGroup.Id && _showing == showTypeToMatch)
        {
            return true;
        }

        return false;
    }


    private void ShowCreateGroup()
    {
        _showCreateGroup = true;
    }

    private async Task HandleGroupCreated(Guid groupId)
    {
        _showCreateGroup = false;
        await ReloadGroups();
    }

    private void HandleGroupMembersClosed() => ClearSelection();

    private void HandleRoleAssignmentsClosed() => ClearSelection();

    private void HandleCancelCreate()
    {
        _showCreateGroup = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadGroups();
    }

    protected override void OnParametersSet()
    {
        if (_groups is null) return;
        if (Guid.TryParse(Group, out var id))
        {
            var match = _groups.FirstOrDefault(g => g.Id == id);
            if (match is not null)
            {
                _expandedId = id;
                if (!string.IsNullOrEmpty(Action)
                    && Enum.TryParse<ShowingType>(Action, ignoreCase: true, out var parsed)
                    && parsed != ShowingType.None)
                {
                    _selectedGroup = match;
                    _showing = parsed;
                }
            }
        }
    }

    private void HandleExpansionChanged(Guid id, bool expanded)
    {
        if (expanded)
        {
            _expandedId = id;
        }
        else if (_expandedId == id)
        {
            _expandedId = null;
            if (_selectedGroup?.Id == id)
            {
                _selectedGroup = null;
                _showing = ShowingType.None;
            }
        }
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var query = new Dictionary<string, object?>();
        if (_expandedId is { } eid) query["group"] = eid.ToString();
        if (_selectedGroup is not null && _showing != ShowingType.None)
            query["action"] = _showing.ToString().ToLowerInvariant();
        var url = NavigationManager.GetUriWithQueryParameters("/Groups", query);
        NavigationManager.NavigateTo(url, forceLoad: false, replace: true);
    }

    private void Select(Group entity, ShowingType action)
    {
        _selectedGroup = entity;
        _expandedId = entity.Id;
        _showing = action;
        UpdateUrl();
    }

    private void ClearSelection()
    {
        _selectedGroup = null;
        _showing = ShowingType.None;
        UpdateUrl();
    }

    private async Task ReloadGroups()
    {
        using var repo = RepoFactory.Create();
        _groups = await repo.List(OrganizationId);
    }


    private async Task Delete(Group group)
    {
        var parameters = new DialogParameters<DeleteGroupDialog>
        {
            { x => x.Group, group },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteGroupDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var deletedUserId);
            Snackbar.Add($"Successfully deleted user \"{deletedUserId}\"");
            await ReloadGroups();
        }
    }

    private async Task HandleGroupSaved(Group group)
    {
        ClearSelection();
        Snackbar.Add($"Successfully updated group {group.Name}", Severity.Success);
        await ReloadGroups();
    }

    private void HandleCancelEdit() => ClearSelection();

    private void ManageRoles(Group group) => Select(group, ShowingType.Roles);

    private void ManageMembers(Group group) => Select(group, ShowingType.Members);

    private void Edit(Group group) => Select(group, ShowingType.Edit);


    public void Dispose()
    {
    }

}
