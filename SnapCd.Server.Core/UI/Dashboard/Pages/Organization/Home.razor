@page "/Organization/"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Organization</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-8" Style="text-align: center;">
        <MudText Typo="Typo.h3" GutterBottom="true">Welcome to SnapCD</MudText>
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-4">
            Select an Organization in the Nav Menu to start managing your infrastructure
        </MudText>
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Large" Color="Color.Primary" Class="mt-4" Style="transform: rotate(90deg);" />
    </MudPaper>
</MudContainer>

