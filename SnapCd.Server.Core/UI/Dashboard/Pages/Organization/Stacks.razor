@page "/Tree"
@layout FullHeightLayout

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject OrganizationServiceFactory OrganizationServiceFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject IOrganizationContext OrganizationContext
@inject IJSRuntime JS
@implements IAsyncDisposable
@inject SnapCd.Server.Core.Repositories.Organizations.Secured.StackSecuredRepositoryFactory CreatePermissionRepoFactory

@using Microsoft.AspNetCore.Authorization
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Services.Interfaces.OrganizationContext
@using SnapCd.Server.Core.Services.Nonsecured.PrincipalProvider
@using SnapCd.Server.Core.Services.Secured
@using SnapCd.Server.Core.UI.Dashboard.Components.Stack
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Stacks

@attribute [Authorize]
@attribute [OrganizationScopedFeature]
@attribute [AuthorizeOnNavigationPermission]

<PageTitle>Tree</PageTitle>

<CascadingValue Value="OrganizationId">
    @* The stacks are a quarter of the width, and what is selected in them fills the rest. *@
    <div class="split-layout" @ref="_splitLayout">
        <div class="split-pane split-pane-tree">
            <div class="tree-column">
                @if (_searchTerms.Any())
                {
                    <div class="search-chips-header mb-2">
                        @foreach (var term in _searchTerms)
                        {
                            <MudChip T="string"
                                     Text="@term"
                                     Size="Size.Small"
                                     Color="Color.Secondary"
                                     OnClose="@(() => RemoveSearchTerm(term))"/>
                        }
                    </div>
                }

                @if (_showStackSearch)
                {
                    <div class="search-input-container mb-2">
                        <MudSelect @bind-Value="_searchScope"
                                   Label="Search in"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Class="search-scope-select">
                            <MudSelectItem Value="@SearchScope.Stack">Stacks</MudSelectItem>
                            <MudSelectItem Value="@SearchScope.Namespace">Namespaces</MudSelectItem>
                            <MudSelectItem Value="@SearchScope.Module">Modules</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_searchInput"
                                      Label="Search across stacks, namespaces, and modules"
                                      HelperText="Press Enter to search (minimum 2 characters)"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@SnapCdIcons.Search"
                                      OnKeyDown="@HandleKeyDown"
                                      Immediate="true"
                                      Class="search-field-inline"/>
                    </div>
                }

                <ListStacks @ref="_listStacksComponent"
                            SearchTerms="@_searchTerms"
                            SearchScope="@_searchScope"
                            PageSize="@_stackPageSize"
                            OnSelected="@HandleSelected"
                            OnCreateRequested="@HandleCreateRequested"
                            Selected="@_selection">
                    <HeadingActions>
                        <MudTooltip Text="Search stacks">
                            <MudIconButton Icon="@SnapCdIcons.Search"
                                           Color="@(_showStackSearch ? Color.Secondary : Color.Primary)"
                                           Size="Size.Small"
                                           OnClick="@(() => _showStackSearch = !_showStackSearch)"/>
                        </MudTooltip>
                    </HeadingActions>
                </ListStacks>
            </div>
        </div>
        <div class="split-handle" data-splitter-handle title="Drag to resize. Double-click to reset."></div>
        <div class="split-pane split-pane-content">
            <SelectedHierarchyPanels @key="(_creation, _selection)"
                                     Selection="_selection"
                                     Creation="_creation"
                                     OnChanged="HandleSelectionChanged"
                                     OnCreated="HandleCreated"
                                     OnCreateCancelled="HandleCreateCanceled"/>
        </div>
    </div>
</CascadingValue>

@code {

    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
    [SupplyParameterFromQuery] public string? Search { get; set; }

    /// <summary>Selects a Stack on arrival, so a link elsewhere can point at one.</summary>
    [SupplyParameterFromQuery(Name = "stack")] public string? SelectedStack { get; set; }

    /// <summary>Given alongside stack, selects that Namespace within it.</summary>
    [SupplyParameterFromQuery(Name = "namespace")] public string? SelectedNamespace { get; set; }

    /// <summary>Given alongside stack and namespace, selects that Module within them.</summary>
    [SupplyParameterFromQuery(Name = "module")] public string? SelectedModule { get; set; }

    private ListStacks? _listStacksComponent;

    /// <summary>What the tree has selected, which the panels beside it follow.</summary>
    private HierarchySelection? _selection;

    /// <summary>A level the tree asked to create at, which takes the column until it is done.</summary>
    private HierarchyCreation? _creation;

    private bool _showStackSearch;
    private string _searchInput = string.Empty;
    private List<string> _searchTerms = new();
    private SearchScope _searchScope = SearchScope.Stack;

    protected override void OnInitialized()
    {
        using (var repo = CreatePermissionRepoFactory.Create())
        {
        }

        // Parse search terms from URL query parameter
        if (!string.IsNullOrEmpty(Search))
        {
            _searchTerms = Search.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        }

    }

    /// <summary>
    /// The query values arrive with the parameters, not before them, so the selection is read here.
    /// A click sets both the selection and the address bar, so the two agree and this is a no-op
    /// until the address bar names something else.
    /// </summary>
    protected override void OnParametersSet()
    {
        var fromUrl = string.IsNullOrEmpty(SelectedStack)
            ? null
            : string.IsNullOrEmpty(SelectedNamespace)
                ? HierarchySelection.OfStack(SelectedStack)
                : string.IsNullOrEmpty(SelectedModule)
                    ? HierarchySelection.OfNamespace(SelectedStack, SelectedNamespace)
                    : HierarchySelection.OfModule(SelectedStack, SelectedNamespace, SelectedModule);

        // Changing the selection changes the panels' @key, which disposes one keyed component and
        // builds another. Done inside the location-changed event, that mutates the set of
        // query-parameter subscribers Blazor is still iterating, so it is applied after the render.
        if (fromUrl != null && fromUrl != _selection) _pendingSelection = fromUrl;
    }

    private HierarchySelection? _pendingSelection;

    // The selection keys the panels, so this event also disposes one keyed component and builds
    // another. Navigating in the same call stack mutates the query-parameter provider's subscriber
    // set while it is enumerating, so the URL is written after the render that changes it.
    private void HandleSelected(HierarchySelection selection)
    {
        _creation = null;
        _selection = selection;
        _urlPending = true;
    }

    // The selection keys the panels, so changing it disposes one keyed component and builds
    // another. Navigating in the same call stack mutates the query-parameter provider's
    // subscriber set while it is enumerating them, so the URL is written after the render.
    private bool _urlPending;

    private int _stackPageSize = 10;

    private ElementReference _splitLayout;
    private IJSObjectReference? _splitterModule;

    // A stack row is 30px and the heading above the list takes its own space, so how many rows
    // fit is a property of the column's height rather than a number worth fixing in advance.
    // A collapsed row and the 4px gap below it, which is what one row costs when nothing is open.
    // An expanded branch is taller, and the column scrolls for it, which is what the scroll is for.
    private const int StackRowHeight = 34;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await AttachSplitter();

        if (_pendingSelection != null)
        {
            _selection = _pendingSelection;
            _pendingSelection = null;
            StateHasChanged();
            return;
        }

        if (_urlPending)
        {
            _urlPending = false;
            UpdateUrl();
        }

        // Not only on the first render: arriving with a selection applies that selection on a
        // later pass, and the rows are only worth measuring against once they are in place.
        await MeasureStackPageSize();
    }

    public async ValueTask DisposeAsync()
    {
        if (_splitterModule == null) return;

        try
        {
            await _splitterModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, so the module went with it.
        }
    }

    private async Task AttachSplitter()
    {
        try
        {
            _splitterModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/SnapCd.Server.Core/snapcd-splitter.js");
            await _splitterModule.InvokeVoidAsync("attach", _splitLayout);
        }
        catch (JSException)
        {
            // Without the handle the columns keep the width the stylesheet gives them.
        }
    }

    /// <summary>
    /// How many stack rows the column has room for. Measured once: a resize changes the answer,
    /// but the scroll area absorbs that without a reload.
    /// </summary>
    private async Task MeasureStackPageSize()
    {
        double available;

        try
        {
            // The container gives the rows their height; this only reads it, to pick a page size
            // that fills the space rather than overflowing it.
            available = await JS.InvokeAsync<double>(
                "eval",
                "(function(){var e=document.querySelector('.tree-scroll');" +
                "return e?e.getBoundingClientRect().height:0;})()");
        }
        catch (JSException)
        {
            return;
        }

        if (available <= 0) return;

        var fits = (int)(available / StackRowHeight);
        var wanted = Math.Clamp(fits, 5, 100);

        if (wanted == _stackPageSize) return;

        _stackPageSize = wanted;
        StateHasChanged();
    }

    /// <summary>A create form replaces whatever the column was showing until it closes.</summary>
    private void HandleCreateRequested(HierarchyCreation creation) => _creation = creation;

    /// <summary>A panel renamed or deleted what it was showing, so the tree and the panels reload.</summary>
    private async Task HandleSelectionChanged()
    {
        _selection = null;

        if (_listStacksComponent != null) await _listStacksComponent.LoadStacks();
    }

    private async Task HandleCreated()
    {
        _creation = null;
        await ReloadStacks();
    }

    private void HandleCreateCanceled() => _creation = null;

    private async Task ReloadStacks()
    {
        if (_listStacksComponent != null)
        {
            await _listStacksComponent.LoadStacks();
            _listStacksComponent.TriggerStateHasChanged();
        }
    }

    private async Task AddSearchTerm()
    {
        if (!string.IsNullOrWhiteSpace(_searchInput) &&
            _searchInput.Length >= 2 &&
            !_searchTerms.Contains(_searchInput))
        {
            _searchTerms.Add(_searchInput);
            _searchInput = string.Empty;
            _showStackSearch = false; // Hide search box after adding term
            UpdateUrlWithSearchTerms();

            // _searchTerms is mutated in place, so the parameter reference does not
            // change and OnParametersSetAsync will not fire. Reload explicitly.
            await ReloadStacks();
        }
    }

    private async Task RemoveSearchTerm(string term)
    {
        _searchTerms.Remove(term);
        UpdateUrlWithSearchTerms();
        await ReloadStacks();
    }

    private void UpdateUrlWithSearchTerms() => UpdateUrl();

    /// <summary>
    /// Writes the search and the selection into the address bar together, so a link copied from it
    /// opens the same node. It replaces the history entry, because selecting in a tree is not a
    /// navigation the back button should step through.
    /// </summary>
    private void UpdateUrl()
    {
        var uri = NavigationManager.Uri;
        var baseUrl = uri.Contains('?') ? uri[..uri.IndexOf('?')] : uri;

        var query = new List<string>();

        if (_searchTerms.Any())
            query.Add($"search={Uri.EscapeDataString(string.Join(",", _searchTerms))}");

        if (_selection != null)
        {
            query.Add($"stack={Uri.EscapeDataString(_selection.StackName)}");

            if (_selection.NamespaceName != null)
                query.Add($"namespace={Uri.EscapeDataString(_selection.NamespaceName)}");

            if (_selection.ModuleName != null)
                query.Add($"module={Uri.EscapeDataString(_selection.ModuleName)}");
        }

        var target = query.Any() ? $"{baseUrl}?{string.Join("&", query)}" : baseUrl;

        NavigationManager.NavigateTo(target, forceLoad: false, replace: true);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddSearchTerm();
        }
    }

}

<style>
    .page-header {
        margin-bottom: 16px;
    }

    .page-header-title {
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 4px;
    }

    /* The split is a CSS variable so the drag can move it without a re-render. */
    .split-layout {
        --tree-width: 25%;
        display: flex;
        align-items: stretch;
        gap: 0;
        flex: 1 1 auto;
        min-height: 0;
    }

    .split-pane-tree {
        width: var(--tree-width);
        flex: 0 0 var(--tree-width);
        min-width: 0;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    /* The right pane gives its content the height; what scrolls inside is the content's own
       business, so a tab can pin its pager while only its list scrolls. */
    .split-pane-content {
        flex: 1 1 auto;
        min-width: 0;
        padding-left: 12px;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .split-handle {
        flex: 0 0 9px;
        align-self: stretch;
        min-height: 200px;
        cursor: col-resize;
        position: relative;
        touch-action: none;
    }

    .split-handle::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 4px;
        width: 1px;
        background: var(--snap-border);
    }

    .split-handle:hover::before,
    .is-splitting .split-handle::before {
        background: var(--snap-accent);
        width: 2px;
    }

    @@media (max-width: 960px) {
        .split-layout {
            flex-direction: column;
        }

        .split-pane-tree,
        .split-pane-content {
            width: 100%;
            flex: 1 1 auto;
            padding-left: 0;
        }

        .split-handle {
            display: none;
        }
    }

    /* The tree scrolls within the viewport so the page itself does not grow with the hierarchy. */
    /* A fixed height, not a max: the pager stays at the bottom however few rows a page holds.
       --tree-top is the column's distance from the top of the viewport, measured on first render. */
    .tree-column {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }

    /* Only the rows scroll. The pager below them stays put. */
    /* 1 1 0 rather than 1 1 auto, so a short page still fills the column instead of collapsing. */
    .tree-column .tree-scroll {
        flex: 1 1 0;
        min-height: 0;
        overflow-y: auto;
        overflow-x: auto;
        padding-right: 4px;
    }

    /* The pager sits on the page, not on a raised surface, and takes a row's height. */
    /* Matches the sidebar's Account bar, so the two borders sit on one line: that bar is a
       40px nav link inside 4px of padding, and both end at the bottom of the window. */
    .tree-column .tree-pager {
        flex: 0 0 auto;
        box-sizing: border-box;
        min-height: 57px;
        display: flex;
        align-items: center;
        padding: 4px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .tree-column .tree-pager > * {
        flex: 1 1 auto;
    }

    .tree-column .tree-pager .mud-paper {
        background-color: transparent;
        box-shadow: none;
        padding: 0 !important;
        margin-bottom: 0 !important;
    }

    .tree-column .tree-pager .mud-icon-button {
        padding: 4px;
    }


    .stack-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .search-chips-header {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        align-items: center;
    }

    .search-input-container {
        flex: 1;
        min-width: 300px;
    }

    .search-field-inline {
        margin-bottom: 0;
    }

    .selection-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.5rem;
        padding: 0.5rem;
        background-color: var(--mud-palette-background-grey);
        border-radius: 4px;
    }

</style>