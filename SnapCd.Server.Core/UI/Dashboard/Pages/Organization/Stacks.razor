@page "/Stacks"
@layout OrganizationMainLayout

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject OrganizationServiceFactory OrganizationServiceFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject IOrganizationContext OrganizationContext

@using Microsoft.AspNetCore.Authorization
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.UI.Dashboard.Components.Stack
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Stacks

@attribute [Authorize]
@attribute [OrganizationScopedFeature]
@attribute [AuthorizeOnNavigationPermission]

<PageTitle>Stacks</PageTitle>

<CascadingValue Value="OrganizationId">
    <div class="page-header">
        <MudText Typo="Typo.h4" Class="page-header-title">Stacks</MudText>
    </div>

    @if (_showCreate)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <CreateStack OnCreated="HandleCreated"
                         OnCancel="HandleCreateCanceled"/>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       OnClick="ShowCreate">
                Create
            </MudButton>
        </MudPaper>
    }

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <div class="stack-header">
                <MudTooltip Text="Select multiple">
                    <MudIconButton Icon="@SnapCdIcons.Checklist"
                                   Color="@(_showSelectionMode ? Color.Secondary : Color.Primary)"
                                   Size="Size.Small"
                                   OnClick="() => ToggleSelectionMode()"/>
                </MudTooltip>

                <MudTooltip Text="Search stacks">
                    <MudIconButton Icon="@SnapCdIcons.Search"
                                   Color="@(_showStackSearch ? Color.Secondary : Color.Primary)"
                                   Size="Size.Small"
                                   OnClick="@(() => _showStackSearch = !_showStackSearch)"/>
                </MudTooltip>

                @if (_searchTerms.Any())
                {
                    <div class="search-chips-header">
                        @foreach (var term in _searchTerms)
                        {
                            <MudChip T="string"
                                     Text="@term"
                                     Size="Size.Small"
                                     Color="Color.Secondary"
                                     OnClose="@(() => RemoveSearchTerm(term))"/>
                        }
                    </div>
                }

                @if (_showStackSearch)
                {
                    <div class="search-input-container">
                        <MudTextField @bind-Value="_searchInput"
                                      Label="Search across stacks, namespaces, and modules"
                                      HelperText="Press Enter to search (minimum 2 characters)"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@SnapCdIcons.Search"
                                      OnKeyDown="@HandleKeyDown"
                                      Immediate="true"
                                      Class="search-field-inline"/>
                    </div>
                }
            </div>

            @if (_showSelectionMode)
            {
                <div class="selection-controls">
                    <MudCheckBox T="bool"
                                 Value="_selectAllStacks"
                                 ValueChanged="OnSelectAllChanged"
                                 Label="Select all Stacks"
                                 Color="Color.Secondary"
                                 Dense="true"/>

                    @if (_selectedStacks.Any())
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   StartIcon="@SnapCdIcons.Delete"
                                   OnClick="DeleteSelectedStacks"
                                   Size="Size.Small">
                            Delete Selected (@_selectedStacks.Count)
                        </MudButton>
                    }
                </div>
            }
        </MudPaper>

        <ListStacks @ref="_listStacksComponent"
                    SearchTerms="@_searchTerms"
                    ShowCheckboxes="@_showSelectionMode"
                    SelectAll="@_selectAllStacks"
                    OnSelectionChanged="@HandleStackSelectionChanged"/>
</CascadingValue>

@code {
    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
    [SupplyParameterFromQuery] public string? Search { get; set; }

    private ListStacks? _listStacksComponent;

    private bool _showCreate;
    private bool _showStackSearch;
    private string _searchInput = string.Empty;
    private List<string> _searchTerms = new();
    private bool _selectAllStacks;
    private HashSet<Guid> _selectedStacks = new();
    private bool _showSelectionMode;

    protected override void OnInitialized()
    {
        // Parse search terms from URL query parameter
        if (!string.IsNullOrEmpty(Search))
        {
            _searchTerms = Search.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        }
    }

    private void ShowCreate()
    {
        _showCreate = true;
    }

    private async Task HandleCreated()
    {
        _showCreate = false;
        await ReloadStacks();
    }

    private void HandleCreateCanceled()
    {
        _showCreate = false;
    }

    private async Task ReloadStacks()
    {
        if (_listStacksComponent != null)
        {
            await _listStacksComponent.LoadStacks();
            _listStacksComponent.TriggerStateHasChanged();
        }
    }

    private async Task AddSearchTerm()
    {
        if (!string.IsNullOrWhiteSpace(_searchInput) &&
            _searchInput.Length >= 2 &&
            !_searchTerms.Contains(_searchInput))
        {
            _searchTerms.Add(_searchInput);
            _searchInput = string.Empty;
            _showStackSearch = false; // Hide search box after adding term
            UpdateUrlWithSearchTerms();

            // _searchTerms is mutated in place, so the parameter reference does not
            // change and OnParametersSetAsync will not fire. Reload explicitly.
            await ReloadStacks();
        }
    }

    private async Task RemoveSearchTerm(string term)
    {
        _searchTerms.Remove(term);
        UpdateUrlWithSearchTerms();
        await ReloadStacks();
    }

    private void UpdateUrlWithSearchTerms()
    {
        var uri = NavigationManager.Uri;
        var baseUrl = uri.Contains('?') ? uri.Substring(0, uri.IndexOf('?')) : uri;

        if (_searchTerms.Any())
        {
            var searchTermsParam = string.Join(",", _searchTerms);
            NavigationManager.NavigateTo($"{baseUrl}?search={Uri.EscapeDataString(searchTermsParam)}", false);
        }
        else
        {
            NavigationManager.NavigateTo(baseUrl, false);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddSearchTerm();
        }
    }

    private void OnSelectAllChanged(bool value)
    {
        _selectAllStacks = value;
    }

    private void ToggleSelectionMode()
    {
        _showSelectionMode = !_showSelectionMode;

        // Clear selections when exiting selection mode
        if (!_showSelectionMode)
        {
            _selectAllStacks = false;
            _selectedStacks.Clear();
        }
    }

    private void HandleStackSelectionChanged(HashSet<Guid> selectedStacks)
    {
        _selectedStacks = selectedStacks;
        StateHasChanged();
    }

    private async Task DeleteSelectedStacks()
    {
        if (!_selectedStacks.Any() || _listStacksComponent == null)
            return;

        var selectedStacks = _listStacksComponent.GetSelectedStacks();

        var parameters = new DialogParameters<DeleteSelectedStacksDialog>
        {
            { x => x.Stacks, selectedStacks },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteSelectedStacksDialog>("Delete Selected Stacks", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            // Clear selection
            _selectAllStacks = false;
            _selectedStacks.Clear();

            // Reload stacks list
            await ReloadStacks();

            Snackbar.Add($"Successfully deleted {selectedStacks.Count} stack(s)", Severity.Success);
        }
    }
}

<style>
    .page-header {
        margin-bottom: 16px;
    }

    .page-header-title {
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 4px;
    }

    .stack-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .search-chips-header {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        align-items: center;
    }

    .search-input-container {
        flex: 1;
        min-width: 300px;
    }

    .search-field-inline {
        margin-bottom: 0;
    }

    .selection-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.5rem;
        padding: 0.5rem;
        background-color: var(--mud-palette-background-grey);
        border-radius: 4px;
    }

</style>