@page "/Transfer/{transferId:guid}"
@layout OrganizationMainLayout
@attribute [Authorize]
@attribute [OrganizationScopedFeature]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SnapCd.Contracts
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Services.Crud.Transfers
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Theme
@using Color = MudBlazor.Color

@inject IOrganizationContext OrganizationContext
@inject IDbContextFactory<SnapCdDbContext> DbContextFactory
@inject TransferServiceFactory TransferServiceFactory
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Transfer</PageTitle>

@if (_transfer == null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Loading the transfer...</MudText>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.h5">Transfer</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@_transfer.Status</MudChip>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Moving resources from <strong>@Name(_transfer.SourceModuleId)</strong>
        into <strong>@Name(_transfer.ReceiverModuleId)</strong>.
        Map <code>@Short(_transfer.MapHash)</code>.
    </MudText>

    @if (_transfer.ClosedAt != null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Closed @Ago(_transfer.ClosedAt.Value)@(string.IsNullOrWhiteSpace(_transfer.CloseReason) ? "" : $": {_transfer.CloseReason}")
        </MudAlert>
    }

    @* Each Module's page links here so a long hold is attributable to the other side
       not having merged, rather than looking like a mystery. *@
    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudText Typo="Typo.overline" Class="mud-text-secondary">Gates</MudText>
        <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
            <thead>
            <tr>
                <th></th>
                <th>Consent</th>
                <th>Ref</th>
                <th>Locked</th>
                <th>Merged</th>
                <th>Released</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><strong>Source</strong><br/><span class="mud-text-secondary">@Name(_transfer.SourceModuleId)</span></td>
                <td>@Gate(true, "by initiating")</td>
                <td>@Ref(_transfer.SourceProveRef)</td>
                <td>@Gate(_transfer.SourceLockedAt != null, Who(_transfer.SourceLockedBy, _transfer.SourceLockedAt))</td>
                <td>@Gate(_transfer.SourceMergedDeclaredAt != null, Commit(_transfer.SourceMergedCommit, _transfer.SourceMergedDeclaredAt))</td>
                <td>@Gate(_transfer.SourceReleasedAt != null, When(_transfer.SourceReleasedAt))</td>
            </tr>
            <tr>
                <td><strong>Receiver</strong><br/><span class="mud-text-secondary">@Name(_transfer.ReceiverModuleId)</span></td>
                <td>@ConsentCell()</td>
                <td>@Ref(_transfer.ReceiverProveRef)</td>
                <td>@Gate(_transfer.ReceiverLockedAt != null, Who(_transfer.ReceiverLockedBy, _transfer.ReceiverLockedAt))</td>
                <td>@Gate(_transfer.ReceiverMergedDeclaredAt != null, Commit(_transfer.ReceiverMergedCommit, _transfer.ReceiverMergedDeclaredAt))</td>
                <td>@Gate(_transfer.ReceiverReleasedAt != null, When(_transfer.ReceiverReleasedAt))</td>
            </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @if (_jobs.Count > 0)
    {
        <MudPaper Elevation="0" Class="pa-4">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Jobs run under this transfer</MudText>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                <tbody>
                @foreach (var job in _jobs)
                {
                    <tr>
                        <td>@job.JobType</td>
                        <td>@Name(job.ModuleId)</td>
                        <td>@job.Status</td>
                        <td class="mud-text-secondary">@Ago(job.TimestampStart)</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public Guid TransferId { get; set; }

    private Transfer? _transfer;
    private readonly Dictionary<Guid, string> _moduleNames = new();
    private List<ManualModuleJob> _jobs = [];

    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();

        _transfer = await db.Transfers.AsNoTracking()
            .SingleOrDefaultAsync(t => t.Id == TransferId && t.OrganizationId == OrganizationId);

        if (_transfer == null) return;

        var moduleIds = new[] { _transfer.SourceModuleId, _transfer.ReceiverModuleId };

        foreach (var module in await db.Modules.AsNoTracking()
                     .Where(m => moduleIds.Contains(m.Id) && m.OrganizationId == OrganizationId)
                     .Select(m => new { m.Id, m.Name })
                     .ToListAsync())
            _moduleNames[module.Id] = module.Name;

        _jobs = await db.ManualModuleJobs.AsNoTracking()
            .Where(j => moduleIds.Contains(j.ModuleId)
                        && j.OrganizationId == OrganizationId
                        && (j.JobType == ManualJobTypes.TransferProve || j.JobType == ManualJobTypes.TransferMigrate))
            .OrderByDescending(j => j.TimestampStart)
            .ToListAsync();
    }

    private string Name(Guid moduleId) => _moduleNames.GetValueOrDefault(moduleId, moduleId.ToString()[..8]);

    private static string Short(string hash) => hash.Length > 12 ? hash[..12] : hash;

    private RenderFragment ConsentCell() =>
        @<span>
            @if (_transfer!.ReceiverConsentStatus == ConsentStatus.Granted)
            {
                <MudIcon Icon="@SnapCdIcons.CheckCircle" Color="Color.Success" Size="Size.Small"/>
            }
            else if (_transfer.ReceiverConsentStatus is ConsentStatus.Refused or ConsentStatus.Revoked)
            {
                <MudIcon Icon="@SnapCdIcons.Error" Color="Color.Error" Size="Size.Small"/>
            }
            <span class="ml-1">@_transfer.ReceiverConsentStatus</span>
            @if (_transfer.ReceiverConsentDecidedAt != null)
            {
                <span class="mud-text-secondary"> @Ago(_transfer.ReceiverConsentDecidedAt.Value)</span>
            }
        </span>;

    private static RenderFragment Gate(bool passed, string detail) =>
        @<span>
            @if (passed)
            {
                <MudIcon Icon="@SnapCdIcons.CheckCircle" Color="Color.Success" Size="Size.Small"/>
                <span class="mud-text-secondary ml-1">@detail</span>
            }
            else
            {
                <span class="mud-text-secondary">not yet</span>
            }
        </span>;

    private static RenderFragment Ref(string? proveRef) =>
        @<span class="mud-text-secondary">@(string.IsNullOrWhiteSpace(proveRef) ? "not set" : proveRef)</span>;

    private string Who(Guid? principalId, DateTimeOffset? at) =>
        principalId == null ? "" : When(at);

    private static string Commit(string? commit, DateTimeOffset? at) =>
        string.IsNullOrWhiteSpace(commit) ? When(at) : $"{(commit.Length > 8 ? commit[..8] : commit)} {When(at)}";

    private static string When(DateTimeOffset? at) => at == null ? "" : Ago(at.Value);

    private static string Ago(DateTimeOffset at)
    {
        var elapsed = DateTimeOffset.UtcNow - at;
        return elapsed.TotalMinutes < 60 ? $"{(int)elapsed.TotalMinutes} minutes ago"
            : elapsed.TotalHours < 24 ? $"{(int)elapsed.TotalHours} hours ago"
            : elapsed.TotalHours < 48 ? "yesterday"
            : $"{(int)elapsed.TotalDays} days ago";
    }
}
