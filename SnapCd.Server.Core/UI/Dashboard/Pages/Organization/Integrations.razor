@page "/Integrations"
@layout OrganizationMainLayout

@inject SnapCd.Server.Core.Services.Integrations.IntegrationService Service
@inject SnapCd.Server.Core.Repositories.Organizations.Secured.IntegrationSecuredRepositoryFactory RepoFactory
@inject SnapCd.Server.Core.Services.OrganizationContext.IOrganizationContext OrganizationContext
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Confirm

@using Microsoft.AspNetCore.Authorization
@using SnapCd.Contracts
@using SnapCd.Contracts.Dto.Integrations
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Licensing.Models
@using SnapCd.Server.Core.UI.Dashboard.Components.Integrations
@using SnapCd.Server.Core.UI.Dashboard.Components.IntegrationSupplies
@using SnapCd.Server.Core.UI.Dashboard.Components.Licensing

@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@attribute [OrganizationScopedFeature]
<PageTitle>Integrations</PageTitle>

<CascadingValue Value="OrganizationId">
    <MudText Typo="Typo.h4" GutterBottom="true">Integrations</MudText>
    <EeFeatureAlert Feature="Feature.Integrations" Message="Integrations are not included in your current tier. You can configure integrations, but events will not be dispatched." />

    @if (_showCreate)
    {
        <CreateIntegration OnCreated="HandleCreated" OnCancel="@(() => _showCreate = false)"/>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="ShowCreate">Create</MudButton>
        </MudPaper>
    }

    @if (_integrations is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (_integrations.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mt-2">No integrations yet, or you do not have permission to see any.</MudText>
    }
    else
    {
        <MudExpansionPanels>
            @foreach (var i in _integrations)
            {
                <MudExpansionPanel Expanded="@(i.Id == _expandedIntegrationId)"
                                   ExpandedChanged="@(e => HandleExpansionChanged(i.Id, e))">
                    <TitleContent>
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <MudText><b>@i.Name</b> — @i.IntegrationType</MudText>
                                @if (!i.Enabled) { <MudChip T="string" Size="Size.Small" Class="ms-2">disabled</MudChip> }
                                @if (i.IsSuppliedToAllModules) { <MudChip T="string" Size="Size.Small" Class="ms-2">all modules</MudChip> }
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudTooltip Text="Edit Integration">
                            <MudIconButton Icon="@SnapCdIcons.Edit"
                                           Color="@GetColor(i.Id, ShowingType.Edit)" Size="Size.Small"
                                           OnClick="() => SelectShowing(i.Id, ShowingType.Edit)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage Integration Events">
                            <MudIconButton Icon="@SnapCdIcons.Bolt"
                                           Color="@GetColor(i.Id, ShowingType.IntegrationEvents)" Size="Size.Small"
                                           OnClick="() => SelectShowing(i.Id, ShowingType.IntegrationEvents)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage Supplies">
                            <MudIconButton Icon="@SnapCdIcons.Layers"
                                           Color="@GetColor(i.Id, ShowingType.Supplies)" Size="Size.Small"
                                           OnClick="() => SelectShowing(i.Id, ShowingType.Supplies)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage Roles">
                            <MudIconButton Icon="@SnapCdIcons.Shield"
                                           Color="@GetColor(i.Id, ShowingType.Roles)" Size="Size.Small"
                                           OnClick="() => SelectShowing(i.Id, ShowingType.Roles)"/>
                        </MudTooltip>

                        <MudTooltip Text="Test Connection">
                            <MudIconButton Icon="@SnapCdIcons.NetworkCheck"
                                           Color="@GetColor(i.Id, ShowingType.Test)" Size="Size.Small"
                                           OnClick="() => SelectShowing(i.Id, ShowingType.Test)"/>
                        </MudTooltip>

                        <MudTooltip Text="Delete Integration">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => Delete(i.Id)"/>
                        </MudTooltip>

                        @if (IsShowing(i.Id, ShowingType.Edit))
                        {
                            <MudItem Class="mt-2">
                                <EditIntegration IntegrationId="i.Id"
                                                 IntegrationType="i.IntegrationType"
                                                 OnSaved="HandleSaved"/>
                            </MudItem>
                        }

                        @if (IsShowing(i.Id, ShowingType.IntegrationEvents))
                        {
                            <MudItem Class="mt-2">
                                <ManageIntegrationEvents IntegrationId="i.Id"/>
                            </MudItem>
                        }

                        @if (IsShowing(i.Id, ShowingType.Supplies))
                        {
                            <MudItem Class="mt-2">
                                <ManageIntegrationSupplies
                                    IntegrationId="i.Id"
                                    OnClose="HandleSuppliesClosed"/>
                            </MudItem>
                        }

                        @if (IsShowing(i.Id, ShowingType.Test))
                        {
                            <MudItem Class="mt-2">
                                <TestIntegrationConnection
                                    IntegrationId="i.Id"
                                    IntegrationType="i.IntegrationType"
                                    OnClose="HandleTestClosed"/>
                            </MudItem>
                        }

                        @if (IsShowing(i.Id, ShowingType.Roles))
                        {
                            <MudItem Class="mt-2">
                                <ManageIntegrationRoles
                                    IntegrationId="i.Id"
                                    OnCancel="HandleRolesClosed"/>
                            </MudItem>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</CascadingValue>

@code {
    [SupplyParameterFromQuery] public string? Action { get; set; }
    [SupplyParameterFromQuery] public string? Integration { get; set; }

    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;

    private List<IntegrationReadDto>? _integrations;
    private bool _showCreate;
    private Guid? _expandedIntegrationId;
    private Guid? _selectedIntegrationId;
    private ShowingType _showing;

    private enum ShowingType
    {
        None,
        Edit,
        IntegrationEvents,
        Supplies,
        Roles,
        Test
    }

    private Color GetColor(Guid integrationId, ShowingType showTypeToMatch)
    {
        if (_selectedIntegrationId is null) return Color.Primary;
        if (integrationId == _selectedIntegrationId)
            return _showing == showTypeToMatch ? Color.Secondary : Color.Primary;
        return Color.Primary;
    }

    private bool IsShowing(Guid integrationId, ShowingType showTypeToMatch)
    {
        if (_selectedIntegrationId is null) return false;
        return integrationId == _selectedIntegrationId && _showing == showTypeToMatch;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override void OnParametersSet()
    {
        if (_integrations is null) return;

        if (Guid.TryParse(Integration, out var integrationId))
        {
            var match = _integrations.FirstOrDefault(i => i.Id == integrationId);
            if (match is not null)
            {
                _expandedIntegrationId = integrationId;
                if (!string.IsNullOrEmpty(Action) && Enum.TryParse<ShowingType>(Action, ignoreCase: true, out var parsedShowing) && parsedShowing != ShowingType.None)
                {
                    _selectedIntegrationId = integrationId;
                    _showing = parsedShowing;
                }
            }
        }
        else if (!string.IsNullOrEmpty(Action) && Enum.TryParse<ShowingType>(Action, ignoreCase: true, out var parsedShowing) && parsedShowing != ShowingType.None)
        {
            _showing = parsedShowing;
        }
    }


    private async Task HandleCreated()
    {
        _showCreate = false;
        await LoadAsync();
    }

    private async Task HandleSaved()
    {
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _integrations = await Service.List(OrganizationId);
        using (var repo = RepoFactory.Create())
        {
        }
    }

    private async Task HandleExpansionChanged(Guid integrationId, bool expanded)
    {
        if (expanded)
        {
            _expandedIntegrationId = integrationId;
        }
        else if (_expandedIntegrationId == integrationId)
        {
            _expandedIntegrationId = null;
            if (_selectedIntegrationId == integrationId)
            {
                _selectedIntegrationId = null;
                _showing = ShowingType.None;
            }
        }
        UpdateUrl();
    }

    private void HandleTestClosed()
    {
        _selectedIntegrationId = null;
        _showing = ShowingType.None;
        UpdateUrl();
    }

    private void HandleRolesClosed()
    {
        _selectedIntegrationId = null;
        _showing = ShowingType.None;
    }

    private async Task SelectShowing(Guid integrationId, ShowingType showType)
    {
        if (_selectedIntegrationId == integrationId && _showing == showType)
        {
            _selectedIntegrationId = null;
            _showing = ShowingType.None;
        }
        else
        {
            _selectedIntegrationId = integrationId;
            _expandedIntegrationId = integrationId;
            _showing = showType;

        }
        UpdateUrl();
    }

    private void HandleSuppliesClosed()
    {
        _selectedIntegrationId = null;
        _showing = ShowingType.None;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var query = new Dictionary<string, object?>();
        if (_expandedIntegrationId is { } eid) query["integration"] = eid.ToString();
        if (_selectedIntegrationId is not null && _showing != ShowingType.None)
            query["action"] = _showing.ToString().ToLowerInvariant();
        var url = NavigationManager.GetUriWithQueryParameters("/Integrations", query);
        NavigationManager.NavigateTo(url, forceLoad: false, replace: true);
    }

    private void ShowCreate() => _showCreate = true;

    private async Task Delete(Guid id)
    {
        var refusal = Service.CanDelete(id, OrganizationId)
            ? null
            : "You do not have permission to delete this integration.";

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "This permanently deletes the integration and its event subscriptions. This cannot be undone." },
            { x => x.ButtonText, "Delete" },
            { x => x.RefusalReason, refusal }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Integration", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
            return;

        try
        {
            await Service.Delete(id, OrganizationId);
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

}
