@page "/Dashboard"
@layout OrganizationMainLayout
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using SnapCd.Server.Core.Filters
@using SnapCd.Contracts
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Nonsecured
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider

@attribute [Authorize]
@attribute [OrganizationScopedFeature]

@implements IDisposable

@inject IOrganizationContext OrganizationContext
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject ModuleSecuredRepositoryFactory ModuleRepoFactory
@inject ModuleJobSecuredRepositoryFactory JobRepoFactory
@inject StackSecuredRepositoryFactory StackRepoFactory
@inject NamespaceSecuredRepositoryFactory NamespaceRepoFactory
@inject RunnerConnectionRepositoryFactory RunnerConnectionRepoFactory
@inject AgentConnectionRepositoryFactory AgentConnectionRepoFactory
@inject JobCreatedNotificationService JobCreatedNotificationService
@inject JobUpdatedNotificationService JobUpdatedNotificationService
@inject ModuleSagaModifiedNotificationService ModuleSagaModifiedNotificationService
@inject RunnerAvailabilityModifiedNotificationService RunnerAvailabilityModifiedNotificationService
@inject UserFavoriteSecuredRepositoryFactory FavoriteRepoFactory
@inject FavoritesModifiedNotificationService FavoritesModifiedNotificationService

@* Nonsecured repositories: the Modules / Infrastructure / Activity summary cards always
   show organization-wide totals, not what the current user is permitted to see. The
   actionable lists (Needs Attention, Recent Activity, Running, Queued, Starred) stay secured. *@
@inject ModuleRepositoryFactory NonsecuredModuleRepoFactory
@inject ModuleJobRepositoryFactory NonsecuredJobRepoFactory
@inject RunnerRepositoryFactory NonsecuredRunnerRepoFactory
@inject AgentRepositoryFactory NonsecuredAgentRepoFactory
@inject StateStoreRepositoryFactory NonsecuredStateStoreRepoFactory
@inject IntegrationRepositoryFactory NonsecuredIntegrationRepoFactory
@inject StackRepositoryFactory NonsecuredStackRepoFactory
@inject NamespaceRepositoryFactory NonsecuredNamespaceRepoFactory

<PageTitle>Dashboard</PageTitle>

@if (OrganizationId == Guid.Empty)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
        <MudPaper Elevation="2" Class="pa-8" Style="text-align: center;">
            <MudText Typo="Typo.h4" GutterBottom="true">Welcome to Snap CD</MudText>
            <MudText Typo="Typo.body2">Select or create an organization to get started.</MudText>
        </MudPaper>
    </MudContainer>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else
{
    <div class="dash-header">
        <MudText Typo="Typo.h4" Class="dash-title">Dashboard</MudText>
    </div>

    <MudGrid Spacing="4" Class="mb-4">

        <!-- Modules: every module in the organization, grouped by its current state -->
        <MudItem xs="12" md="4">
        <div class="dash-card" style="height: 100%;">
            <div class="dash-card-header">Modules</div>
            <div class="pa-4">
                @if (_fleetTotal == 0)
                {
                    <MudText Typo="Typo.body2">No modules yet. Create a stack, namespace and module to get started.</MudText>
                }
                else
                {
                    <div class="fleet-topline">
                        <span class="fleet-count">@_fleetTotal module@(_fleetTotal == 1 ? "" : "s")</span>
                        <span class="fleet-scope">
                            <a href="/Stacks">@_stackCount stack@(_stackCount == 1 ? "" : "s")</a> · @_namespaceCount namespace@(_namespaceCount == 1 ? "" : "s")
                        </span>
                    </div>
                    <div class="fleet-bar">
                        @foreach (var seg in _fleetSegments)
                        {
                            <div class="fleet-seg" style="width: @seg.Percent; background: @seg.Color;" title="@seg.Count @seg.Label"></div>
                        }
                    </div>
                    <div class="fleet-legend">
                        @foreach (var seg in _fleetSegments)
                        {
                            <span class="fleet-legend-item">
                                <span class="dash-dot" style="background: @seg.Color;"></span>
                                <span class="fleet-n">@seg.Count</span> <span class="fleet-lbl">@seg.Label</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
        </MudItem>

        <!-- Infrastructure -->
        <MudItem xs="12" md="4">
        <div class="dash-card" style="height: 100%;">
            <div class="dash-card-header">Infrastructure</div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/Runners"><span class="attn-n">@_runnerCount</span> runner@(_runnerCount == 1 ? "" : "s")</a></span>
                <span class="attn-sub">@_connectedRunnerCount connected</span>
            </div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/Agents"><span class="attn-n">@_agentCount</span> agent@(_agentCount == 1 ? "" : "s")</a></span>
                <span class="attn-sub">@_connectedAgentCount connected</span>
            </div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/Integrations"><span class="attn-n">@_integrationCount</span> integration@(_integrationCount == 1 ? "" : "s")</a></span>
            </div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/StateStores"><span class="attn-n">@_stateStoreCount</span> state store@(_stateStoreCount == 1 ? "" : "s")</a></span>
            </div>
        </div>
        </MudItem>

        <!-- 7-day activity -->
        <MudItem xs="12" md="4">
        <div class="dash-card" style="height: 100%;">
            <div class="dash-card-header">Activity — Last 7 Days</div>
            <div class="pa-4">
                <div class="week-bars">
                    @foreach (var day in _weekDays)
                    {
                        <div class="week-day @(day.IsToday ? "today" : "")" title="@($"{day.Label}: {day.OkCount} succeeded · {day.FailCount} failed · {day.OtherCount} other")">
                            <div class="week-day-count">@(day.OkCount + day.FailCount + day.OtherCount > 0 ? (day.OkCount + day.FailCount + day.OtherCount).ToString() : "")</div>
                            @if (day.OtherHeight > 0)
                            {
                                <div class="wb wb-other" style="height: @day.OtherHeight%"></div>
                            }
                            @if (day.FailedHeight > 0)
                            {
                                <div class="wb wb-fail" style="height: @day.FailedHeight%"></div>
                            }
                            @if (day.SucceededHeight > 0)
                            {
                                <div class="wb wb-ok" style="height: @day.SucceededHeight%"></div>
                            }
                        </div>
                    }
                </div>
                <div class="week-labels">
                    @foreach (var day in _weekDays)
                    {
                        <span class="@(day.IsToday ? "today" : "")">@day.Label</span>
                    }
                </div>
                <div class="week-legend">
                    <span class="week-legend-item"><span class="dash-dot" style="background: var(--snap-accent, #E85D1A);"></span> succeeded</span>
                    <span class="week-legend-item"><span class="dash-dot dash-dot-error"></span> failed</span>
                    <span class="week-legend-item"><span class="dash-dot dash-dot-neutral"></span> other</span>
                </div>
                <div class="week-caption">
                    <span class="dash-mono">@_weekTotal</span> job@(_weekTotal == 1 ? "" : "s") this week@(_weekSuccessRate != null ? $" · " : "")@if (_weekSuccessRate != null)
                    {
                        <span class="dash-mono">@_weekSuccessRate%</span><span> succeeded</span>
                    }
                </div>
            </div>
        </div>
        </MudItem>
    </MudGrid>

    <div class="dash-col">

            <!-- Starred -->
            <div class="dash-card">
                <div class="dash-card-header">
                    Starred
                    @if (_favorites.Any())
                    {
                        <span class="dash-count-chip">@_favorites.Count</span>
                    }
                </div>
                @if (!_favorites.Any())
                {
                    <div class="attn-row">
                        <MudIcon Icon="@SnapCdIcons.Star" Size="Size.Small" Style="color: var(--mud-palette-text-secondary);"/>
                        <span class="attn-main" style="color: var(--mud-palette-text-secondary);">Star modules, namespaces or stacks to pin them here.</span>
                    </div>
                }
                else
                {
                    FavoriteTargetType? previousFavoriteType = null;
                    @foreach (var favorite in Page(_favorites, _starredPage))
                    {
                        @if (favorite.TargetType != previousFavoriteType)
                        {
                            previousFavoriteType = favorite.TargetType;
                            <div class="attn-subheading">@GetFavoriteGroupLabel(favorite.TargetType)</div>
                        }

                        <div class="attn-row">
                            <MudIcon Icon="@GetFavoriteIcon(favorite.TargetType)" Size="Size.Small" Style="color: var(--snap-accent, #E85D1A);"/>
                            <span class="attn-main">
                                @switch (favorite.TargetType)
                                {
                                    case FavoriteTargetType.Module:
                                        @PathLinks(favorite.StackName, favorite.NamespaceName!, favorite.ModuleName!)
                                        break;
                                    case FavoriteTargetType.Namespace:
                                        <span class="dash-path"><a href="@($"/Stack/{favorite.StackName}")">@favorite.StackName</a><span class="dash-path-sep">/</span><a href="@($"/Namespace/{favorite.StackName}/{favorite.NamespaceName}")">@favorite.NamespaceName</a></span>
                                        break;
                                    default:
                                        <span class="dash-path"><a href="@($"/Stack/{favorite.StackName}")">@favorite.StackName</a></span>
                                        break;
                                }
                            </span>
                            @if (favorite.ModuleFleetState != null)
                            {
                                <span class="attn-sub">
                                    <span class="dash-dot @GetFleetStateDotClass(favorite.ModuleFleetState.Value)" style="margin-right: 4px;"></span>@GetFleetStateLabel(favorite.ModuleFleetState.Value)
                                </span>
                            }
                            <span class="row-star">
                                <MudTooltip Text="Unstar">
                                    <MudIconButton Icon="@SnapCdIcons.Star" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => Unstar(favorite))"/>
                                </MudTooltip>
                            </span>
                        </div>
                    }
                    @if (_favorites.Count > DashboardPageSize)
                    {
                        <div class="dash-pagination">
                            <Pagination CurrentPage="_starredPage" TotalPages="PageCount(_favorites.Count)" PageChanged="@(p => _starredPage = p)"/>
                        </div>
                    }
                }
            </div>

            <!-- Needs attention -->
            <div class="dash-card">
                <div class="dash-card-header">
                    Needs Attention
                    @if (AttentionCount > 0)
                    {
                        <span class="dash-count-chip">@AttentionCount</span>
                    }
                </div>

                @if (_attentionItems.Any())
                {
                    AttentionKind? previousKind = null;
                    @foreach (var item in Page(_attentionItems, _attentionPage))
                    {
                        @if (item.Kind != previousKind)
                        {
                            previousKind = item.Kind;
                            <div class="attn-subheading">@GetAttentionKindLabel(item.Kind)</div>
                        }

                        @switch (item.Kind)
                        {
                            case AttentionKind.Approval:
                                <div class="attn-row">
                                    <span class="dash-dot dash-dot-accent"></span>
                                    <span class="attn-main">
                                        @FormatJobType(item.Approval!.JobType) @PathLinks(item.Approval.StackName, item.Approval.NamespaceName, item.Approval.ModuleName)
                                    </span>
                                    <span class="attn-sub">
                                        waiting @FormatWaitTime(item.Approval.TimestampStart) ·
                                        <a class="attn-action" href="@($"{ModuleUrl(item.Approval.StackName, item.Approval.NamespaceName, item.Approval.ModuleName)}?Job={item.Approval.JobId}&Tab=approvals")">review Job #@item.Approval.JobNumber →</a>
                                    </span>
                                </div>
                                break;
                            case AttentionKind.Failed:
                                <div class="attn-row">
                                    <span class="dash-dot dash-dot-accent"></span>
                                    <span class="attn-main">@PathLinks(item.Module!.StackName, item.Module.NamespaceName, item.Module.Name)</span>
                                    <span class="attn-sub">@FormatActualState(item.Module.ActualState)</span>
                                </div>
                                break;
                            default:
                                <div class="attn-row">
                                    <span class="dash-dot dash-dot-accent"></span>
                                    <span class="attn-main"><a class="dash-mono" href="/Runners">@item.RunnerName</a> has no connected instances</span>
                                </div>
                                break;
                        }
                    }
                    @if (_attentionItems.Count > DashboardPageSize)
                    {
                        <div class="dash-pagination">
                            <Pagination CurrentPage="_attentionPage" TotalPages="PageCount(_attentionItems.Count)" PageChanged="@(p => _attentionPage = p)"/>
                        </div>
                    }
                }
                else
                {
                    <div class="attn-row">
                        <span class="dash-dot dash-dot-success"></span>
                        <span class="attn-main">Nothing needs your attention.</span>
                    </div>
                }
            </div>

            <!-- Recent activity -->
            <div class="dash-card">
                <div class="dash-card-header">Recent Activity</div>
                @if (!_activityHasAny)
                {
                    <div class="attn-row"><span class="attn-main">No jobs have run yet.</span></div>
                }
                else
                {
                    <table class="dash-table">
                        <thead>
                        <tr>
                            <th>Status</th>
                            <th>Job</th>
                            <th>Module</th>
                            <th>Action</th>
                            <th>When</th>
                            <th>Duration</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var job in CurrentActivityRows)
                        {
                            <tr>
                                <td>
                                    <span class="dash-status">
                                        <span class="dash-dot @GetJobDotClass(job)"></span> @GetJobStatusLabel(job)
                                    </span>
                                </td>
                                <td class="dash-mono">
                                    <a href="@($"{ModuleUrl(job.StackName, job.NamespaceName, job.ModuleName)}?Job={job.JobId}")">#@job.JobNumber</a>
                                </td>
                                <td>@PathLinks(job.StackName, job.NamespaceName, job.ModuleName)</td>
                                <td>@FormatJobType(job.JobType)</td>
                                <td>@FormatTimeAgo(job.TimestampStart)</td>
                                <td class="dash-mono">@(FormatDuration(job.TimestampStart, job.TimestampEnd) ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if (_activityTotalPages > 1)
                    {
                        <div class="dash-pagination">
                            <Pagination CurrentPage="_activityPage" TotalPages="_activityTotalPages" PageChanged="OnActivityPageChanged"/>
                        </div>
                    }
                }
            </div>

            <!-- Running now -->
            @if (_runningModules.Any())
            {
                <div class="dash-card">
                    <div class="dash-card-header">Running Now <span class="dash-count-chip">@_runningModules.Count</span></div>
                    @foreach (var module in Page(_runningModules, _runningPage))
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-running"></span>
                            <span class="attn-main">@PathLinks(module.StackName, module.NamespaceName, module.Name)</span>
                            @if (module.CurrentJobStart != null)
                            {
                                <span class="attn-sub dash-mono">@(FormatDuration(module.CurrentJobStart.Value, null))</span>
                            }
                        </div>
                    }
                    @if (_runningModules.Count > DashboardPageSize)
                    {
                        <div class="dash-pagination">
                            <Pagination CurrentPage="_runningPage" TotalPages="PageCount(_runningModules.Count)" PageChanged="@(p => _runningPage = p)"/>
                        </div>
                    }
                </div>
            }

            <!-- Queued -->
            @if (_queuedModules.Any())
            {
                <div class="dash-card">
                    <div class="dash-card-header">Queued <span class="dash-count-chip">@_queuedModules.Count</span></div>
                    @foreach (var module in Page(_queuedModules, _queuedPage))
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-accent"></span>
                            <span class="attn-main">@PathLinks(module.StackName, module.NamespaceName, module.Name)</span>
                            <span class="attn-sub">@FormatQueuedReason(module.QueuedReasonValue)</span>
                        </div>
                    }
                    @if (_queuedModules.Count > DashboardPageSize)
                    {
                        <div class="dash-pagination">
                            <Pagination CurrentPage="_queuedPage" TotalPages="PageCount(_queuedModules.Count)" PageChanged="@(p => _queuedPage = p)"/>
                        </div>
                    }
                </div>
            }
    </div>
}

<style>
    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
    }

    .dash-title {
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .dash-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    .dash-dot-success { background: var(--mud-palette-success); }
    .dash-dot-error { background: var(--mud-palette-error); }
    .dash-dot-warning { background: var(--mud-palette-warning); }
    .dash-dot-neutral { background: var(--snap-fog, #8B96A0); }
    .dash-dot-accent { background: var(--snap-accent, #E85D1A); }

    @@keyframes dash-pulse {
        0% { box-shadow: 0 0 0 0 rgba(232, 93, 26, 0.45); }
        70% { box-shadow: 0 0 0 6px rgba(232, 93, 26, 0); }
        100% { box-shadow: 0 0 0 0 rgba(232, 93, 26, 0); }
    }

    .dash-dot-running {
        background: var(--snap-accent, #E85D1A);
        animation: dash-pulse 2s infinite;
    }

    .dash-card {
        background: var(--mud-palette-surface);
        box-shadow: var(--mud-elevation-1);
        overflow: hidden;
    }

    .dash-card-header {
        padding: 12px 16px;
        font-family: var(--snap-font-mono, monospace);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #E8ECEF;
        background: var(--snap-ink, #12171D);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dash-count-chip {
        background: var(--snap-accent, #E85D1A);
        color: var(--snap-on-accent, #FFFFFF);
        font-weight: 600;
        padding: 0 7px;
        line-height: 16px;
        font-size: 11px;
    }

    .dash-mono {
        font-family: var(--snap-font-mono, monospace);
        font-size: 13px;
    }

    .dash-path {
        font-family: var(--snap-font-mono, monospace);
        font-size: 13px;
    }

    .dash-path a {
        color: var(--mud-palette-text-primary);
    }

    .dash-path a:hover {
        color: var(--snap-accent, #E85D1A);
        text-decoration: underline;
    }

    .dash-path-sep {
        color: var(--mud-palette-text-secondary);
    }

    .attn-action {
        color: var(--snap-accent, #E85D1A);
    }

    .fleet-topline {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .fleet-count { font-size: 15px; font-weight: 600; }

    .fleet-scope {
        font-size: 12px;
        color: var(--mud-palette-text-secondary);
    }

    .fleet-scope a { color: var(--mud-palette-text-secondary); }
    .fleet-scope a:hover { color: var(--snap-accent, #E85D1A); }

    .fleet-bar {
        display: flex;
        height: 12px;
        width: 100%;
        background: var(--mud-palette-background-grey);
        overflow: hidden;
    }

    .fleet-seg { height: 100%; }
    .fleet-seg + .fleet-seg { margin-left: 2px; }

    .fleet-legend {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .fleet-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 14px;
    }

    .fleet-n { font-weight: 700; }
    .fleet-lbl { color: var(--mud-palette-text-secondary); }

    .dash-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-width: 0;
    }

    .dash-pagination {
        padding: 6px 12px;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .attn-subheading {
        padding: 10px 16px 4px;
        font-family: var(--snap-font-mono, monospace);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--mud-palette-text-secondary);
    }

    .attn-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        font-size: 14px;
    }

    .attn-row:last-child { border-bottom: none; }

    .attn-main {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--mud-palette-text-primary);
    }

    .attn-main a { color: var(--mud-palette-text-primary); }
    .attn-main a:hover { color: var(--snap-accent, #E85D1A); text-decoration: underline; }

    .attn-sub {
        font-size: 12px;
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
    }

    .attn-n { font-weight: 700; }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dash-table th {
        text-align: left;
        padding: 8px 16px;
        font-family: var(--snap-font-mono, monospace);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #E8ECEF;
        background: var(--snap-ink, #12171D);
        white-space: nowrap;
    }

    .dash-table td {
        padding: 10px 16px;
        font-size: 14px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        vertical-align: middle;
    }

    .dash-table tr:last-child td { border-bottom: none; }
    .dash-table tr:hover td { background: var(--mud-palette-background-grey); }
    .dash-table a { color: var(--mud-palette-text-primary); }
    .dash-table a:hover { color: var(--snap-accent, #E85D1A); text-decoration: underline; }

    .dash-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .week-bars {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        height: 72px;
    }

    .week-day {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 2px;
        height: 100%;
    }

    .wb { width: 100%; }
    .wb-ok { background: var(--mud-palette-success); opacity: 0.75; }
    .wb-fail { background: var(--mud-palette-error); }
    .wb-other { background: var(--snap-fog, #8B96A0); opacity: 0.55; }
    .week-day.today .wb-ok { opacity: 1; }

    .week-labels { display: flex; gap: 8px; margin-top: 6px; }

    .week-labels span {
        flex: 1;
        text-align: center;
        font-family: var(--snap-font-mono, monospace);
        font-size: 10px;
        font-weight: 500;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
    }

