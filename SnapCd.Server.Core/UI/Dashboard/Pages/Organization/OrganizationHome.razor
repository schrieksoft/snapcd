@page "/Home"
@layout OrganizationMainLayout
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using SnapCd.Contracts
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Repositories.Organizations.Nonsecured
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider

@attribute [Authorize]

@implements IDisposable

@inject IOrganizationContext OrganizationContext
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject ModuleSecuredRepositoryFactory ModuleRepoFactory
@inject ModuleJobSecuredRepositoryFactory JobRepoFactory
@inject StackSecuredRepositoryFactory StackRepoFactory
@inject NamespaceSecuredRepositoryFactory NamespaceRepoFactory
@inject RunnerSecuredRepositoryFactory RunnerRepoFactory
@inject AgentSecuredRepositoryFactory AgentRepoFactory
@inject StateStoreSecuredRepositoryFactory StateStoreRepoFactory
@inject IntegrationSecuredRepositoryFactory IntegrationRepoFactory
@inject RunnerConnectionRepositoryFactory RunnerConnectionRepoFactory
@inject AgentConnectionRepositoryFactory AgentConnectionRepoFactory
@inject JobCreatedNotificationService JobCreatedNotificationService
@inject JobUpdatedNotificationService JobUpdatedNotificationService
@inject ModuleSagaModifiedNotificationService ModuleSagaModifiedNotificationService
@inject RunnerAvailabilityModifiedNotificationService RunnerAvailabilityModifiedNotificationService

<PageTitle>Dashboard</PageTitle>

@if (OrganizationId == Guid.Empty)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
        <MudPaper Elevation="2" Class="pa-8" Style="text-align: center;">
            <MudText Typo="Typo.h4" GutterBottom="true">Welcome to Snap CD</MudText>
            <MudText Typo="Typo.body2">Select or create an organization to get started.</MudText>
        </MudPaper>
    </MudContainer>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else
{
    <div class="dash-header">
        <MudText Typo="Typo.h4" Class="dash-title">Dashboard</MudText>
    </div>

    <MudGrid Spacing="4" Class="mb-4">

        <!-- Modules: every module in the organization, grouped by its current state -->
        <MudItem xs="12" md="4">
        <div class="dash-card" style="height: 100%;">
            <div class="dash-card-header">Modules</div>
            <div class="pa-4">
                @if (_modules.Count == 0)
                {
                    <MudText Typo="Typo.body2">No modules yet. Create a stack, namespace and module to get started.</MudText>
                }
                else
                {
                    <div class="fleet-topline">
                        <span class="fleet-count">@_modules.Count module@(_modules.Count == 1 ? "" : "s")</span>
                        <span class="fleet-scope">
                            <a href="/Stacks">@_stackCount stack@(_stackCount == 1 ? "" : "s")</a> · @_namespaceCount namespace@(_namespaceCount == 1 ? "" : "s")
                        </span>
                    </div>
                    <div class="fleet-bar">
                        @foreach (var seg in _fleetSegments)
                        {
                            <div class="fleet-seg" style="width: @seg.Percent; background: @seg.Color;" title="@seg.Count @seg.Label"></div>
                        }
                    </div>
                    <div class="fleet-legend">
                        @foreach (var seg in _fleetSegments)
                        {
                            <span class="fleet-legend-item">
                                <span class="dash-dot" style="background: @seg.Color;"></span>
                                <span class="fleet-n">@seg.Count</span> <span class="fleet-lbl">@seg.Label</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
        </MudItem>

        <!-- Infrastructure -->
        <MudItem xs="12" md="4">
        <div class="dash-card" style="height: 100%;">
            <div class="dash-card-header">Infrastructure</div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/Runners"><span class="attn-n">@_runnerCount</span> runner@(_runnerCount == 1 ? "" : "s")</a></span>
                <span class="attn-sub">@_connectedRunnerCount connected</span>
            </div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/Agents"><span class="attn-n">@_agentCount</span> agent@(_agentCount == 1 ? "" : "s")</a></span>
                <span class="attn-sub">@_connectedAgentCount connected</span>
            </div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/Integrations"><span class="attn-n">@_integrationCount</span> integration@(_integrationCount == 1 ? "" : "s")</a></span>
            </div>
            <div class="attn-row">
                <span class="dash-dot dash-dot-accent"></span>
                <span class="attn-main"><a href="/StateStores"><span class="attn-n">@_stateStoreCount</span> state store@(_stateStoreCount == 1 ? "" : "s")</a></span>
            </div>
        </div>
        </MudItem>

        <!-- 7-day activity -->
        <MudItem xs="12" md="4">
        <div class="dash-card" style="height: 100%;">
            <div class="dash-card-header">Activity — Last 7 Days</div>
            <div class="pa-4">
                <div class="week-bars">
                    @foreach (var day in _weekDays)
                    {
                        <div class="week-day @(day.IsToday ? "today" : "")">
                            @if (day.FailedHeight > 0)
                            {
                                <div class="wb wb-fail" style="height: @day.FailedHeight%"></div>
                            }
                            @if (day.SucceededHeight > 0)
                            {
                                <div class="wb wb-ok" style="height: @day.SucceededHeight%"></div>
                            }
                        </div>
                    }
                </div>
                <div class="week-labels">
                    @foreach (var day in _weekDays)
                    {
                        <span class="@(day.IsToday ? "today" : "")">@day.Label</span>
                    }
                </div>
                <div class="week-caption">
                    <span class="dash-mono">@_weekTotal</span> job@(_weekTotal == 1 ? "" : "s") this week@(_weekSuccessRate != null ? $" · " : "")@if (_weekSuccessRate != null)
                    {
                        <span class="dash-mono">@_weekSuccessRate%</span><span> succeeded</span>
                    }
                </div>
            </div>
        </div>
        </MudItem>
    </MudGrid>

    <div class="dash-col">

            <!-- Needs attention -->
            <div class="dash-card">
                <div class="dash-card-header">
                    Needs Attention
                    @if (AttentionCount > 0)
                    {
                        <span class="dash-count-chip">@AttentionCount</span>
                    }
                </div>

                @if (_pendingApprovals.Any())
                {
                    <div class="attn-subheading">Approval required</div>
                    @foreach (var approval in _pendingApprovals)
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-accent"></span>
                            <span class="attn-main">
                                @FormatJobType(approval.JobType) @PathLinks(approval.StackName, approval.NamespaceName, approval.ModuleName)
                            </span>
                            <span class="attn-sub">
                                waiting @FormatWaitTime(approval.TimestampStart) ·
                                <a class="attn-action" href="@($"{ModuleUrl(approval.StackName, approval.NamespaceName, approval.ModuleName)}?Job={approval.JobId}&Tab=approvals")">review Job #@approval.JobNumber →</a>
                            </span>
                        </div>
                    }
                }

                @if (_failedModules.Any())
                {
                    <div class="attn-subheading">Failed</div>
                    @foreach (var module in _failedModules)
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-error"></span>
                            <span class="attn-main">@PathLinks(module.StackName, module.NamespaceName, module.Name)</span>
                            <span class="attn-sub">@FormatActualState(module.ActualState)</span>
                        </div>
                    }
                }

                @if (_outOfSyncModules.Any())
                {
                    <div class="attn-subheading">Out of sync</div>
                    @foreach (var module in _outOfSyncModules)
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-warning"></span>
                            <span class="attn-main">@PathLinks(module.StackName, module.NamespaceName, module.Name)</span>
                            <span class="attn-sub">source ahead of deployed revision</span>
                        </div>
                    }
                }

                @if (_runnersWithoutInstances.Any())
                {
                    <div class="attn-subheading">Runners</div>
                    @foreach (var runner in _runnersWithoutInstances)
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-neutral"></span>
                            <span class="attn-main"><a class="dash-mono" href="/Runners">@runner</a> has no connected instances</span>
                        </div>
                    }
                }

                @if (AttentionCount == 0)
                {
                    <div class="attn-row">
                        <span class="dash-dot dash-dot-success"></span>
                        <span class="attn-main">Nothing needs your attention.</span>
                    </div>
                }
            </div>

            <!-- Recent activity -->
            <div class="dash-card">
                <div class="dash-card-header">Recent Activity</div>
                @if (_recentJobs.Count == 0)
                {
                    <div class="attn-row"><span class="attn-main">No jobs have run yet.</span></div>
                }
                else
                {
                    <table class="dash-table">
                        <thead>
                        <tr>
                            <th>Status</th>
                            <th>Job</th>
                            <th>Module</th>
                            <th>Action</th>
                            <th>When</th>
                            <th>Duration</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var job in _recentJobs)
                        {
                            <tr>
                                <td>
                                    <span class="dash-status">
                                        <span class="dash-dot @GetJobDotClass(job)"></span> @GetJobStatusLabel(job)
                                    </span>
                                </td>
                                <td class="dash-mono">
                                    <a href="@($"{ModuleUrl(job.StackName, job.NamespaceName, job.ModuleName)}?Job={job.JobId}")">#@job.JobNumber</a>
                                </td>
                                <td>@PathLinks(job.StackName, job.NamespaceName, job.ModuleName)</td>
                                <td>@FormatJobType(job.JobType)</td>
                                <td>@FormatTimeAgo(job.TimestampStart)</td>
                                <td class="dash-mono">@(FormatDuration(job.TimestampStart, job.TimestampEnd) ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            <!-- Running now -->
            @if (_runningModules.Any())
            {
                <div class="dash-card">
                    <div class="dash-card-header">Running Now <span class="dash-count-chip">@_runningModules.Count</span></div>
                    @foreach (var module in _runningModules)
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-running"></span>
                            <span class="attn-main">@PathLinks(module.StackName, module.NamespaceName, module.Name)</span>
                            @if (module.CurrentJobStart != null)
                            {
                                <span class="attn-sub dash-mono">@(FormatDuration(module.CurrentJobStart.Value, null))</span>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Queued -->
            @if (_queuedModules.Any())
            {
                <div class="dash-card">
                    <div class="dash-card-header">Queued <span class="dash-count-chip dash-chip-neutral">@_queuedModules.Count</span></div>
                    @foreach (var module in _queuedModules)
                    {
                        <div class="attn-row">
                            <span class="dash-dot dash-dot-neutral"></span>
                            <span class="attn-main">@PathLinks(module.StackName, module.NamespaceName, module.Name)</span>
                            <span class="attn-sub">@FormatQueuedReason(module.QueuedReasonValue)</span>
                        </div>
                    }
                </div>
            }
    </div>
}

