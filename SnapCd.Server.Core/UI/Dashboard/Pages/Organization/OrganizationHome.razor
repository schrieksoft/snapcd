    private async Task LoadWeekActivity()
    {
        var cutoff = DateTimeOffset.UtcNow.Date.AddDays(-6);
        using var jobRepo = JobRepoFactory.Create(Principal());
        var jobs = await jobRepo.List(OrganizationId, q => q
            .Where(j => j.TimestampStart >= cutoff)
            .Select(j => new WeekJob { TimestampStart = j.TimestampStart, Status = j.Status }));

        _weekTotal = jobs.Count;
        var succeeded = jobs.Count(j => j.Status == ExecutionStatus.Completed);
        var failed = jobs.Count(j => j.Status == ExecutionStatus.Failed);
        _weekSuccessRate = succeeded + failed > 0 ? (int)Math.Round(100.0 * succeeded / (succeeded + failed)) : null;

        var byDay = jobs
            .GroupBy(j => j.TimestampStart.UtcDateTime.Date)
            .ToDictionary(g => g.Key, g => (Ok: g.Count(j => j.Status == ExecutionStatus.Completed), Fail: g.Count(j => j.Status == ExecutionStatus.Failed)));

        var maxCount = byDay.Values.Select(v => v.Ok + v.Fail).DefaultIfEmpty(0).Max();

        _weekDays = Enumerable.Range(0, 7)
            .Select(i =>
            {
                var date = DateTime.UtcNow.Date.AddDays(i - 6);
                byDay.TryGetValue(date, out var counts);
                return new WeekDay
                {
                    Label = date.ToString("ddd", CultureInfo.InvariantCulture),
                    IsToday = i == 6,
                    SucceededHeight = maxCount > 0 ? (int)Math.Round(90.0 * counts.Ok / maxCount) : 0,
                    FailedHeight = maxCount > 0 ? (int)Math.Round(90.0 * counts.Fail / maxCount) : 0
                };
            })
            .ToList();
    }

    private async Task LoadInfrastructure()
    {
        using var runnerRepo = RunnerRepoFactory.Create(Principal());
        var runners = await runnerRepo.List(OrganizationId, q => q.Select(r => new RunnerRow { Id = r.Id, Name = r.Name, IsDisabled = r.IsDisabled }));
        _runnerCount = runners.Count;
        _runnerIds = runners.Select(r => r.Id).ToList();

        using var connectionRepo = RunnerConnectionRepoFactory.Create();
        _connectedRunnerCount = 0;
        _runnersWithoutInstances = new List<string>();
        foreach (var runner in runners)
        {
            var connections = await connectionRepo.GetActiveConnectionsByRunnerId(runner.Id, OrganizationId);
            if (connections.Count > 0)
                _connectedRunnerCount++;
            else if (!runner.IsDisabled)
                _runnersWithoutInstances.Add(runner.Name);
        }

        using var agentRepo = AgentRepoFactory.Create(Principal());
        var agents = await agentRepo.List(OrganizationId, q => q.Select(a => new RunnerRow { Id = a.Id, Name = a.Name, IsDisabled = a.IsDisabled }));
        _agentCount = agents.Count;

        using var agentConnectionRepo = AgentConnectionRepoFactory.Create();
        _connectedAgentCount = 0;
        foreach (var agent in agents)
        {
            var connections = await agentConnectionRepo.GetActiveConnectionsByAgentId(agent.Id, OrganizationId);
            if (connections.Count > 0)
                _connectedAgentCount++;
        }

        using var stateStoreRepo = StateStoreRepoFactory.Create(Principal());
        _stateStoreCount = await stateStoreRepo.Count(OrganizationId);

        using var integrationRepo = IntegrationRepoFactory.Create(Principal());
        _integrationCount = await integrationRepo.Count(OrganizationId);
    }

