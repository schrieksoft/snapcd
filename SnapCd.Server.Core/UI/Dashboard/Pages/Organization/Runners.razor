@page "/Runners"
@layout OrganizationMainLayout

@implements IDisposable


@* TODO, move this to Account/Pages/Manage and add to nav menu Account/Shared/ManageNavMenu.razor. For some reason when in that location the buttons do not work! *@

@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@inject OrganizationServiceFactory OrganizationServiceFactory
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject IOrganizationContext OrganizationContext

@using Microsoft.AspNetCore.Authorization
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Server.Core.UI.Dashboard.Components.Runner
@using SnapCd.Server.Core.UI.Dashboard.Dialogs.Runners
@using SnapCd.Server.Core.UI.Dashboard.Components.RunnerSupplies
@using SnapCd.Server.Core.UI.Dashboard.Components.Roles

@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@attribute [OrganizationScopedFeature]
<PageTitle>Runners</PageTitle>

<CascadingValue Value="OrganizationId">
    <MudText Typo="Typo.h4" GutterBottom="true">Runners</MudText>

    @if (_showCreateRunner)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <CreateRunner OnCreated="HandleRunnerCreated"
                          OnCancel="HandleCancelCreate"/>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       OnClick="ShowCreateRunner">
                Create
            </MudButton>
        </MudPaper>
    }

    @if (_runners == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    }
    else
    {
        <MudExpansionPanels>
            @foreach (var runner in _runners)
            {
                <MudExpansionPanel Expanded="@(runner.Id == _expandedId)"
                                   ExpandedChanged="@(e => HandleExpansionChanged(runner.Id, e))">
                    <TitleContent>
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <MudText>@runner.Name</MudText>
                                @if (runner.IsDisabled)
                                {
                                    <MudChip T="string" Color="Color.Error" Text="Disabled" Size="Size.Small"/>
                                }
                                <RunnerOnlineBadge RunnerId="runner.Id" OrganizationId="OrganizationId" />
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (!runner.IsDisabled)
                        {
                            <MudTooltip Text="Runner is enabled, click to disable">
                                <MudIconButton Icon="@SnapCdIcons.PlayDisabled" Color="Color.Primary"
                                               Size="Size.Small" OnClick="() => DeactivateRunner(runner)"/>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Runner is disabled, click to enable">
                                <MudIconButton Icon="@SnapCdIcons.PlayArrow" Color="Color.Primary"
                                                                             Size="Size.Small" OnClick="() => ActivateRunner(runner)"/>
                            </MudTooltip>
                        }

                        <MudTooltip Text="Edit Runner">
                            <MudIconButton Icon="@SnapCdIcons.Edit"
                                           Color="@GetColor(runner.Id, ShowingType.Edit)" Size="Size.Small"
                                           OnClick="() => Select(runner, ShowingType.Edit)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage Where Runner can be used from">
                            <MudIconButton Icon="@SnapCdIcons.Layers"
                                           Color="@GetColor(runner.Id, ShowingType.Supplies)" Size="Size.Small"
                                           OnClick="() => Select(runner, ShowingType.Supplies)"/>
                        </MudTooltip>

                        <MudTooltip Text="Manage Roles">
                            <MudIconButton Icon="@SnapCdIcons.Shield"
                                           Color="@GetColor(runner.Id, ShowingType.Roles)" Size="Size.Small"
                                           OnClick="() => Select(runner, ShowingType.Roles)"/>
                        </MudTooltip>

                        <MudTooltip Text="Delete Runner">
                            <MudIconButton Icon="@SnapCdIcons.Delete" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => Delete(runner)"/>
                        </MudTooltip>

                        @if (IsShowing(runner.Id, ShowingType.Edit))
                        {
                            <MudItem Class="mt-2">
                                <EditRunner Runner="_selectedRunner"
                                                OnSaved="HandleRunnerSaved"
                                                OnCancel="HandleCancelEdit"/>
                            </MudItem>
                        }

                        @if (IsShowing(runner.Id, ShowingType.Supplies))
                        {
                            <MudItem Class="mt-2">
                                <ManageRunnerSupplies
                                    RunnerId=runner.Id
                                    OnClose="HandleSuppliesClosed"/>
                            </MudItem>
                        }

                        @if (IsShowing(runner.Id, ShowingType.Roles))
                        {
                            <MudItem Class="mt-2">
                                <ManageRunnerRoles
                                    RunnerId="runner.Id"
                                    OnCancel="HandleRolesClosed"/>
                            </MudItem>
                        }

                    </ChildContent>
                </MudExpansionPanel>
            }

        </MudExpansionPanels>
    }
</CascadingValue>



@code {
    [Inject] private RunnerSecuredRepositoryFactory RepoFactory { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    [SupplyParameterFromQuery] public string? Runner { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }

    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;

    private List<Entities.Definition.Runner>? _runners;
    private bool _showCreateRunner;
    private Entities.Definition.Runner? _selectedRunner;
    private Guid? _expandedId;
    private ShowingType _showing;

    private enum ShowingType
    {
        None,
        Edit,
        Supplies,
        Roles
    }

    private Color GetColor(Guid runnerId, ShowingType showTypeToMatch)
    {
        if (_selectedRunner == null)
            return Color.Primary;
        if (runnerId == _selectedRunner.Id)
            return _showing == showTypeToMatch ? Color.Secondary : Color.Primary;
        return Color.Primary;
    }

    private bool IsShowing(Guid runnerId, ShowingType showTypeToMatch)
    {
        if (_selectedRunner == null)
            return false;
        return runnerId == _selectedRunner.Id && _showing == showTypeToMatch;
    }

    private void ShowCreateRunner()
    {
        _showCreateRunner = true;
    }

    private async Task HandleRunnerCreated(Guid runnerId)
    {
        _showCreateRunner = false;
        await ReloadRunners();
    }

    private void HandleSuppliesClosed() => ClearSelection();

    private void HandleCancelCreate()
    {
        _showCreateRunner = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadRunners();
    }

    protected override void OnParametersSet()
    {
        if (_runners is null) return;
        if (Guid.TryParse(Runner, out var id))
        {
            var match = _runners.FirstOrDefault(r => r.Id == id);
            if (match is not null)
            {
                _expandedId = id;
                if (!string.IsNullOrEmpty(Action)
                    && Enum.TryParse<ShowingType>(Action, ignoreCase: true, out var parsed)
                    && parsed != ShowingType.None)
                {
                    _selectedRunner = match;
                    _showing = parsed;
                }
            }
        }
    }

    private void HandleExpansionChanged(Guid id, bool expanded)
    {
        if (expanded)
        {
            _expandedId = id;
        }
        else if (_expandedId == id)
        {
            _expandedId = null;
            if (_selectedRunner?.Id == id)
            {
                _selectedRunner = null;
                _showing = ShowingType.None;
            }
        }
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var query = new Dictionary<string, object?>();
        if (_expandedId is { } eid) query["runner"] = eid.ToString();
        if (_selectedRunner is not null && _showing != ShowingType.None)
            query["action"] = _showing.ToString().ToLowerInvariant();
        var url = NavigationManager.GetUriWithQueryParameters("/Runners", query);
        NavigationManager.NavigateTo(url, forceLoad: false, replace: true);
    }

    private void Select(Entities.Definition.Runner entity, ShowingType action)
    {
        _selectedRunner = entity;
        _expandedId = entity.Id;
        _showing = action;
        UpdateUrl();
    }

    private void ClearSelection()
    {
        _selectedRunner = null;
        _showing = ShowingType.None;
        UpdateUrl();
    }

    private async Task ReloadRunners()
    {
        using var repo = RepoFactory.Create();
        _runners = await repo.List(OrganizationId);
    }

    private async Task Delete(Entities.Definition.Runner runner)
    {
        var parameters = new DialogParameters<DeleteRunnerDialog>
        {
            { x => x.Runner, runner },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeleteRunnerDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var runnerId);
            Snackbar.Add($"Successfully deleted Runner \"{runnerId}\"", Severity.Success);
            await ReloadRunners();
        }
    }

    private async Task HandleRunnerSaved(Entities.Definition.Runner runner)
    {
        ClearSelection();
        await ReloadRunners();
    }

    private void HandleCancelEdit() => ClearSelection();

    private void HandleRolesClosed() => ClearSelection();

    private async Task ActivateRunner(Entities.Definition.Runner runner)
    {
        var parameters = new DialogParameters<ActivateRunnerDialog>
        {
            { x => x.Runner, runner },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ActivateRunnerDialog>("Activate", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var activatedRunnerId);
            Snackbar.Add($"Successfully activated Runner \"{activatedRunnerId}\"", Severity.Success);
            await ReloadRunners();
        }
    }

    private async Task DeactivateRunner(Entities.Definition.Runner runner)
    {
        var parameters = new DialogParameters<DeactivateRunnerDialog>
        {
            { x => x.Runner, runner },
            { x => x.OrganizationId, OrganizationId }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DeactivateRunnerDialog>("Deactivate", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Guid.TryParse(result.Data?.ToString(), out var deactivatedRunnerId);
            Snackbar.Add($"Successfully deactivated Runner \"{deactivatedRunnerId}\"", Severity.Success);
            await ReloadRunners();
        }
    }

    public void Dispose()
    {
    }


}