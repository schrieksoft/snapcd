</style>

@code {
    private User _user = default!;
    private string? _username;
    private bool _hasPassword;
    private bool _hasAuthenticator;
    private bool _is2FaEnabled;
    private int _recoveryCodesLeft = -1;
    private IList<UserLoginInfo>? _currentLogins;
    private IList<AuthenticationScheme>? _otherLogins;
    private string? _statusMessage;
    private Severity _statusSeverity = Severity.Info;
    private string? _basicInfoStatusMessage;
    private Severity _basicInfoStatusSeverity = Severity.Info;
    // private PersistingComponentStateSubscription _persistenceSubscription;

    private BasicInfoInputModel BasicInfoInput { get; set; } = new();

    // Access Token fields
    private bool _showTokenForm;
    private MudForm? _tokenForm;
    private string TokenName { get; set; } = string.Empty;
    private DateTime? SelectedDate { get; set; } = DateTime.UtcNow.Date.AddMonths(1);
    private TimeSpan? SelectedTime { get; set; } = TimeSpan.FromHours(12);
    private GeneratedToken? GeneratedToken { get; set; }
    private string DisplayedToken => IsTokenVisible ? GeneratedToken?.TokenString ?? "" : "******************";
    private InputType DisplayedTokenType => IsTokenVisible ? InputType.Text : InputType.Password;
    private bool IsTokenVisible { get; set; }
    private string ShowTokenText => IsTokenVisible ? "Hide Token" : "Show Token";

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        // Pre-rendering persistence - commented out since pre-rendering is disabled
        // _persistenceSubscription = ApplicationState.RegisterOnPersisting(PersistData);
        //
        // if (ApplicationState.TryTakeFromJson<User>("current_user", out var persistedUser) && persistedUser != null)
        // {
        //     _user = persistedUser;
        //     _username = persistedUser.Email;
        //     BasicInfoInput.FirstName = persistedUser.FirstName ?? "";
        //     BasicInfoInput.LastName = persistedUser.LastName ?? "";
        // }

        // Load user data from repository
        try
        {
                using var userRepositoryScope = SecuredUserRepositoryFactory.Create();
                using var userManagerScope = UserManagerFactory.Create();

                _user = await userRepositoryScope.GetRequiredCurrentUser();
                _username = _user.UserName;
                _hasPassword = await userRepositoryScope.DoesCurrentUserHavePassword();

                // Load 2FA status
                _is2FaEnabled = await userManagerScope.UserManager.GetTwoFactorEnabledAsync(_user);
                var authenticatorKey = await userManagerScope.UserManager.GetAuthenticatorKeyAsync(_user);
                // Only consider authenticator configured if it has a key AND either 2FA is enabled or recovery codes exist
                // This prevents showing "configured" just from visiting the setup page
                _hasAuthenticator = !string.IsNullOrEmpty(authenticatorKey) &&
                                    (_is2FaEnabled || await userManagerScope.UserManager.CountRecoveryCodesAsync(_user) > 0);
                _recoveryCodesLeft = await userManagerScope.UserManager.CountRecoveryCodesAsync(_user);

            // Load basic info into form
            BasicInfoInput.FirstName = _user.FirstName ?? "";
            BasicInfoInput.LastName = _user.LastName ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading user data");
            ShowStatusMessage("Error loading user information.", Severity.Error);
            return;
        }

        // Load external login data
        try
        {
            using var userLoginRepositoryScope = UserLoginServiceFactory.Create();
            _currentLogins = await userLoginRepositoryScope.Service.ListForCurrentUser();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading external login data");
            ShowStatusMessage("Error loading external login information.", Severity.Error);
            return;
        }

        // Always load other logins (available providers)
        try
        {
            using var signInManagerScope = SignInManagerFactory.Create();
            _otherLogins = (await signInManagerScope.SignInManager.GetExternalAuthenticationSchemesAsync())
                .Where(auth => _currentLogins.All(ul => auth.Name != ul.LoginProvider))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading external authentication schemes");
            ShowStatusMessage("Error loading available login providers.", Severity.Error);
        }
    }

    private Task PersistData()
    {
        if (_user != null)
        {
            ApplicationState.PersistAsJson("current_user", _user);
            ApplicationState.PersistAsJson("user_has_password", _hasPassword);
            ApplicationState.PersistAsJson("user_has_authenticator", _hasAuthenticator);
            ApplicationState.PersistAsJson("user_2fa_enabled", _is2FaEnabled);
            ApplicationState.PersistAsJson("user_recovery_codes_left", _recoveryCodesLeft);
        }

        if (_currentLogins != null)
        {
            // Convert to List for JSON serialization
            var currentLoginsList = _currentLogins.ToList();
            ApplicationState.PersistAsJson("external_logins_current", currentLoginsList);
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        // _persistenceSubscription.Dispose();
    }


    private (string iconHtml, string color) GetProviderStyleInfo(string providerName)
    {
        return providerName.ToLower() switch
        {
            "microsoft" => (GetMicrosoftSvgIcon(), "#ffffff"),
            "google" => (GetGoogleSvgIcon(), "#ffffff"),
            "okta" => (GetOktaSvgIcon(), "#ffffff"),
            "github" => (GetGitHubSvgIcon(), "#24292e"),
            "auth0" => (GetAuth0SvgIcon(), "#2d2d2d"),
            "facebook" => (GetFacebookSvgIcon(), "#1877f2"),
            "twitter" => (GetTwitterSvgIcon(), "#1da1f2"),
            _ => (GetDefaultSvgIcon(), "#666666")
        };
    }

    private string GetMicrosoftSvgIcon()
    {
        return @"<svg viewBox=""0 0 21 21"" xmlns=""http://www.w3.org/2000/svg"">
            <rect x=""1"" y=""1"" width=""9"" height=""9"" fill=""#f25022""/>
            <rect x=""1"" y=""11"" width=""9"" height=""9"" fill=""#00a4ef""/>
            <rect x=""11"" y=""1"" width=""9"" height=""9"" fill=""#7fba00""/>
            <rect x=""11"" y=""11"" width=""9"" height=""9"" fill=""#ffb900""/>
        </svg>";
    }

    private string GetGoogleSvgIcon()
    {
        return @"<svg viewBox=""0 0 24 24"" xmlns=""http://www.w3.org/2000/svg"">
            <path d=""M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"" fill=""#4285F4""/>
            <path d=""M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"" fill=""#34A853""/>
            <path d=""M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"" fill=""#FBBC05""/>
            <path d=""M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"" fill=""#EA4335""/>
        </svg>";
    }

    private string GetOktaSvgIcon()
    {
        return @"<img src=""/_content/SnapCd.Server.Core/okta.png"" alt=""Okta"" style=""width: 24px; height: 24px;"" />";
    }

    private string GetGitHubSvgIcon()
