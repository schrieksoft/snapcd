    .mud-expand-panel-header .mud-expand-panel-text {
        font-size: 1.25rem !important;
        font-weight: 500 !important;
    }

    .connected-accounts-container {
        margin-bottom: 1rem;
    }

    .connected-accounts-buttons {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .connected-account-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        position: relative;
    }

    .connected-account-item .external-login-btn {
        opacity: 0.7;
        cursor: default;
    }

    .connected-account-item .external-login-btn:hover {
        transform: none;
        box-shadow: none;
        opacity: 0.7;
    }

    .remove-btn {
        width: 24px !important;
        height: 24px !important;
        min-width: 24px !important;
        min-height: 24px !important;
    }

    .manage-external-login-buttons {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .external-login-btn {
        width: 48px;
        height: 48px;
        padding: 0;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .external-login-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .external-login-btn:active {
        transform: scale(0.95);
    }

    .mud-dark .external-login-btn:hover {
        box-shadow: 0 4px 16px rgba(255, 255, 255, 0.2);
    }

    .provider-icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

    .provider-icon svg {
        width: 100%;
        height: 100%;
    }

    /* Provider-specific styles */
    .provider-microsoft {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-microsoft:hover {
        background: #f5f5f5 !important;
    }

    .provider-google {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-google:hover {
        background: #f5f5f5 !important;
    }

    .provider-okta {
        background: #ffffff !important;
        border: 1px solid #e0e0e0;
    }

    .provider-okta:hover {
        background: #f5f5f5 !important;
    }

    .provider-github {
        background: #24292e !important;
    }

    .provider-github:hover {
        background: #1a1e22 !important;
    }

    .provider-github .provider-icon svg path {
        fill: white !important;
    }

    .provider-auth0 {
        background: #2d2d2d !important;
    }

    .provider-auth0:hover {
        background: #1a1a1a !important;
    }

    /* Dark mode adjustments */
    .mud-dark .provider-microsoft,
    .mud-dark .provider-google {
        background: white !important;
    }

    .mud-dark .provider-microsoft:hover,
    .mud-dark .provider-google:hover {
