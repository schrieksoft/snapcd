@page "/Account"
@rendermode InteractiveServer
@layout SnapCd.Server.Core.UI.Dashboard.Layout.AccountInteractiveLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using MudBlazor
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Factories
@using SnapCd.Server.Core.Repositories.System.Secured
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Views
@using SnapCd.Server.Core.UI.Dashboard.Layout
@implements IDisposable

@inject UserManagerFactory<User, IdentityRole<Guid>, SnapCdDbContext> UserManagerFactory
@inject IdentityUserAccessorFactory UserAccessorFactory
@inject UserSecuredRepositoryFactory SecuredUserRepositoryFactory
@inject UserLoginServiceFactory UserLoginServiceFactory
@inject SignInManagerFactory SignInManagerFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Profile> Logger
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject PersistentComponentState ApplicationState
@inject AccessTokenServiceFactory AccessTokenServiceFactory
@inject IJSRuntime JsRuntime

<PageTitle>Account</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Account</MudText>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <MudAlert Severity="@_statusSeverity" Class="mb-4" ShowCloseIcon="true"
              CloseIconClicked="() => ClearStatusMessage()">
        @_statusMessage
    </MudAlert>
}

<MudExpansionPanels MultiExpansion="true" Class="mb-4">
    <!-- Basic Information Section -->
    <MudExpansionPanel Text="Basic Information">
        <MudText Typo="Typo.body1" Color="Color.Secondary" GutterBottom="true">
            Update your personal information and view your account details.
        </MudText>

        @if (!string.IsNullOrEmpty(_basicInfoStatusMessage))
        {
            <MudAlert Severity="@_basicInfoStatusSeverity" Class="mb-4">@_basicInfoStatusMessage</MudAlert>
        }

        <EditForm Model="BasicInfoInput" OnValidSubmit="OnValidBasicInfoSubmitAsync">
            <DataAnnotationsValidator/>

            <MudStack Spacing="4" Class="mt-4">
                <MudTextField Value="@_username" Label="Email" Disabled="true"
                              HelperText="Your email address is your username and cannot be changed."/>

                <MudTextField For="@(() => BasicInfoInput.FirstName)" @bind-Value="BasicInfoInput.FirstName"
                              Label="First Name" Placeholder="Enter your first name"
                              HelperText="Your first name as it appears on your account."/>

                <MudTextField For="@(() => BasicInfoInput.LastName)" @bind-Value="BasicInfoInput.LastName"
                              Label="Last Name" Placeholder="Enter your last name"
                              HelperText="Your last name as it appears on your account."/>

                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" ButtonType="ButtonType.Submit">
                        Save Changes
                    </MudButton>
                </div>
            </MudStack>
        </EditForm>
    </MudExpansionPanel>

    <!-- Password Section -->
    <MudExpansionPanel Text="Password">
        <MudText Typo="Typo.body1" Color="Color.Secondary" GutterBottom="true">
            Manage your password authentication settings.
        </MudText>

        @if (_hasPassword)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3 mb-3">
                A password is currently set for your account.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3 mb-3">
                No password currently set, only external logins supported.
            </MudAlert>
        }

        <div class="button-group mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="NavigateToResetPassword"
                       Class="profile-btn">
                Reset Password
            </MudButton>

            @if (_hasPassword)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="NavigateToRemovePassword"
                           Class="profile-btn">
                    Remove Password
                </MudButton>
            }
        </div>
    </MudExpansionPanel>

    <!-- Two-Factor Authentication Section -->
    <MudExpansionPanel Text="Two-Factor Authentication">
        <MudText Typo="Typo.body1" Color="Color.Secondary" GutterBottom="true">
            Enhance your account security with two-factor authentication.
        </MudText>

        @if (_hasAuthenticator)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3 mb-3">
                <div class="d-flex align-center justify-space-between">
                    <span>Authenticator app is configured</span>
                    @if (_is2FaEnabled)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Enabled</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Disabled</MudChip>
                    }
                </div>
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3 mb-3">
                No authenticator app configured. Set one up to enable two-factor authentication.
            </MudAlert>
        }

        @if (_recoveryCodesLeft >= 0 && _is2FaEnabled)
        {
            <MudAlert
                Severity="@(_recoveryCodesLeft == 0 ? Severity.Error : _recoveryCodesLeft <= 3 ? Severity.Warning : Severity.Info)"
                Dense="true" Class="mb-3">
                @if (_recoveryCodesLeft == 0)
                {
                    <text>You have no recovery codes left! Generate new codes immediately.</text>
                }
                else if (_recoveryCodesLeft == 1)
                {
                    <text>You have 1 recovery code left.</text>
                }
                else if (_recoveryCodesLeft <= 3)
                {
                    <text>You have @_recoveryCodesLeft recovery codes left.</text>
                }
                else
                {
                    <text>You have @_recoveryCodesLeft recovery codes available.</text>
                }
            </MudAlert>
        }

        <div class="button-group mt-4">
            @if (!_hasAuthenticator)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="NavigateToRegisterAuthenticator"
                           Class="profile-btn">
                    Add Authenticator
                </MudButton>
            }
            else
            {
                @if (_is2FaEnabled)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               OnClick="NavigateToDisable2fa"
                               Class="profile-btn">
                        Disable 2FA
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               OnClick="NavigateToEnable2fa"
                               Class="profile-btn">
                        Enable 2FA
                    </MudButton>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="NavigateToResetAuthenticator"
                           Class="profile-btn">
                    Reset Authenticator
                </MudButton>
            }

            @if (_is2FaEnabled)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="NavigateToGenerateRecoveryCodes"
                           Class="profile-btn">
                    Generate Recovery Codes
                </MudButton>
            }
        </div>
    </MudExpansionPanel>

    <!-- External Logins Section -->
    <MudExpansionPanel Text="External Logins">
        <MudText Typo="Typo.body1" Color="Color.Secondary" GutterBottom="true">
            Manage external login providers connected to your account
        </MudText>

        @if (_currentLogins?.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" GutterBottom="true" Class="mt-4 mb-2">Connected Logins</MudText>
            <div class="connected-accounts-container">
                <div class="connected-accounts-buttons">
                    @foreach (var login in _currentLogins)
                    {
                        var (iconHtml, color) = GetProviderStyleInfo(login.LoginProvider);
                        <div class="connected-account-item">
                            <button type="button"
                                    class="external-login-btn @($"provider-{login.LoginProvider.ToLower()}")"
                                    style="background-color: @color;"
                                    disabled
                                    title="@login.ProviderDisplayName">
                                <MudTooltip Text="@login.ProviderDisplayName" Placement="Placement.Top" Arrow="true">
                                    <span class="provider-icon">@((MarkupString)iconHtml)</span>
                                </MudTooltip>
                            </button>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => NavigateToRemoveLogin(login.LoginProvider, login.ProviderKey)"
                                           title="Remove this login"
                                           Class="remove-btn"/>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">You currently have no assigned external providers. Select
                one below to add. You can only add an external login for which the email address matches your account
                email.
            </MudAlert>
        }

        @if (_otherLogins?.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" GutterBottom="true" Class="mt-4 mb-2">Add an External Login</MudText>
            <div style="max-width: 50%; margin: 0;">
                <div class="manage-external-login-buttons">
                    @foreach (var provider in _otherLogins)
                    {
                        var (iconHtml, color) = GetProviderStyleInfo(provider.Name);
                        <MudTooltip Text="@provider.DisplayName" Placement="Placement.Top" Arrow="true">
                            <button type="button"
                                    class="external-login-btn @($"provider-{provider.Name.ToLower()}")"
                                    style="background-color: @color;"
                                    title="@provider.DisplayName"
                                    aria-label="@($"Add {provider.DisplayName} login")"
                                    @onclick="() => NavigateToAddLogin(provider.Name)">
                                <span class="provider-icon">@((MarkupString)iconHtml)</span>
                            </button>
                        </MudTooltip>
                    }
                </div>
            </div>
        }
    </MudExpansionPanel>

    <!-- Access Token Management Section -->
    <MudExpansionPanel Text="Access Tokens">
        <MudText Typo="Typo.body1" Color="Color.Secondary" GutterBottom="true">
            Generate and manage API access tokens for programmatic access to your account.
        </MudText>

        @if (GeneratedToken != null)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4 mt-4" Style="background-color: var(--mud-palette-success-lighten);">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Generated Token</MudText>
                    <MudIconButton
                        Icon="@Icons.Material.Filled.Close"
                        OnClick="CloseTokenPanel"
                        Color="Color.Inherit"
                        Size="Size.Small"
                        Class="ml-auto"/>
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField
                        Value="@DisplayedToken"
                        ReadOnly="true"
                        InputType="@DisplayedTokenType"
                        Style="width: 600px; margin-right: 1rem;"/>
                    <MudButton Variant="Variant.Text" OnClick="ToggleShowToken">
                        @ShowTokenText
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CopyToken">
                        Copy Token
                    </MudButton>
                </MudStack>

                <MudText Typo="Typo.body1" GutterBottom="true" Style="font-style: italic; font-size: 0.875rem;">
                    Make sure you save it - you won't be able to access it again!
                </MudText>
            </MudPaper>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   OnClick="ToggleTokenForm"
                   Class="profile-btn mt-4 mb-4">
            Generate New Token
        </MudButton>

        @if (_showTokenForm)
        {
            <MudForm @ref="_tokenForm">
                <MudStack Spacing="3" Class="mb-4">
                    <MudTextField Label="Token Name" @bind-Value="TokenName" Required="true"
                                  HelperText="Enter a token name."/>
                    <MudDatePicker Label="Select Expiration Date" @bind-Date="SelectedDate" Required="true"
                                   HelperText="Pick an expiration date."/>
                    <MudTimePicker Label="Select Expiration Time" @bind-Time="SelectedTime" Required="true"
                                   HelperText="Pick an expiration time."/>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               OnClick="GenerateToken"
                                Class="profile-btn mt-4 mb-4">
                        Submit
                    </MudButton>
                </MudStack>
            </MudForm>
        }

        <MudTable Items="@GetTokens()" Dense="true" Bordered="true" Hover="true" Class="mt-4">
            <HeaderContent>
                <MudTh>Token Name</MudTh>
                <MudTh>Expiration</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Token Name">@context.Name</MudTd>
                <MudTd DataLabel="Expiration">
                    @if (context.ExpirationDate != null)
                    {
                        @ExpiresIn(new DateTimeOffset(context.ExpirationDate.Value))
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton OnClick="() => RevokeToken(context.Id)" Variant="Variant.Text" Color="Color.Info">
                        <MudIcon Icon="@Icons.Material.Filled.Delete"/>
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudExpansionPanel>
</MudExpansionPanels>

<style>
