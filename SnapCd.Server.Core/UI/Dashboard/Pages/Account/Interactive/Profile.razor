    private async Task OnValidBasicInfoSubmitAsync()
    {
        try
        {
            using var userManagerScope = UserManagerFactory.Create();

            // Update user properties
            _user.FirstName = BasicInfoInput.FirstName;
            _user.LastName = BasicInfoInput.LastName;

            var result = await userManagerScope.UserManager.UpdateAsync(_user);
            if (!result.Succeeded)
            {
                _basicInfoStatusMessage = $"Error: {string.Join(", ", result.Errors.Select(error => error.Description))}";
                _basicInfoStatusSeverity = Severity.Error;
                return;
            }

            Logger.LogInformation("User updated their profile information successfully.");
            _basicInfoStatusMessage = "Your profile has been updated successfully.";
            _basicInfoStatusSeverity = Severity.Success;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating profile information");
            _basicInfoStatusMessage = "An error occurred while updating your profile. Please try again.";
            _basicInfoStatusSeverity = Severity.Error;
        }
    }

