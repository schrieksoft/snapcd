    // Access Token Methods
    private void CloseTokenPanel()
    {
        GeneratedToken = null;
        IsTokenVisible = false;
    }

    private void ToggleTokenForm()
    {
        _showTokenForm = !_showTokenForm;
    }

    private async Task GenerateToken()
    {
        if (_tokenForm != null)
        {
            await _tokenForm.Validate();
            if (!_tokenForm.IsValid)
            {
                return;
            }
        }
        else throw new Exception("Form is null");

        var expiration = SelectedDate!.Value.Add(SelectedTime!.Value).ToUniversalTime();

        using var service = AccessTokenServiceFactory.Create();
        GeneratedToken = service.GenerateToken(TokenName, expiration);

        service.AddAccessToken(GeneratedToken.TokenEntity);

        TokenName = string.Empty;
        SelectedDate = DateTime.UtcNow.Date.AddMonths(1);
        SelectedTime = TimeSpan.FromHours(12);
        _showTokenForm = false;
        StateHasChanged();
    }

    public List<Token> GetTokens()
    {
        using var service = AccessTokenServiceFactory.Create();
        return service.Tokens;
    }

    private void ToggleShowToken()
    {
        IsTokenVisible = !IsTokenVisible;
    }

    private async Task CopyToken()
    {
        if (!string.IsNullOrEmpty(GeneratedToken?.TokenString))
        {
            await JsRuntime.InvokeVoidAsync("copyToClipboard", GeneratedToken.TokenString);
        }
    }

    private void RevokeToken(Guid tokenId)
    {
        using var service = AccessTokenServiceFactory.Create();
        service.RevokeAccessToken(tokenId);
    }

    private string ExpiresIn(DateTimeOffset expiration)
    {
        var timeToExpiry = expiration - DateTimeOffset.UtcNow;

        if (timeToExpiry <= TimeSpan.Zero)
        {
            return "Expired";
        }

        if (timeToExpiry.TotalMinutes < 60)
        {
            return $"in {(int)timeToExpiry.TotalMinutes} minutes";
        }

        if (timeToExpiry.TotalHours < 24)
        {
            return $"in {(int)timeToExpiry.TotalHours} hours";
        }

        if (timeToExpiry.TotalHours < 48)
        {
            return "tomorrow";
        }

        return $"in {(int)timeToExpiry.TotalDays} days";
    }

