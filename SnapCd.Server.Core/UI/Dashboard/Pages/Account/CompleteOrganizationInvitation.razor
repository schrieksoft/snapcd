@page "/Account/CompleteOrganizationInvitation"
@layout SnapCd.Server.Core.UI.Dashboard.Layout.AccountLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Factories
@using SnapCd.Server.Core.Services.Dashboard
@using SnapCd.Server.Core.UI.Dashboard.Components.Account

@attribute [Authorize]

@inject UserManager<User> UserManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<CompleteOrganizationInvitation> Logger

<PageTitle>Organization Invitation - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="@GetSubtitle()">
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Organizations" class="login-btn-link">
                    view organizations
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_invitation != null)
    {
        <div class="invitation-info">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                <MudText Typo="Typo.body2">
                    You've been invited to join <strong>@_invitation.Organization.Name</strong> on Snap CD.
                </MudText>
            </MudAlert>
        </div>

        <MudText Typo="Typo.body2" Class="mb-4" Style="text-align: center;">
            Would you like to accept this invitation and join the organization?
        </MudText>

        <div class="button-container">
            <EditForm Model="@_emptyModel" FormName="accept-invitation" OnValidSubmit="OnAcceptAsync" method="post">
                <MudStaticButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large"
                                 FormAction="FormAction.Submit" Class="action-btn">
                    Accept Invitation
                </MudStaticButton>
            </EditForm>
        </div>

        <div class="button-container mt-3">
            <EditForm Model="@_emptyModel" FormName="decline-invitation" OnValidSubmit="OnDeclineAsync" method="post">
                <MudStaticButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Medium"
                                 FormAction="FormAction.Submit" Class="action-btn">
                    Decline
                </MudStaticButton>
            </EditForm>
        </div>
    }
</StaticAccountComponent>

<style>
    .button-container {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .action-btn {
        min-width: 200px;
    }

    .login-button-container {
        display: flex;
        align-items: center;
        margin: 1rem 0;
    }

    .login-btn-link {
        color: #ffffff !important;
        text-decoration: none !important;
        background-color: #000000 !important;
        border: 1px solid #000000;
        padding: 8px 16px;
        cursor: pointer;
        font-size: 14px;
        border-radius: 24px;
        display: inline-block;
    }

    .login-btn-link:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
        text-decoration: none !important;
    }

    .login-button-container .divider-line {
        flex: 1;
        height: 1px;
        background-color: #e0e0e0;
        margin: 0 1rem;
    }

    .mud-dark .login-button-container .divider-line {
        background-color: #333;
    }

    .mt-3 {
        margin-top: 0.75rem;
    }

    .mb-4 {
        margin-bottom: 1rem;
    }
</style>

@code {
    [Inject] private MemberServiceFactory MemberServiceFactory { get; set; } = null!;

    private string? _errorMessage;
    private OrganizationUser? _invitation;
    private readonly object _emptyModel = new();

    [SupplyParameterFromQuery] private string? Token { get; set; }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private string? GetSubtitle()
    {
        if (!string.IsNullOrEmpty(_errorMessage)) return "Invalid Invitation";
        if (_invitation != null) return "Organization Invitation";
        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = "No invitation token provided.";
            return;
        }

        await LoadInvitationAsync();
    }

    private async Task LoadInvitationAsync()
    {
        try
        {
            using var memberServiceScope = MemberServiceFactory.Create();
            _invitation = await memberServiceScope.Service.GetInvitationByTokenAsync(Token!);

            if (_invitation == null)
            {
                _errorMessage = "Invalid or expired invitation token.";
                return;
            }

            if (_invitation.InvitationExpirationDateTime <= DateTime.UtcNow)
            {
                _errorMessage = "This invitation has expired. Please request a new invitation.";
                return;
            }

            if (_invitation.InvitationCompleted)
            {
                _errorMessage = "This invitation has already been completed.";
                return;
            }

            var currentUser = await UserManager.GetUserAsync(HttpContext.User);
            if (currentUser == null || currentUser.Id != _invitation.UserId)
            {
                _errorMessage = "This invitation is for a different user account.";
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invitation");
            _errorMessage = "An error occurred while processing the invitation.";
        }
    }

    private async Task OnAcceptAsync()
    {
        Guid? orgId = await ProcessInvitationActionAsync(accept: true);
        if (orgId is { } id)
        {
            var target = string.IsNullOrEmpty(ReturnUrl) ? "/Home" : ReturnUrl;
            RedirectManager.RedirectTo($"/api/organization/switch/{id}?returnUrl={Uri.EscapeDataString(target)}");
        }
    }

    private async Task OnDeclineAsync()
    {
        var declined = await ProcessInvitationActionAsync(accept: false);
        if (declined is not null)
        {
            if (string.IsNullOrEmpty(ReturnUrl))
            {
                RedirectManager.RedirectTo("/Account/SelectOrganization");
            }
            else
            {
                RedirectManager.RedirectTo(
                    "/Account/SelectOrganization",
                    new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl });
            }
        }
    }

    private async Task<Guid?> ProcessInvitationActionAsync(bool accept)
    {
        try
        {
            using var memberServiceScope = MemberServiceFactory.Create();

            _invitation = await memberServiceScope.Service.GetInvitationByTokenAsync(Token!);

            if (_invitation == null)
            {
                _errorMessage = "Invalid or expired invitation token.";
                return null;
            }

            if (_invitation.InvitationExpirationDateTime <= DateTime.UtcNow)
            {
                _errorMessage = "This invitation has expired.";
                return null;
            }

            if (_invitation.InvitationCompleted)
            {
                _errorMessage = "This invitation has already been completed.";
                return null;
            }

            var currentUser = await UserManager.GetUserAsync(HttpContext.User);
            if (currentUser == null || currentUser.Id != _invitation.UserId)
            {
                _errorMessage = "This invitation is for a different user account.";
                return null;
            }

            if (accept)
            {
                await memberServiceScope.Service.CompleteInvitationAsync(Token!);
                Logger.LogInformation("User {UserId} accepted invitation to organization {OrgId}",
                    currentUser.Id, _invitation.OrganizationId);
            }
            else
            {
                await memberServiceScope.Service.DeclineInvitationAsync(Token!);
                Logger.LogInformation("User {UserId} declined invitation to organization {OrgId}",
                    currentUser.Id, _invitation.OrganizationId);
            }

            return _invitation.OrganizationId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing invitation action");
            _errorMessage = "An error occurred while processing your request.";
            return null;
        }
    }
}
