@page "/Account/RegisterConfirmation"
@layout AccountLayout

@using Microsoft.AspNetCore.Identity
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services.Dashboard
@using SnapCd.Server.Core.Services.Email
@using SnapCd.Server.Core.UI.Dashboard.Components.Email

@inject UserManager<User> UserManager
@inject ISnapCdEmailSender EmailSender
@inject IdentityRedirectManager RedirectManager

<PageTitle>Registration Confirmation - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Registration confirmation">

    <StatusMessage Message="@statusMessage"/>

    @if (_isDeliveryActive == false)
    {
        <EmailNotConfiguredNotice Reason="to confirm your account" />
    }
    else if (_isDeliveryActive == true)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            <MudText Typo="Typo.body1">
                Please check your email to confirm your account. If you don't see the email in your inbox, check your
                spam folder.
            </MudText>
        </MudAlert>
    }

    <div class="register-link">
        <div class="login-button-container">
            <div class="divider-line"></div>
            <a href="@LoginUrl" class="login-btn-link">
                go to login
            </a>
            <div class="divider-line"></div>
        </div>
    </div>
</StaticAccountComponent>

@code {
    private string? statusMessage;
    private bool? _isDeliveryActive;

    [SupplyParameterFromQuery] private string? Email { get; set; }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private string LoginUrl => string.IsNullOrEmpty(ReturnUrl)
        ? "/Account/Login"
        : $"/Account/Login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        if (Email is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = "Error finding user for unspecified email";
            return;
        }

        _isDeliveryActive = await EmailSender.IsDeliveryActiveAsync();
    }

}
