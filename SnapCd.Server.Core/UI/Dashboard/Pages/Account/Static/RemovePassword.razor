@page "/Account/RemovePassword"
@layout AccountLayout

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services.Dashboard
@inject UserManager<User> UserManager
@inject IdentityUserAccessor UserAccessor
@inject ILogger<RemovePassword> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Remove Password - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Remove Password">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to profile
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_removalSuccessful)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Your password has been successfully removed from your account. You can now only sign in using external login
            providers.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to profile
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_user != null && _hasPassword)
    {
        <MudAlert Severity="@(_willLogOut ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-4">
            <MudText Typo="Typo.body2">
                @if (_willLogOut)
                {
                    <text><strong>Warning:</strong> You are currently logged in with a password. Removing your password
                        will log you out immediately.</text>
                }
                else
                {
                    <text><strong>Note:</strong> Removing your password will disable password-based authentication. You
                        will only be able to sign in using external login providers.</text>
                }
            </MudText>
        </MudAlert>

        @if (_currentLogins?.Count == 0)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                <MudText Typo="Typo.body2">
                    <strong>Cannot remove password:</strong> You must have at least one external login provider
                    configured before removing your password.
                </MudText>
            </MudAlert>
        }

        <div style="text-align: center; margin: 2rem 0;">
            <div class="password-preview">
                <div class="password-icon"
                     style="background-color: #f44336; display: inline-flex; align-items: center; justify-content: center;">
                    <span class="provider-icon">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M18,8H16V6A6,6 0 0,0 10,0H9A6,6 0 0,0 3,6V8H1A1,1 0 0,0 0,9V23A1,1 0 0,0 1,24H23A1,1 0 0,0 24,23V9A1,1 0 0,0 23,8M5,6A4,4 0 0,1 9,2H10A4,4 0 0,1 14,6V8H5V6Z"
                                fill="white"/>
                        </svg>
                    </span>
                </div>
                <div style="margin-top: 1rem;">
                    <MudText Typo="Typo.h6">Password Authentication</MudText>
                </div>
            </div>
        </div>

        <div class="sign-in-container">
            <div class="divider-line"></div>
            <form method="post" @formname="remove-password" @onsubmit="OnValidSubmitAsync">
                <AntiforgeryToken/>
                <MudStaticButton Class="remove-btn" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                 FormAction="FormAction.Submit" Disabled="@(_currentLogins?.Count == 0)">
                    @(_willLogOut ? "Remove Password & Sign Out" : "Remove Password")
                </MudStaticButton>
            </form>
            <div class="divider-line"></div>
        </div>
        <div class="mt-3 text-center">
            <form action="/Account" method="get">
                <MudStaticButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                 Class="decline-btn" FormAction="FormAction.Submit">
                    Go Back
                </MudStaticButton>
            </form>
        </div>
    }
    else if (_user != null && !_hasPassword)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            You currently do not have a password set. You can only sign in using external login providers.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to profile
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            User not found or unable to load password information.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to profile
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
</StaticAccountComponent>

@if (_requiresLogout)
{
    <form id="auto-logout-form" action="/Account/Logout" method="post" style="display: none;">
        <AntiforgeryToken/>
    </form>

    <script>
        // Auto-submit the logout form
        document.getElementById('auto-logout-form').submit();
    </script>
}

<style>
    .password-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .password-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: none;
        cursor: default;
    }

    .provider-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .provider-icon svg {
        width: 100%;
        height: 100%;
    }

    /* Button styling matching other static pages */
    .sign-in-container {
        display: flex;
        align-items: center;
        margin: 2rem 0 1rem 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background-color: #e0e0e0;
        margin: 0 1rem;
    }

    .mud-dark .divider-line {
        background-color: #333;
    }

    .remove-btn {
        min-width: 150px;
        background-color: var(--snap-accent) !important;
        color: var(--snap-on-accent) !important;
        padding: 5px 14px;
    }

    .remove-btn:hover:not(:disabled) {
        background-color: var(--snap-accent-hover) !important;
        color: var(--snap-on-accent) !important;
    }

    .remove-btn:disabled {
        background-color: var(--snap-border) !important;
        color: var(--snap-text-3) !important;
        cursor: not-allowed;
    }

    .mud-dark .remove-btn {
        background-color: var(--snap-accent) !important;
        color: var(--snap-on-accent) !important;
    }

    .mud-dark .remove-btn:hover:not(:disabled) {
        background-color: var(--snap-accent-hover) !important;
        color: var(--snap-on-accent) !important;
    }




    .text-center {
        text-align: center;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .register-link {
        margin-top: 1rem;
    }

    .login-button-container {
        display: flex;
        align-items: center;
        margin: 1rem 0;
    }

    .login-btn-link {
        color: var(--snap-on-accent) !important;
        text-decoration: none !important;
        background-color: var(--snap-accent) !important;
        border: 1px solid var(--snap-accent);
        padding: 5px 14px;
        cursor: pointer;
        font-size: 14px;
        border-radius: 0;
        display: inline-block;
    }

    .login-btn-link:hover {
        background-color: var(--snap-accent-hover) !important;
        color: var(--snap-on-accent) !important;
        text-decoration: none !important;
    }

    .mud-dark .login-btn-link {
        color: var(--snap-on-accent) !important;
        background-color: var(--snap-accent) !important;
        border: 1px solid var(--snap-accent);
    }

    .mud-dark .login-btn-link:hover {
        background-color: var(--snap-accent-hover) !important;
        color: var(--snap-on-accent) !important;
        text-decoration: none !important;
    }
</style>

@code {
    private string? errorMessage;
    private User? _user;
    private bool _hasPassword = false;
    private bool _removalSuccessful = false;
    private bool _willLogOut = false;
    private bool _requiresLogout = false;
    private IList<UserLoginInfo>? _currentLogins;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext == null)
        {
            errorMessage = "No HTTP context available.";
            return;
        }

        try
        {
            _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
            _hasPassword = await UserManager.HasPasswordAsync(_user);
            _currentLogins = await UserManager.GetLoginsAsync(_user);

            // Check if the user is currently authenticated via password
            // AMR (Authentication Methods References) claim should contain "pwd" for password authentication
            var amrClaim = HttpContext.User.FindFirst("amr")?.Value;
            _willLogOut = !string.IsNullOrEmpty(amrClaim) && amrClaim.Equals("pwd", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading user password information");
            errorMessage = "Error loading user information.";
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (_user == null)
        {
            errorMessage = "User not found.";
            return;
        }

        if (_currentLogins?.Count == 0)
        {
            errorMessage = "Cannot remove password: You must have at least one external login provider configured.";
            return;
        }

        try
        {
            // Remove password by setting it to null
            var result = await UserManager.RemovePasswordAsync(_user);
            if (!result.Succeeded)
            {
                errorMessage = $"Error: {string.Join(", ", result.Errors.Select(error => error.Description))}";
                return;
            }

            Logger.LogInformation("Password removed for user {UserId}", _user.Id);

            if (_willLogOut)
            {
                // User removed their current authentication method - must logout immediately
                // Use a form submission to properly logout with POST
                _requiresLogout = true;
                StateHasChanged();
            }
            else
            {
                // Safe removal - show success message
                _removalSuccessful = true;
            }
        }
        catch (NavigationException)
        {
            // NavigationException is expected when redirecting to logout
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing password for user {UserId}", _user?.Id);
            errorMessage = "An error occurred while removing the password. Please try again.";
        }
    }

}