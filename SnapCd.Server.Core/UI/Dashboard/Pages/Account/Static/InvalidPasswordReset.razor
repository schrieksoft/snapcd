@page "/Account/InvalidPasswordReset"
@layout AccountLayout


<PageTitle>Invalid Password Reset - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Invalid password reset">
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <MudText Typo="Typo.body1">
            The password reset link is invalid or has expired. Please request a new password reset.
        </MudText>
    </MudAlert>
    
    <div class="register-link">
        <div class="login-button-container">
            <div class="divider-line"></div>
            <a href="@ForgotPasswordUrl" class="login-btn-link">
                reset password
            </a>
            <div class="divider-line"></div>
        </div>
    </div>
</StaticAccountComponent>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string ForgotPasswordUrl => string.IsNullOrEmpty(ReturnUrl)
        ? "/Account/ForgotPassword"
        : $"/Account/ForgotPassword?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}