</style>

@code {
    private string? errorMessage;
    private string? _token;
    private OrganizationUser? _invitation;
    private User? _invitedUser;
    private bool _registrationSuccessful = false;

    [SupplyParameterFromQuery] private string? Token { get; set; }

    [SupplyParameterFromQuery] private string? Error { get; set; }

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    private bool IsNewUser => _invitedUser?.IsRegistrationNotCompleted == true;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private string? GetSubtitle()
    {
        if (!string.IsNullOrEmpty(errorMessage)) return "Invalid Invitation";
        if (_registrationSuccessful) return "Registration Complete!";
        if (_invitation != null && IsNewUser) return "Complete Your Registration";
        if (_invitation != null && !IsNewUser) return "Already Registered";
        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        // Get error message from query parameter
        errorMessage = Error;

        // Get token from query string
        _token = Token;

        if (string.IsNullOrWhiteSpace(_token))
        {
            errorMessage = "No invitation token provided.";
            return;
        }

        try
        {
            // Load invitation details
            _invitation = await MemberService.GetInvitationByTokenAsync(_token);

            if (_invitation == null)
            {
                errorMessage = "Invalid or expired invitation token.";
                return;
            }

            // Check if invitation has expired
            if (_invitation.InvitationExpirationDateTime <= DateTime.UtcNow)
            {
                errorMessage = "This invitation has expired. Please request a new invitation.";
                return;
            }

            // Check if invitation is already completed
            if (_invitation.InvitationCompleted)
            {
                errorMessage = "This invitation has already been completed.";
                return;
            }

            // Get the user
            _invitedUser = _invitation.User;
            if (_invitedUser == null)
            {
                errorMessage = "User not found for this invitation.";
                return;
            }

            // Initialize form model for new users
            if (IsNewUser)
            {
                Input.Email = _invitedUser.Email ?? "";
                Input.FirstName = _invitedUser.FirstName ?? "";
                Input.LastName = _invitedUser.LastName ?? "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading invitation");
            errorMessage = "An error occurred while processing the invitation.";
        }
    }

    private async Task OnValidSubmitAsync()
    {
        try
        {
            // Get a fresh user instance from UserManager to avoid tracking conflicts
            var userToUpdate = await UserManager.FindByIdAsync(_invitedUser!.Id.ToString());
            if (userToUpdate == null)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("User not found.", HttpContext);
                return;
            }

            // Update user profile
            userToUpdate.FirstName = Input.FirstName;
            userToUpdate.LastName = Input.LastName;
            userToUpdate.IsRegistrationNotCompleted = false;

            // Add password
            var addPasswordResult = await UserManager.AddPasswordAsync(userToUpdate, Input.Password);
            if (!addPasswordResult.Succeeded)
            {
                var errors = string.Join(", ", addPasswordResult.Errors.Select(e => e.Description));
                RedirectManager.RedirectToCurrentPageWithStatus($"Error setting password: {errors}", HttpContext);
                return;
            }

            // Update user
            var updateResult = await UserManager.UpdateAsync(userToUpdate);
            if (!updateResult.Succeeded)
            {
                var errors = string.Join(", ", updateResult.Errors.Select(e => e.Description));
                RedirectManager.RedirectToCurrentPageWithStatus($"Error updating user: {errors}", HttpContext);
                return;
            }

            // Record terms acceptance
            var ipAddress = HttpContext?.Connection.RemoteIpAddress?.ToString();
            var userAgent = HttpContext?.Request.Headers["User-Agent"].ToString();
            await TermsService.RecordAcceptanceAsync(
                userToUpdate.Id,
                TermsAcceptanceContext.InvitationRegistration,
                ipAddress,
                userAgent);

            // Mark registration as successful - user still needs to verify email and then accept org invitation
            _registrationSuccessful = true;

            Logger.LogInformation("User registration completed for {Email}", userToUpdate.Email);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error completing registration for token {Token}", _token);
            RedirectManager.RedirectToCurrentPageWithStatus("An error occurred while processing the registration. Please try again.", HttpContext);
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(50, ErrorMessage = "The {0} must be at most {1} characters long.")]
        [Display(Name = "First Name")]
        public string FirstName { get; set; } = "";

        [Required]
        [StringLength(50, ErrorMessage = "The {0} must be at most {1} characters long.")]
        [Display(Name = "Last Name")]
        public string LastName { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        [Required(ErrorMessage = "You must accept the Terms of Service and Privacy Policy")]
        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the Terms of Service and Privacy Policy")]
        [Display(Name = "Accept Terms")]
        public bool AcceptTerms { get; set; } = false;
    }
}
