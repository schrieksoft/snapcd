@page "/Account/CompleteInvitation"
@layout AccountLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.Dashboard
@using SnapCd.Server.Core.Services.Edition

@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject MemberService MemberService
@inject ILogger<CompleteInvitation> Logger
@inject ITermsAcceptanceService TermsService
@inject IInvitationAutoAcceptPolicy InvitationAutoAcceptPolicy
@inject IConsentRequirementPolicy ConsentPolicy

<PageTitle>Complete Registration - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="@GetSubtitle()">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/" class="login-btn-link">
                    return to home
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_registrationSuccessful)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            @if (InvitationAutoAcceptPolicy.AutoAcceptOnRegistration)
            {
                <text>Your registration is complete! Log in to continue.</text>
            }
            else
            {
                <text>Your registration is complete! Log in to accept or decline the organization invitation.</text>
            }
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="@LoginAfterRegistrationUrl" class="login-btn-link">
                    go to login
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_invitation != null && IsNewUser)
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <div class="invitation-info">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                <MudText Typo="Typo.body2">
                    You've been invited to join <strong>@_invitation.Organization.Name</strong> on Snap CD.
                    Complete your registration below, then verify your email and log in to accept the invitation.
                </MudText>
            </MudAlert>
        </div>

        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="registration" method="post">
            <DataAnnotationsValidator/>

            <MudGrid>
                <MudItem xs="12">
                    <MudStaticTextField For="@(() => Input.Email)" @bind-Value="@Input.Email"
                                        Label="Email"
                                        Variant="Variant.Outlined"
                                        FullWidth="true"
                                        ReadOnly="true"
                                        Disabled="true"/>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStaticTextField For="@(() => Input.FirstName)" @bind-Value="Input.FirstName"
                                        Label="First Name"
                                        Variant="Variant.Outlined" FullWidth="true"
                                        Required="true"/>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStaticTextField For="@(() => Input.LastName)" @bind-Value="Input.LastName"
                                        Label="Last Name"
                                        Variant="Variant.Outlined" FullWidth="true"
                                        Required="true"/>
                </MudItem>
                <MudItem xs="12">
                    <MudStaticTextField For="@(() => Input.Password)" @bind-Value="Input.Password"
                                        Label="Password" InputType="InputType.Password"
                                        Placeholder="Enter your password"
                                        Variant="Variant.Outlined" FullWidth="true"
                                        UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" } })"/>
                </MudItem>
                <MudItem xs="12">
                    <MudStaticTextField For="@(() => Input.ConfirmPassword)" @bind-Value="Input.ConfirmPassword"
                                        Label="Confirm Password" InputType="InputType.Password"
                                        Placeholder="Confirm your password"
                                        Variant="Variant.Outlined" FullWidth="true"
                                        UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" } })"/>
                </MudItem>
                @if (ConsentPolicy.RequiresTermsAcceptance)
                {
                    <MudItem xs="12" Class="mt-2">
                        <MudStaticCheckBox @bind-Value="Input.AcceptTerms" For="@(() => Input.AcceptTerms)">
                            <MudText Typo="Typo.body2">
                                I agree to the
                                <MudLink Href="@TermsService.TermsUrl" Target="_blank" Typo="Typo.body2">Terms of Service</MudLink>
                                and
                                <MudLink Href="@TermsService.PrivacyUrl" Target="_blank" Typo="Typo.body2">Privacy Policy</MudLink>
                            </MudText>
                        </MudStaticCheckBox>
                    </MudItem>
                }
                <MudItem xs="12">
                    <div class="complete-button-container">
                        <div class="divider-line"></div>
                        <MudStaticButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                         FormAction="FormAction.Submit" Class="complete-btn">
                            Complete Registration
                        </MudStaticButton>
                        <div class="divider-line"></div>
                    </div>
                </MudItem>
            </MudGrid>
        </EditForm>

        <div class="external-login-section">
            <MudText Align="Align.Center" Typo="Typo.body2" Class="mb-2"
                     Style="color: var(--mud-palette-text-secondary);">or continue with
            </MudText>
            <ExternalLoginPicker Token="@Token" IsRegistrationContext="true"/>
        </div>
    }
    else if (_invitation != null && !IsNewUser)
    {
        @* Existing user - redirect to organization invitation page *@
        <MudAlert Severity="Severity.Info" Class="mb-4">
            You already have a SnapCD account. Please log in to accept or decline this invitation.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="@LoginAfterRegistrationUrl" class="login-btn-link">
                    go to login
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
</StaticAccountComponent>

