@page "/Account/RemoveExternalLogin"
@layout AccountLayout

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services.Dashboard
@inject UserManager<User> UserManager
@inject IdentityUserAccessor UserAccessor
@inject ILogger<RemoveExternalLogin> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Remove External Login - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Remove External Login">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account/Manage/Profile" class="login-btn-link">
                    back to external logins
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_removalSuccessful)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            The <strong>@Provider</strong> login has been successfully removed from your account.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account/Manage/Profile" class="login-btn-link">
                    back to external logins
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Provider) && !string.IsNullOrEmpty(ProviderKey) && _user != null)
    {
        <MudAlert Severity="@(_willLogOut ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-4">
            @if (_willLogOut)
            {
                <MudText Typo="Typo.body2">
                    <strong>Warning:</strong> You are currently logged in via @Provider. Removing this login will log
                    you out.

                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    You are about to remove the <strong>@Provider</strong> login from your account.
                </MudText>
            }
        </MudAlert>

        <div style="text-align: center; margin: 2rem 0;">
            <div class="external-login-preview">
                @{
                    var (iconHtml, color) = GetProviderStyleInfo(Provider);
                }
                <div class="external-login-btn provider-@(Provider.ToLower())"
                     style="background-color: @color; display: inline-flex; align-items: center; justify-content: center;">
                    <span class="provider-icon">@((MarkupString)iconHtml)</span>
                </div>
                <div style="margin-top: 1rem;">
                    <MudText Typo="Typo.h6">@Provider</MudText>
                </div>
            </div>
        </div>

        <div class="sign-in-container">
            <div class="divider-line"></div>
            <form method="post" @formname="remove-login" @onsubmit="OnValidSubmitAsync">
                <AntiforgeryToken/>
                <input type="hidden" name="Input.LoginProvider" value="@Provider"/>
                <input type="hidden" name="Input.ProviderKey" value="@ProviderKey"/>
                <MudStaticButton Class="remove-btn" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                                 FormAction="FormAction.Submit">
                    @(_willLogOut ? "Remove & Sign Out" : "Remove Login")
                </MudStaticButton>
            </form>
            <div class="divider-line"></div>
        </div>
        <div class="mt-3 text-center">
            <form action="/Account/Manage/Profile" method="get">
                <MudStaticButton Variant="Variant.Text" Color="Color.Default" Size="Size.Medium"
                                 Class="decline-btn" FormAction="FormAction.Submit">
                    Go Back
                </MudStaticButton>
            </form>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Missing provider information or user not found.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account/Manage/Profile" class="login-btn-link">
                    back to external logins
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
</StaticAccountComponent>

<style>
    .external-login-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .external-login-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: none;
        cursor: default;
    }

    .provider-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .provider-icon svg {
        width: 100%;
        height: 100%;
    }

    /* Provider-specific styles */
    .provider-microsoft {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-google {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-okta {
        background: #ffffff !important;
        border: 1px solid #e0e0e0;
    }

    .provider-github {
        background: #24292e !important;
    }

    .provider-github .provider-icon svg path {
        fill: white !important;
    }

    .provider-auth0 {
        background: #2d2d2d !important;
    }

    /* Button styling matching other static pages */
    .sign-in-container {
        display: flex;
        align-items: center;
        margin: 2rem 0 1rem 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background-color: #e0e0e0;
        margin: 0 1rem;
    }

    .mud-dark .divider-line {
        background-color: #333;
    }

    .remove-btn {
        min-width: 150px;
        background-color: #000000 !important;
        color: #ffffff !important;
        padding: 8px 16px;
    }

    .remove-btn:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
    }

    .mud-dark .remove-btn {
        background-color: #ffffff !important;
        color: #000000 !important;
    }

    .mud-dark .remove-btn:hover {
        background-color: #e0e0e0 !important;
        color: #000000 !important;
    }

    .decline-btn {
        color: #666 !important;
        text-decoration: underline;
    }

    .mud-dark .decline-btn {
        color: #ccc !important;
    }

    .text-center {
        text-align: center;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .register-link {
        margin-top: 1rem;
    }

    .login-button-container {
        display: flex;
        align-items: center;
        margin: 1rem 0;
    }

    .login-btn-link {
        color: #ffffff !important;
        text-decoration: none !important;
        background-color: #000000 !important;
        border: 1px solid #000000;
        padding: 8px 16px;
        cursor: pointer;
        font-size: 14px;
        border-radius: 24px;
        display: inline-block;
    }

    .login-btn-link:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
        text-decoration: none !important;
    }

    .mud-dark .login-btn-link {
        color: #000000 !important;
        background-color: #ffffff !important;
        border: 1px solid #ffffff;
    }

    .mud-dark .login-btn-link:hover {
        background-color: #e0e0e0 !important;
        color: #000000 !important;
        text-decoration: none !important;
    }
</style>

@if (_requiresLogout)
{
    <form id="auto-logout-form" action="/Account/Logout" method="post" style="display: none;">
        <AntiforgeryToken/>
    </form>

    <script>
        // Auto-submit the logout form
        document.getElementById('auto-logout-form').submit();
    </script>
}

@code {
    private string? errorMessage;
    private User? _user;
    private bool _willLogOut = false;
    private bool _removalSuccessful = false;
    private bool _requiresLogout = false;

    [SupplyParameterFromQuery] private string? Provider { get; set; }

    [SupplyParameterFromQuery] private string? ProviderKey { get; set; }

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Provider) || string.IsNullOrEmpty(ProviderKey))
        {
            errorMessage = "Missing provider information.";
            return;
        }

        if (HttpContext == null)
        {
            errorMessage = "No HTTP context available.";
            return;
        }

        try
        {
            _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

            // Check if removing this provider will require logout
            // This happens if the user is currently authenticated via this provider
            var currentAuthMethod = HttpContext.User.FindFirst("http://schemas.microsoft.com/ws/2008/06/identity/claims/authenticationmethod")?.Value;
            _willLogOut = !string.IsNullOrEmpty(currentAuthMethod) && currentAuthMethod.Equals(Provider, StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading user");
            errorMessage = "Error loading user information.";
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (_user == null)
        {
            errorMessage = "User not found.";
            return;
        }

        try
        {
            var result = await UserManager.RemoveLoginAsync(_user, Input.LoginProvider!, Input.ProviderKey!);
            if (!result.Succeeded)
            {
                errorMessage = "Error: The external login was not removed.";
                return;
            }

            Logger.LogInformation("External login {Provider} removed for user {UserId}", Input.LoginProvider, _user.Id);

            if (_willLogOut)
            {
                // User removed their current authentication method - must logout immediately
                // Use a form submission to properly logout with POST
                _requiresLogout = true;
                StateHasChanged();
            }
            else
            {
                // Safe removal - show success message
                _removalSuccessful = true;
            }
        }
        catch (NavigationException)
        {
            // NavigationException is expected when redirecting to logout
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing external login {Provider} for user {UserId}", Input.LoginProvider, _user?.Id);
            errorMessage = "An error occurred while removing the external login. Please try again.";
        }
    }

    private (string iconHtml, string color) GetProviderStyleInfo(string providerName)
    {
        return providerName.ToLower() switch
        {
            "microsoft" => (GetMicrosoftSvgIcon(), "#ffffff"),
            "google" => (GetGoogleSvgIcon(), "#ffffff"),
            "okta" => (GetOktaSvgIcon(), "#ffffff"),
            "github" => (GetGitHubSvgIcon(), "#24292e"),
            "auth0" => (GetAuth0SvgIcon(), "#2d2d2d"),
            "facebook" => (GetFacebookSvgIcon(), "#1877f2"),
            "twitter" => (GetTwitterSvgIcon(), "#1da1f2"),
            _ => (GetDefaultSvgIcon(), "#666666")
        };
    }

    private string GetMicrosoftSvgIcon()
