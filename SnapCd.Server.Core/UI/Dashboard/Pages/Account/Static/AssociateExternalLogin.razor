@page "/Account/AssociateExternalLogin"
@layout AccountLayout

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services.Dashboard


@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IUserStore<User> UserStore
@inject IdentityRedirectManager RedirectManager
@inject ILogger<AssociateExternalLogin> Logger
@inject NavigationManager NavigationManager

<PageTitle>Associate External Login - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Associate External Login">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to external logins
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (_associationSuccessful)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            The <strong>@Provider</strong> login has been successfully added to your account.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to external logins
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Provider))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            <MudText Typo="Typo.body2">
                You are about to associate your account with <strong>@Provider</strong>.
            </MudText>
        </MudAlert>

        <div style="text-align: center; margin: 2rem 0;">
            <div class="external-login-preview">
                @{
                    var (iconHtml, color) = GetProviderStyleInfo(Provider);
                }
                <div class="external-login-btn provider-@(Provider.ToLower())"
                     style="background-color: @color; display: inline-flex; align-items: center; justify-content: center;">
                    <span class="provider-icon">@((MarkupString)iconHtml)</span>
                </div>
                <div style="margin-top: 1rem;">
                    <MudText Typo="Typo.h6">@Provider</MudText>
                </div>
            </div>
        </div>

        <div class="sign-in-container">
            <div class="divider-line"></div>
            <form action="/Account/Manage/LinkExternalLogin" method="post">
                <AntiforgeryToken/>
                <input type="hidden" name="Provider" value="@Provider"/>
                <MudStaticButton Class="sign-in-btn" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                                 FormAction="FormAction.Submit">
                    Continue
                </MudStaticButton>
            </form>
            <div class="divider-line"></div>
        </div>
        <div class="mt-3 text-center">
            <form action="/Account" method="get">
                <MudStaticButton Variant="Variant.Text" Color="Color.Default" Size="Size.Medium"
                                 Class="decline-btn" FormAction="FormAction.Submit">
                    Go Back
                </MudStaticButton>
            </form>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            No provider specified.
        </MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/Account" class="login-btn-link">
                    back to external logins
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
</StaticAccountComponent>

<style>
    .external-login-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .external-login-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: none;
        cursor: default;
    }

    .provider-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .provider-icon svg {
        width: 100%;
        height: 100%;
    }

    /* Provider-specific styles */
    .provider-microsoft {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-google {
        background: white !important;
        border: 1px solid #e0e0e0;
    }

    .provider-okta {
        background: #ffffff !important;
        border: 1px solid #e0e0e0;
    }

    .provider-github {
        background: #24292e !important;
    }

    .provider-github .provider-icon svg path {
        fill: white !important;
    }

    .provider-auth0 {
        background: #2d2d2d !important;
    }

    /* Button styling matching other static pages */
    .sign-in-container {
        display: flex;
        align-items: center;
        margin: 2rem 0 1rem 0;
    }

    .sign-in-btn {
        min-width: 200px;
        background-color: #000000 !important;
        color: #ffffff !important;
        padding: 12px 24px;
    }

    .mud-dark .sign-in-btn {
        background-color: #ffffff !important;
        color: #000000 !important;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background-color: #e0e0e0;
        margin: 0 1rem;
    }

    .mud-dark .divider-line {
        background-color: #333;
    }

    .decline-btn {
        color: #666 !important;
        text-decoration: underline;
    }

    .mud-dark .decline-btn {
        color: #ccc !important;
    }

    .text-center {
        text-align: center;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .register-link {
        margin-top: 1rem;
    }

    .login-button-container {
        display: flex;
        align-items: center;
        margin: 1rem 0;
    }

    .login-btn-link {
        color: #ffffff !important;
        text-decoration: none !important;
        background-color: #000000 !important;
        border: 1px solid #000000;
        padding: 8px 16px;
        cursor: pointer;
        font-size: 14px;
        border-radius: 24px;
        display: inline-block;
    }

    .login-btn-link:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
        text-decoration: none !important;
    }

    .mud-dark .login-btn-link {
        color: #000000 !important;
        background-color: #ffffff !important;
        border: 1px solid #ffffff;
    }

    .mud-dark .login-btn-link:hover {
        background-color: #e0e0e0 !important;
        color: #000000 !important;
        text-decoration: none !important;
    }
</style>

@code {
    private string? errorMessage;
    private User _user = null!;
    private bool _associationSuccessful = false;

    [SupplyParameterFromQuery] private string? Provider { get; set; }

    [SupplyParameterFromQuery] private string? Action { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        // Handle link login callback if needed
        if (HttpMethods.IsGet(HttpContext.Request.Method) && Action == ExternalLoginConstants.LinkLoginCallbackAction)
        {
            await OnGetLinkLoginCallbackAsync();
            return;
        }

        if (string.IsNullOrEmpty(Provider))
        {
            errorMessage = "No external login provider specified.";
        }
    }

    private async Task OnGetLinkLoginCallbackAsync()
    {
        // Load fresh user to avoid EF tracking conflicts
        var currentUser = await UserAccessor.GetRequiredUserAsync(HttpContext);
        var userId = await UserManager.GetUserIdAsync(currentUser);
        var info = await SignInManager.GetExternalLoginInfoAsync(userId);

        if (info is null)
        {
            errorMessage = "Error: Could not load external login info.";
            return;
        }

        // Validate that the external login matches the current user's email
        if (!DoesExternalLoginMatchUser(currentUser.Email ?? "", info))
        {
            var externalLoginEmail = GetExternalLoginEmail(info);
            errorMessage = $"Error: Cannot associate external login to your account with email {currentUser.Email}. External login \"{externalLoginEmail}\" does not match this email address.";
            return;
        }

        var result = await UserManager.AddLoginAsync(currentUser, info);
        if (!result.Succeeded)
        {
            errorMessage = "Error: The external login was not added. External logins can only be associated with one account.";
            return;
        }

        // Clear the existing external cookie to ensure a clean login process
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);

        Logger.LogInformation("External login {Provider} added for user {UserId}", info.LoginProvider, currentUser.Id);
        _associationSuccessful = true;
    }

    private string GetExternalLoginEmail(ExternalLoginInfo externalLoginInfo)
    {
        if (externalLoginInfo?.Principal == null)
            return "";

        // First try to get email from the email claim
        var email = externalLoginInfo.Principal.FindFirstValue(ClaimTypes.Email);

        // If email claim is missing, try to get it from the username/name identifier
        if (string.IsNullOrEmpty(email))
        {
            var username = externalLoginInfo.Principal.Identity?.Name;

            // Check if the username looks like an email address
            if (!string.IsNullOrEmpty(username) && username.Contains('@') && username.Contains('.'))
            {
                email = username;
                Logger.LogInformation("External login: Using username '{Username}' as email for provider '{Provider}'",
                    username, externalLoginInfo.LoginProvider);
            }
        }

        return email ?? "";
    }

    private bool DoesExternalLoginMatchUser(string userEmail, ExternalLoginInfo externalLoginInfo)
    {
        if (externalLoginInfo?.Principal == null || string.IsNullOrEmpty(userEmail))
            return false;

        // First check if user email equals external login username
        var username = externalLoginInfo.Principal.Identity?.Name;

        if (!string.IsNullOrEmpty(username) && string.Equals(userEmail, username, StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogInformation("External login: User email '{UserEmail}' matches username '{Username}' from provider '{Provider}'",
                userEmail, username, externalLoginInfo.LoginProvider);
            return true;
        }

        // Then check against email claim
        var externalEmail = externalLoginInfo.Principal.FindFirstValue(ClaimTypes.Email);
        if (!string.IsNullOrEmpty(externalEmail) && string.Equals(userEmail, externalEmail, StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogInformation("External login: User email '{UserEmail}' matches email claim '{ExternalEmail}' from provider '{Provider}'",
                userEmail, externalEmail, externalLoginInfo.LoginProvider);
            return true;
        }

        Logger.LogWarning("External login: User email '{UserEmail}' does not match username '{Username}' or email claim '{ExternalEmail}' from provider '{Provider}'",
            userEmail, username ?? "null", externalEmail ?? "null", externalLoginInfo.LoginProvider);
        return false;
    }

    private (string iconHtml, string color) GetProviderStyleInfo(string providerName)
    {
        return providerName.ToLower() switch
        {
            "microsoft" => (GetMicrosoftSvgIcon(), "#ffffff"),
            "google" => (GetGoogleSvgIcon(), "#ffffff"),
            "okta" => (GetOktaSvgIcon(), "#ffffff"),
            "github" => (GetGitHubSvgIcon(), "#24292e"),
            "auth0" => (GetAuth0SvgIcon(), "#2d2d2d"),
            "facebook" => (GetFacebookSvgIcon(), "#1877f2"),
            "twitter" => (GetTwitterSvgIcon(), "#1da1f2"),
            _ => (GetDefaultSvgIcon(), "#666666")
        };
    }

    private string GetMicrosoftSvgIcon()
    {
        return @"<svg viewBox=""0 0 21 21"" xmlns=""http://www.w3.org/2000/svg"">
            <rect x=""1"" y=""1"" width=""9"" height=""9"" fill=""#f25022""/>
            <rect x=""1"" y=""11"" width=""9"" height=""9"" fill=""#00a4ef""/>
            <rect x=""11"" y=""1"" width=""9"" height=""9"" fill=""#7fba00""/>
            <rect x=""11"" y=""11"" width=""9"" height=""9"" fill=""#ffb900""/>
        </svg>";
    }

