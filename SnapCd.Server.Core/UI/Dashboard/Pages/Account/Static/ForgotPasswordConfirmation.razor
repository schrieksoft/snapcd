@page "/Account/ForgotPasswordConfirmation"
@layout AccountLayout

@using SnapCd.Server.Core.Services.Email
@using SnapCd.Server.Core.UI.Dashboard.Components.Email

@inject ISnapCdEmailSender EmailSender

<PageTitle>Password Reset Sent - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Password reset sent">
    @if (_isDeliveryActive == false)
    {
        <EmailNotConfiguredNotice Reason="to reset your password" />
        <MudText Typo="Typo.body2" Class="mb-4">
            If you've forgotten your password, ask your organization owner to reset it for you.
        </MudText>
    }
    else if (_isDeliveryActive == true)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            <MudText Typo="Typo.body1">
                Please check your email to reset your password. If you don't see the email in your inbox, check your spam folder.
            </MudText>
        </MudAlert>
    }

    <div class="register-link">
        <div class="login-button-container">
            <div class="divider-line"></div>
            <a href="@LoginUrl" class="login-btn-link">
                back to login
            </a>
            <div class="divider-line"></div>
        </div>
    </div>
</StaticAccountComponent>

@code {
    private bool? _isDeliveryActive;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string LoginUrl => string.IsNullOrEmpty(ReturnUrl)
        ? "/Account/Login"
        : $"/Account/Login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        _isDeliveryActive = await EmailSender.IsDeliveryActiveAsync();
    }
}
