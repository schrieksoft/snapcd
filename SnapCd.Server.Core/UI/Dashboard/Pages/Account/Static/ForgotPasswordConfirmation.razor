@page "/Account/ForgotPasswordConfirmation"
@layout AccountLayout


<PageTitle>Password Reset Sent - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Password reset sent">
    <MudAlert Severity="Severity.Success" Class="mb-4">
        <MudText Typo="Typo.body1">
            Please check your email to reset your password. If you don't see the email in your inbox, check your spam folder.
        </MudText>
    </MudAlert>
    
    <div class="register-link">
        <div class="login-button-container">
            <div class="divider-line"></div>
            <a href="/Account/Login" class="login-btn-link">
                back to login
            </a>
            <div class="divider-line"></div>
        </div>
    </div>
</StaticAccountComponent>