@page "/Account/ResetPasswordConfirmation"
@layout AccountLayout


<PageTitle>Password Reset Complete - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="Password reset complete">
    <MudAlert Severity="Severity.Success" Class="mb-4">
        <MudText Typo="Typo.body1">
            Your password has been reset successfully. You can now sign in with your new password.
        </MudText>
    </MudAlert>
    
    <div class="register-link">
        <div class="login-button-container">
            <div class="divider-line"></div>
            <a href="/Account/Login" class="login-btn-link">
                sign in now
            </a>
            <div class="divider-line"></div>
        </div>
    </div>
</StaticAccountComponent>