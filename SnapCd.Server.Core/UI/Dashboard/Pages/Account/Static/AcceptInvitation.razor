@page "/Account/AcceptInvitation"
@layout AccountLayout

@using Microsoft.AspNetCore.Identity
@using SnapCd.Server.Core.Factories

@inject NavigationManager NavigationManager
@inject ILogger<AcceptInvitation> Logger

<PageTitle>Accept Invitation - Snap CD</PageTitle>

<StaticAccountComponent Subtitle="@GetSubtitle()">
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>

        <div class="register-link">
            <div class="login-button-container">
                <div class="divider-line"></div>
                <a href="/" class="login-btn-link">
                    return to home
                </a>
                <div class="divider-line"></div>
            </div>
        </div>
    }
    else
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.body2" Class="mt-4" Style="text-align: center;">
            Processing invitation...
        </MudText>
    }
</StaticAccountComponent>

<style>
    .login-button-container {
        display: flex;
        align-items: center;
        margin: 1rem 0;
    }

    .login-btn-link {
        color: #ffffff !important;
        text-decoration: none !important;
        background-color: #000000 !important;
        border: 1px solid #000000;
        padding: 8px 16px;
        cursor: pointer;
        font-size: 14px;
        border-radius: 24px;
        display: inline-block;
    }

    .login-btn-link:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
        text-decoration: none !important;
    }

    .mud-dark .login-btn-link {
        color: #000000 !important;
        background-color: #ffffff !important;
        border: 1px solid #ffffff;
    }

    .mud-dark .login-btn-link:hover {
        background-color: #e0e0e0 !important;
        color: #000000 !important;
        text-decoration: none !important;
    }

    .login-button-container .divider-line {
        flex: 1;
        height: 1px;
        background-color: #e0e0e0;
        margin: 0 1rem;
    }

    .mud-dark .login-button-container .divider-line {
        background-color: #333;
    }

    .mt-4 {
        margin-top: 1rem;
    }

    .mb-4 {
        margin-bottom: 1rem;
    }
</style>

@code {
    [Inject] private MemberServiceFactory MemberServiceFactory { get; set; } = null!;

    private string? _errorMessage;

    [SupplyParameterFromQuery] private string? Token { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private string? GetSubtitle()
    {
        if (!string.IsNullOrEmpty(_errorMessage)) return "Invalid Invitation";
        return "Processing...";
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = "No invitation token provided.";
            return;
        }

        try
        {
            using var memberServiceScope = MemberServiceFactory.Create();
            var invitation = await memberServiceScope.Service.GetInvitationByTokenAsync(Token);

            if (invitation == null)
            {
                _errorMessage = "Invalid or expired invitation token.";
                return;
            }

            // Check if invitation has expired
            if (invitation.InvitationExpirationDateTime <= DateTime.UtcNow)
            {
                _errorMessage = "This invitation has expired. Please request a new invitation.";
                return;
            }

            // Check if invitation is already completed
            if (invitation.InvitationCompleted)
            {
                _errorMessage = "This invitation has already been completed.";
                return;
            }

            // Route based on user status
            if (invitation.User.IsRegistrationNotCompleted)
            {
                // New user - send to registration page
                NavigationManager.NavigateTo($"/Account/CompleteInvitation?token={Token}", forceLoad: true);
            }
            else
            {
                // Existing user - send to login, then to organization invitation page
                var returnUrl = Uri.EscapeDataString($"/Account/CompleteOrganizationInvitation?token={Token}");
                NavigationManager.NavigateTo($"/Account/Login?returnUrl={returnUrl}", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing invitation");
            _errorMessage = "An error occurred while processing the invitation.";
        }
    }
}
