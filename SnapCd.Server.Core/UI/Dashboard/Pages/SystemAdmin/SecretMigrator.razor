@page "/SecretMigrator"
@layout OrganizationMainLayout

@inject ISnackbar Snackbar
@inject IOptions<SecretStoreSettings> Settings
@inject IOrganizationContext OrganizationContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<User> UserManager
@inject SecretMigratorService Migrator

@using System.Threading
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Filters
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.SecretMigrator
@using SnapCd.Server.Core.Settings
@using SnapCd.Server.Core.UI
@using SnapCd.Server.Core.UI.Dashboard.Layout

@attribute [Authorize]
@attribute [AuthorizeOnNavigationPermission]
@attribute [OrganizationScopedFeature]

<PageTitle>Secret Migrator</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Secret Migrator</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else if (!_enabled)
{
    <MudAlert Severity="Severity.Warning">
        Secret Migrator is not enabled. Set <code>SecretStore:EnableMigrator=true</code> in appsettings to use this page.
    </MudAlert>
}
else if (!_authorized)
{
    <MudAlert Severity="Severity.Error">
        You do not have permission to run the Secret Migrator. Requires organization Owner or system Administrator.
    </MudAlert>
}
else
{
    <MudPaper Elevation="1" Class="pa-6 mt-4">
        <MudText Typo="Typo.body2" Class="mb-4">
            Copies secrets between the SQL store and Azure Key Vault. Runs are scoped to the current organization.
            Input/output split is routed automatically by name prefix. Secret values never cross the browser.
        </MudText>

        <MudStack Spacing="3">
            <MudSelect T="MigrationDirection" @bind-Value="_direction" Label="Direction" Disabled="@_running">
                <MudSelectItem Value="@MigrationDirection.SqlToAzureKeyVault">SQL → Azure Key Vault</MudSelectItem>
                <MudSelectItem Value="@MigrationDirection.AzureKeyVaultToSql">Azure Key Vault → SQL</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_inputUrl" Label="Input vault URL" HelperText="Defaults from SecretStore:AzureKeyVault:DefaultInputKeyVaultUrl" Disabled="@_running"/>
            <MudTextField @bind-Value="_outputUrl" Label="Output vault URL" HelperText="Defaults from SecretStore:AzureKeyVault:DefaultOutputKeyVaultUrl" Disabled="@_running"/>

            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                Planning is a read-only step that enumerates source secrets and probes the destination for conflicts.
                For Azure Key Vault it requires one <code>GetSecret</code> call per secret. AKV throttles aggressively, so this can take a while on
                large stores — progress updates live below. You can cancel mid-plan.
            </MudAlert>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PlanAsync"
                           Disabled="@(_running || _planning)"
                           StartIcon="@(_planning ? SnapCdIcons.HourglassTop : null)">
                    @(_planning ? "Planning…" : "Plan migration")
                </MudButton>
                @if (_planning)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small"/>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Cancel">Cancel plan</MudButton>
                }
                @if (_plan is not null && !_planning)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ExecuteAsync" Disabled="@_running" Size="Size.Small">
                        Execute
                    </MudButton>
                }
                @if (_running)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Cancel">Cancel</MudButton>
                }
            </MudStack>

            @if (_planning && _planProgress is not null)
            {
                <MudStack Spacing="1" Class="mt-2">
                    <MudText Typo="Typo.body2">
                        @switch (_planProgress.Phase)
                        {
                            case PlanPhase.ListingSource:
                                <text>Listing source — @_planProgress.Processed found</text>
                                break;
                            case PlanPhase.ProbingDestination:
                                <text>
                                    Probing destination — @_planProgress.Processed
                                    @if (_planProgress.KnownTotal is { } kt)
                                    {
                                        <text>/ @kt</text>
                                    }
                                </text>
                                break;
                        }
                    </MudText>
                    @if (_planProgress.Phase == PlanPhase.ProbingDestination && _planProgress.KnownTotal is { } total && total > 0)
                    {
                        <MudProgressLinear Value="@(100.0 * _planProgress.Processed / total)" Color="Color.Primary"/>
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
                    }
                    @if (!string.IsNullOrEmpty(_planProgress.CurrentName))
                    {
                        <MudText Typo="Typo.caption" Style="word-break: break-all;">@_planProgress.CurrentName</MudText>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    @if (_progress is not null)
    {
        <MudPaper Elevation="1" Class="pa-6 mt-4">
            <MudText Typo="Typo.h6">Progress</MudText>
            <MudProgressLinear Value="@(_progress.Total == 0 ? 0 : 100.0 * _progress.Processed / _progress.Total)"
                               Color="Color.Primary" Class="my-3"/>
            <MudText Typo="Typo.body2">
                @_progress.Processed / @_progress.Total processed —
                @_progress.Copied copied, @_progress.Overwritten overwritten, @_progress.Skipped skipped, @_progress.Failed failed.
            </MudText>
            @if (!string.IsNullOrEmpty(_progress.CurrentName))
            {
                <MudText Typo="Typo.caption">Current: @_progress.CurrentName</MudText>
            }
            @if (!string.IsNullOrEmpty(_progress.LastError))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2">Last error: @_progress.LastError</MudAlert>
            }
        </MudPaper>
    }

    @if (_plan is not null)
    {
        var newItems = _plan.Items.Where(i => !i.DestExists).ToList();
        var existingItems = _plan.Items.Where(i => i.DestExists).ToList();

        <MudPaper Elevation="1" Class="pa-6 mt-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">New (@newItems.Count)</MudText>
                <MudText Typo="Typo.caption">Run id: @_plan.RunId</MudText>
            </MudStack>
            @if (newItems.Count == 0)
            {
                <MudText Typo="Typo.body2">No new secrets to copy.</MudText>
            }
            else
            {
                <MudTable Items="newItems" Dense="true" Hover="true" Bordered="false" Striped="true" FixedHeader="true" Height="300px">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Kind</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name"><code>@context.Name</code></MudTd>
                        <MudTd DataLabel="Kind">@context.Kind</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-6 mt-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">
                    Existing (@existingItems.Count) —
                    <MudText Typo="Typo.body2" Inline="true">
                        @OverwriteCount selected for overwrite, @(existingItems.Count - OverwriteCount) skipped
                    </MudText>
                </MudText>
            </MudStack>
            @if (existingItems.Count == 0)
            {
                <MudText Typo="Typo.body2">No conflicts at destination.</MudText>
            }
            else
            {
                <MudTable Items="existingItems" Dense="true" Hover="true" Bordered="false" Striped="true" FixedHeader="true" Height="360px">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Kind</MudTh>
                        <MudTh Style="width: 120px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudCheckBox T="bool" Value="@AllExistingSelected(existingItems)"
                                             ValueChanged="@((bool v) => ToggleAllOverwrites(existingItems, v))"
                                             Dense="true" Disabled="@_running"/>
                                <span>Overwrite</span>
                            </MudStack>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name"><code>@context.Name</code></MudTd>
                        <MudTd DataLabel="Kind">@context.Kind</MudTd>
                        <MudTd DataLabel="Overwrite">
                            <MudCheckBox T="bool"
                                         Value="@GetOverwrite(context.Name)"
                                         ValueChanged="@((bool v) => SetOverwrite(context.Name, v))"
                                         Dense="true" Disabled="@_running"/>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }
}

@code {
    private bool _loading = true;
    private bool _enabled;
    private bool _authorized;

    private MigrationDirection _direction = MigrationDirection.SqlToAzureKeyVault;
    private string _inputUrl = "";
    private string _outputUrl = "";

    private MigrationPlan? _plan;
    private MigrationProgress? _progress;
    private PlanProgress? _planProgress;
    private CancellationTokenSource? _cts;
    private bool _running;
    private bool _planning;

    // Overwrite selections keyed by item name (only relevant for existing/conflict items).
    private Dictionary<string, bool> _overwriteSelections = new();
    private int OverwriteCount => _overwriteSelections.Count(kvp => kvp.Value);

    private bool GetOverwrite(string name) =>
        _overwriteSelections.TryGetValue(name, out var v) && v;

    private void SetOverwrite(string name, bool value) =>
        _overwriteSelections[name] = value;

    private bool AllExistingSelected(IEnumerable<MigrationItem> items) =>
        items.Any() && items.All(i => GetOverwrite(i.Name));

    private void ToggleAllOverwrites(IEnumerable<MigrationItem> items, bool value)
    {
        foreach (var i in items) _overwriteSelections[i.Name] = value;
    }

    private Guid OrganizationId => OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _enabled = Settings.Value.EnableMigrator;
            if (!_enabled) return;

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(state.User);
            if (user is null) return;
            _userId = user.Id;

            _authorized = await Migrator.IsAuthorizedAsync(_userId, OrganizationId);

            _inputUrl = Settings.Value.AzureKeyVault.DefaultInputKeyVaultUrl;
            _outputUrl = Settings.Value.AzureKeyVault.DefaultOutputKeyVaultUrl;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PlanAsync()
    {
        _plan = null;
        _progress = null;
        _planProgress = null;
        _overwriteSelections = new();
        _planning = true;
        _cts = new CancellationTokenSource();

        var progress = new Progress<PlanProgress>(p =>
        {
            _planProgress = p;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            _plan = await Migrator.PlanAsync(
                _direction, OrganizationId, _userId,
                _inputUrl, _outputUrl, progress, _cts.Token);

            foreach (var item in _plan.Items.Where(i => i.DestExists))
                _overwriteSelections[item.Name] = false;

            Snackbar.Add($"Planned {_plan.Items.Count} items.", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Planning cancelled.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Plan failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _planning = false;
            _planProgress = null;
        }
    }

    private async Task ExecuteAsync()
    {
        if (_plan is null) return;

        _running = true;
        _progress = new MigrationProgress(_plan.Items.Count, 0, 0, 0, 0, 0, null, null);
        _cts = new CancellationTokenSource();

        var progress = new Progress<MigrationProgress>(p =>
        {
            _progress = p;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            // Apply user's per-row overwrite selections onto the plan before execute.
            var resolvedItems = _plan.Items
                .Select(i => i.DestExists
                    ? i with { Action = GetOverwrite(i.Name) ? ItemAction.Overwrite : ItemAction.Skip }
                    : i)
                .ToList();
            var resolvedPlan = _plan with { Items = resolvedItems };

            var final = await Migrator.ExecuteAsync(resolvedPlan, OrganizationId, _userId, progress, _cts.Token);
            _progress = final;
            Snackbar.Add(
                $"Done. Copied {final.Copied}, overwritten {final.Overwritten}, skipped {final.Skipped}, failed {final.Failed}.",
                final.Failed == 0 ? Severity.Success : Severity.Warning);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Migration cancelled.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Migration error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _running = false;
        }
    }

    private void Cancel() => _cts?.Cancel();
}
