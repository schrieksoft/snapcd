@using Microsoft.AspNetCore.Identity
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.Dashboard

@implements IDisposable

@inject IHttpContextAccessor HttpContextAccessor
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject IVersionService VersionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<User> UserManager
@inject OrganizationServiceFactory OrganizationServiceFactory


<MudThemeProvider Theme="_myCustomTheme" IsDarkMode="@_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Never" Elevation="2"
               Style="display: flex; flex-direction: column; background-color: var(--snap-bg-sidebar) !important; height: 100vh; top: 0;">
        <div style="flex: 1; overflow-y: auto; background-color: var(--snap-bg-sidebar);">
            <NavMenu CurrentPageType="@PageType"/> @* See https://stackx48a overflow.com/a/63225118/141789*@
        </div>
        <div style="display: flex; align-items: center; padding: 4px 0; border-top: 1px solid rgba(255,255,255,0.15); background-color: var(--snap-bg-sidebar);">
            <MudNavLink Href="/Account" Match="NavLinkMatch.Prefix" Icon="@SnapCdIcons.AccountCircle"
                        Style="flex: 1; color: var(--snap-sidebar-text) !important;">
                Account
            </MudNavLink>
            @if (RenderModeHelper.IsStaticServersideRendering(HttpContext, NavigationManager))
            {
                <form action="Theme/ToggleDarkMode" method="post" style="margin: 0;">
                    <AntiforgeryToken/>
                    <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                        <MudStaticButton Style="box-shadow: none; min-width: unset; padding: 8px;"
                                         Variant="Variant.Text" FormAction="FormAction.Submit">
                            <MudIcon
                                Icon="@(_isDarkMode ? SnapCdIcons.LightMode : SnapCdIcons.DarkMode)"/>
                        </MudStaticButton>
                    </MudTooltip>
                </form>
            }
            else
            {
                <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                    <MudIconButton Style="box-shadow: none;"
                                   OnClick="@(_ => ToggleDarkMode())"
                                   Icon="@(_isDarkMode ? SnapCdIcons.LightMode : SnapCdIcons.DarkMode)"/>
                </MudTooltip>
            }
        </div>
    </MudDrawer>

    <!-- Custom Drawer Toggle Button -->
    <div class="drawer-toggle-button @(_drawerOpen ? "drawer-open" : "drawer-closed")" @onclick="DrawerToggle">
        <MudIcon Icon="@(_drawerOpen ? SnapCdIcons.ChevronLeft : SnapCdIcons.ChevronRight)"
                 Color="Color.Surface" Size="Size.Small"/>
    </div>

    <!-- Spacer to offset main content -->
    <div
        style="position: fixed; top: 0; left: 0; width: 18px; height: 100vh; z-index: 1000; pointer-events: none;"></div>

    <MudMainContent Class="pa-4">
        <div style="margin-left: 18px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<style>
    .drawer-toggle-button {
        position: fixed;
        top: 32px;
        background-color: var(--snap-bg-sidebar);
        width: 18px;
        height: 36px;
        border-radius: 0 4px 4px 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 1300;
        transition: left 0.3s ease;
        box-shadow: var(--snap-shadow-md);
    }

    .drawer-toggle-button,
    .drawer-toggle-button .mud-icon-root,
    .drawer-toggle-button svg {
        color: var(--snap-sidebar-text) !important;
    }

    .drawer-toggle-button svg path:not([fill="none"]) {
        fill: var(--snap-sidebar-text) !important;
    }

    .drawer-toggle-button.drawer-open {
        left: 240px;
    }

    .drawer-toggle-button.drawer-closed {
        left: 0px;
    }

    .drawer-toggle-button:hover {
        background-color: var(--snap-bg-raised);
    }

    .mud-drawer .mud-drawer-content {
        background-color: var(--snap-bg-sidebar) !important;
    }

    .mud-drawer .mud-drawer-content,
    .mud-drawer .mud-drawer-content * {
        color: var(--snap-sidebar-text) !important;
    }

    .mud-drawer .mud-drawer-content .mud-icon-root,
    .mud-drawer .mud-drawer-content svg {
        color: var(--snap-sidebar-text) !important;
    }

    .mud-drawer .mud-drawer-content svg path:not([fill="none"]) {
        fill: var(--snap-sidebar-text) !important;
    }

    .mud-drawer .mud-nav-link.mud-nav-link-active,
    .mud-drawer .mud-nav-link.active {
        background-color: rgba(232,236,239,0.15) !important;
        border-left: 3px solid var(--snap-accent, #E85D1A) !important;
        padding-left: calc(var(--mud-nav-link-padding-left, 16px) - 3px);
    }
</style>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = true;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        ThemeService.Initialize(ThemeCookie.IsDark(HttpContextAccessor.HttpContext));
        _isDarkMode = ThemeService.IsDarkMode;
        ThemeService.OnThemeChanged += ThemeChanged;
    }


    private MudTheme _myCustomTheme = SnapCdTheme.Default;

    private async Task ToggleDarkMode()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void ThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= ThemeChanged;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public Type? PageType { get; set; }

    protected override void OnParametersSet()
    {
        PageType = (Body!.Target as RouteView)?.RouteData.PageType;
    }
}
