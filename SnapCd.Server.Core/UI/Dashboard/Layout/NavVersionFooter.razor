@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Services.Edition
@inject IVersionService VersionService
@inject IEditionNavProvider EditionNavProvider

@* Sits at the bottom of the drawer, just above Account, so it never competes with the lockup or the nav items. *@
<div class="nav-version">
    <span class="nav-version-running">v@(VersionService.ShortVersion)</span>@EditionNavProvider.EditionVersionIndicator
</div>

<style>
    .nav-version {
        display: flex;
        flex-direction: row;
        align-items: baseline;
        gap: 6px;
        padding: 12px 16px;
        font-size: 0.7rem;
        line-height: 1.3;
        white-space: nowrap;
        background-color: var(--snap-bg-sidebar);
    }

    .nav-version-running {
        color: rgba(255, 255, 255, 0.35);
        font-family: 'Geist Mono', ui-monospace, monospace;
    }
</style>
