@using SnapCd.Server.Core.UI.Dashboard.Components.Organization
@using Microsoft.AspNetCore.WebUtilities
@using SnapCd.Server.Core.UI.Dashboard.Pages.Account.Interactive
@using SnapCd.Server.Core.UI.Dashboard.Pages.Organization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.Edition
@using SnapCd.Server.Core.Settings
@using SnapCd.Server.Core.UI.Dashboard.Pages.SystemAdmin
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Options
@using SnapCd.Server.Core.Services
@using SnapCd.Server.Core.Enums
@using SnapCd.Server.Core.Repositories.Custom.Secured
@using SnapCd.Server.Core.Repositories.Organizations.Secured
@using SnapCd.Server.Core.Services.Notification
@using SnapCd.Server.Core.Services.PrincipalProvider
@using SnapCd.Contracts
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IHostEnvironment HostEnvironment
@inject IVersionService VersionService
@inject IEditionNavProvider EditionNavProvider
@inject IDbContextFactory<SnapCdDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOrganizationContext OrganizationContext
@inject IOptions<SecretStoreSettings> SecretStoreSettings
@inject IOrganizationActivationService OrganizationActivation
@inject OrganizationMembershipCacheService MembershipCache
@inject UserManager<User> UserManager
@inject HttpContextPrincipalProvider HttpContextPrincipalProvider
@inject UserFavoriteSecuredRepositoryFactory FavoriteRepoFactory
@inject ModuleSecuredRepositoryFactory ModuleRepoFactory
@inject NamespaceSecuredRepositoryFactory NamespaceRepoFactory
@inject StackSecuredRepositoryFactory StackRepoFactory
@inject FavoritesModifiedNotificationService FavoritesModifiedNotificationService

<MudNavMenu Style="background-color: var(--snap-bg-sidebar); color: var(--snap-text); padding-top: 16px; width: 100%; overflow-x: hidden;">

    <AuthorizeView>
        <Authorized>

            <!-- Header Section -->
            <a href="/" style="display: flex; align-items: center; padding: 16px; margin-bottom: 16px; text-decoration: none; cursor: pointer;">
                @* The lockup is a single asset: cube + wordmark, with the accent already
                   on the "CD". The sidebar is always dark, so it takes the white one. *@
                <img src="/_content/SnapCd.Server.Core/lockup-white.svg" alt="Snap CD"
                     style="height: 28px; width: auto;"/>
                <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.35); margin-left: auto; font-size: 0.65rem;">
                    v@(VersionService.ShortVersion)
                </MudText>
            </a>

            <!-- Organization Selector -->
            <OrganizationSelector CurrentOrganizationId="_currentOrganizationId"/>

            <!-- General Section (gated by Cloud subscription status on SaaS) -->
            @if (_organizationActivated && _generalIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                @foreach (var link in _generalNavLinks)
                {
                    @if (_generalIsAllowedToNavigateMap[link.PageType])
                    {
                        <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match"
                                    Icon="@link.Icon">@link.Text</MudNavLink>
                    }

                    @* Starred items sit below Stacks *@
                    @if (link.Href == "Stacks" && _favoriteLinks.Any())
                    {
                        <MudNavGroup Title="Starred" Icon="@SnapCdIcons.Star" Expanded="false" Class="starred-nav-group">
                            @foreach (var group in _favoriteLinks.GroupBy(f => f.TargetType).OrderBy(g => g.Key))
                            {
                                <div class="starred-type-label">@GetStarredGroupLabel(group.Key)</div>
                                @foreach (var favorite in group)
                                {
                                    <MudNavLink Href="@favorite.Url" Match="NavLinkMatch.All" title="@favorite.FullPath">@favorite.Label</MudNavLink>
                                }
                            }
                        </MudNavGroup>
                    }
                }
            }

            <!-- Identity Access Section -->
            @if (_identityAccessIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                <MudNavGroup Title="Identity Access" Icon="@SnapCdIcons.SupervisedUserCircle"
                             Expanded="false">
                    @foreach (var link in _identityAccessNavLinks)
                    {
                        @if (_identityAccessIsAllowedToNavigateMap[link.PageType])
                        {
                            <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match" Icon="@link.Icon">
                                @link.Text
                            </MudNavLink>
                        }
                    }
                </MudNavGroup>
            }

            <!-- System Section (gated by Cloud subscription status on SaaS) -->
            @if (_organizationActivated && _systemIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                <MudNavGroup Title="System" Icon="@SnapCdIcons.Settings" Expanded="false">
                    @foreach (var link in _systemNavLinks)
                    {
                        @if (_systemIsAllowedToNavigateMap[link.PageType])
                        {
                            <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match" Icon="@link.Icon">
                                @link.Text
                            </MudNavLink>
                        }
                    }

                    <!-- Edition-specific items that belong inside System (self-hosted License). -->
                    @if (EditionSystemNavItems != null)
                    {
                        @EditionSystemNavItems
                    }
                </MudNavGroup>
            }

            <!-- Tests Section (dev only — surfaces dev-mode test tools like the Mission test bench). -->
            @if (HostEnvironment.IsDevelopment())
            {
                <MudNavGroup Title="Tests" Icon="@SnapCdIcons.Science" Expanded="false">
                    @foreach (var link in _testsNavLinks)
                    {
                        @if (_testsIsAllowedToNavigateMap.TryGetValue(link.PageType, out var allowed) && allowed)
                        {
                            <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match" Icon="@link.Icon">
                                @link.Text
                            </MudNavLink>
                        }
                    }
                </MudNavGroup>
            }
            <MudNavLink Href="@GetNavigationUrl("ApiReference")" Match="NavLinkMatch.All" Icon="@SnapCdIcons.Api">API Reference</MudNavLink>

            <!-- Edition-specific standalone nav items, after System (SaaS Subscriptions group). -->
            @if (EditionNavItems != null)
            {
                @EditionNavItems
            }

            <!-- Edition-specific account nav items (Organizations, etc.) -->
            @if (EditionAccountNavItems != null)
            {
                @EditionAccountNavItems
            }


        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Match="NavLinkMatch.Prefix" Icon="@SnapCdIcons.Person">
                Register
            </MudNavLink>
            <MudNavLink Href="Account/Login" Match="NavLinkMatch.Prefix" Icon="@SnapCdIcons.Password">Login
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

<style>
    .mud-nav-menu {
        background-color: var(--snap-bg-sidebar) !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
        box-sizing: border-box !important;
    }

    /* Sidebar text colour. Deliberately NOT a blanket `.mud-nav-menu *` rule: with
       !important that beat every attempt to colour anything in the sidebar (the
       brand accent, a status dot, a badge) and was impossible to opt out of.
       Colour is set on the container and inherited; the rules below only target
       the elements that do not inherit it on their own. */
    .mud-nav-menu {
        color: var(--snap-sidebar-text);
    }

    .mud-nav-menu .mud-nav-link,
    .mud-nav-menu .mud-nav-group-header,
    .mud-nav-menu .mud-nav-link .mud-icon-root {
        color: var(--snap-sidebar-text) !important;
    }

    /* Nav-link icons only. Scoped to .mud-icon-root so it cannot repaint other
       artwork in the sidebar (the logo lockup, badges). */
    .mud-nav-menu .mud-icon-root svg path:not([fill="none"]),
    .mud-nav-menu svg.mud-icon-root path:not([fill="none"]) {
        fill: var(--snap-sidebar-text) !important;
    }

    .mud-nav-link {
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        box-sizing: border-box !important;
    }

    .mud-nav-link:hover,
    .mud-nav-group .mud-nav-group-header:hover {
        background-color: rgba(232,236,239,0.1) !important;
    }

    .mud-nav-link.mud-nav-link-active,
    .mud-navmenu .mud-nav-link.active {
        background-color: rgba(232,236,239,0.15) !important;
        border-left: 3px solid var(--snap-accent, #E85D1A) !important;
        padding-left: calc(var(--mud-nav-link-padding-left, 16px) - 3px);
    }

    .mud-divider {
        background-color: rgba(255,255,255,0.15) !important;
    }

    /* Starred group scrolls internally once it exceeds ~a third of the sidebar height */
    .starred-nav-group .mud-collapse-container {
        max-height: 33vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
    }

    .mud-drawer .mud-drawer-content .starred-type-label {
        padding: 6px 16px 2px 24px;
        font-family: var(--snap-font-mono, monospace);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.35) !important;
    }
</style>

@code {
    private Guid? _currentOrganizationId => OrganizationContext.CurrentOrganizationId;
    [Parameter] public required Type CurrentPageType { get; set; }
    private RenderFragment? EditionSystemNavItems => EditionNavProvider.EditionSystemNavItems;
    private RenderFragment? EditionNavItems => EditionNavProvider.EditionNavItems;
    private RenderFragment? EditionAccountNavItems => EditionNavProvider.EditionAccountNavItems;

    protected override async Task OnInitializedAsync()
    {
        var orgId = OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
        _organizationActivated = await OrganizationActivation.IsActivatedAsync(orgId);

        if (SecretStoreSettings.Value.EnableMigrator)
        {
            _systemNavLinks.Add(new NavLinkItem(
                "SecretMigrator", NavLinkMatch.All,
                SnapCdIcons.SyncAlt, "Secret Migrator",
                typeof(SecretMigrator)));
        }

        _generalIsAllowedToNavigateMap = await BuildAllowedMapAsync(_generalNavLinks, orgId);
        _identityAccessIsAllowedToNavigateMap = await BuildAllowedMapAsync(_identityAccessNavLinks, orgId);
        _systemIsAllowedToNavigateMap = await BuildAllowedMapAsync(_systemNavLinks, orgId);
        if (HostEnvironment.IsDevelopment())
            _testsIsAllowedToNavigateMap = await BuildAllowedMapAsync(_testsNavLinks, orgId);

        if (orgId != Guid.Empty
            && HttpContextPrincipalProvider.GetPrincipalDiscriminatorOrDefault() == PrincipalDiscriminator.User)
        {
            _principalId = HttpContextPrincipalProvider.GetSubjectOrDefault(orgId);
            if (_principalId != Guid.Empty)
            {
                await LoadFavorites(orgId);
                FavoritesModifiedNotificationService.Subscribe(_principalId, HandleFavoritesModified);
                _subscribedToFavorites = true;
            }
        }
    }

    private List<FavoriteLink> _favoriteLinks = new();
    private Guid _principalId;
    private bool _subscribedToFavorites;

    private record FavoriteLink(FavoriteTargetType TargetType, string Label, string Url, string FullPath);

    private static string GetStarredGroupLabel(FavoriteTargetType targetType) => targetType switch
    {
        FavoriteTargetType.Stack => "Stacks",
        FavoriteTargetType.Namespace => "Namespaces",
        _ => "Modules"
    };


    private async Task LoadFavorites(Guid orgId)
    {
        var principal = new LiteralPrincipalProvider(_principalId, PrincipalDiscriminator.User, [orgId]);

        using var favoriteRepo = FavoriteRepoFactory.Create(principal);
        var favorites = await favoriteRepo.List(orgId);

        var links = new List<FavoriteLink>();
        if (favorites.Count > 0)
        {
            var moduleIds = favorites.Where(f => f.TargetType == FavoriteTargetType.Module).Select(f => f.TargetId).ToList();
            var namespaceIds = favorites.Where(f => f.TargetType == FavoriteTargetType.Namespace).Select(f => f.TargetId).ToList();
            var stackIds = favorites.Where(f => f.TargetType == FavoriteTargetType.Stack).Select(f => f.TargetId).ToList();

            var moduleLookup = new Dictionary<Guid, FavoriteLink>();
            if (moduleIds.Any())
            {
                using var moduleRepo = ModuleRepoFactory.Create(principal);
                var modules = await moduleRepo.List(orgId, q => q
                    .Where(m => moduleIds.Contains(m.Id))
                    .Select(m => new { m.Id, m.Name, NamespaceName = m.Namespace.Name, StackName = m.Namespace.Stack.Name }));
                moduleLookup = modules.ToDictionary(
                    m => m.Id,
                    m => new FavoriteLink(
                        FavoriteTargetType.Module,
                        m.Name,
                        $"/Module/{m.StackName}/{m.NamespaceName}/{m.Name}",
                        $"{m.StackName}/{m.NamespaceName}/{m.Name}"));
            }

            var namespaceLookup = new Dictionary<Guid, FavoriteLink>();
            if (namespaceIds.Any())
            {
                using var namespaceRepo = NamespaceRepoFactory.Create(principal);
                var namespaces = await namespaceRepo.List(orgId, q => q
                    .Where(n => namespaceIds.Contains(n.Id))
                    .Select(n => new { n.Id, n.Name, StackName = n.Stack.Name }));
                namespaceLookup = namespaces.ToDictionary(
                    n => n.Id,
                    n => new FavoriteLink(
                        FavoriteTargetType.Namespace,
                        n.Name,
                        $"/Namespace/{n.StackName}/{n.Name}",
                        $"{n.StackName}/{n.Name}"));
            }

            var stackLookup = new Dictionary<Guid, FavoriteLink>();
            if (stackIds.Any())
            {
                using var stackRepo = StackRepoFactory.Create(principal);
                var stacks = await stackRepo.List(orgId, q => q
                    .Where(s => stackIds.Contains(s.Id))
                    .Select(s => new { s.Id, s.Name }));
                stackLookup = stacks.ToDictionary(
                    s => s.Id,
                    s => new FavoriteLink(
                        FavoriteTargetType.Stack,
                        s.Name,
                        $"/Stack/{s.Name}",
                        s.Name));
            }

            foreach (var favorite in favorites)
            {
                var lookup = favorite.TargetType switch
                {
                    FavoriteTargetType.Module => moduleLookup,
                    FavoriteTargetType.Namespace => namespaceLookup,
                    _ => stackLookup
                };
                if (lookup.TryGetValue(favorite.TargetId, out var link))
                    links.Add(link);
            }
        }

        // Grouped by target type (same as the dashboard's Starred card), alphabetical within each group
        _favoriteLinks = links
            .OrderBy(l => l.TargetType)
            .ThenBy(l => l.FullPath, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private Task HandleFavoritesModified(Guid userId)
    {
        _ = InvokeAsync(async () =>
        {
            var orgId = OrganizationContext.CurrentOrganizationId ?? Guid.Empty;
            if (orgId == Guid.Empty) return;
            await LoadFavorites(orgId);
            StateHasChanged();
        });
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        if (_subscribedToFavorites)
            FavoritesModifiedNotificationService.Unsubscribe(_principalId, HandleFavoritesModified);
    }

    private async Task<Dictionary<Type, bool>> BuildAllowedMapAsync(IEnumerable<NavLinkItem> links, Guid orgId)
    {
        var map = new Dictionary<Type, bool>();
        foreach (var link in links)
        {
            map[link.PageType] = await IsAllowedToNavigateAsync(link.PageType, orgId);
        }
        return map;
    }

    private bool HasOrganizationSelected()
    {
        return _currentOrganizationId.HasValue && _currentOrganizationId.Value != Guid.Empty;
    }

    private string GetNavigationUrl(string baseHref)
    {
        // All pages now use simple URLs without organization ID
        // The organization context is maintained via cookie
        return $"/{baseHref}";
    }

    // General Section - displayed at the top
    private List<NavLinkItem> _generalNavLinks = new()
    {
        new NavLinkItem("Dashboard", NavLinkMatch.All, SnapCdIcons.SpaceDashboard, "Dashboard", typeof(OrganizationHome)),
        new NavLinkItem("Stacks", NavLinkMatch.Prefix, SnapCdIcons.Layers, "Stacks", typeof(Stacks))
    };

    // System Section - collapsible group
    private List<NavLinkItem> _systemNavLinks = new()
    {
        new NavLinkItem("Runners", NavLinkMatch.All, SnapCdIcons.Manufacturing, "Runners", typeof(Runners)),
        new NavLinkItem("Agents", NavLinkMatch.All, SnapCdIcons.SmartToy, "Agents", typeof(Agents)),
        new NavLinkItem("Integrations", NavLinkMatch.All, SnapCdIcons.Hub, "Integrations", typeof(Integrations)),
        new NavLinkItem("SourceRefresherPreselections", NavLinkMatch.All, SnapCdIcons.Code, "Source Refreshers", typeof(SourceRefresherPreselections)),
        new NavLinkItem("StateStores", NavLinkMatch.All, SnapCdIcons.Storage, "State Stores", typeof(StateStores)),
        new NavLinkItem("PreviewFeatures", NavLinkMatch.All, SnapCdIcons.Science, "Preview Features", typeof(PreviewFeatures))
    };

    // Tests Section - collapsible group, dev only
    private List<NavLinkItem> _testsNavLinks = new()
    {
        new NavLinkItem("MissionTestBench", NavLinkMatch.All, SnapCdIcons.Science, "Mission test bench", typeof(MissionTestBench)),
        new NavLinkItem("IntegrationTestBench", NavLinkMatch.All, SnapCdIcons.Hub, "Integration test bench", typeof(IntegrationTestBench))
    };

    // Identity Access Section - collapsible group
    private List<NavLinkItem> _identityAccessNavLinks = new()
    {
        new NavLinkItem("Users", NavLinkMatch.All, SnapCdIcons.Person, "Users", typeof(Users)),
        new NavLinkItem("Groups", NavLinkMatch.All, @SnapCdIcons.Group, "Groups", typeof(Groups)),
        new NavLinkItem("ServicePrincipals", NavLinkMatch.All, SnapCdIcons.Terminal, "Service Principals", typeof(ServicePrincipals)),
        new NavLinkItem("RoleCapabilities", NavLinkMatch.All, SnapCdIcons.Shield, "Role Capabilities", typeof(RoleCapabilities))
    };


    private record NavLinkItem(string Href, NavLinkMatch Match, string Icon, string Text, Type PageType);

    private Dictionary<Type, bool> _generalIsAllowedToNavigateMap = new();
    private Dictionary<Type, bool> _systemIsAllowedToNavigateMap = new();
    private Dictionary<Type, bool> _testsIsAllowedToNavigateMap = new();
    private Dictionary<Type, bool> _identityAccessIsAllowedToNavigateMap = new();
    private bool _organizationActivated;

    private async Task<bool> IsAllowedToNavigateAsync(Type pageType, Guid orgId)
    {
        var attr = pageType
            .GetCustomAttributes(typeof(AuthorizeOnNavigationPermission), inherit: true)
            .OfType<AuthorizeOnNavigationPermission>()
            .FirstOrDefault();

        if (attr is null) return true;
        if (attr.AnyOf.Length == 0) return true;
        if (orgId == Guid.Empty) return true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null) return false;

        return await MembershipCache.HasAnyOrganizationRoleAsync(user.Id, orgId, attr.AnyOf);
    }


}


