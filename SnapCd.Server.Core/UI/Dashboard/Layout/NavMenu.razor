@implements IDisposable
@using SnapCd.Server.Core.UI.Dashboard.Components.Organization
@using Microsoft.AspNetCore.WebUtilities
@using SnapCd.Server.Core.UI.Dashboard.Pages.Account.Interactive
@using SnapCd.Server.Core.UI.Dashboard.Pages.Organization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SnapCd.Server.Core.Database
@using SnapCd.Server.Core.Entities.Definition
@using SnapCd.Server.Core.Services.OrganizationContext
@using SnapCd.Server.Core.Services.Edition
@using SnapCd.Server.Core.Settings
@using SnapCd.Server.Core.UI.Dashboard.Pages.SystemAdmin
@using Microsoft.Extensions.Options
@inject NavigationManager NavigationManager
@inject IEditionNavProvider EditionNavProvider
@inject IDbContextFactory<SnapCdDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOrganizationContext OrganizationContext
@inject IOptions<SecretStoreSettings> SecretStoreSettings

<MudNavMenu Style="background-color: #000; color: white; padding-top: 16px; width: 100%; overflow-x: hidden;">

    <AuthorizeView>
        <Authorized>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0"/>

            <!-- Header Section -->
            <a href="/" style="display: flex; align-items: center; padding: 16px; margin-bottom: 16px; text-decoration: none; cursor: pointer;">
                <img src="/_content/SnapCd.Server.Core/logo-inverted-32x32.png" alt="Snap CD"
                     style="width: 32px; height: 32px; margin-right: 12px; image-rendering: -webkit-optimize-contrast; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges;"/>
                <MudText Typo="Typo.h5" Style="color: white; font-weight: 600;">Snap CD</MudText>
            </a>

            <!-- Organization Selector -->
            <OrganizationSelector CurrentOrganizationId="_currentOrganizationId"/>

            <!-- General Section -->
            @if (_generalIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                @foreach (var link in _generalNavLinks)
                {
                    @if (_generalIsAllowedToNavigateMap[link.PageType])
                    {
                        <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match"
                                    Icon="@link.Icon">@link.Text</MudNavLink>
                    }
                }
            }

            <!-- System Section -->
            @if (_systemIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                <MudNavGroup Title="System" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                    @foreach (var link in _systemNavLinks)
                    {
                        @if (_systemIsAllowedToNavigateMap[link.PageType])
                        {
                            <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match" Icon="@link.Icon">
                                @link.Text
                            </MudNavLink>
                        }
                    }
                </MudNavGroup>
            }

            <!-- Identity Access Section -->
            @if (_identityAccessIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                <MudNavGroup Title="Identity Access" Icon="@Icons.Material.Filled.SupervisedUserCircle"
                             Expanded="false">
                    @foreach (var link in _identityAccessNavLinks)
                    {
                        @if (_identityAccessIsAllowedToNavigateMap[link.PageType])
                        {
                            <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match" Icon="@link.Icon">
                                @link.Text
                            </MudNavLink>
                        }
                    }
                </MudNavGroup>
            }

            <!-- Edition-specific nav items (License, Subscription, etc.) -->
            @if (EditionNavItems != null)
            {
                @EditionNavItems
            }

            <MudDivider/>

            <!-- Account Section -->
            @if (_accountIsAllowedToNavigateMap.Any(entry => entry.Value))
            {
                @foreach (var link in _accountNavLinks)
                {
                    @if (_accountIsAllowedToNavigateMap[link.PageType])
                    {
                        <MudNavLink Href="@GetNavigationUrl(link.Href)" Match="@link.Match" Icon="@link.Icon">
                            @link.Text
                        </MudNavLink>
                    }
                }
            }

            <!-- Edition-specific account nav items (Organizations, etc.) -->
            @if (EditionAccountNavItems != null)
            {
                @EditionAccountNavItems
            }

            <!-- Swagger -->
            @if (_swaggerIsAllowedToNavigate)
            {
                <MudNavLink Href="@GetNavigationUrl("Swagger")" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Api">Swagger
                </MudNavLink>
            }

            <form action="Account/Logout" method="post" style="margin: 0; padding: 0;">
                <AntiforgeryToken/>
                <input type="hidden" name="ReturnUrl" value="@_currentUrl"/>
                <button type="submit" class="mud-nav-link mud-ripple" style="width: 100%; text-align: left; background: none; border: none; font-family: inherit; font-size: inherit; display: flex; align-items: center; padding: 8px 16px;">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-3"></MudIcon>
                    Logout
                </button>
            </form>

        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
                Register
            </MudNavLink>
            <MudNavLink Href="Account/Login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Password">Login
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

<style>
    /* Override MudNavMenu styles for pitch black theme */
    .mud-nav-menu {
        background-color: #000 !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
        box-sizing: border-box !important;
    }

    .mud-nav-link {
        color: white !important;
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        box-sizing: border-box !important;
    }

    .mud-nav-link:hover {
        background-color: rgba(135, 206, 235, 0.2) !important; /* Light blue with opacity */
        color: white !important;
    }

    .mud-nav-link.mud-nav-link-active {
        background-color: rgba(135, 206, 235, 0.3) !important; /* Light blue with higher opacity */
        color: white !important;
    }

    .mud-nav-link .mud-icon {
        color: white !important;
    }

    .mud-nav-group .mud-nav-group-header {
        color: white !important;
    }

    .mud-nav-group .mud-nav-group-header .mud-icon {
        color: white !important;
    }

    .mud-nav-group .mud-nav-group-header:hover {
        background-color: rgba(135, 206, 235, 0.2) !important;
        color: white !important;
    }

    /* Ensure dropdown arrows are white */
    .mud-nav-group .mud-nav-group-header .mud-expand-icon {
        color: white !important;
    }

    .mud-nav-group .mud-nav-group-header .mud-expand-icon svg {
        color: white !important;
        fill: white !important;
    }

    .mud-divider {
        background-color: rgba(255, 255, 255, 0.2) !important;
    }

    /* Override any theme-specific styles */
    .mud-nav-menu * {
        color: white !important;
    }

    .mud-nav-menu .mud-icon {
        color: white !important;
    }

    /* Ensure all SVG icons are white */
    .mud-nav-menu svg {
        color: white !important;
        fill: white !important;
    }

    /* Target all MudBlazor icon classes */
    .mud-nav-menu .mud-icon-root {
        color: white !important;
    }

    .mud-nav-menu .mud-icon-root svg {
        color: white !important;
        fill: white !important;
    }

    /* Ensure button icons are white */
    .mud-nav-menu .mud-button .mud-icon {
        color: white !important;
    }

    .mud-nav-menu .mud-button .mud-icon svg {
        color: white !important;
        fill: white !important;
    }

    /* Force override for light mode - more specific selectors */
    .mud-theme-light .mud-nav-menu .mud-icon,
    .mud-theme-light .mud-nav-menu .mud-icon-root,
    .mud-theme-light .mud-nav-menu .mud-expand-icon {
        color: white !important;
    }

    .mud-theme-light .mud-nav-menu svg,
    .mud-theme-light .mud-nav-menu .mud-icon svg,
    .mud-theme-light .mud-nav-menu .mud-icon-root svg,
    .mud-theme-light .mud-nav-menu .mud-expand-icon svg {
        color: white !important;
        fill: white !important;
    }

    /* Target the specific MudBlazor icon classes used in light mode */
    .mud-nav-menu .mud-nav-link .mud-icon,
    .mud-nav-menu .mud-nav-group-header .mud-icon,
    .mud-nav-menu .mud-button-root .mud-icon {
        color: white !important;
    }

    .mud-nav-menu .mud-nav-link .mud-icon svg,
    .mud-nav-menu .mud-nav-group-header .mud-icon svg,
    .mud-nav-menu .mud-button-root .mud-icon svg {
        color: white !important;
        fill: white !important;
    }
</style>

@code {
    private string? _currentUrl;
    private Guid? _currentOrganizationId => OrganizationContext.CurrentOrganizationId;
    [Parameter] public required Type CurrentPageType { get; set; }
    private RenderFragment? EditionNavItems => EditionNavProvider.EditionNavItems;
    private RenderFragment? EditionAccountNavItems => EditionNavProvider.EditionAccountNavItems;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        if (SecretStoreSettings.Value.EnableMigrator)
        {
            _systemNavLinks.Add(new NavLinkItem(
                "SecretMigrator", NavLinkMatch.All,
                Icons.Material.Filled.SyncAlt, "Secret Migrator",
                typeof(SecretMigrator)));
        }

        _generalIsAllowedToNavigateMap = _generalNavLinks
            .ToDictionary(
                link => link.PageType,
                link => IsAllowedToNavigate(link.PageType)
            );

        _identityAccessIsAllowedToNavigateMap = _identityAccessNavLinks
            .ToDictionary(
                link => link.PageType,
                link => IsAllowedToNavigate(link.PageType)
            );

        _accountIsAllowedToNavigateMap = _accountNavLinks
            .ToDictionary(
                link => link.PageType,
                link => IsAllowedToNavigate(link.PageType)
            );

        _systemIsAllowedToNavigateMap = _systemNavLinks
            .ToDictionary(
                link => link.PageType,
                link => IsAllowedToNavigate(link.PageType)
            );

        _swaggerIsAllowedToNavigate = IsAllowedToNavigate(typeof(Swagger));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
    }

    private bool HasOrganizationSelected()
    {
        return _currentOrganizationId.HasValue && _currentOrganizationId.Value != Guid.Empty;
    }

    private string GetNavigationUrl(string baseHref)
    {
        // All pages now use simple URLs without organization ID
        // The organization context is maintained via cookie
        return $"/{baseHref}";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    // General Section - displayed at the top
    private List<NavLinkItem> _generalNavLinks = new()
    {
        new NavLinkItem("Stacks", NavLinkMatch.Prefix, Icons.Material.Filled.Layers, "Stacks", typeof(Stacks))
    };

    // System Section - collapsible group
    private List<NavLinkItem> _systemNavLinks = new()
    {
        new NavLinkItem("Runners", NavLinkMatch.All, "material-symbols-outlined/manufacturing", "Runners", typeof(Runners)),
        new NavLinkItem("SourceRefresherPreselections", NavLinkMatch.All, "material-symbols-outlined/code", "Source Refreshers", typeof(SourceRefresherPreselections)),
        new NavLinkItem("PreviewFeatures", NavLinkMatch.All, Icons.Material.Filled.Science, "Preview Features", typeof(PreviewFeatures))
    };

    // Identity Access Section - collapsible group
    private List<NavLinkItem> _identityAccessNavLinks = new()
    {
        new NavLinkItem("Users", NavLinkMatch.All, Icons.Material.Filled.People, "Users", typeof(Users)),
        new NavLinkItem("ServicePrincipals", NavLinkMatch.All, Icons.Material.Filled.PrecisionManufacturing, "Service Principals", typeof(ServicePrincipals)),
        new NavLinkItem("Groups", NavLinkMatch.All, @Icons.Material.Filled.Group, "Groups", typeof(Groups))
    };


    // Account Section - collapsible group
    private List<NavLinkItem> _accountNavLinks = new()
    {
        new NavLinkItem("Account", NavLinkMatch.Prefix, Icons.Material.Filled.AccountCircle, "Account", typeof(Index))
    };

    private record NavLinkItem(string Href, NavLinkMatch Match, string Icon, string Text, Type PageType);

    private Dictionary<Type, bool> _generalIsAllowedToNavigateMap = new();
    private Dictionary<Type, bool> _systemIsAllowedToNavigateMap = new();
    private Dictionary<Type, bool> _identityAccessIsAllowedToNavigateMap = new();
    private Dictionary<Type, bool> _accountIsAllowedToNavigateMap = new();
    private bool _swaggerIsAllowedToNavigate;

    private bool IsAllowedToNavigate(Type pageType)
    {
        // Check if the page has the [AuthorizeOnNavigationPermission] attribute
        var requiresPermissionCheck = pageType.GetCustomAttributes(typeof(AuthorizeOnNavigationPermission), true).Any();

        if (!requiresPermissionCheck)
        {
            return true; // Allow access if the attribute is not present
        }

        // Use PageAuthorizationService to determine access
        return true;
    }


}


