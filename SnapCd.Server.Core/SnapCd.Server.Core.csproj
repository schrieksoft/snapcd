<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>SnapCd.Server.Core</RootNamespace>
        <!-- Required by SnapCd.Generators (mcp command): the codegen reads <summary>/<param> XML doc
             off the controllers it generates wrappers for, which only flows through when doc
             generation is enabled on this project. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: missing XML doc on public members — we only want docs for MCP-exposed actions,
             not every type. Suppressed at project level. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- CS8669: Razor source generator emits nullable annotations in generated code without
             a #nullable enable directive. Generated-code-only; not actionable in source. -->
        <NoWarn>$(NoWarn);CS8669</NoWarn>

        <IsPackable>true</IsPackable>
        <PackageId>SnapCd.Server.Core</PackageId>
        <Authors>Schrieksoft</Authors>
        <Company>Schrieksoft</Company>
        <Description>Shared server-side components, services, and Razor UI for SnapCD.</Description>
        <PackageProjectUrl>https://github.com/schrieksoft/snapcd-lib</PackageProjectUrl>
        <RepositoryUrl>https://github.com/schrieksoft/snapcd-lib</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageTags>snapcd</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- Global usings that the Web SDK normally provides -->
    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Builder" />
        <Using Include="Microsoft.AspNetCore.Http" />
        <Using Include="Microsoft.AspNetCore.Hosting" />
        <Using Include="Microsoft.AspNetCore.Routing" />
        <Using Include="Microsoft.Extensions.Configuration" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BlazorMonaco" Version="3.5.0" />
        <PackageReference Include="MudBlazor" Version="8.14.0" />
        <PackageReference Include="Extensions.MudBlazor.StaticInput" Version="3.2.1" />
        <PackageReference Include="AnsiConsoleToHtml" Version="0.2.0" />
        <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
        <ProjectReference Include="..\SnapCd.Contracts\SnapCd.Contracts.csproj" />
        <ProjectReference Include="..\SnapCd.Utils\SnapCd.Utils.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
        <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
        <PackageReference Include="EntityFrameworkCore.Exceptions.SqlServer" Version="8.1.3" />
        <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
        <PackageReference Include="Hangfire.Core" Version="1.8.25" />
        <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
        <PackageReference Include="MassTransit" Version="8.5.10" />
        <PackageReference Include="MassTransit.Azure.ServiceBus.Core" Version="8.5.10" />
        <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
        <PackageReference Include="MassTransit.SqlTransport.SqlServer" Version="8.5.10" />
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
        <!-- Referenced directly only to raise the floor: EF Core 10.0.14 resolves a SqlClient whose System.Security.Cryptography.Pkcs has an open advisory. -->
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
        <PackageReference Include="SendGrid" Version="9.29.3" />
        <PackageReference Include="OpenIddict.AspNetCore" Version="7.8.0" />
        <PackageReference Include="OpenIddict.Abstractions" Version="7.8.0" />
        <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.8.0" />
        <PackageReference Include="OpenIddict.Quartz" Version="7.8.0" />
        <PackageReference Include="OpenIddict.EntityFrameworkCore.Models" Version="7.8.0" />
        <PackageReference Include="RestSharp" Version="112.1.0" />
        <PackageReference Include="AWSSDK.SimpleEmail" Version="4.0.100.21" />
        <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.22" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
        <PackageReference Include="Markdig" Version="0.38.0" />
    </ItemGroup>

    <!-- Embed SQL views and announcements as resources -->
    <ItemGroup>
        <EmbeddedResource Include="Views\**\*.sql" />
        <EmbeddedResource Include="Startup\Hangfire\*.css" />
        <EmbeddedResource Include="Startup\Hangfire\*.js" />
        <EmbeddedResource Include="AI\Skills\**\*" />
    </ItemGroup>

    <!-- Version Configuration -->
    <!-- Version / AssemblyVersion / FileVersion / InformationalVersion are intentionally
         unset so they are supplied at publish time (CI passes /p:Version=$SEMVER) and fall
         back to git-describe in Debug via Directory.Build.targets at the repo root. -->
    <PropertyGroup>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

</Project>
